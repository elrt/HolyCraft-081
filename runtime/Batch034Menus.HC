 else if(k==14)g29_opt.splitControls=!g29_opt.splitControls;else if(k==21)g29_opt.fancy=!g29_opt.fancy;else if(k==22)g29_opt.fancySkies=!g29_opt.fancySkies;else if(k==23)g29_opt.animateWater=!g29_opt.animateWater;else if(k==24)g29_opt.hideGui=!g29_opt.hideGui;if(k==12 || k==13)MC029_HudConfig();}
F32 MC029_OptMin(I32 k){if(k==15)return 3;return 0;}
F32 MC029_OptMax(I32 k){if(k==15)return 12;return 1;}
F32 MC029_OptGetF(I32 k){if(k==10)return g29_opt.sensitivity;if(k==15)return g29_opt.pixelDensity;if(k==30)return g29_opt.sound;return 0;}
