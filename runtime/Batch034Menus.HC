U0 MC029_ChatInit(){g29_btnN=0;MC029_AddT(2,g29_gw-42,8,38,18,"Back");MC029_Add(1,6,0,g29_gh-20,g29_gw-20,20,NULL);I32 y=g29_gh-20;if(g29_kb)y=g29_gh/2-20;
