 if(o->kind==G29O_PROGRESS){F32 mn=MC029_OptMin(o->key),mx=MC029_OptMax(o->key);MC029_OptSetF(o->key,mn+(mx-mn)*p);}
 else if(release){I32 n=MC029_StepN(o->key),v7=n-1,idx=floorf(v7*p+0.5);if(idx>v7)idx=v7;if(idx<0)idx=0;g29_optProg[i]=idx/(v7(F32));MC029_OptSetI(o->key,MC029_StepVal(o->key,idx));}}
U0 MC029_OptionsPress(){MC029_PressButtons();if(g29_pressId>=0)return;g29_optPress=-1;g29_optDrag=-1;if(!MC029_Inside(48,29,g29_gw-48,g29_gh-29))return;I32 i;
 for(i=0;i<g29_oiN;i++){MCOptItem029 *o=&g29_oi[i];I32 y=MC029_OptY(o),cx=MC029_OptCX(o);
  if((o->kind==G29O_PROGRESS || o->kind==G29O_STEP) && MC029_Inside(cx,y,100,20)){g29_optDrag=i;MC029_OptSliderSet(i,FALSE);return;}
  if(o->kind==G29O_TOGGLE && MC029_Inside(cx,y,38,20))g29_optPress=i;
  if(o->kind==G29O_TEXT){g29_tbUser.x=cx;g29_tbUser.y=y;if(MC029_TextBoxPress(&g29_tbUser))g29_optPress=i;}
  if(o->kind==G29O_LOGIN && MC029_Inside(o->x,y+3,66,18)){g29_optPress=i;g29_pressId=7000+i;}}
 if(g29_optContent>g29_gh-29)MC029_ScrollPress(&g29_optScroll);}
U0 MC029_OptionsMove(){if(g29_optDrag>=0){MC029_OptSliderSet(g29_optDrag,FALSE);return;}MC029_ScrollMove(&g29_optScroll);}
U0 MC029_OptionsRelease(){Bool drag=g29_optScroll.drag && g29_optScroll.active;MC029_ScrollRelease(&g29_optScroll);if(g29_optDrag>=0){MC029_OptSliderSet(g29_optDrag,TRUE);g29_optDrag=-1;return;}
 if(g29_optPress>=0){I32 i=g29_optPress;g29_optPress=-1;MCOptItem029 *o=&g29_oi[i];I32 y=MC029_OptY(o),cx=MC029_OptCX(o);if(o->kind==G29O_LOGIN)g29_pressId=-1;if(drag)return;
  if(o->kind==G29O_TOGGLE && MC029_Inside(cx,y,38,20))MC029_OptToggle(o->key);else if(o->kind==G29O_TEXT){g29_tbUser.x=cx;g29_tbUser.y=y;MC029_TextBoxRelease(&g29_tbUser);}else if(o->kind==G29O_LOGIN)MC029_Status("Realms login is not available in this port");return;}
 I32 id=MC029_ReleaseButtons();if(id==1){MC029_OptSave();if(g29_optFromWorld)MC029_Go(G29S_PAUSE);else MC029_Go(G29S_START);}else if(id>=2 && id<=5){g29_optPane=id-2;MC029_ScrollZero(&g29_optScroll);MC029_OptionsInit();}}
U0 MC029_OptionsSync(){if(strcmp(g29_opt.username,g29_tbUser.text)){strncpy(g29_opt.username,g29_tbUser.text,16);g29_opt.username[16]=0;}}

