I32 MC029_StepVal(I32 k,I32 i){if(k==2){if(i==0)return 0;return 2;}return 3-i;}
I32 MC029_OptGetI(I32 k){if(k==2)return g29_opt.difficulty;return g29_opt.viewDistance;}
U0 MC029_OptSetI(I32 k,I32 v){if(k==2)g29_opt.difficulty=v;else{g29_opt.viewDistance=v;MC029_ApplyViewDistance();}}
