U0 MC029_ChatSend(){if(!g29_chatText[0])return;if(g34_app && MC034_Command(g34_app,g29_chatText)){g29_chatText[0]=0;return;}MC029_AddMessage(g29_opt.username,g29_chatText);I32 i;if(g29_histN>=32){for(i=1;i<32;i++)strcpy(g29_hist[i-1],g29_hist[i]);g29_histN=31;}strcpy(g29_hist[g29_histN++],g29_chatText);g29_histPos=g29_histN;g29_chatText[0]=0;}
