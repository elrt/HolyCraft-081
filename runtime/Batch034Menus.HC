U0 MC029_ChatRender(){MC029_RenderBackground(TRUE);I32 h=g29_gh,v10=g29_gw-20;if(g29_kb)h=g29_gh/2;I32 v11=MC029_Wrap(g29_chatText,0,0,v10-4,0,FALSE,FALSE)*10+4,v12=v11;if(v12<20)v12=20;I32 v13=h-v12,y=v13,i;
