Bool MC029_OptBool(I32 k){if(k==3)return g29_opt.thirdPerson;if(k==4)return g29_opt.serverVisible;if(k==11)return g29_opt.invertMouse;if(k==12)return g29_opt.lefty;if(k==13)return g29_opt.useTouch;if(k==14)return g29_opt.splitControls;if(k==21)return g29_opt.fancy;if(k==22)return g29_opt.fancySkies;if(k==23)return g29_opt.animateWater;if(k==24)return g29_opt.hideGui;return FALSE;}
