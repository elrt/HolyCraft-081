 else{if(!g29_tbHad){Bool moving=MC029_Speed2(s)>0.01;g29_tbStart=now;g29_tbMoved=0;g29_tbState=1;g29_tbCanUse=FALSE;g29_tbRing=!moving;g29_tbUsed=FALSE;g29_tbLX=x;g29_tbLY=y;}
  dx=x-g29_tbLX;dy=y-g29_tbLY;F32 v22=fabsf(dx)+fabsf(dy);if(v22>200){v22=0;dx=0;dy=0;}g29_tbMoved+=v22;if(g29_tbState==1 && g29_tbMoved>=20)g29_tbState=2;
  if(g29_tbState==1 && now-g29_tbStart>=0.4){Bool moving=MC029_Speed2(s)>0.01;if(g29_tbCanUse || (g29_tbMoved<=20 && !moving)){g29_tbState=3;g29_tbRing=TRUE;}else g29_tbState=2;}
  g29_tbLX=x;g29_tbLY=y;}
 if(!g29_tbRing)g29_build=-0.05;else if(g29_tbState==1){F32 t=(now-g29_tbStart)/0.4;g29_build=t*t;}else if(g29_tbState==3)g29_build=MC029_Approach(g29_build,1);else g29_build=MC029_Approach(g29_build,0);
 g29_tbHad=has;*rx=dx;*ry=-dy;}
// tickBuild: press/release events of this tick (single pointer).
Bool g29_evPress=FALSE,g29_evRelease=FALSE;I32 g29_evRX=0,g29_evRY=0,g29_evPX=0,g29_evPY=0;
I32 MC029_TickBuild(MCApp028 *s){if(g29_tbState==3){g29_tbUsed=TRUE;return 20;}I32 ret=0;F64 now=getTimeS();
 if(g29_evPress && MC029_CameraArea(g29_evPX,g29_evPY)){g29_tbPressAt=now;g29_tbState=1;}
 if(g29_evRelease && MC029_CameraArea(g29_evRX,g29_evRY)){if(!(g29_tbMoved>20)){if(g29_tbState<=1){F64 d=now-g29_tbPressAt;if(d>=0 && d<0.25)ret=9;}g29_tbState=0;}}
 return ret;}
// GameRenderer::render/tick mouse smoothing (sensitivity curve, |x|^1.2 acceleration).
U0 MC029_TurnAccumulate(F32 rx,F32 ry){F32 c=g29_opt.sensitivity*0.6+0.2,f=c*c*c*8.0;g29_acc9C+=f*rx*4.0;g29_accA0+=f*ry*4.0;}
U0 MC029_TurnTick(I32 ticks){if(ticks<1)ticks=1;F32 inv=1.0/ticks,v=powf(fabsf(g29_acc9C),1.2)*0.4*inv;g29_turnA4=v;if(g29_acc9C<0)g29_turnA4=-v;v=powf(fabsf(g29_accA0),1.2)*0.4*inv;g29_turnA8=v;if(g29_accA0<0)g29_turnA8=-v;g29_acc9C=0;g29_accA0=0;}
U0 MC029_TurnApply(MCApp028 *s,F32 now){F32 d=now-g29_turnPrev;g29_turnPrev=now;if(d>3)d=3;if(d<0)d=0;if(d==0)return;F32 inv=-1;if(g29_opt.invertMouse)inv=1;Entity *e=&s->minecraft.player->player.mob.entity;Entity_turn(e,d*g29_turnA4,d*g29_turnA8*inv);if(e->body.pitch>90)e->body.pitch=90;if(e->body.pitch< -90)e->body.pitch=-90;}
// Pick ray through the pointer (ITouchScreenModel/allowPicking -> GameRenderer::pick with mouseX/mouseY).
U0 MC029_RayAt(MCApp028 *s,F32 px,F32 py){F32 *p=s->camera.projectionMat,*m=s->camera.modelViewMat;if(p[0]==0 || p[5]==0){g29_dirMode=0;return;}F32 nx=2*px/g29_W-1,ny=1-2*py/g29_H,xe=(nx+p[8])/p[0],ye=(ny+p[9])/p[5];
 F32 dx=-m[2]+xe*m[0]+ye*m[1],dy=-m[6]+xe*m[4]+ye*m[5],dz=-m[10]+xe*m[8]+ye*m[9],l=sqrtf(dx*dx+dy*dy+dz*dz);if(l<=0){g29_dirMode=0;return;}g29_rayX=dx/l;g29_rayY=dy/l;g29_rayZ=dz/l;g29_dirMode=1;}
U0 MC029_UpdatePickMode(MCApp028 *s){if(!g29_opt.useTouch){g29_dirMode=0;return;}if(g29_pDown && MC029_CameraArea(g29_px,g29_py))MC029_RayAt(s,g29_px,g29_py);else g29_dirMode=2;}
// Gui::tickItemDrop (survival: hold a toolbar slot for 40 ticks).
U0 MC029_DropSlot(MCApp028 *s,I32 slot){Inventory *inv=&s->minecraft.player->player.inventory;ItemInstance *it=Inventory_getLinked(inv,slot);if(!MC029_ValidItem(it))return;I32 sel=inv->selectedSlot,mode=g29_dirMode;inv->selectedSlot=slot;g29_dirMode=0;I32 n=it->count,i;for(i=0;i<n && MC029_ValidItem(it);i++)MC028_DropHeld(s);inv->selectedSlot=sel;g29_dirMode=mode;}
