U0 MC029_GuiTick(MCApp028 *s,Bool screenOpen){g29_guiTick++;if(g29_nameT<2)g29_nameT+=0.05;I32 i;for(i=0;i<g29_msgN;i++)g29_msg[i].ticks++;MC029_TickItemDrop(s,screenOpen);}
