   else if(k==0){if(b->inWater)g29_tJump=TRUE;else if(!g29_flyMode)v5=TRUE;g29_tForward+=1;g29_btnDown[0]=TRUE;}
   else if(k==1){if(!g29_fwdHeld){g29_tForward-=1;g29_btnDown[1]=TRUE;}}
