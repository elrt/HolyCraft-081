Bool MC029_ToolbarClick(MCApp028 *s,I32 x,I32 y,Bool screenOpen){I32 slot=MC029_SlotAt(x,y);if(slot<0)return FALSE;if(slot==g29_slots-1){g29_invRequest=TRUE;return TRUE;}MC028_Select(s,slot);g29_nameT=0;return TRUE;}
