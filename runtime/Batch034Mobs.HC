// ---- spawning (Level::postProcess spawnMobs / MobSpawner) ----
I32 MC31_Top(I32 x,I32 z){I32 y;for(y=127;y>0;y--){I32 id=MC31_Tile(x,y,z);if(id>0 && MC31_Solid(id) && id!=18)return y+1;}return 1;}
Bool MC31_SpawnOk(I32 x,I32 y,I32 z){if(x<0 || z<0 || x>255 || z>255 || y<1 || y>126)return FALSE;I32 below=MC31_Tile(x,y-1,z),at=MC31_Tile(x,y,z),up=MC31_Tile(x,y+1,z);return MC31_Cube(below) && below!=7 && !MC31_Cube(at) && !MC31_Water(at) && !MC31_Lava(at) && !MC31_Cube(up);}
Random g31_babyRng;Bool g31_babyReady;
U0 MC31_Finalize(MC31Mob *m){if(!g31_babyReady){Random_InitSeed(&g31_babyRng,0x5DEEA8F);g31_babyReady=TRUE;}if(m->kind==13)MC31_SheepColor(m);if(Random_nextInt(&g31_babyRng,2)==0)m->age=-24000;}
BiomeMobSpawnerData *MC31_PickEntry(I32 x,I32 z,Random *r){Biome *bio=BiomeSource_getBiome(&g31_app->biome,x,z);if(!bio)return NULL;MCVector *v=&bio->creatureVec;if(v->size<=0)return NULL;BiomeMobSpawnerData *d=v->data(BiomeMobSpawnerData*);I32 total=0,i;for(i=0;i<v->size;i++)total+=d[i].rarity;if(total<=0)return NULL;I32 w=Random_nextInt(r,total);for(i=0;i<v->size;i++){w-=d[i].rarity;if(w<0)return &d[i];}return &d[0];}
U0 MC31_ChunkSpawn(I32 cx,I32 cz,Random *r){I32 bx=cx*16,bz=cz*16;BiomeMobSpawnerData *e;while(Random_nextFloat(r)<0.08){e=MC31_PickEntry(bx+8,bz+8,r);if(!e)return;I32 n=e->min+Random_nextInt(r,1+e->max-e->min),x0=bx+Random_nextInt(r,16),z0=bz+Random_nextInt(r,16),x=x0,z=z0,i,t;
  for(i=0;i<n;i++){Bool ok=FALSE;for(t=0;t<4 && !ok;t++){I32 y=MC31_Top(x,z);if(MC31_SpawnOk(x,y,z)){MC31Mob *m=MC31_New(e->mobtype,x+0.5,y,z+0.5,Random_nextFloat(r)*360);if(m)MC31_Finalize(m);ok=TRUE;}
    x+=Random_nextInt(r,5)-Random_nextInt(r,5);z+=Random_nextInt(r,5)-Random_nextInt(r,5);while(x<bx || x>=bx+16 || z<bz || z>=bz+16){x=x0+Random_nextInt(r,5)-Random_nextInt(r,5);z=z0+Random_nextInt(r,5)-Random_nextInt(r,5);}}}}}
U0 MC31_InitialSpawn(MCApp028 *s){Random r;I32 cx,cz;for(cz=0;cz<16;cz++)for(cx=0;cx<16;cx++){if(!s->level.chunks[cx+16*cz])continue;Random_InitSeed(&r,s->seed*341873128712+cx*132897987541+cz*42317861+31);MC31_ChunkSpawn(cx,cz,&r);}}
U0 MC31_NaturalSpawn(MCApp028 *s){if((s->ticks%400)!=1)return;if(MC34_Passive()>15)return;Player *p=MC31_Player();if(!p)return;MCBody023 *pb=&p->mob.entity.body;I32 cx,cz,g,t,added=0;
 for(cz=0;cz<16;cz++)for(cx=0;cx<16;cx++){if(!s->level.chunks[cx+16*cz])continue;I32 x=cx*16+MC31_RandI(16),y=MC31_RandI(128),z=cz*16+MC31_RandI(16);if(MC31_Tile(x,y,z)!=0)continue;
  for(g=0;g<3;g++){I32 x2=x,z2=z,cluster=0;BiomeMobSpawnerData *e=NULL;for(t=0;t<4;t++){x2+=MC31_RandI(6)-MC31_RandI(6);z2+=MC31_RandI(6)-MC31_RandI(6);if(!MC31_SpawnOk(x2,y,z2))continue;F32 fx=x2+0.5,fz=z2+0.5,dx=fx-pb->x,dy=y-pb->y,dz=fz-pb->z;if(dx*dx+dy*dy+dz*dz<576)continue;
    dx=fx-s->level.data.xSpawn;dy=y-s->level.data.ySpawn;dz=fz-s->level.data.zSpawn;if(dx*dx+dy*dy+dz*dz<576)continue;if(!e)e=MC31_PickEntry(x2,z2,&g31_rng);if(!e)break;
    if(MC31_Tile(x2,y-1,z2)!=2 || MC31_RawLight(x2,y,z2)<=8)continue;MC31Mob *m=MC31_New(e->mobtype,fx,y,fz,MC31_Rand()*360);if(!m)return;
    MCVector cubes;Level_getCubes(&s->level,&m->e.box,&cubes);Bool clear=cubes.size==0;MCVector_Destroy(&cubes);if(!clear || MC31_InLiquid(&m->e.box,FALSE) || MC31_InLiquid(&m->e.box,TRUE)){g31_mobN--;free(m);continue;}
    if(m->kind==13)MC31_SheepColor(m);added++;cluster++;if(cluster>=4)break;}}}
 if(added){s->unsaved=TRUE;}}

// ---- persistence: entities031.dat ----
#define MC31_REC 128
Bool MC031_SaveEntities(MCApp028 *s,U8 *stage){I32 n=0,i,k=0;for(i=0;i<g31_mobN;i++)if(!g31_mobs[i]->removed && g31_mobs[i]->e.body.health>0)n++;I32 size=16+n*MC31_REC;U8 *buf=MC_Alloc(size);memset(buf,0,size);I32 *h=buf(I32*);h[0]=0x4433314D;h[1]=1;h[2]=n;
 for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->removed || m->e.body.health<=0)continue;MCBody023 *b=&m->e.body;I32 *w=(buf+16+k*MC31_REC)(I32*);F32 *f=w(F32*);
  w[0]=m->kind;f[1]=b->x;f[2]=b->y;f[3]=b->z;f[4]=b->yaw;f[5]=b->pitch;f[6]=b->motionX;f[7]=b->motionY;f[8]=b->motionZ;w[9]=b->health;w[10]=m->age;w[11]=m->inLove;w[12]=m->color;w[13]=m->sheared;w[14]=m->e.fire;w[15]=m->eggTime;f[16]=m->bodyRot;f[17]=m->headYaw;f[18]=m->e.fallDistance;w[19]=m->airSupply;w[20]=m->deathTime;w[21]=m->anger;k++;}
 h[3]=MC028_Hash(buf,size);
 MCString path;MCString_FromC(&path,stage);MC025_Append(&path,"/entities031.dat");U0 *file=fopen(path.data,"wb");Bool ok=FALSE;if(file){ok=fwrite(buf,1,size,file)==size;if(fclose(file))ok=FALSE;}MCString_Destroy(&path);free(buf);return ok;}
I32 MC31_Load(MCApp028 *s){MCString path;MCString_FromC(&path,s->activePath);MC025_Append(&path,"/entities031.dat");U0 *file=fopen(path.data,"rb");MCString_Destroy(&path);if(!file)return 0;
 if(fseek(file,0,2)){fclose(file);return -1;}I64 size=ftell(file);if(size<16 || size>16+MC31_MAXMOBS*MC31_REC){fclose(file);return -1;}rewind(file);U8 *buf=MC_Alloc(size);Bool ok=fread(buf,1,size,file)==size;fclose(file);if(!ok){free(buf);return -1;}
 I32 *h=buf(I32*);if(h[0]!=0x4433314D || h[1]!=1 || h[2]<0 || h[2]>MC31_MAXMOBS || size!=16+h[2]*MC31_REC){free(buf);return -1;}U32 expected=h[3];h[3]=0;if(MC028_Hash(buf,size)!=expected){free(buf);return -1;}
 I32 i,n=h[2];for(i=0;i<n;i++){I32 *w=(buf+16+i*MC31_REC)(I32*);F32 *f=w(F32*);
  if(!MC34_KindOk(w[0]) || !(f[1]>=0 && f[1]<=256 && f[2]>-64 && f[2]<256 && f[3]>=0 && f[3]<=256) || !(fabs(f[6])<=10 && fabs(f[7])<=10 && fabs(f[8])<=10) || w[9]<1 || w[9]>20 || w[10]<-24000 || w[10]>6000 || w[11]<0 || w[11]>600 || w[12]<0 || w[12]>15 || w[13]<0 || w[13]>1 || w[14]<0 || w[14]>600 || w[15]<-1 || w[15]>12000 || !(fabs(f[16])<1.0e6 && fabs(f[17])<1.0e6 && f[18]>=0 && f[18]<1000) || w[19]<-20 || w[19]>300){free(buf);MC031_ClearMobs();return -1;}
  MC31Mob *m=MC31_New(w[0],f[1],f[2],f[3],f[4]);if(!m)break;MCBody023 *b=&m->e.body;b->pitch=f[5];b->prevPitch=f[5];b->motionX=f[6];b->motionY=f[7];b->motionZ=f[8];b->health=w[9];m->age=w[10];m->inLove=w[11];m->color=w[12];m->sheared=w[13];m->e.fire=w[14];m->eggTime=w[15];m->bodyRot=f[16];m->prevBodyRot=f[16];m->headYaw=f[17];m->prevHeadYaw=f[17];m->lastHeadYaw=f[17];m->e.fallDistance=f[18];m->airSupply=w[19];m->firstTick=TRUE;m->anger=w[21];if(m->anger<0 || m->anger>2000)m->anger=0;}
 free(buf);return 1;}
// MCPE_MOBDEMO=1: place one adult + one baby of every passive mob in front of the player (testing aid).
I32 g31_demo;
U0 MC31_Demo(MCApp028 *s){U8 *v=C31_getenv("MCPE_MOBDEMO");if(!v)return;if(v[0]!='1' && v[0]!='2')return;g31_demo=v[0]-'0';Player *p=MC31_Player();if(!p)return;MCBody023 *b=&p->mob.entity.body;F32 yaw=b->yaw*MC31_PI/180;I32 k;
 for(k=0;k<8;k++){F32 side=(k-3.5)*1.3,dist=4.5;if(k&1)dist=3.2;F32 x=b->x-sin(yaw)*dist+cos(yaw)*side,z=b->z+cos(yaw)*dist+sin(yaw)*side;I32 y=MC31_Top(floorf(x),floorf(z));MC31Mob *m=MC31_New(10+k/2,x,y,z,b->yaw+180);if(!m)continue;if(k&1)m->age=-24000;if(m->kind==13)m->color=(k*3)&15;}
 printf("MOBS031 demo=%d\n",g31_mobN);}
Bool MC031_StartMobs(MCApp028 *s,I32 active,Bool fullWorld){MC031_ClearMobs();g31_app=s;MC31_RngInit();
 if(active==1){I32 r=MC31_Load(s);if(r<0)return FALSE;if(r==1){printf("MOBS031 loaded=%d\n",g31_mobN);return TRUE;}}
 MC31_InitialSpawn(s);printf("MOBS031 spawned=%d\n",g31_mobN);if(g31_mobN)s->unsaved=TRUE;MC31_Demo(s);return TRUE;}

U0 MC31_DemoTick(MCApp028 *s){I32 t=s->ticks,i,cows=0;
 if(t==100 && !s->creative){MC031_ClearMobs();printf("DEMO031 cleared for natural spawn test\n");}
 if(t==30){MC31Mob *c1=NULL,*c2=NULL;for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->kind==11 && m->age==0){if(!c1)c1=m;else if(!c2)c2=m;}}if(c1 && c2){Entity_moveTo(&c2->e,c1->e.body.x+1.5,c1->e.body.y+0.5,c1->e.body.z,0,0);c1->inLove=600;c2->inLove=600;printf("DEMO031 cows in love\n");}}
 if(t==40 || t==55 || t==70)for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->kind==12 && m->age==0){printf("DEMO031 hurt pig hp=%d ok=%d\n",m->e.body.health,MC31_Hurt(m,TRUE,4));break;}}
 if(t==45)for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->kind==13 && m->age==0){m->sheared=TRUE;MC31_Drop(35,m->color,2,m->e.body.x,m->e.body.y+1,m->e.body.z,0,0.1,0,TRUE);break;}}
 if(t%50==0){I32 n[4];memset(n,0,sizeof(n));for(i=0;i<g31_mobN;i++)n[g31_mobs[i]->kind-10]++;printf("DEMO031 t=%d mobs=%d chicken=%d cow=%d pig=%d sheep=%d particles=%d drops=%d\n",t,g31_mobN,n[0],n[1],n[2],n[3],g31_partN,s->level.drops.size);}}
U0 MC31_PartTick();
U0 MC031_TickAll(MCApp028 *s){g31_app=s;MC31_RngInit();I32 i,j,n=g31_mobN;for(i=0;i<n;i++){MC31Mob *m=g31_mobs[i];if(!m->removed)MC31_Tick(m);}
 for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(!m->removed)continue;for(j=0;j<g31_mobN;j++){MC31Mob *o=g31_mobs[j];if(o->partner==m)o->partner=NULL;if(o->parent==m)o->parent=NULL;}if(g31_sel==m)g31_sel=NULL;}
 j=0;for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->removed){free(m);continue;}g31_mobs[j++]=m;}g31_mobN=j;
 MC31_PartTick();if(!s->creative)MC31_NaturalSpawn(s);MC34_Spawn(s);if(g31_demo==2)MC31_DemoTick(s);}

// ---- particles (ExplodeParticle / HeartParticle / BubbleParticle / WaterSplash) ----
class MC31Part {F32 x,y,z,px,py,pz,mx,my,mz,size,r,g,b;I32 kind,tex,age,life;};
#define MC31_MAXPART 768
MC31Part g31_parts[MC31_MAXPART];
U0 MC31_Particle(I32 kind,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz){if(g31_partN>=MC31_MAXPART)return;MC31Part *p=&g31_parts[g31_partN++];memset(p,0,sizeof(MC31Part));
 p->kind=kind;p->x=x;p->y=y;p->z=z;p->px=x;p->py=y;p->pz=z;p->r=1;p->g=1;p->b=1;
 F32 bx=mx+(MC31_Rand()*2-1)*0.4,by=my+(MC31_Rand()*2-1)*0.4,bz=mz+(MC31_Rand()*2-1)*0.4,sp=(MC31_Rand()+MC31_Rand()+1)*0.15,dd=sqrt(bx*bx+by*by+bz*bz);if(dd<1.0e-4)dd=1;bx=bx/dd*sp*0.4;by=by/dd*sp*0.4+0.1;bz=bz/dd*sp*0.4;
 F32 scale=(MC31_Rand()*0.5+0.5)*2;
 if(kind==1){p->mx=mx+(MC31_Rand()*2-1)*0.05;p->my=my+(MC31_Rand()*2-1)*0.05;p->mz=mz+(MC31_Rand()*2-1)*0.05;F32 c=MC31_Rand()*0.3+0.7;p->r=c;p->g=c;p->b=c;scale=MC31_Rand()*MC31_Rand()*6+1;p->life=16/(MC31_Rand()*0.8+0.2)+2;p->tex=7;}
 else if(kind==2){p->mx=bx*0.01;p->my=by*0.01+0.1;p->mz=bz*0.01;scale*=0.75*2;p->life=16;p->tex=80;}
 else if(kind==3){p->mx=mx*0.2+(MC31_Rand()*2-1)*0.02;p->my=my*0.2+(MC31_Rand()*2-1)*0.02;p->mz=mz*0.2+(MC31_Rand()*2-1)*0.02;scale*=MC31_Rand()*0.6+0.2;p->life=8/(MC31_Rand()*0.8+0.2);p->tex=32;}
 else if(kind==5){p->mx=bx*0.1+mx;p->my=by*0.1+my;p->mz=bz*0.1+mz;F32 c=MC31_Rand()*0.3;p->r=c;p->g=c;p->b=c;scale*=0.75;p->life=8/(MC31_Rand()*0.8+0.2);p->tex=7;}
 else {p->mx=bx*0.3;p->my=MC31_Rand()*0.2+0.1;p->mz=bz*0.3;scale*=0.5;p->life=8/(MC31_Rand()*0.8+0.2);p->tex=19+MC31_RandI(4);}
 p->size=0.1*scale;}
U0 MC31_PartTick(){I32 i,j=0;for(i=0;i<g31_partN;i++){MC31Part *p=&g31_parts[i];p->px=p->x;p->py=p->y;p->pz=p->z;p->age++;Bool dead=p->age>=p->life;
  if(p->kind==1 || p->kind==5){p->tex=7-p->age*8/p->life;if(p->tex<0)p->tex=0;p->my+=0.004;}
  if(p->kind==3)p->my+=0.002;
  if(p->kind==4)p->my-=0.04;
  F32 ny=p->y+p->my;Bool hitY=MC31_Solid(MC31_Tile(floorf(p->x),floorf(ny),floorf(p->z)));if(!hitY)p->y=ny;else p->my=0;
  F32 nx=p->x+p->mx;if(!MC31_Solid(MC31_Tile(floorf(nx),floorf(p->y),floorf(p->z))))p->x=nx;else p->mx=0;
  F32 nz=p->z+p->mz;if(!MC31_Solid(MC31_Tile(floorf(p->x),floorf(p->y),floorf(nz))))p->z=nz;else p->mz=0;
  F32 f=0.98;if(p->kind==1)f=0.9;if(p->kind==2){f=0.86;if(hitY){p->mx*=1.1;p->mz*=1.1;}}if(p->kind==3){f=0.85;if(!MC31_Water(MC31_Tile(floorf(p->x),floorf(p->y),floorf(p->z))))dead=TRUE;}
  if(p->kind==4 && (hitY || MC31_Water(MC31_Tile(floorf(p->x),floorf(p->y),floorf(p->z))) && p->age>1))dead=TRUE;
  p->mx*=f;p->my*=f;p->mz*=f;if(p->kind==5){if(hitY){p->mx*=1.1;p->mz*=1.1;}p->mx*=0.96/f;p->my*=0.96/f;p->mz*=0.96/f;}if(hitY && (p->kind==1 || p->kind==5)){p->mx*=0.7;p->mz*=0.7;}
  if(dead)continue;if(j!=i)g31_parts[j]=g31_parts[i];j++;}
 g31_partN=j;}

// ---- rendering (MobRenderer + QuadrupedModel/PigModel/CowModel/SheepModel/SheepFurModel/ChickenModel) ----
U32 g31_tex[4],g31_sheepTex[16],g31_partTex,g31_shadowTex;Bool g31_texTried;F32 g31_tw=64,g31_th=32;
U8 *g31_sheepNames[16]={"assets/031/mob/sheep_0.png","assets/031/mob/sheep_1.png","assets/031/mob/sheep_2.png","assets/031/mob/sheep_3.png","assets/031/mob/sheep_4.png","assets/031/mob/sheep_5.png","assets/031/mob/sheep_6.png","assets/031/mob/sheep_7.png","assets/031/mob/sheep_8.png","assets/031/mob/sheep_9.png","assets/031/mob/sheep_10.png","assets/031/mob/sheep_11.png","assets/031/mob/sheep_12.png","assets/031/mob/sheep_13.png","assets/031/mob/sheep_14.png","assets/031/mob/sheep_15.png"};
U8 g31_shadowPix[32*32*4];
U0 MC31_LoadTex(){if(g31_texTried)return;g31_texTried=TRUE;I32 i;g31_tex[0]=MC028_Texture("assets/031/mob/chicken.png",NULL,NULL);g31_tex[1]=MC028_Texture("assets/031/mob/cow.png",NULL,NULL);g31_tex[2]=MC028_Texture("assets/031/mob/pig.png",NULL,NULL);
 for(i=0;i<16;i++)g31_sheepTex[i]=MC028_Texture(g31_sheepNames[i],NULL,NULL);g31_partTex=MC028_Texture("assets/031/particles.png",NULL,NULL);
 I32 x,y;for(y=0;y<32;y++)for(x=0;x<32;x++){F32 dx=(x+0.5-16)/16.0,dy=(y+0.5-16)/16.0,d=sqrt(dx*dx+dy*dy),a=(1-d)*5;if(a<0)a=0;if(a>1)a=1;I32 o=(y*32+x)*4;g31_shadowPix[o]=0;g31_shadowPix[o+1]=0;g31_shadowPix[o+2]=0;I32 av=a*255;g31_shadowPix[o+3]=av;}
 hcgl028_glGenTextures(1,&g31_shadowTex);hcgl028_glBindTexture(0xDE1,g31_shadowTex);hcgl028_glTexParameteri(0xDE1,0x2801,0x2601);hcgl028_glTexParameteri(0xDE1,0x2800,0x2601);hcgl028_glTexParameteri(0xDE1,0x2802,0x812F);hcgl028_glTexParameteri(0xDE1,0x2803,0x812F);hcgl028_glTexImage2D(0xDE1,0,0x1908,32,32,0,0x1908,0x1401,g31_shadowPix);}

U0 MC31_V(F32 *p,F32 u,F32 v){hcgl028_glTexCoord2f(u/g31_tw,v/g31_th);hcgl028_glVertex3f(p[0],p[1],p[2]);}
U0 MC31_Quad(F32 *a,F32 *b,F32 *c,F32 *d,F32 u1,F32 v1,F32 u2,F32 v2,F32 nx,F32 ny,F32 nz){G31_Normal3f(nx,ny,nz);MC31_V(a,u2,v1);MC31_V(b,u1,v1);MC31_V(c,u1,v2);MC31_V(d,u2,v2);}
U0 MC31_Box(F32 u,F32 v,F32 x0,F32 y0,F32 z0,F32 w,F32 h,F32 d,F32 g){F32 x1=(x0+w+g)/16,y1=(y0+h+g)/16,z1=(z0+d+g)/16;x0=(x0-g)/16;y0=(y0-g)/16;z0=(z0-g)/16;
 F32 p0[3]={x0,y0,z0},p1[3]={x1,y0,z0},p2[3]={x1,y1,z0},p3[3]={x0,y1,z0},p4[3]={x0,y0,z1},p5[3]={x1,y0,z1},p6[3]={x1,y1,z1},p7[3]={x0,y1,z1};
 hcgl028_glBegin(7);
 MC31_Quad(p5,p1,p2,p6,u+d+w,v+d,u+d+w+d,v+d+h,1,0,0);
 MC31_Quad(p0,p4,p7,p3,u,v+d,u+d,v+d+h,-1,0,0);
 MC31_Quad(p5,p4,p0,p1,u+d,v,u+d+w,v+d,0,-1,0);
 MC31_Quad(p2,p3,p7,p6,u+d+w,v+d,u+d+w+w,v,0,1,0);
 MC31_Quad(p1,p0,p3,p2,u+d,v+d,u+d+w,v+d+h,0,0,-1);
 MC31_Quad(p4,p5,p6,p7,u+d+w+d,v+d,u+d+w+d+w,v+d+h,0,0,1);
 hcgl028_glEnd();}
U0 MC31_Part(F32 px,F32 py,F32 pz,F32 rx,F32 ry,F32 rz){hcgl028_glPushMatrix();hcgl028_glTranslatef(px/16,py/16,pz/16);if(rz!=0)hcgl028_glRotatef(rz*180/MC31_PI,0,0,1);if(ry!=0)hcgl028_glRotatef(ry*180/MC31_PI,0,1,0);if(rx!=0)hcgl028_glRotatef(rx*180/MC31_PI,1,0,0);}
U0 MC31_End(){hcgl028_glPopMatrix();}

// part=0 base model, 1 sheep fur. hy/hp in degrees. eat: sheep head animation values.
U0 MC31_Model(MC31Mob *m,I32 layer,F32 wp,F32 ws,F32 hy,F32 hp,F32 eatY,F32 eatX,Bool eating,F32 bob){I32 k=m->kind;Bool baby=m->age<0;F32 hyr=hy/(180/MC31_PI),hpr=hp/(180/MC31_PI),l0=cos(wp*0.6662)*1.4*ws,l1=cos(wp*0.6662+MC31_PI)*1.4*ws,half=MC31_PI/2;
 if(k==10){g31_th=32;
  hcgl028_glPushMatrix();if(baby)hcgl028_glTranslatef(0,5.0/16,2.0/16);
  MC31_Part(0,15,-4,hpr,hyr,0);MC31_Box(0,0,-2,-6,-2,4,6,3,0);MC31_Box(14,0,-2,-4,-4,4,2,2,0);MC31_Box(14,4,-1,-2,-3,2,2,2,0);MC31_End();
  hcgl028_glPopMatrix();hcgl028_glPushMatrix();if(baby){hcgl028_glScalef(0.5,0.5,0.5);hcgl028_glTranslatef(0,24.0/16,0);}
  MC31_Part(0,16,0,half,0,0);MC31_Box(0,9,-3,-4,-3,6,8,6,0);MC31_End();
  MC31_Part(-2,19,1,l0,0,0);MC31_Box(26,0,-1,0,-3,3,5,3,0);MC31_End();
  MC31_Part(1,19,1,l1,0,0);MC31_Box(26,0,-1,0,-3,3,5,3,0);MC31_End();
  MC31_Part(-4,13,0,0,0,bob);MC31_Box(24,13,0,0,-3,1,4,6,0);MC31_End();
  MC31_Part(4,13,0,0,0,-bob);MC31_Box(24,13,-1,0,-3,1,4,6,0);MC31_End();
  hcgl028_glPopMatrix();return;}
 F32 yHead=4,zHead=4;if(k==11)yHead=10;if(k==13)yHead=8;
 hcgl028_glPushMatrix();if(baby)hcgl028_glTranslatef(0,yHead/16,zHead/16);
 if(k==12){g31_th=32;MC31_Part(0,12,-6,hpr,hyr,0);MC31_Box(0,0,-4,-4,-8,8,8,8,0);MC31_Box(16,16,-2,0,-9,4,3,1,0);MC31_End();}
 if(k==11){g31_th=32;MC31_Part(0,4,-8,hpr,hyr,0);MC31_Box(0,0,-4,-4,-6,8,8,6,0);MC31_Box(22,0,-5,-5,-4,1,3,1,0);MC31_Box(22,0,4,-5,-4,1,3,1,0);MC31_End();}
 if(k==13){g31_th=64;F32 hx=hpr;if(eating)hx=eatX;F32 py=6+eatY*9;if(layer==0){MC31_Part(0,py,-8,hx,hyr,0);MC31_Box(0,0,-3,-4,-6,6,6,8,0);MC31_End();}else{MC31_Part(0,py,-8,hx,hyr,0);MC31_Box(0,32,-3,-4,-4,6,6,6,0.6);MC31_End();}}
 hcgl028_glPopMatrix();hcgl028_glPushMatrix();if(baby){hcgl028_glScalef(0.5,0.5,0.5);hcgl028_glTranslatef(0,24.0/16,0);}
 if(k==12){MC31_Part(0,11,2,half,0,0);MC31_Box(28,8,-5,-10,-7,10,16,8,0);MC31_End();
  MC31_Part(-3,18,7,l0,0,0);MC31_Box(0,16,-2,0,-2,4,6,4,0);MC31_End();MC31_Part(3,18,7,l1,0,0);MC31_Box(0,16,-2,0,-2,4,6,4,0);MC31_End();
  MC31_Part(-3,18,-5,l1,0,0);MC31_Box(0,16,-2,0,-2,4,6,4,0);MC31_End();MC31_Part(3,18,-5,l0,0,0);MC31_Box(0,16,-2,0,-2,4,6,4,0);MC31_End();}
 if(k==11){MC31_Part(0,5,2,half,0,0);MC31_Box(18,4,-6,-10,-7,12,18,10,0);MC31_Box(52,0,-2,2,-8,4,6,1,0);MC31_End();
  MC31_Part(-4,12,7,l0,0,0);MC31_Box(0,16,-2,0,-2,4,12,4,0);MC31_End();MC31_Part(4,12,7,l1,0,0);MC31_Box(0,16,-2,0,-2,4,12,4,0);MC31_End();
  MC31_Part(-4,12,-6,l1,0,0);MC31_Box(0,16,-2,0,-2,4,12,4,0);MC31_End();MC31_Part(4,12,-6,l0,0,0);MC31_Box(0,16,-2,0,-2,4,12,4,0);MC31_End();}
 if(k==13){F32 v=0,g=0,bg=0,lh=12,lg=0;if(layer==1){v=32;bg=1.75;lh=6;lg=0.5;}
  MC31_Part(0,5,2,half,0,0);MC31_Box(28,8+v,-4,-10,-7,8,16,6,bg);MC31_End();
  MC31_Part(-3,12,7,l0,0,0);MC31_Box(0,16+v,-2,0,-2,4,lh,4,lg);MC31_End();MC31_Part(3,12,7,l1,0,0);MC31_Box(0,16+v,-2,0,-2,4,lh,4,lg);MC31_End();
  MC31_Part(-3,12,-5,l1,0,0);MC31_Box(0,16+v,-2,0,-2,4,lh,4,lg);MC31_End();MC31_Part(3,12,-5,l0,0,0);MC31_Box(0,16+v,-2,0,-2,4,lh,4,lg);MC31_End();}
 hcgl028_glPopMatrix();}

U0 MC31_DrawMob(MC31Mob *m,F32 pt,F32 light){MCBody023 *b=&m->e.body;F32 ws=m->prevWalkSpeed+(m->walkSpeed-m->prevWalkSpeed)*pt,wp=m->walkPos-m->walkSpeed*(1-pt);if(ws>1)ws=1;
 F32 br=m->prevBodyRot+(m->bodyRot-m->prevBodyRot)*pt,hy=m->prevHeadYaw+(m->headYaw-m->prevHeadYaw)*pt-br,hp=b->prevPitch+(b->pitch-b->prevPitch)*pt;
 if(m->kind>=32){MC34_Draw(m,pt,light,wp,ws,hy,hp);return;}F32 eatY=0,eatX=0;Bool eating=FALSE;if(m->kind==13 && m->eatTick>0){F32 t=m->eatTick;eating=TRUE;if(t>=4 && t<=36){eatY=1;F32 f=(t-4-pt)/32.0;eatX=MC31_PI/5+0.22*MC31_PI*sin(f*28.7);}else{if(t<4)eatY=(t-pt)/4.0;else eatY=-(t-40-pt)/4.0;eatX=MC31_PI/5;}}
 F32 bob=0;if(m->kind==10){F32 fl=m->oFlap+(m->flap-m->oFlap)*pt,fs=m->oFlapSpeed+(m->flapSpeed-m->oFlapSpeed)*pt;bob=(sin(fl)+1)*fs;}
 I32 tex=0;if(m->kind==10)tex=g31_tex[0];if(m->kind==11)tex=g31_tex[1];if(m->kind==12)tex=g31_tex[2];if(m->kind==13)tex=g31_sheepTex[m->color&15];
 hcgl028_glEnable(0xDE1);hcgl028_glBindTexture(0xDE1,tex);hcgl028_glColor4f(light,light,light,1);
 MC31_Model(m,0,wp,ws,hy,hp,eatY,eatX,eating,bob);if(m->kind==13 && !m->sheared)MC31_Model(m,1,wp,ws,hy,hp,eatY,eatX,eating,bob);
 if(m->hurtTime>0 || m->deathTime>0){hcgl028_glDisable(0xDE1);hcgl028_glEnable(0xBE2);hcgl028_glBlendFunc(0x302,0x303);hcgl028_glDepthFunc(0x202);hcgl028_glColor4f(light,0,0,0.4);
  MC31_Model(m,0,wp,ws,hy,hp,eatY,eatX,eating,bob);if(m->kind==13 && !m->sheared)MC31_Model(m,1,wp,ws,hy,hp,eatY,eatX,eating,bob);
  hcgl028_glDepthFunc(0x203);hcgl028_glDisable(0xBE2);hcgl028_glEnable(0xDE1);}}

F32 MC31_ShadowRadius(MC31Mob *m){F32 r=0.7;if(m->kind==10)r=0.3;if(m->kind>=32)r=0.5;if(m->kind==35)r=1.0;if(m->kind==12)r=0.5;if(m->age<0)r*=0.5;return r;}
U0 MC31_Shadow(MC31Mob *m,F32 ix,F32 iy,F32 iz,F32 d2){F32 r=MC31_ShadowRadius(m),op=1-d2/256.0;if(op<=0)return;I32 x0=floorf(ix-r),x1=floorf(ix+r),y0=floorf(iy-r),y1=floorf(iy),z0=floorf(iz-r),z1=floorf(iz+r),x,y,z;
 for(x=x0;x<=x1;x++)for(y=y0;y<=y1;y++)for(z=z0;z<=z1;z++){if(!MC31_Cube(MC31_Tile(x,y-1,z)) || MC31_Cube(MC31_Tile(x,y,z)))continue;F32 a=(op-(iy-y)/2.0)*0.5*MC31_Bright(x,y,z);if(a<0)continue;if(a>1)a=1;
  F32 ax=x,bx=x+1,yy=y+0.015625,az=z,bz=z+1,u0=(ix-ax)/2/r+0.5,u1=(ix-bx)/2/r+0.5,v0=(iz-az)/2/r+0.5,v1=(iz-bz)/2/r+0.5;
  hcgl028_glColor4f(1,1,1,a);hcgl028_glTexCoord2f(u0,v0);hcgl028_glVertex3f(ax,yy,az);hcgl028_glTexCoord2f(u0,v1);hcgl028_glVertex3f(ax,yy,bz);hcgl028_glTexCoord2f(u1,v1);hcgl028_glVertex3f(bx,yy,bz);hcgl028_glTexCoord2f(u1,v0);hcgl028_glVertex3f(bx,yy,az);}}

U0 MC031_RenderMobs(MCApp028 *s,F32 pt){g31_app=s;MC31_LoadTex();Player *p=MC31_Player();if(!p)return;MCBody023 *pb=&p->mob.entity.body;F32 cx=pb->prevX+(pb->x-pb->prevX)*pt,cy=pb->prevY+(pb->y-pb->prevY)*pt,cz=pb->prevZ+(pb->z-pb->prevZ)*pt,range=g29_fogFar+8;I32 i;
 F32 l0[4]={0.16169041,0.80845207,-0.56591643,0},l1[4]={-0.16169041,0.80845207,0.56591643,0},dif[4]={0.6,0.6,0.6,1},amb[4]={0.4,0.4,0.4,1},zero[4]={0,0,0,1};
 hcgl028_glEnable(0xB50);hcgl028_glEnable(0x4000);hcgl028_glEnable(0x4001);hcgl028_glEnable(0xB57);hcgl028_glEnable(0xBA1);
 G31_Lightfv(0x4000,0x1203,l0);G31_Lightfv(0x4000,0x1201,dif);G31_Lightfv(0x4000,0x1200,amb);G31_Lightfv(0x4000,0x1202,zero);
 G31_Lightfv(0x4001,0x1203,l1);G31_Lightfv(0x4001,0x1201,dif);G31_Lightfv(0x4001,0x1200,zero);G31_Lightfv(0x4001,0x1202,zero);
 for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->removed)continue;MCBody023 *b=&m->e.body;F32 ix=b->prevX+(b->x-b->prevX)*pt,iy=b->prevY+(b->y-b->prevY)*pt,iz=b->prevZ+(b->z-b->prevZ)*pt,dx=ix-cx,dy=iy-cy,dz=iz-cz;if(dx*dx+dy*dy+dz*dz>range*range)continue;
  F32 light=MC31_Bright(floorf(ix),floorf(iy+b->height*0.66),floorf(iz)),br=m->prevBodyRot+(m->bodyRot-m->prevBodyRot)*pt;
  hcgl028_glPushMatrix();hcgl028_glTranslatef(ix,iy,iz);hcgl028_glRotatef(180-br,0,1,0);if(m->deathTime>0){F32 f=((m->deathTime+pt-1)/20.0)*1.6;if(f<0)f=0;f=sqrt(f);if(f>1)f=1;hcgl028_glRotatef(f*MC34_Flip(m),0,0,1);}
  hcgl028_glScalef(-1,-1,1);hcgl028_glTranslatef(0,-24*0.0625-0.0078125,0);MC31_DrawMob(m,pt,light);hcgl028_glPopMatrix();}
 hcgl028_glDisable(0xBA1);hcgl028_glDisable(0xB57);hcgl028_glDisable(0x4001);hcgl028_glDisable(0x4000);hcgl028_glDisable(0xB50);g31_th=32;
 // blob shadows
 hcgl028_glEnable(0xDE1);hcgl028_glBindTexture(0xDE1,g31_shadowTex);hcgl028_glEnable(0xBE2);hcgl028_glBlendFunc(0x302,0x303);hcgl028_glDepthMask(0);hcgl028_glBegin(7);
 for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(m->removed)continue;MCBody023 *b=&m->e.body;F32 ix=b->prevX+(b->x-b->prevX)*pt,iy=b->prevY+(b->y-b->prevY)*pt,iz=b->prevZ+(b->z-b->prevZ)*pt,dx=ix-cx,dy=iy-cy,dz=iz-cz,d2=dx*dx+dy*dy+dz*dz;if(d2<256)MC31_Shadow(m,ix,iy,iz,d2);}
 hcgl028_glEnd();
 // particles: camera-facing quads from the modelview basis
 if(g31_partN>0 && g31_partTex){F32 *mv=s->camera.modelViewMat;F32 rx=mv[0],ry=mv[4],rz=mv[8],ux=mv[1],uy=mv[5],uz=mv[9];hcgl028_glBindTexture(0xDE1,g31_partTex);hcgl028_glBegin(7);
  for(i=0;i<g31_partN;i++){MC31Part *q=&g31_parts[i];F32 x=q->px+(q->x-q->px)*pt,y=q->py+(q->y-q->py)*pt,z=q->pz+(q->z-q->pz)*pt,sz=q->size,u0=(q->tex%16)/16.0,v0=(q->tex/16)/16.0,u1=u0+0.0624,v1=v0+0.0624,l=MC31_Bright(floorf(x),floorf(y),floorf(z));
   hcgl028_glColor4f(q->r*l,q->g*l,q->b*l,1);
   hcgl028_glTexCoord2f(u1,v1);hcgl028_glVertex3f(x-rx*sz-ux*sz,y-ry*sz-uy*sz,z-rz*sz-uz*sz);
   hcgl028_glTexCoord2f(u1,v0);hcgl028_glVertex3f(x-rx*sz+ux*sz,y-ry*sz+uy*sz,z-rz*sz+uz*sz);
   hcgl028_glTexCoord2f(u0,v0);hcgl028_glVertex3f(x+rx*sz+ux*sz,y+ry*sz+uy*sz,z+rz*sz+uz*sz);
   hcgl028_glTexCoord2f(u0,v1);hcgl028_glVertex3f(x+rx*sz-ux*sz,y+ry*sz-uy*sz,z+rz*sz-uz*sz);}
  hcgl028_glEnd();}
 hcgl028_glDepthMask(1);hcgl028_glDisable(0xBE2);hcgl028_glColor4f(1,1,1,1);hcgl028_glBindTexture(0xDE1,s->terrainTex);}
