U0 MC31_RngInit(){if(!g31_rngReady){Random_Init(&g31_rng);g31_rngReady=TRUE;}}
F32 MC31_Rand(){return Random_nextFloat(&g31_rng);}
I32 MC31_RandI(I32 n){if(n<=0)return 0;return Random_nextInt(&g31_rng,n);}
F32 MC31_Gauss(){return Random_nextGaussian(&g31_rng);}
F32 MC31_Wrap(F32 a){while(a>=180)a-=360;while(a<-180)a+=360;return a;}
F32 MC31_RotLerp(F32 a,F32 b,F32 max){F32 d=MC31_Wrap(b-a);if(d>max)d=max;if(d<-max)d=-max;return a+d;}
I32 MC31_Tile(I32 x,I32 y,I32 z){return Level_getTile(&g31_app->level,x,y,z);}
Bool MC31_Solid(I32 id){if(id<=0 || id>255)return FALSE;return g31_app->catalog.registry.tiles[id].solid;}
Bool MC31_Cube(I32 id){if(id<=0 || id>255)return FALSE;return g31_app->catalog.registry.tiles[id].solid && g31_app->catalog.registry.tiles[id].cube;}
Bool MC31_Water(I32 id){return id==8 || id==9;}
Bool MC31_Lava(I32 id){return id==10 || id==11;}
F32 MC31_Bright(I32 x,I32 y,I32 z){if(y<0)return 0.05;if(y>127)return 1;LevelChunk *c=Level_getChunk(&g31_app->level,x>>4,z>>4,FALSE);if(!c)return 1;I32 l=LevelChunk_getRawBrightness(c,x&15,y,z&15,g33_skyDarken);F32 f=1-l/15.0;return (1-f)/(f*3+1)*0.95+0.05;}
I32 MC31_RawLight(I32 x,I32 y,I32 z){if(y<0)return 0;if(y>127)return 15;LevelChunk *c=Level_getChunk(&g31_app->level,x>>4,z>>4,FALSE);if(!c)return 15;return LevelChunk_getRawBrightness(c,x&15,y,z&15,0);}
Player *MC31_Player(){if(!g31_app->minecraft.player)return NULL;return &g31_app->minecraft.player->player;}
F32 MC31_Dist2(MC31Mob *a,F32 x,F32 y,F32 z){F32 dx=a->e.body.x-x,dy=a->e.body.y-y,dz=a->e.body.z-z;return dx*dx+dy*dy+dz*dz;}
F32 MC31_PlayerDist2(MC31Mob *m){Player *p=MC31_Player();if(!p)return 1.0e30;return MC31_Dist2(m,p->mob.entity.body.x,p->mob.entity.box.minY,p->mob.entity.body.z);}
F32 MC31_Eye(MC31Mob *m){return m->e.body.height*0.85;}
Bool MC31_Alive(MC31Mob *m){return m && !m->removed && m->e.body.health>0;}

Bool MC31_InLiquid(AABB *b,Bool lava){I32 x0=floorf(b->minX),x1=floorf(b->maxX),y0=floorf(b->minY),y1=floorf(b->maxY),z0=floorf(b->minZ),z1=floorf(b->maxZ),x,y,z;
 for(x=x0;x<=x1;x++)for(y=y0;y<=y1;y++)for(z=z0;z<=z1;z++){I32 id=MC31_Tile(x,y,z);Bool hit=FALSE;if(lava)hit=MC31_Lava(id);else hit=MC31_Water(id);if(!hit)continue;I32 meta=Level_getData(&g31_app->level,x,y,z);if(meta>=8)meta=0;F32 top=y+1-(meta+1)/9.0;if(b->maxY>=top)return TRUE;}
 return FALSE;}

U0 MC31_Goal(MC31Mob *m,I32 id,I32 prio,I32 flags){if(m->ng>=MC31_MAXGOALS)return;m->gid[m->ng]=id;m->gprio[m->ng]=prio;m->gflags[m->ng]=flags;m->grun[m->ng]=FALSE;m->ng++;}
