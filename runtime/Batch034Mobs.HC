MC31Mob *MC31_New(I32 kind,F32 x,F32 y,F32 z,F32 yaw){
 if(g31_mobN>=MC31_MAXMOBS || !MC34_KindOk(kind))return NULL;
 MC31Mob *m=MC_Alloc(sizeof(MC31Mob));memset(m,0,sizeof(MC31Mob));
 F32 w=0.9,h=0.9,sp=0.25;I32 hp=10;
 if(kind==10){w=0.3;h=0.7;hp=4;}else if(kind==11){h=1.3;sp=0.2;}else if(kind==13){h=1.3;hp=8;}if(kind>=32)MC34_Size(kind,&w,&h,&hp,&sp);
 Entity_Init(&m->e,&g31_app->level,kind,w,h);m->e.stepHeight=0.5;m->e.body.health=hp;m->kind=kind;m->baseSpeed=sp;m->speed=sp;
 Entity_moveTo(&m->e,x,y,z,yaw,0);
 m->bodyRot=yaw;m->prevBodyRot=yaw;m->headYaw=yaw;m->prevHeadYaw=yaw;m->lastHeadYaw=yaw;
 m->ambient=-MC31_RandI(100);m->airSupply=300;m->avoidWater=TRUE;m->eggTime=MC31_RandI(6000)+6000;m->firstTick=TRUE;
 if(kind>=32){g31_mobs[g31_mobN++]=m;return m;}MC31_Goal(m,G31_FLOAT,0,4);MC31_Goal(m,G31_PANIC,1,1);MC31_Goal(m,G31_BREED,2,3);MC31_Goal(m,G31_TEMPT,3,3);MC31_Goal(m,G31_FOLLOW,4,0);
 if(kind==13){MC31_Goal(m,G31_EAT,5,7);MC31_Goal(m,G31_STROLL,6,3);MC31_Goal(m,G31_LOOKP,7,2);MC31_Goal(m,G31_LOOKAROUND,8,3);}
 else {MC31_Goal(m,G31_STROLL,5,3);MC31_Goal(m,G31_LOOKP,6,2);MC31_Goal(m,G31_LOOKAROUND,7,3);}
 g31_mobs[g31_mobN++]=m;return m;}

U0 MC31_Drop(I32 id,I32 meta,I32 count,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,Bool motion){
 if(count<1)return;MCApp028 *s=g31_app;I32 before=s->level.drops.size;MCWorldEvent023 ev;memset(&ev,0,sizeof(ev));ev.op=MC023_DROP;ev.id=id;ev.meta=meta;ev.count=count;ev.a=x;ev.b=y;ev.c=z;MC025_LevelEvent(&s->level,&ev);
 if(s->level.drops.size>before){ItemEntity *d=s->level.drops.data[before];d->pickupDelay=10;if(motion){d->motionX=mx;d->motionY=my;d->motionZ=mz;}s->unsaved=TRUE;}}

F32 MC31_SoundPitch(MC31Mob *m){if(m->age<0)return (MC31_Rand()-MC31_Rand())*0.2+1.5;return (MC31_Rand()-MC31_Rand())*0.2+1.0;}
U0 MC31_Sound(MC31Mob *m,I32 which){U8 *n=NULL;I32 k=m->kind;if(k>=32){MC34_Sound(m,which);return;}
 if(which==0){if(k==10)n="mob.chicken";if(k==11)n="mob.cow";if(k==12)n="mob.pig";if(k==13)n="mob.sheep";}
 else if(which==1){if(k==10)n="mob.chickenhurt";if(k==11)n="mob.cowhurt";if(k==12)n="mob.pig";if(k==13)n="mob.sheep";}
 else {if(k==10)n="mob.chickenhurt";if(k==11)n="mob.cowhurt";if(k==12)n="mob.pigdeath";if(k==13)n="mob.sheep";}
 F32 v=1.0;if(k==11)v=0.4;MC030_Play(n,m->e.body.x,m->e.body.y,m->e.body.z,v,MC31_SoundPitch(m));}

U0 MC31_Hearts(MC31Mob *m,I32 n){I32 i;MCBody023 *b=&m->e.body;for(i=0;i<n;i++)MC31_Particle(2,b->x+(MC31_Rand()*b->width*2)-b->width,b->y+0.5+MC31_Rand()*b->height,b->z+(MC31_Rand()*b->width*2)-b->width,MC31_Gauss()*0.02,MC31_Gauss()*0.02,MC31_Gauss()*0.02);}

U0 MC31_Die(MC31Mob *m){MCBody023 *b=&m->e.body;if(m->age<0)return;if(m->kind>=32){MC34_Die(m);return;}Bool fire=m->e.fire>0;I32 n,k=m->kind;
 if(k==12){n=MC31_RandI(3)+1;if(fire)MC31_Drop(320,0,n,b->x,b->y,b->z,0,0,0,FALSE);else MC31_Drop(319,0,n,b->x,b->y,b->z,0,0,0,FALSE);}
 if(k==11){n=MC31_RandI(3);MC31_Drop(334,0,n,b->x,b->y,b->z,0,0,0,FALSE);n=MC31_RandI(3)+1;if(fire)MC31_Drop(364,0,n,b->x,b->y,b->z,0,0,0,FALSE);else MC31_Drop(363,0,n,b->x,b->y,b->z,0,0,0,FALSE);}
 if(k==10){n=MC31_RandI(3);MC31_Drop(288,0,n,b->x,b->y,b->z,0,0,0,FALSE);if(fire)MC31_Drop(366,0,1,b->x,b->y,b->z,0,0,0,FALSE);else MC31_Drop(365,0,1,b->x,b->y,b->z,0,0,0,FALSE);}
 if(k==13 && !m->sheared)MC31_Drop(35,m->color,1,b->x,b->y,b->z,0,0,0,FALSE);}

Bool MC31_Hurt(MC31Mob *m,Bool byPlayer,I32 dmg){MCBody023 *b=&m->e.body;if(m->removed || b->health<=0 || dmg<=0)return FALSE;
 m->noAction=0;m->walkSpeed=1.5;Bool hit=TRUE;
 if(m->invul>10){if(dmg<=m->lastHurt)return FALSE;b->health-=dmg-m->lastHurt;m->lastHurt=dmg;hit=FALSE;}
 else {m->lastHurt=dmg;m->invul=20;b->health-=dmg;m->hurtTime=10;}
 m->inLove=0;if(byPlayer && m->kind>=32)MC34_Provoked(m);
 if(hit && byPlayer){Player *p=MC31_Player();m->hurtByTime=60;if(p){F32 dx=p->mob.entity.body.x-b->x,dz=p->mob.entity.body.z-b->z;while(dx*dx+dz*dz<1.0e-4){dx=(MC31_Rand()-MC31_Rand())*0.01;dz=(MC31_Rand()-MC31_Rand())*0.01;}F32 d=sqrt(dx*dx+dz*dz);b->motionX/=2;b->motionY/=2;b->motionZ/=2;b->motionX-=dx/d*0.4;b->motionY+=0.4;b->motionZ-=dz/d*0.4;if(b->motionY>0.4)b->motionY=0.4;}}
 if(b->health<=0){MC31_Sound(m,2);MC31_Die(m);}else if(hit)MC31_Sound(m,1);
 g31_app->unsaved=TRUE;return TRUE;}

U0 MC31_Fall(MC31Mob *m,F32 dist){if(m->kind==10)return;I32 d=ceilf(dist-3);if(d<=0)return;MCBody023 *b=&m->e.body;if(d>4)MC030_Play("damage.fallbig",b->x,b->y,b->z,1.0,1.0);else MC030_Play("damage.fallsmall",b->x,b->y,b->z,1.0,1.0);MC31_Hurt(m,FALSE,d);}

U0 MC31_Move(MC31Mob *m,F32 dx,F32 dy,F32 dz){Entity *e=&m->e;MCBody023 *b=&e->body;F32 fall=e->fallDistance;Entity_move(e,dx,dy,dz);if(b->onGround && fall>0 && !b->inWater)MC31_Fall(m,fall);if(b->inWater)e->fallDistance=0;
 F32 x=b->x,z=b->z;Bool fix=FALSE;F32 r=b->width*0.5+0.01;if(x<r){x=r;b->motionX=0;fix=TRUE;}if(x>256-r){x=256-r;b->motionX=0;fix=TRUE;}if(z<r){z=r;b->motionZ=0;fix=TRUE;}if(z>256-r){z=256-r;b->motionZ=0;fix=TRUE;}if(fix)Entity_setPos(e,x,b->y,z);}

F32 MC31_Friction(MC31Mob *m){MCBody023 *b=&m->e.body;if(!b->onGround)return 0.91;I32 id=MC31_Tile(floorf(b->x),floorf(m->e.box.minY)-1,floorf(b->z));if(id<=0)return 0.546;F32 sl=g31_app->catalog.registry.tiles[id].slipperiness;if(sl<=0)sl=0.6;return sl*0.91;}
U0 MC31_Travel(MC31Mob *m,F32 st,F32 fw){Entity *e=&m->e;MCBody023 *b=&e->body;
 if(b->inWater || b->inLava){F32 y0=b->y,f=0.8;if(!b->inWater)f=0.5;Entity_moveRelative(e,st,fw,0.02);MC31_Move(m,b->motionX,b->motionY,b->motionZ);b->motionX*=f;b->motionY*=f;b->motionZ*=f;b->motionY-=0.02;if(e->horizontalCollision && Entity_isFree(e,b->motionX,b->motionY+0.6-b->y+y0,b->motionZ))b->motionY=0.3;return;}
 F32 fr=MC31_Friction(m),acc=0.02;if(b->onGround)acc=m->speed*0.7*(0.16277136/(fr*fr*fr));
 Entity_moveRelative(e,st,fw,acc);fr=MC31_Friction(m);MC31_Move(m,b->motionX,b->motionY,b->motionZ);b->motionY-=0.08;b->motionY*=0.98;b->motionX*=fr;b->motionZ*=fr;}

U0 MC31_PushPair(MCBody023 *a,MCBody023 *o,Bool moveOther){F32 dx=o->x-a->x,dz=o->z-a->z,d=fabs(dx);if(fabs(dz)>d)d=fabs(dz);if(d<0.01)return;d=sqrt(d);dx/=d;dz/=d;F32 f=1/d;if(f>1)f=1;dx*=f*0.05;dz*=f*0.05;a->motionX-=dx;a->motionZ-=dz;if(moveOther){o->motionX+=dx;o->motionZ+=dz;}}
Bool MC31_Overlap(AABB *a,AABB *b){return a->maxX>b->minX && a->minX<b->maxX && a->maxY>b->minY && a->minY<b->maxY && a->maxZ>b->minZ && a->minZ<b->maxZ;}
U0 MC31_Push(MC31Mob *m){AABB g=m->e.box;g.minX-=0.2;g.maxX+=0.2;g.minZ-=0.2;g.maxZ+=0.2;I32 i;for(i=0;i<g31_mobN;i++){MC31Mob *o=g31_mobs[i];if(o==m || o->removed)continue;if(MC31_Overlap(&g,&o->e.box))MC31_PushPair(&m->e.body,&o->e.body,TRUE);}
 Player *p=MC31_Player();if(p && MC31_Overlap(&g,&p->mob.entity.box))MC31_PushPair(&m->e.body,&p->mob.entity.body,FALSE);}

// ---- path finder (PathFinder / Node / BinaryHeap) ----
class MC31Node {I32 x,y,z,heap,from,next;F32 g,h,f;Bool closed;};
#define MC31_NODES 2048
MC31Node g31_nodes[MC31_NODES];I32 g31_nodeN,g31_hash[4096],g31_heap[MC31_NODES],g31_heapN,g31_pw,g31_ph;Bool g31_pAvoid;
I32 MC31_NodeGet(I32 x,I32 y,I32 z){I64 k=((x*73856093)^(y*19349663)^(z*83492791))&4095;I32 i=g31_hash[k];while(i>=0){if(g31_nodes[i].x==x && g31_nodes[i].y==y && g31_nodes[i].z==z)return i;i=g31_nodes[i].next;}
 if(g31_nodeN>=MC31_NODES)return -1;i=g31_nodeN++;MC31Node *n=&g31_nodes[i];n->x=x;n->y=y;n->z=z;n->heap=-1;n->from=-1;n->g=0;n->h=0;n->f=0;n->closed=FALSE;n->next=g31_hash[k];g31_hash[k]=i;return i;}
F32 MC31_NodeDist(I32 a,I32 b){F32 dx=g31_nodes[b].x-g31_nodes[a].x,dy=g31_nodes[b].y-g31_nodes[a].y,dz=g31_nodes[b].z-g31_nodes[a].z;return sqrt(dx*dx+dy*dy+dz*dz);}
U0 MC31_HeapUp(I32 i){I32 n=g31_heap[i];F32 f=g31_nodes[n].f;while(i>0){I32 p=(i-1)>>1;I32 pn=g31_heap[p];if(f>=g31_nodes[pn].f)break;g31_heap[i]=pn;g31_nodes[pn].heap=i;i=p;}g31_heap[i]=n;g31_nodes[n].heap=i;}
U0 MC31_HeapDown(I32 i){I32 n=g31_heap[i];F32 f=g31_nodes[n].f;while(TRUE){I32 l=i*2+1,r=l+1;if(l>=g31_heapN)break;I32 c=l;if(r<g31_heapN && g31_nodes[g31_heap[r]].f<g31_nodes[g31_heap[l]].f)c=r;if(g31_nodes[g31_heap[c]].f>=f)break;g31_heap[i]=g31_heap[c];g31_nodes[g31_heap[i]].heap=i;i=c;}g31_heap[i]=n;g31_nodes[n].heap=i;}
U0 MC31_HeapPush(I32 n){if(g31_heapN>=MC31_NODES)return;g31_heap[g31_heapN]=n;g31_nodes[n].heap=g31_heapN;g31_heapN++;MC31_HeapUp(g31_heapN-1);}
I32 MC31_HeapPop(){I32 n=g31_heap[0];g31_heapN--;if(g31_heapN>0){g31_heap[0]=g31_heap[g31_heapN];g31_nodes[g31_heap[0]].heap=0;MC31_HeapDown(0);}g31_nodes[n].heap=-1;return n;}
I32 MC31_IsFree(I32 x,I32 y,I32 z){Bool water=FALSE;I32 a,b,c;for(a=x;a<x+g31_pw;a++)for(b=y;b<y+g31_ph;b++)for(c=z;c<z+g31_pw;c++){I32 id=MC31_Tile(a,b,c);if(id<=0)continue;
 if(id==96)return -4;if(MC31_Water(id)){if(g31_pAvoid)return -1;water=TRUE;continue;}if(MC31_Lava(id))return -2;
 if(id==64 || id==71){if(!(Level_getData(&g31_app->level,a,b,c)&4))return 0;continue;}
 if(id==107){if(Level_getData(&g31_app->level,a,b,c)&4)continue;return -3;}if(id==85 || id==139)return -3;
 if(MC31_Solid(id))return 0;}
 if(b<0)return 0;if(water)return 2;return 1;}
I32 MC31_Safe(I32 x,I32 y,I32 z,I32 jump){if(x<0 || z<0 || x>255 || z>255 || y<1 || y>126)return -1;I32 best=-1,f=MC31_IsFree(x,y,z);if(f==2)return MC31_NodeGet(x,y,z);if(f==1)best=MC31_NodeGet(x,y,z);
 if(best<0 && jump>0 && f!=-3 && f!=-4 && MC31_IsFree(x,y+jump,z)==1){best=MC31_NodeGet(x,y+jump,z);y+=jump;}
 if(best>=0){I32 drop=0,t=0;while(y>0){t=MC31_IsFree(x,y-1,z);if(g31_pAvoid && t==-1)return -1;if(t!=1)break;drop++;if(drop>=4)return -1;y--;if(y>0)best=MC31_NodeGet(x,y,z);}if(t==-2)return -1;}
 return best;}
Bool MC31_FindPath(MC31Mob *m,F32 tx,F32 ty,F32 tz,F32 maxDist){MCBody023 *b=&m->e.body;memset(g31_hash,0xFF,sizeof(g31_hash));g31_nodeN=0;g31_heapN=0;g31_pw=floorf(b->width+1);g31_ph=floorf(b->height+1);g31_pAvoid=m->avoidWater;
 I32 start=MC31_NodeGet(floorf(m->e.box.minX),floorf(m->e.box.minY),floorf(m->e.box.minZ)),end=MC31_NodeGet(floorf(tx-b->width*0.5),floorf(ty),floorf(tz-b->width*0.5));if(start<0 || end<0 || start==end)return FALSE;
 g31_nodes[start].g=0;g31_nodes[start].h=MC31_NodeDist(start,end);g31_nodes[start].f=g31_nodes[start].h;MC31_HeapPush(start);I32 closest=start;
 while(g31_heapN>0){I32 cur=MC31_HeapPop();if(cur==end){closest=end;break;}if(g31_nodes[cur].h<g31_nodes[closest].h)closest=cur;g31_nodes[cur].closed=TRUE;
  I32 cx=g31_nodes[cur].x,cy=g31_nodes[cur].y,cz=g31_nodes[cur].z,jump=0,d;if(MC31_IsFree(cx,cy+1,cz)==1)jump=1;
  for(d=0;d<4;d++){I32 nx=cx,nz=cz;if(d==0)nz++;if(d==1)nx--;if(d==2)nx++;if(d==3)nz--;I32 nb=MC31_Safe(nx,cy,nz,jump);if(nb<0 || g31_nodes[nb].closed)continue;if(MC31_NodeDist(nb,end)>=maxDist)continue;
   F32 g=g31_nodes[cur].g+MC31_NodeDist(cur,nb);if(g31_nodes[nb].heap<0 || g<g31_nodes[nb].g){g31_nodes[nb].from=cur;g31_nodes[nb].g=g;g31_nodes[nb].h=MC31_NodeDist(nb,end);g31_nodes[nb].f=g+g31_nodes[nb].h;if(g31_nodes[nb].heap>=0)MC31_HeapUp(g31_nodes[nb].heap);else MC31_HeapPush(nb);}}}
 if(closest==start)return FALSE;
 I32 count=0,i=closest;while(i>=0){count++;i=g31_nodes[i].from;}I32 keep=count;if(keep>MC31_PATHMAX)keep=MC31_PATHMAX;
 i=closest;I32 k=count-1;while(i>=0){if(k<keep){m->px[k]=g31_nodes[i].x;m->py[k]=g31_nodes[i].y;m->pz[k]=g31_nodes[i].z;}k--;i=g31_nodes[i].from;}
 m->pathN=keep;m->pathI=0;return TRUE;}

U0 MC31_NavStop(MC31Mob *m){m->pathN=0;m->pathI=0;}
Bool MC31_NavDone(MC31Mob *m){return m->pathI>=m->pathN;}
Bool MC31_MoveTo(MC31Mob *m,F32 x,F32 y,F32 z,F32 speed){if(!MC31_FindPath(m,x,y,z,16)){MC31_NavStop(m);return FALSE;}m->navSpeed=speed;m->stuckTick=m->navTick;m->stuckX=m->e.body.x;m->stuckY=m->e.body.y;m->stuckZ=m->e.body.z;return TRUE;}
U0 MC31_SetWanted(MC31Mob *m,F32 x,F32 y,F32 z,F32 sp){m->wx=x;m->wy=y;m->wz=z;m->wspeed=sp;m->wanted=TRUE;}
U0 MC31_NavTick(MC31Mob *m){m->navTick++;if(MC31_NavDone(m))return;MCBody023 *b=&m->e.body;F32 half=floorf(b->width+1)*0.5;
 if(b->onGround || b->inWater || b->inLava){I32 cy=floorf(m->e.box.minY+0.5),limit=m->pathN,i;for(i=m->pathI;i<m->pathN;i++)if(m->py[i]!=cy){limit=i;break;}
  F32 ww=b->width*b->width;for(i=m->pathI;i<limit;i++){F32 dx=m->px[i]+half-b->x,dz=m->pz[i]+half-b->z;if(dx*dx+dz*dz<ww)m->pathI=i+1;}
  if(m->navTick-m->stuckTick>100){if(MC31_Dist2(m,m->stuckX,m->stuckY,m->stuckZ)<2.25)MC31_NavStop(m);m->stuckTick=m->navTick;m->stuckX=b->x;m->stuckY=b->y;m->stuckZ=b->z;}}
 if(MC31_NavDone(m))return;MC31_SetWanted(m,m->px[m->pathI]+half,m->py[m->pathI],m->pz[m->pathI]+half,m->navSpeed);}

U0 MC31_LookAt(MC31Mob *m,F32 x,F32 y,F32 z,F32 ys,F32 ps){m->lx=x;m->ly=y;m->lz=z;m->lyawSpd=ys;m->lpitchSpd=ps;m->looking=TRUE;}
U0 MC31_LookAtMob(MC31Mob *m,MC31Mob *o,F32 ys,F32 ps){MC31_LookAt(m,o->e.body.x,o->e.body.y+MC31_Eye(o),o->e.body.z,ys,ps);}
U0 MC31_LookAtPlayer(MC31Mob *m,F32 ys,F32 ps){Player *p=MC31_Player();if(p)MC31_LookAt(m,p->mob.entity.body.x,p->mob.entity.body.y,p->mob.entity.body.z,ys,ps);}
U0 MC31_MoveTick(MC31Mob *m){m->forward=0;if(!m->wanted)return;m->wanted=FALSE;MCBody023 *b=&m->e.body;I32 yo=floorf(m->e.box.minY+0.5);F32 dx=m->wx-b->x,dz=m->wz-b->z,dy=m->wy-yo;if(dx*dx+dy*dy+dz*dz<2.5e-7)return;
 F32 yaw=atan2f(dz,dx)*180/MC31_PI-90;b->yaw=MC31_RotLerp(b->yaw,yaw,30);m->speed=m->wspeed*m->baseSpeed;m->forward=m->speed;if(dy>0 && dx*dx+dz*dz<1)m->jumpFlag=TRUE;}
U0 MC31_LookTick(MC31Mob *m){MCBody023 *b=&m->e.body;b->pitch=0;
 if(m->looking){m->looking=FALSE;F32 dx=m->lx-b->x,dy=m->ly-(b->y+MC31_Eye(m)),dz=m->lz-b->z,hd=sqrt(dx*dx+dz*dz);F32 ty=atan2f(dz,dx)*180/MC31_PI-90,tp=-atan2f(dy,hd)*180/MC31_PI;b->pitch=MC31_RotLerp(b->pitch,tp,m->lpitchSpd);m->headYaw=MC31_RotLerp(m->headYaw,ty,m->lyawSpd);}
 else m->headYaw=MC31_RotLerp(m->headYaw,m->bodyRot,10);
 F32 d=MC31_Wrap(m->headYaw-m->bodyRot);if(!MC31_NavDone(m)){if(d<-75)m->headYaw=m->bodyRot-75;if(d>75)m->headYaw=m->bodyRot+75;}}
U0 MC31_BodyTick(MC31Mob *m){MCBody023 *b=&m->e.body;F32 dx=b->x-b->prevX,dz=b->z-b->prevZ;
 if(dx*dx+dz*dz>2.5e-7){m->bodyRot=MC31_RotLerp(m->bodyRot,b->yaw,10);F32 d=MC31_Wrap(m->headYaw-m->bodyRot);if(d>75)m->headYaw=m->bodyRot+75;if(d<-75)m->headYaw=m->bodyRot-75;m->lastHeadYaw=m->headYaw;m->headStable=0;return;}
 F32 max=75;if(fabs(MC31_Wrap(m->headYaw-m->lastHeadYaw))>15){m->headStable=0;m->lastHeadYaw=m->headYaw;}else{m->headStable++;if(m->headStable>10){max=(1-(m->headStable-10)/10.0)*75;if(max<0)max=0;}}
 F32 d=MC31_Wrap(m->headYaw-m->bodyRot);if(d>max)d=max;if(d<-max)d=-max;m->bodyRot=m->headYaw-d;}

// ---- goals ----
Bool MC31_IsFood(I32 kind,I32 id){if(kind==11 || kind==13)return id==296;if(kind==12)return id==391 || id==392 || id==457;if(kind==10)return id==295 || id==361 || id==362 || id==458;return FALSE;}
I32 MC31_Held(){Player *p=MC31_Player();if(!p)return 0;ItemInstance *h=Inventory_getSelected(&p->inventory);if(!h || h->count<1 || ItemInstance_isNull(h))return 0;return ItemInstance_getId(h);}
Bool MC31_RandomPos(MC31Mob *m,I32 h,I32 v,F32 *ox,F32 *oy,F32 *oz){MCBody023 *b=&m->e.body;Bool found=FALSE;F32 best=-99999;I32 fx=floorf(b->x),fy=floorf(b->y),fz=floorf(b->z),bx=0,by=0,bz=0,i;
 for(i=0;i<10;i++){I32 x=fx+MC31_RandI(2*h)-h,y=fy+MC31_RandI(2*v)-v,z=fz+MC31_RandI(2*h)-h;if(x<0 || z<0 || x>255 || z>255 || y<1 || y>126)continue;F32 val;if(MC31_Tile(x,y-1,z)==2)val=10;else val=MC31_Bright(x,y,z)-0.5;if(val>best){best=val;bx=x;by=y;bz=z;found=TRUE;}}
 if(found){*ox=bx;*oy=by;*oz=bz;}return found;}
F32 MC31_Speed(MC31Mob *m,I32 g){I32 k=m->kind;if(g==G31_PANIC)return 1.5;if(g==G31_BREED)return 1.0;if(g==G31_TEMPT){if(k==11)return 1.25;if(k==12)return 1.2;if(k==13)return 1.1;return 1.0;}if(g==G31_FOLLOW){if(k==13)return 1.0;return 1.1;}if(g==G31_STROLL){if(k==11)return 0.8;return 1.0;}return 1.0;}
MC31Mob *MC31_FindPartner(MC31Mob *m){MC31Mob *best=NULL;F32 bd=1.0e30;I32 i;for(i=0;i<g31_mobN;i++){MC31Mob *o=g31_mobs[i];if(o==m || !MC31_Alive(o) || o->kind!=m->kind || o->inLove<=0 || o->age!=0)continue;MCBody023 *a=&o->e.body;if(fabs(a->x-m->e.body.x)>8 || fabs(a->y-m->e.body.y)>8 || fabs(a->z-m->e.body.z)>8)continue;F32 d=MC31_Dist2(m,a->x,a->y,a->z);if(d<bd){bd=d;best=o;}}return best;}
MC31Mob *MC31_FindParent(MC31Mob *m){MC31Mob *best=NULL;F32 bd=1.0e30;I32 i;for(i=0;i<g31_mobN;i++){MC31Mob *o=g31_mobs[i];if(o==m || !MC31_Alive(o) || o->kind!=m->kind || o->age<0)continue;MCBody023 *a=&o->e.body;if(fabs(a->x-m->e.body.x)>8 || fabs(a->y-m->e.body.y)>4 || fabs(a->z-m->e.body.z)>8)continue;F32 d=MC31_Dist2(m,a->x,a->y,a->z);if(d<bd){bd=d;best=o;}}return best;}
Bool MC31_GrassAt(MC31Mob *m,Bool *tall){MCBody023 *b=&m->e.body;I32 x=floorf(b->x),y=floorf(b->y),z=floorf(b->z);*tall=FALSE;if(MC31_Tile(x,y,z)==31 && Level_getData(&g31_app->level,x,y,z)==1){*tall=TRUE;return TRUE;}return MC31_Tile(x,y-1,z)==2;}

Bool MC31_CanUse(MC31Mob *m,I32 i){I32 g=m->gid[i];MCBody023 *b=&m->e.body;F32 x,y,z;
 if(g==G31_FLOAT)return b->inWater || b->inLava;
 if(g==G31_PANIC){if(m->hurtByTime<=0 && m->e.fire<=0)return FALSE;if(!MC31_RandomPos(m,5,4,&x,&y,&z))return FALSE;m->lx=x;m->ly=y;m->lz=z;return TRUE;}
 if(g==G31_BREED){if(m->inLove<=0)return FALSE;m->partner=MC31_FindPartner(m);return m->partner!=NULL;}
 if(g==G31_TEMPT){if(m->temptCool>0){m->temptCool--;return FALSE;}if(MC31_PlayerDist2(m)>=100)return FALSE;return MC31_IsFood(m->kind,MC31_Held());}
 if(g==G31_FOLLOW){if(m->age>=0)return FALSE;MC31Mob *p=MC31_FindParent(m);if(!p)return FALSE;if(MC31_Dist2(m,p->e.body.x,p->e.body.y,p->e.body.z)<9)return FALSE;m->parent=p;return TRUE;}
 if(g==G31_EAT){I32 n=1000;if(m->age<0)n=50;if(MC31_RandI(n)!=0)return FALSE;Bool tall;return MC31_GrassAt(m,&tall);}
 if(g==G31_STROLL){if(m->noAction>=100)return FALSE;if(MC31_RandI(120)!=0)return FALSE;if(!MC31_RandomPos(m,10,7,&x,&y,&z))return FALSE;m->lx=x;m->ly=y;m->lz=z;return TRUE;}
 if(g==G31_LOOKP){if(MC31_Rand()>=0.02)return FALSE;return MC31_PlayerDist2(m)<36;}
 if(g==G31_LOOKAROUND)return MC31_Rand()<0.02;
 return FALSE;}
Bool MC31_CanContinue(MC31Mob *m,I32 i){I32 g=m->gid[i];
 if(g==G31_PANIC || g==G31_STROLL)return !MC31_NavDone(m);
 if(g==G31_BREED)return MC31_Alive(m->partner) && m->partner->inLove>0 && m->breedTime<60;
 if(g==G31_TEMPT)return MC31_CanUse(m,i);
 if(g==G31_FOLLOW){if(!MC31_Alive(m->parent))return FALSE;F32 d=MC31_Dist2(m,m->parent->e.body.x,m->parent->e.body.y,m->parent->e.body.z);return d>=9 && d<=256;}
 if(g==G31_EAT)return m->eatTick>0;
 if(g==G31_LOOKP)return MC31_PlayerDist2(m)<=36 && m->lookTime>0;
 if(g==G31_LOOKAROUND)return m->lookTime>=0;
 return MC31_CanUse(m,i);}
U0 MC31_Start(MC31Mob *m,I32 i){I32 g=m->gid[i];
 if(g==G31_PANIC || g==G31_STROLL)MC31_MoveTo(m,m->lx+0.5,m->ly,m->lz+0.5,MC31_Speed(m,g));
 if(g==G31_BREED)m->breedTime=0;
 if(g==G31_TEMPT){m->tempting=TRUE;m->avoidWater=FALSE;m->temptRecalc=0;}
 if(g==G31_FOLLOW)m->followRecalc=0;
 if(g==G31_EAT){m->eatTick=40;MC31_NavStop(m);}
 if(g==G31_LOOKP)m->lookTime=40+MC31_RandI(40);
 if(g==G31_LOOKAROUND){F32 a=MC31_PI*2*MC31_Rand();m->lookRX=cos(a);m->lookRZ=sin(a);m->lookTime=20+MC31_RandI(20);}}
U0 MC31_Stop(MC31Mob *m,I32 i){I32 g=m->gid[i];
 if(g==G31_BREED){m->partner=NULL;m->breedTime=0;}
 if(g==G31_TEMPT){MC31_NavStop(m);m->temptCool=100;m->tempting=FALSE;m->avoidWater=TRUE;}
 if(g==G31_FOLLOW)m->parent=NULL;
 if(g==G31_EAT)m->eatTick=0;}
U0 MC31_Breed(MC31Mob *m){MC31Mob *p=m->partner;m->age=6000;p->age=6000;m->inLove=0;p->inLove=0;MCBody023 *b=&m->e.body;MC31Mob *c=MC31_New(m->kind,b->x,b->y,b->z,b->yaw);if(!c)return;c->age=-24000;if(m->kind==13){if(MC31_RandI(2))c->color=m->color;else c->color=p->color;}MC31_Hearts(c,7);g31_app->unsaved=TRUE;}
U0 MC31_Ate(MC31Mob *m){m->sheared=FALSE;if(m->age<0){m->age+=1200;if(m->age>0)m->age=0;}}
U0 MC31_GoalTick(MC31Mob *m,I32 i){I32 g=m->gid[i];MCBody023 *b=&m->e.body;
 if(g==G31_FLOAT){if(MC31_Rand()<0.8)m->jumpFlag=TRUE;}
 if(g==G31_BREED){MC31Mob *p=m->partner;MC31_LookAtMob(m,p,10,40);MC31_MoveTo(m,p->e.body.x,p->e.box.minY,p->e.body.z,MC31_Speed(m,g));m->breedTime++;if(m->breedTime>=60 && MC31_Dist2(m,p->e.body.x,p->e.body.y,p->e.body.z)<9)MC31_Breed(m);}
 if(g==G31_TEMPT){Player *p=MC31_Player();if(!p)return;MC31_LookAtPlayer(m,30,40);if(MC31_PlayerDist2(m)<6.25)MC31_NavStop(m);else{m->temptRecalc--;if(m->temptRecalc<=0 || MC31_NavDone(m)){m->temptRecalc=(MC31_RandI(4))+8;MC31_MoveTo(m,p->mob.entity.body.x,p->mob.entity.box.minY,p->mob.entity.body.z,MC31_Speed(m,g));}}}
 if(g==G31_FOLLOW){m->followRecalc--;if(m->followRecalc<=0){m->followRecalc=10;MC31Mob *p=m->parent;MC31_MoveTo(m,p->e.body.x,p->e.box.minY,p->e.body.z,MC31_Speed(m,g));}}
 if(g==G31_EAT){if(m->eatTick>0)m->eatTick--;if(m->eatTick==4){Bool tall;if(MC31_GrassAt(m,&tall)){I32 x=floorf(b->x),y=floorf(b->y),z=floorf(b->z);if(tall)Level_setTileAndData(&g31_app->level,x,y,z,0,0,3);else{y--;Level_setTileAndData(&g31_app->level,x,y,z,3,0,3);}MC028_Dirty(g31_app,x,y,z);MC31_Ate(m);g31_app->unsaved=TRUE;}}}
 if(g==G31_LOOKP){MC31_LookAtPlayer(m,10,40);m->lookTime--;}
 if(g==G31_LOOKAROUND){m->lookTime--;MC31_LookAt(m,b->x+m->lookRX,b->y+MC31_Eye(m),b->z+m->lookRZ,10,40);}}
Bool MC31_InSystem(MC31Mob *m,I32 a){I32 j;for(j=0;j<m->ng;j++){if(j==a || !m->grun[j])continue;if(m->gprio[a]>=m->gprio[j]){if(m->gflags[a] & m->gflags[j])return FALSE;}}return TRUE;}
U0 MC31_Goals(MC31Mob *m){I32 i;for(i=0;i<m->ng;i++){if(m->grun[i]){if(MC31_InSystem(m,i) && MC31_CanContinue(m,i))continue;MC31_Stop(m,i);m->grun[i]=FALSE;}
  if(MC31_InSystem(m,i) && MC31_CanUse(m,i)){MC31_Start(m,i);m->grun[i]=TRUE;}}
 for(i=0;i<m->ng;i++)if(m->grun[i] && !m->removed)MC31_GoalTick(m,i);}

U0 MC31_ServerAi(MC31Mob *m){m->noAction++;if(MC31_PlayerDist2(m)<1024)m->noAction=0;if(m->kind>=32)MC34_Ai(m);else MC31_Goals(m);MC31_NavTick(m);MC31_MoveTick(m);MC31_LookTick(m);m->jumping=m->jumpFlag;m->jumpFlag=FALSE;}
U0 MC31_AiStep(MC31Mob *m){MCBody023 *b=&m->e.body;
 if(b->health<=0){m->jumping=FALSE;m->forward=0;m->strafe=0;}else MC31_ServerAi(m);
 if(m->jumping){if(b->inWater || b->inLava)b->motionY+=0.04;else if(b->onGround && !(m->kind==13 && m->eatTick>0))b->motionY=0.42;}
 m->strafe*=0.98;m->forward*=0.98;MC31_Travel(m,m->strafe,m->forward);MC31_Push(m);}

U0 MC31_Splash(MC31Mob *m){MCBody023 *b=&m->e.body;F32 v=sqrt(b->motionX*b->motionX*0.2+b->motionY*b->motionY+b->motionZ*b->motionZ*0.2)*0.2;if(v>1)v=1;MC030_Play("random.splash",b->x,b->y,b->z,v,1+(MC31_Rand()-MC31_Rand())*0.4);
 F32 y=floorf(m->e.box.minY)+1;I32 i,n=1+b->width*20;for(i=0;i<n;i++){F32 ox=(MC31_Rand()*2-1)*b->width,oz=(MC31_Rand()*2-1)*b->width;MC31_Particle(3,b->x+ox,y,b->z+oz,b->motionX,b->motionY-MC31_Rand()*0.2,b->motionZ);MC31_Particle(4,b->x+ox,y,b->z+oz,b->motionX,b->motionY,b->motionZ);}}

U0 MC31_Tick(MC31Mob *m){Entity *e=&m->e;MCBody023 *b=&e->body;
 b->prevX=b->x;b->prevY=b->y;b->prevZ=b->z;b->prevYaw=b->yaw;b->prevPitch=b->pitch;m->prevBodyRot=m->bodyRot;m->prevHeadYaw=m->headYaw;m->prevWalkSpeed=m->walkSpeed;m->oFlap=m->flap;m->oFlapSpeed=m->flapSpeed;
 AABB wb=e->box;wb.minY+=0.4;wb.maxY-=0.4;wb.minX+=0.001;wb.maxX-=0.001;wb.minZ+=0.001;wb.maxZ-=0.001;Bool water=MC31_InLiquid(&wb,FALSE);
 if(water){if(!b->inWater && !m->firstTick)MC31_Splash(m);e->fallDistance=0;e->fire=0;}b->inWater=water;
 AABB lb=e->box;lb.minX+=0.1;lb.maxX-=0.1;lb.minY+=0.4;lb.maxY-=0.4;lb.minZ+=0.1;lb.maxZ-=0.1;b->inLava=MC31_InLiquid(&lb,TRUE);
 if(b->inLava){MC31_Hurt(m,FALSE,4);e->fire=300;}
 if(e->fire>0){if(e->fire%20==0)MC31_Hurt(m,FALSE,1);e->fire--;}
 if(b->y<0)MC31_Hurt(m,FALSE,4);
 m->firstTick=FALSE;
 if(b->health>0){m->ambient++;if((m->ambient&15)==0 && MC31_RandI(2000)<m->ambient*16){m->ambient=-240;MC31_Sound(m,0);}
  I32 ex=floorf(b->x),ey=floorf(b->y+MC31_Eye(m)),ez=floorf(b->z),eid=MC31_Tile(ex,ey,ez);if(MC31_Cube(eid))MC31_Hurt(m,FALSE,1);
  if(MC31_Water(eid)){m->airSupply--;if(m->airSupply==-20){m->airSupply=0;I32 i;for(i=0;i<8;i++)MC31_Particle(3,b->x+MC31_Rand()-MC31_Rand(),b->y+MC31_Eye(m)+MC31_Rand()-MC31_Rand(),b->z+MC31_Rand()-MC31_Rand(),b->motionX,b->motionY,b->motionZ);MC31_Hurt(m,FALSE,2);}}else m->airSupply=300;}
 if(m->hurtTime>0)m->hurtTime--;if(m->invul>0)m->invul--;if(m->hurtByTime>0)m->hurtByTime--;
 if(b->health<=0){m->deathTime++;if(m->deathTime>=20){I32 i;for(i=0;i<20;i++)MC31_Particle(1,b->x+(MC31_Rand()*b->width*2)-b->width,b->y+MC31_Rand()*b->height,b->z+(MC31_Rand()*b->width*2)-b->width,MC31_Gauss()*0.02,MC31_Gauss()*0.02,MC31_Gauss()*0.02);m->removed=TRUE;return;}}
 if(m->age<0)m->age++;else if(m->age>0)m->age--;
 if(m->age!=0)m->inLove=0;
 if(m->inLove>0){m->inLove--;if(m->inLove%10==0)MC31_Hearts(m,1);}
 MC31_AiStep(m);if(m->kind>=32)MC34_PostTick(m);
 if(m->kind==10){m->flapSpeed+=(-0.3);if(!b->onGround)m->flapSpeed+=1.5;if(m->flapSpeed<0)m->flapSpeed=0;if(m->flapSpeed>1)m->flapSpeed=1;if(!b->onGround && m->flapping<1)m->flapping=1;m->flapping*=0.9;if(!b->onGround && b->motionY<0)b->motionY*=0.6;m->flap+=m->flapping*2;
  if(m->age>=0 && b->health>0){m->eggTime--;if(m->eggTime<=0){MC030_Play("random.pop",b->x,b->y,b->z,1.0,(MC31_Rand()-MC31_Rand())*0.2+1);MC31_Drop(344,0,1,b->x,b->y,b->z,0,0,0,FALSE);m->eggTime=MC31_RandI(6000)+6000;}}}
 F32 dx=b->x-b->prevX,dz=b->z-b->prevZ,dist=sqrt(dx*dx+dz*dz)*4;if(dist>1)dist=1;m->walkSpeed+=(dist-m->walkSpeed)*0.4;m->walkPos+=m->walkSpeed;
 if(b->health>0)MC31_BodyTick(m);
 while(m->bodyRot-m->prevBodyRot<-180)m->prevBodyRot-=360;while(m->bodyRot-m->prevBodyRot>=180)m->prevBodyRot+=360;
 while(m->headYaw-m->prevHeadYaw<-180)m->prevHeadYaw-=360;while(m->headYaw-m->prevHeadYaw>=180)m->prevHeadYaw+=360;
 while(b->yaw-b->prevYaw<-180)b->prevYaw-=360;while(b->yaw-b->prevYaw>=180)b->prevYaw+=360;}

U0 MC031_ClearMobs(){I32 i;for(i=0;i<g31_mobN;i++)free(g31_mobs[i]);g31_mobN=0;g31_sel=NULL;}
I32 MC031_Count(){I32 i,n=0;for(i=0;i<g31_mobN;i++)if(!g31_mobs[i]->removed)n++;return n;}

// ---- player interaction ----
I32 MC31_AttackDamage(I32 id){if(id==268 || id==283)return 4;if(id==272)return 5;if(id==267)return 6;if(id==276)return 7;
 I32 tier=-1,base=0;if(id==269 || id==284){tier=0;base=1;}if(id==273){tier=1;base=1;}if(id==256){tier=2;base=1;}if(id==277){tier=3;base=1;}
 if(id==270 || id==285){tier=0;base=2;}if(id==274){tier=1;base=2;}if(id==257){tier=2;base=2;}if(id==278){tier=3;base=2;}
 if(id==271 || id==286){tier=0;base=3;}if(id==275){tier=1;base=3;}if(id==258){tier=2;base=3;}if(id==279){tier=3;base=3;}
 if(tier>=0)return base+tier;return 1;}
I32 MC031_FoodHeal(I32 id){if(id==260)return 4;if(id==297)return 5;if(id==319)return 3;if(id==320)return 8;if(id==363)return 3;if(id==364)return 8;if(id==365)return 2;if(id==366)return 6;if(id==360)return 2;if(id==393)return 6;if(id==400)return 8;if(id==457)return 1;return 0;}
U0 MC31_Attack(MCApp028 *s,MC31Mob *m){Player *p=MC31_Player();if(!p)return;ItemInstance *h=Inventory_getSelected(&p->inventory);I32 id=MC31_Held();
 if(MC31_Hurt(m,TRUE,MC31_AttackDamage(id)) && id>=256 && !s->creative && ItemInstance_isDamageableItem(h)){I32 wear=2;if(id==268 || id==272 || id==267 || id==276 || id==283)wear=1;if(id>=290 && id<=294)wear=0;if(wear)ItemInstance_hurtAndBreak(h,wear,&p->view);if(h->count<1)ItemInstance_setNull(h);}}
Bool MC31_Interact(MCApp028 *s,MC31Mob *m){Player *p=MC31_Player();if(!p || !MC31_Alive(m))return FALSE;ItemInstance *h=Inventory_getSelected(&p->inventory);I32 id=MC31_Held();MCBody023 *b=&m->e.body;
 if(m->kind==11 && id==325 && h->metadata==0 && !s->creative){if(h->count==1)h->metadata=1;else{h->count--;ItemInstance milk;ItemInstance_Init(&milk,&s->catalog.registry,325,1,1);if(!Inventory_add(&p->inventory,&milk))MC31_Drop(325,1,1,p->mob.entity.body.x,p->mob.entity.box.minY+0.5,p->mob.entity.body.z,0,0,0,FALSE);}return TRUE;}
 if(m->kind==13 && id==359 && !m->sheared && m->age>=0){m->sheared=TRUE;I32 i,n=1+MC31_RandI(3);for(i=0;i<n;i++)MC31_Drop(35,m->color,1,b->x,b->y+1,b->z,(MC31_Rand()-MC31_Rand())*0.1,MC31_Rand()*0.05,(MC31_Rand()-MC31_Rand())*0.1,TRUE);if(!s->creative){ItemInstance_hurtAndBreak(h,1,&p->view);if(h->count<1)ItemInstance_setNull(h);}return TRUE;}
 if(id && MC31_IsFood(m->kind,id) && m->age==0){if(!s->creative){h->count--;if(h->count<1)ItemInstance_setNull(h);}m->inLove=600;MC31_Hearts(m,7);return TRUE;}
 return FALSE;}
F32 MC31_Slab(Vec3 *o,F32 dx,F32 dy,F32 dz,F32 x0,F32 y0,F32 z0,F32 x1,F32 y1,F32 z1){F32 tmin=-1.0e30,tmax=1.0e30,t1,t2,t;
 if(fabs(dx)<1.0e-9){if(o->x<x0 || o->x>x1)return -1;}else{t1=(x0-o->x)/dx;t2=(x1-o->x)/dx;if(t1>t2){t=t1;t1=t2;t2=t;}if(t1>tmin)tmin=t1;if(t2<tmax)tmax=t2;}
 if(fabs(dy)<1.0e-9){if(o->y<y0 || o->y>y1)return -1;}else{t1=(y0-o->y)/dy;t2=(y1-o->y)/dy;if(t1>t2){t=t1;t1=t2;t2=t;}if(t1>tmin)tmin=t1;if(t2<tmax)tmax=t2;}
 if(fabs(dz)<1.0e-9){if(o->z<z0 || o->z>z1)return -1;}else{t1=(z0-o->z)/dz;t2=(z1-o->z)/dz;if(t1>t2){t=t1;t1=t2;t2=t;}if(t1>tmin)tmin=t1;if(t2<tmax)tmax=t2;}
 if(tmax<0 || tmin>tmax)return -1;if(tmin<0)return 0;return tmin;}
U0 MC031_PickMob(MCApp028 *s){g31_app=s;g31_sel=NULL;g31_holdEdge=s->leftDown && !g31_prevHold;g31_prevHold=s->leftDown;if(!s->worldReady || !s->minecraft.player || g29_dirMode==2 || s->paused || s->inventory)return;
 Vec3 eye,end;MC028_Direction(s,&eye,&end,1);F32 dx=end.x-eye.x,dy=end.y-eye.y,dz=end.z-eye.z,limit=3;if(s->creative)limit=5;
 if(s->hasHit){I32 id=Level_getTile(&s->level,s->hit.x,s->hit.y,s->hit.z);AABB box;Tile_getAABB(&s->catalog.tiles[id],s->hit.x,s->hit.y,s->hit.z,&box);F32 t=MC31_Slab(&eye,dx,dy,dz,box.minX,box.minY,box.minZ,box.maxX,box.maxY,box.maxZ);if(t>=0 && t<limit)limit=t;}
 I32 i;for(i=0;i<g31_mobN;i++){MC31Mob *m=g31_mobs[i];if(!MC31_Alive(m))continue;AABB *a=&m->e.box;F32 t=MC31_Slab(&eye,dx,dy,dz,a->minX-0.1,a->minY-0.1,a->minZ-0.1,a->maxX+0.1,a->maxY+0.1,a->maxZ+0.1);if(t>=0 && t<limit){limit=t;g31_sel=m;}}
 if(g31_sel)s->hasHit=FALSE;}
U0 MC031_MobInput(MCApp028 *s){MC31Mob *m=g31_sel;if(!m)return;if(s->mining){SurvivalMode_stopDestroyBlock(&s->minecraft.survival);s->mining=FALSE;}
