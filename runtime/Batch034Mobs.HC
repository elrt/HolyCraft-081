 if(attack)MC31_Attack(s,m);else if(use){if(MC31_Interact(s,m))s->unsaved=TRUE;s->placeCooldown=5;}
 s->rightPressed=FALSE;}
Bool MC031_SpawnEgg(MCApp028 *s,ItemInstance *item,I32 x,I32 y,I32 z,I32 face){g31_app=s;MC31_RngInit();I32 kind=item->metadata;if(!MC34_KindOk(kind))return TRUE;
 I32 clicked=Level_getTile(&s->level,x,y,z);if(face==0)y--;if(face==1)y++;if(face==2)z--;if(face==3)z++;if(face==4)x--;if(face==5)x++;F32 yo=0;if(face==1 && (clicked==85 || clicked==107))yo=0.5;
 MC31Mob *m=MC31_New(kind,x+0.5,y+yo,z+0.5,MC31_Rand()*360);if(!m)return TRUE;if(kind==13)MC31_SheepColor(m);s->unsaved=TRUE;
