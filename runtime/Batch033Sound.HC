class MCSoundDesc030 {U8 *name;I32 id;};
MCSoundDesc030 g30_snd[128];
I32 g30_sndN=0,g30_sndMissing=0,g30_requests=0,g30_started=0;
Bool g30_audio=FALSE,g30_log=FALSE;
F32 g30_volume=1.0,g30_lx=0,g30_ly=0,g30_lz=0,g30_lyaw=0;
Random g30_rng;
U0 MC030_Add(U8 *name,U8 *file){if(g30_sndN>=128)return;U8 path[160];sprintf(path,"assets/030/sound/%s.pcm",file);I32 id=hc030_snd_load(path);
 if(id<0){g30_sndMissing++;printf("SOUND030 missing %s\n",path);return;}g30_snd[g30_sndN].name=name;g30_snd[g30_sndN].id=id;g30_sndN++;}
