// SoundRepository::get: a random SoundDesc among the variants registered for the name.
I32 MC030_Get(U8 *name){I32 i,n=0,pick;for(i=0;i<g30_sndN;i++)if(!strcmp(g30_snd[i].name,name))n++;if(n<=0)return -1;pick=Random_nextInt(&g30_rng,n);
 for(i=0;i<g30_sndN;i++)if(!strcmp(g30_snd[i].name,name)){if(pick==0)return g30_snd[i].id;pick--;}return -1;}
// SoundEngine(20): field_A24 = 1/20.
F32 MC030_VolumeMult(F32 x,F32 y,F32 z){F32 dx=x-g30_lx,dy=y-g30_ly,dz=z-g30_lz;F32 v=1.1-sqrtf(dx*dx+dy*dy+dz*dz)*0.05;if(v>1.0)return 1.0;if(v<=-1.0)return -1.0;return v;}
U0 MC030_Start(U8 *name,F32 v){I32 id=MC030_Get(name);if(id<0)return;Bool ok=FALSE;if(g30_audio)ok=hc030_snd_play(id,v)!=0;if(ok)g30_started++;
 if(g30_log){if(ok)printf("SOUND030 play %s volume=%.3f\n",name,v);else printf("SOUND030 skip %s volume=%.3f\n",name,v);}}
U0 MC030_Play(U8 *name,F32 x,F32 y,F32 z,F32 volume,F32 pitch){g30_requests++;if(name==NULL)return;if(!name[0])return;F32 v=volume*g30_volume;if(v<=0)return;
 v*=MC030_VolumeMult(x,y,z);if(v>1.0)v=1.0;else if(v<=0)v=0;if(g30_volume!=0 && v>0)MC030_Start(name,v);}
U0 MC030_PlayUI(U8 *name,F32 volume,F32 pitch){g30_requests++;F32 v=volume*g30_volume;if(v<=0)return;if(v>1.0)v=1.0;if(g30_volume!=0)MC030_Start(name,v);}
// SoundEngine::update(player, partial): listener = interpolated player position (SL ignores the angle).
U0 MC030_Listener(MCApp028 *s,F32 a){if(g30_volume==0 || !s->worldReady)return;MCBody023 *b=&s->minecraft.player->player.mob.entity.body;
 g30_lx=b->prevX+(b->x-b->prevX)*a;g30_ly=b->prevY+(b->y-b->prevY)*a;g30_lz=b->prevZ+(b->z-b->prevZ)*a;g30_lyaw=b->prevYaw+(b->yaw-b->prevYaw)*a;}
// LevelRenderer::playSound: every MC023_SOUND of the level goes to the SoundEngine.
U0 MC030_WorldEvent(U0 *ctx,MCWorldEvent023 *e){if(e->op==MC023_SOUND)MC030_Play(e->name,e->a,e->b,e->c,e->d,e->e);MC028_WorldEvent(ctx,e);}
// ---- player sounds that the 028 runtime computes outside the ported Entity/Mob code ----
F32 g30_walkDist=0,g30_pmx=0,g30_pmy=0,g30_pmz=0;I32 g30_nextStep=1;Bool g30_wasInWater=FALSE;
U0 MC030_ResetPlayerSounds(){g30_walkDist=0;g30_nextStep=1;g30_wasInWater=FALSE;g30_pmx=0;g30_pmy=0;g30_pmz=0;}
// Entity::playStepSound
U0 MC030_StepSound(MCApp028 *s,I32 x,I32 y,I32 z,I32 id,F32 px,F32 py,F32 pz){if(id<=0 || id>255)return;MCTileDef023 *t=&s->catalog.registry.tiles[id];
 if(Level_getTile(&s->level,x,y+1,z)==78)t=&s->catalog.registry.tiles[78];else if(id>=8 && id<=11)return;
 if(t->stepSound==NULL)return;MC030_Play(t->stepSound,px,py,pz,t->soundVolume*0.25,t->soundPitch);}
// Entity::move step counter (walkDist/nextStep) and Entity::updateInWaterState splash, after the tick moved the player.
U0 MC030_AfterMove(MCApp028 *s){Player *p=&s->minecraft.player->player;Entity *e=&p->mob.entity;MCBody023 *b=&e->body;F32 feet=e->box.minY;
 if(!b->onGround || !s->input.sneaking){F32 dx=b->x-b->prevX,dz=b->z-b->prevZ;g30_walkDist+=sqrtf(dx*dx+dz*dz)*0.6;
  I32 x=floorf(b->x),y=floorf(feet-0.2),z=floorf(b->z),id=Level_getTile(&s->level,x,y,z);
  if(id==0){I32 below=Level_getTile(&s->level,x,y-1,z);if(below==85 || below==107 || below==139)id=below;}
  if(g30_walkDist>g30_nextStep && id>0){g30_nextStep=g30_walkDist;g30_nextStep++;MC030_StepSound(s,x,y,z,id,b->x,feet,b->z);}}
 I32 w=Level_getTile(&s->level,floorf(b->x),floorf(feet+0.1),floorf(b->z));Bool water=w==8 || w==9;
 if(water && !g30_wasInWater){F32 v=sqrtf(g30_pmy*g30_pmy+g30_pmx*g30_pmx*0.2+g30_pmz*g30_pmz*0.2)*0.2;if(v>1.0)v=1.0;MC030_Play("random.splash",b->x,feet,b->z,v,1.0);}
 g30_wasInWater=water;g30_pmx=b->motionX;g30_pmy=b->motionY;g30_pmz=b->motionZ;}
// Mob::causeFallDamage: fall sound, hurt (Mob::hurt plays random.hurt), then the landing step sound.
U0 MC030_CauseFallDamage(MCApp028 *s,I32 damage){Player *p=&s->minecraft.player->player;Entity *e=&p->mob.entity;MCBody023 *b=&e->body;F32 feet=e->box.minY;
 if(damage<=0)return;if(damage<=4)MC030_Play("damage.fallsmall",b->x,feet,b->z,0.75,1.0);else MC030_Play("damage.fallbig",b->x,feet,b->z,0.75,1.0);
 MC033_Hurt(p,NULL,damage,FALSE);
 I32 id=Level_getTile(&s->level,floorf(b->x),floorf(feet-0.2),floorf(b->z));if(id>0 && id<256){MCTileDef023 *t=&s->catalog.registry.tiles[id];
  if(t->stepSound!=NULL)MC030_Play(t->stepSound,b->x,feet,b->z,t->soundVolume*0.5,t->soundPitch*0.75);}}
// TileItem::useOn: placing a tile plays its step sound at (volume+1)/2, pitch*0.8.
U0 MC030_PlaceSound(MCApp028 *s,I32 id,I32 x,I32 y,I32 z){if(id<=0 || id>255)return;MCTileDef023 *t=&s->catalog.registry.tiles[id];
 if(t->stepSound!=NULL)MC030_Play(t->stepSound,x+0.5,y+0.5,z+0.5,(t->soundVolume+1.0)*0.5,t->soundPitch*0.8);}
U0 MC030_SoundClose(){hc030_audio_close();}
// Player::spawnEatParticles "random.eat" + FoodItem::useTimeDepleted "random.burp" (eating is instant in the 028 runtime).
U0 MC030_EatSound(MCApp028 *s){Entity *e=&s->minecraft.player->player.mob.entity;MCBody023 *b=&e->body;F32 loud=0.5;if(Random_genrand_int32(&g30_rng)&1)loud=1.0;
 MC030_Play("random.eat",b->x,e->box.minY,b->z,loud,1.0);MC030_Play("random.burp",b->x,e->box.minY,b->z,0.5,1.0);}
// Level::playSound(Entity*,...): position = entity x, y-heightOffset (feet), z.
U0 MC030_PlayAtPlayer(MCApp028 *s,U8 *name,F32 volume,F32 pitch){Entity *e=&s->minecraft.player->player.mob.entity;MCBody023 *b=&e->body;MC030_Play(name,b->x,e->box.minY,b->z,volume,pitch);}
