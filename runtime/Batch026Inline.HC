Bool App_wantToQuit(App *s){return s->wantsToQuit;}
U0 App_Destroy(App *s){if(s->initialized && s->context.platform)AppPlatform_removeListener(s->context.platform,s);s->initialized=FALSE;}

// util/RandomPos
Bool RandomPos_generateRandomPos(Vec3 *out,MCRandomPos026 *adapter,I32 horizontal,I32 vertical,Vec3 *dir){if(!adapter || !adapter->mob || adapter->walkValue==NULL || horizontal<=0 || vertical<=0 || horizontal>1000000 || vertical>1000000)return FALSE;MCBody023 *b=adapter->mob;F32 best=-99999;I32 xx=0,yy=0,zz=0,k;Bool found=FALSE;U32 width=2*horizontal,height=2*vertical;for(k=0;k<10;k++){I32 dx=Random_genrand_int32(&b->rng)%width-horizontal;U32 ry=Random_genrand_int32(&b->rng);I32 dz=Random_genrand_int32(&b->rng)%width-horizontal;if(dir!=NULL && dz*dir->z+dx*dir->x<0)continue;I32 x=floorf(b->x)(I32)+dx,y=floorf(b->y)(I32)+ry%height-vertical,z=floorf(b->z)(I32)+dz;F32 score=adapter->walkValue(adapter->context,x,y,z);if(score>best){best=score;xx=x;yy=y;zz=z;found=TRUE;}}if(found){out->x=xx;out->y=yy;out->z=zz;}return found;}

// util/ParameterStringify
Bool ParameterStringify_stringify(MCVector *out,MCStringifyArg026 *args,I32 count){if(count<0 || count>4096 || (count>0 && args==NULL))return FALSE;MCVector_Init(out,sizeof(MCString));I32 i;for(i=0;i<count;i++){MCString value;U8 buffer[96];if(args[i].kind==0 && args[i].text)MCString_CopyInit(&value,args[i].text);else{if(args[i].kind==1)sprintf(buffer,"%ld",args[i].integer);else if(args[i].kind==2)sprintf(buffer,"%.6g",args[i].floating);else if(args[i].kind==3){buffer[0]=48+(args[i].integer!=0);buffer[1]=0;}else{MCStringVector_Destroy(out);return FALSE;}MCString_FromC(&value,buffer);}MCVector_Push(out,&value);}return TRUE;}

