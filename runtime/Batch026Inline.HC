// input/UnifiedTurnBuild
F32 UnifiedTurnBuild_smooth(F32 current,F32 target){if(target<=current){if(target<current){F32 down=current-0.04;if(down>1)return 1;if(down>target)return down;}else return current;}else{F32 up=current+0.02;if(up<=target){target=0;if(up>0)return up;}}return target;}
F32 UnifiedTurnBuild_getSpeedSquared(Entity *e){F32 x=e->body.x-e->body.prevX,y=e->body.y-e->body.prevY,z=e->body.z-e->body.prevZ;return y*y+x*x+z*z;}
Bool UnifiedTurnBuild_inside(UnifiedTurnBuild *s,I32 x,I32 y){return RectangleArea_isInside(&s->screen,x,y) && !RectangleArea_isInside(&s->movement,x,y) && !RectangleArea_isInside(&s->hotbar,x,y);}
U0 UnifiedTurnBuild_onConfigChanged(UnifiedTurnBuild *s,I32 w,I32 h){RectangleArea_Init(&s->screen,TRUE,0,0,w,h);F32 x=(s->movement.maxX-s->movement.minX)*0.05+10,y=(s->movement.maxY-s->movement.minY)*0.05+10;s->movement.minX-=x;s->movement.maxX+=x;s->movement.minY-=y;s->movement.maxY+=y;}
U0 UnifiedTurnBuild_getTurnDelta(UnifiedTurnBuild *s,Vec3 *out){I32 i;F32 x=0,y=0,dx=0,dy=0;Bool active=FALSE,first=FALSE;for(i=0;i<s->points.size;i++){MCTouch026 *p=MCVector_At(&s->points,i);if(p->active && p->id>=0 && UnifiedTurnBuild_inside(s,p->x,p->y)){x=p->x(I16)*0.5;y=p->y(I16)*-0.5;first=p->first;active=TRUE;break;}}if(s->wasTouch && !active){s->used=FALSE;s->state=0;}if(!s->wasTouch && active){s->started=s->now;s->distance=0;Bool moving=FALSE;if(s->player)moving=UnifiedTurnBuild_getSpeedSquared(&s->player->mob.entity)>0.01;s->state=1;s->canUse=!moving;s->movingUse=FALSE;/* Caller sets moving-use capability explicitly; no virtual item catalog ABI. */if(moving && s->player && s->canUseMoving!=NULL && s->canUseMoving(s->context,s->player)){s->canUse=TRUE;s->movingUse=TRUE;}s->used=FALSE;s->lastX=x;s->lastY=y;}if(s->mode==2 && active){dx=s->sensitivity*ITurnInput_linearTransform(x-s->lastX,0,1,FALSE);dy=s->sensitivity*ITurnInput_linearTransform(y-s->lastY,0,1,FALSE);F32 d=fabsf(dx)+fabsf(dy);if(d>s->threshold){d=0;dx=dy=0;}s->distance+=d;if(s->state==1 && s->distance>=20)s->state=2;if(s->state==1 && s->now-s->started>=0.4){Bool moving=FALSE;if(s->player)moving=UnifiedTurnBuild_getSpeedSquared(&s->player->mob.entity)>0.01;if(s->movingUse || (s->distance<=20 && !moving)){s->state=3;s->canUse=TRUE;}else s->state=2;}if(first)dx=dy=0;s->lastX=x;s->lastY=y;}else if(s->mode!=2)s->state=0;if(s->holder){if(!s->canUse)s->holder->field_C=-0.05;else if(s->state==1){F32 t=(s->now-s->started)/0.4;s->holder->field_C=t*t;}else if(s->state==3)s->holder->field_C=UnifiedTurnBuild_smooth(s->holder->field_C,1);else s->holder->field_C=UnifiedTurnBuild_smooth(s->holder->field_C,0);}s->wasTouch=active;out->x=dx;out->y=-dy;out->z=0;}
Bool UnifiedTurnBuild_tickBuild(UnifiedTurnBuild *s,Player *player,BuildActionIntention *intent){s->player=player;if(s->state==3){if(s->used && player && player->useItemDuration>0){intent->field_0=18;if(s->movingUse)intent->field_0=16;}else{intent->field_0=20;if(s->movingUse)intent->field_0=16;s->used=TRUE;}s->events.size=0;return TRUE;}I32 i;Bool ret=FALSE;for(i=0;i<s->events.size;i++){MCTouchEvent026 *e=MCVector_At(&s->events,i);if(!e->button || !UnifiedTurnBuild_inside(s,e->x,e->y))continue;I32 state=e->down;if(s->distance>20 || e->down || ret){if(!state)continue;s->pressedAt=s->now;}else{if(s->state<=1){F32 elapsed=s->now-s->pressedAt;if(elapsed>=0 && elapsed<0.25){ret=TRUE;intent->field_0=9;}}state=0;}s->state=state;}s->events.size=0;return ret;}
U0 UnifiedTurnBuild_turnDispatch(ITurnInput *base,Vec3 *out){MCTurnAdapter026 *a=base;UnifiedTurnBuild_getTurnDelta(a->owner,out);}
Bool UnifiedTurnBuild_buildDispatch(IBuildInput *base,U0 *player,BuildActionIntention *intent){MCBuildAdapter026 *a=base;return UnifiedTurnBuild_tickBuild(a->owner,player,intent);}
U0 UnifiedTurnBuild_Init(UnifiedTurnBuild *s,IInputHolder *holder,Options *options,I32 w,I32 h,F64 now){memset(s,0,sizeof(UnifiedTurnBuild));s->turn.owner=s;s->build.owner=s;IConfigListener_Init(&s->turn.base,&IConfigListener_NoConfig,NULL);s->turn.base.turnFn=&UnifiedTurnBuild_turnDispatch;s->turn.base.curTime=-1;IBuildInput_Init(&s->build.base);s->build.base.tickBuildFn=&UnifiedTurnBuild_buildDispatch;s->holder=holder;s->options=options;s->threshold=200;s->sensitivity=1;s->mode=2;s->now=s->started=s->pressedAt=now;MCVector_Init(&s->points,sizeof(MCTouch026));MCVector_Init(&s->events,sizeof(MCTouchEvent026));RectangleArea_Init(&s->movement,TRUE,-1,-1,0,0);RectangleArea_Init(&s->hotbar,TRUE,-1,-1,0,0);UnifiedTurnBuild_onConfigChanged(s,w,h);}
U0 UnifiedTurnBuild_feed(UnifiedTurnBuild *s,MCTouch026 *points,I32 n,MCTouchEvent026 *events,I32 count,F64 now){s->points.size=s->events.size=0;s->now=now;I32 i;for(i=0;i<n;i++)MCVector_Push(&s->points,&points[i]);for(i=0;i<count;i++)MCVector_Push(&s->events,&events[i]);}
U0 UnifiedTurnBuild_Destroy(UnifiedTurnBuild *s){MCVector_Destroy(&s->points);MCVector_Destroy(&s->events);}

// item/MonsterPlacerItem
U0 MonsterPlacerItem_Init(MonsterPlacerItem *s,I32 id,MCSpawnHost026 *host,I32 fence){memset(s,0,sizeof(MonsterPlacerItem));s->base.id=id;s->base.stackedByData=TRUE;s->base.maxStack=64;if(host)s->host=*host;s->fence=fence;}
TextureUVCoordinateSet *MonsterPlacerItem_getIcon(MonsterPlacerItem *s,I32 aux){I32 index=0;if(aux==11)index=1;else if(aux==12)index=2;else if(aux==13)index=3;return &s->icons[index];}
Bool MonsterPlacerItem_spawnMobAt(MonsterPlacerItem *s,Level *level,I32 type,F32 x,F32 y,F32 z){MCSpawnHost026 *h=&s->host;if(h->baseType==NULL || h->create==NULL || h->finalize==NULL || h->discard==NULL)return FALSE;if(h->baseType(h->context,type)!=2)return FALSE;Mob *mob=h->create(h->context,level,type);if(!mob)return FALSE;Entity_moveTo(&mob->entity,x,y,z,Random_nextFloat(&level->world.random)*360,0);if(!h->finalize(h->context,mob,level)){h->discard(h->context,mob);return FALSE;}if(h->ambient!=NULL)h->ambient(h->context,mob);Level_addEntity(level,&mob->entity.body);return TRUE;}
Bool MonsterPlacerItem_useOn(MonsterPlacerItem *s,ItemInstance *item,Player *player,I32 x,I32 y,I32 z,I32 face){if(!player || !item || face<0 || face>5)return FALSE;Level *level=player->mob.entity.level;if(!level->world.isClient){I32 id=Level_getTile(level,x,y,z);I32 dx[6]={0,0,0,0,-1,1},dy[6]={-1,1,0,0,0,0},dz[6]={0,0,-1,1,0,0};F32 offset=0;if(face==1 && id==s->fence)offset=0.5;if(MonsterPlacerItem_spawnMobAt(s,level,item->metadata,x+dx[face]+0.5,y+dy[face]+offset,z+dz[face]+0.5) && !player->abilities.instabuild)item->count--;}return TRUE;}

// rendering/TextureTesselator
U0 TextureTesselator_Init(TextureTesselator *s,TextureData *texture,I32 x,I32 y,I32 xx,I32 yy,Vec3 *light,Color4 *ambient,Color4 *tint){memset(s,0,sizeof(TextureTesselator));s->texture=texture;s->texXMin=x;s->texYMin=y;s->texXMax=xx;s->texYMax=yy;s->light=*light;s->ambient=*ambient;s->tint=*tint;}
F32 MC026_Clamp01(F32 v){if(v<0)return 0;if(v>1)return 1;return v;}
U0 TextureTesselator_addLighting(TextureTesselator *s,Tesselator *t,F32 nx,F32 ny,F32 nz,U8 *pixel,I32 x,I32 y){if(s->lit){F32 k=(s->light.y*ny+s->light.x*nx+s->light.z*nz+1)*0.5;F32 r=MC026_Clamp01(k+s->ambient.r),g=MC026_Clamp01(k+s->ambient.g),b=MC026_Clamp01(k+s->ambient.b);F32 red=((pixel[0]*r)/255)*s->tint.r,green=((pixel[1]*g)/255)*s->tint.g,blue=((pixel[2]*b)/255)*s->tint.b,alpha=(pixel[3](F32)/255)*s->tint.a;Tesselator_color(t,(red*255)(I32),(green*255)(I32),(blue*255)(I32),(alpha*255)(I32));}else{Tesselator_normal(t,nx,ny,nz);if(nx>0)x--;else if(nz>0)y--;t->u=(x+0.5)/s->texture->image.width;t->v=(y+0.5)/s->texture->image.height;}}
U8 *TextureTesselator_pixel(TextureTesselator *s,I32 x,I32 y){I32 w=s->texture->image.width,h=s->texture->image.height;x=(x%w+w)%w;y=(y%h+h)%h;return s->texture->image.pixels+4*(x+w*y);}
U0 MC026_Quad(Tesselator *t,F32 x,F32 y,F32 z,F32 xx,F32 yy,F32 zz,I32 axis,Bool reverse){I32 base=t->vertices.size;if(axis==1){Tesselator_vertex(t,xx,y,z);Tesselator_vertex(t,xx,y,zz);Tesselator_vertex(t,x,y,zz);Tesselator_vertex(t,x,y,z);}else if(axis==2){Tesselator_vertex(t,x,y,z);Tesselator_vertex(t,x,y,zz);Tesselator_vertex(t,x,yy,zz);Tesselator_vertex(t,x,yy,z);}Tesselator_quad(t,base,reverse);}
Bool TextureTesselator_tesselate(TextureTesselator *s,Tesselator *t){if(!s->texture || !s->texture->image.pixels || s->texture->image.width<=0 || s->texture->image.height<=0 || t->drawing || s->texXMax<s->texXMin || s->texYMax<s->texYMin)return FALSE;/* Vertex indices are U16: reject rectangles that could overflow instead of truncating. */I64 area=(s->texXMax-s->texXMin+1)(I64)*(s->texYMax-s->texYMin+1);if(area>1024)return FALSE;s->lit=s->light.x!=0 || s->light.y!=0 || s->light.z!=0;Tesselator_begin(t,4);s->texXMax++;s->texYMax++;I32 x,y;F32 px=0,pz;for(x=s->texXMin;x<s->texXMax;x++){pz=0;for(y=s->texYMin;y<s->texYMax;y++){U8 *p=TextureTesselator_pixel(s,x,y);if(p[3]>9 && x!=s->texYMax){TextureTesselator_addLighting(s,t,0,-1,0,p,(x%s->texture->image.width+s->texture->image.width)%s->texture->image.width,(y%s->texture->image.height+s->texture->image.height)%s->texture->image.height);MC026_Quad(t,px,0,pz,px+1,0,pz+1,1,FALSE);TextureTesselator_addLighting(s,t,0,1,0,p,(x%s->texture->image.width+s->texture->image.width)%s->texture->image.width,(y%s->texture->image.height+s->texture->image.height)%s->texture->image.height);I32 base=t->vertices.size;Tesselator_vertex(t,px,1,pz);Tesselator_vertex(t,px,1,pz+1);Tesselator_vertex(t,px+1,1,pz+1);Tesselator_vertex(t,px+1,1,pz);Tesselator_quad(t,base,FALSE);}pz++;}px++;}/* LABEL_24 resets x before its exit test, so the Z-side loop does run. */I32 endY=s->texYMin;F32 row=0;U8 zero[4]={0,0,0,0};for(y=endY;y<=s->texYMax;y++){Bool previous=TRUE;U8 *last=zero;F32 column=0;for(x=s->texXMin;x<=s->texXMax;x++){U8 *p=TextureTesselator_pixel(s,x,y);Bool empty=TRUE;if(p[3]>9)empty=x==s->texXMax;if(empty!=previous){U8 *color=last;F32 normal=1;if(!empty){normal=-1;color=p;}I32 tx=(x%s->texture->image.width+s->texture->image.width)%s->texture->image.width,ty=(y%s->texture->image.height+s->texture->image.height)%s->texture->image.height;TextureTesselator_addLighting(s,t,normal,0,0,color,tx,ty);MC026_Quad(t,column,0,row,column,1,row+1,2,empty);}column++;previous=empty;last=p;}row++;}F32 column=0;for(x=s->texXMin;x<s->texXMax;x++){Bool previous=TRUE;U8 *last=zero;F32 rowZ=0;for(y=s->texYMin;y<s->texYMax;y++){U8 *p=TextureTesselator_pixel(s,x,y);Bool empty=p[3]<=9;if(empty!=previous){F32 normal=1;U8 *color=last;if(!empty){normal=-1;color=p;}I32 tx=(x%s->texture->image.width+s->texture->image.width)%s->texture->image.width,ty=(y%s->texture->image.height+s->texture->image.height)%s->texture->image.height;TextureTesselator_addLighting(s,t,0,0,normal,color,tx,ty);I32 base=t->vertices.size;Tesselator_vertex(t,column,1,rowZ);Tesselator_vertex(t,column+1,1,rowZ);Tesselator_vertex(t,column+1,0,rowZ);Tesselator_vertex(t,column,0,rowZ);Tesselator_quad(t,base,empty);}rowZ++;previous=empty;last=p;}column++;}Tesselator_end(t);return TRUE;}

// tile/TorchTile
Bool TorchTile_Init(TorchTile *s,MCRegistry023 *r,I32 id,I32 fence,I32 glass,I32 wall){memset(s,0,sizeof(TorchTile));Bool ok=Tile_Init(&s->base,r,id,6,FALSE,FALSE);s->base.ticking=TRUE;s->fence=fence;s->glass=glass;s->wall=wall;r->tiles[id].renderShape=2;return ok;}
Bool TorchTile__canBePlacedOn(TorchTile *s,MCWorld023 *w,I32 x,I32 y,I32 z){I32 id=MC023_Tile(w,x,y,z);return MC023_Solid(w,x,y,z) || (id!=0 && (id==s->fence || id==s->glass || id==s->wall));}
Bool TorchTile_mayPlace(TorchTile *s,MCWorld023 *w,I32 x,I32 y,I32 z){return MC023_Solid(w,x-1,y,z) || MC023_Solid(w,x+1,y,z) || MC023_Solid(w,x,y,z-1) || MC023_Solid(w,x,y,z+1) || TorchTile__canBePlacedOn(s,w,x,y-1,z);}
Bool TorchTile_checkCanSurvive(TorchTile *s,Level *l,I32 x,I32 y,I32 z){if(TorchTile_mayPlace(s,&l->world,x,y,z))return TRUE;if(Level_getTile(l,x,y,z)==s->base.id){Tile_spawnResources(&s->base,l,x,y,z,Level_getData(l,x,y,z),1);Level_setTileAndData(l,x,y,z,0,0,3);}return FALSE;}
I32 TorchTile_getPlacementDataValue(TorchTile *s,MCWorld023 *w,I32 x,I32 y,I32 z,I32 face,I32 old){if(face==1 && TorchTile__canBePlacedOn(s,w,x,y-1,z))return 5;if(face==2 && MC023_Solid(w,x,y,z+1))return 4;if(face==3 && MC023_Solid(w,x,y,z-1))return 3;if(face==4 && MC023_Solid(w,x+1,y,z))return 2;if(face==5 && MC023_Solid(w,x-1,y,z))return 1;return old;}
U0 TorchTile_onPlace(TorchTile *s,Level *l,I32 x,I32 y,I32 z){if(Level_getData(l,x,y,z)==0){I32 value=0;if(MC023_Solid(&l->world,x-1,y,z))value=1;else if(MC023_Solid(&l->world,x+1,y,z))value=2;else if(MC023_Solid(&l->world,x,y,z-1))value=3;else if(MC023_Solid(&l->world,x,y,z+1))value=4;else if(TorchTile__canBePlacedOn(s,&l->world,x,y-1,z))value=5;if(value)Level_setTileAndData(l,x,y,z,s->base.id,value,2);}TorchTile_checkCanSurvive(s,l,x,y,z);}
U0 TorchTile_neighborChanged(TorchTile *s,Level *l,I32 x,I32 y,I32 z){if(!TorchTile_checkCanSurvive(s,l,x,y,z))return;I32 meta=Level_getData(l,x,y,z);Bool bad=FALSE;if(meta==1 && !MC023_Solid(&l->world,x-1,y,z))bad=TRUE;if(meta==2 && !MC023_Solid(&l->world,x+1,y,z))bad=TRUE;if(meta==3 && !MC023_Solid(&l->world,x,y,z-1))bad=TRUE;if(meta==4 && !MC023_Solid(&l->world,x,y,z+1))bad=TRUE;if(meta==5 && !TorchTile__canBePlacedOn(s,&l->world,x,y-1,z))bad=TRUE;if(bad){Tile_spawnResources(&s->base,l,x,y,z,meta,1);Level_setTileAndData(l,x,y,z,0,0,3);}}
U0 TorchTile_tick(TorchTile *s,Level *l,I32 x,I32 y,I32 z){if(Level_getData(l,x,y,z)==0)TorchTile_onPlace(s,l,x,y,z);}
U0 TorchTile_animateTick(TorchTile *s,Level *l,I32 x,I32 y,I32 z){I32 meta=Level_getData(l,x,y,z);F32 xx=x+0.5,yy=y+0.7,zz=z+0.5;if(meta>=1 && meta<=4)yy+=0.22;if(meta==1)xx-=0.27;else if(meta==2)xx+=0.27;else if(meta==3)zz-=0.27;else if(meta==4)zz+=0.27;MC023_Particle(&l->world,s->smokeParticle,xx,yy,zz,0,0,0);MC023_Particle(&l->world,s->flameParticle,xx,yy,zz,0,0,0);}
U0 TorchTile_clipShape(TorchTile *s,I32 meta){meta&=7;if(meta==1)Tile_setShape(&s->base,0,0.2,0.35,0.3,0.8,0.65);else if(meta==2)Tile_setShape(&s->base,0.7,0.2,0.35,1,0.8,0.65);else if(meta==3)Tile_setShape(&s->base,0.35,0.2,0,0.65,0.8,0.3);else if(meta==4)Tile_setShape(&s->base,0.35,0.2,0.7,0.65,0.8,1);else Tile_setShape(&s->base,0.4,0,0.4,0.6,0.6,0.6);}

// tile/LadderTile
Bool LadderTile_Init(LadderTile *s,MCRegistry023 *r,I32 id){Bool ok=Tile_Init(&s->base,r,id,2,TRUE,FALSE);r->tiles[id].renderShape=8;return ok;}
U0 LadderTile_getAABB(LadderTile *s,Level *l,I32 x,I32 y,I32 z,AABB *out){I32 meta=Level_getData(l,x,y,z);if(meta==2)Tile_setShape(&s->base,0,0,0.875,1,1,1);else if(meta==3)Tile_setShape(&s->base,0,0,0,1,1,0.125);else if(meta==4)Tile_setShape(&s->base,0.875,0,0,1,1,1);else if(meta==5)Tile_setShape(&s->base,0,0,0,0.125,1,1);Tile_getAABB(&s->base,x,y,z,out);}
Bool LadderTile_mayPlace(LadderTile *s,MCWorld023 *w,I32 x,I32 y,I32 z){return MC023_Solid(w,x-1,y,z) || MC023_Solid(w,x+1,y,z) || MC023_Solid(w,x,y,z-1) || MC023_Solid(w,x,y,z+1);}
I32 LadderTile_getPlacementDataValue(LadderTile *s,MCWorld023 *w,I32 x,I32 y,I32 z,I32 face,I32 old){I32 v=old;if(!old || face==2){if(MC023_Solid(w,x,y,z+1))v=2;else if(!old)goto L6;}if(face!=3)goto L17;L6:if(!MC023_Solid(w,x,y,z-1)){L17:if(!v)goto L9;goto L8;}v=3;L8:if(face!=4)goto L11;L9:if(MC023_Solid(w,x+1,y,z)){v=4;goto L11;}if(v){L11:if(face!=5)return v;}if(MC023_Solid(w,x-1,y,z))return 5;return v;}
U0 LadderTile_neighborChanged(LadderTile *s,Level *l,I32 x,I32 y,I32 z){I32 meta=Level_getData(l,x,y,z);Bool supported=FALSE;if(meta==2)supported=MC023_Solid(&l->world,x,y,z+1);else if(meta==3)supported=MC023_Solid(&l->world,x,y,z-1);else if(meta==4)supported=MC023_Solid(&l->world,x+1,y,z);else if(meta==5)supported=MC023_Solid(&l->world,x-1,y,z);if(!supported){Tile_spawnResources(&s->base,l,x,y,z,meta,1);Level_setTileAndData(l,x,y,z,0,0,3);}MC023_Event(&l->world,MC023_NEIGHBOR,x,y,z,s->base.id,0,0);}
