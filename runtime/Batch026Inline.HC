// Definitions from ten inline header source paths; no empty cpp files counted.
// App
U0 App_suspendDispatch(U0 *object){App *s=object;if(s->suspended!=NULL)s->suspended(s);}
U0 App_Init(App *s){memset(s,0,sizeof(App));s->listener.object=s;s->listener.suspend=&App_suspendDispatch;}
Bool App_initContext(App *s,AppContext *context){if(s->initialized || !context || !context->platform)return FALSE;s->context=*context;if(s->init!=NULL)s->init(s);s->initialized=TRUE;AppPlatform_addListener(context->platform,&s->listener);return TRUE;}
