
class MCBlockShapes026 {Level *level;LadderTile *ladder;TorchTile *torch;};
Bool MC026_TileBox(MCBlockShapes026 *s,I32 x,I32 y,I32 z,Bool collision,AABB *out){I32 id=Level_getTile(s->level,x,y,z);if(!id)return FALSE;if(s->torch && id==s->torch->base.id){if(collision)return FALSE;TorchTile_clipShape(s->torch,Level_getData(s->level,x,y,z));Tile_getAABB(&s->torch->base,x,y,z,out);return TRUE;}if(s->ladder && id==s->ladder->base.id){LadderTile_getAABB(s->ladder,s->level,x,y,z,out);return TRUE;}if(collision && !s->level->registry->tiles[id].solid)return FALSE;if(s->level->tileObjects[id])Tile_getAABB(s->level->tileObjects[id],x,y,z,out);else AABB_Init(out,x,y,z,x+1,y+1,z+1);return TRUE;}
U0 MC026_GetCubes(MCBlockShapes026 *s,AABB *box,MCVector *out){MCVector_Init(out,sizeof(AABB));I32 x0=floorf(box->minX),x1=floorf(box->maxX+1),y0=floorf(box->minY)-1,y1=floorf(box->maxY+1),z0=floorf(box->minZ),z1=floorf(box->maxZ+1),x,y,z;if(x0<0)x0=0;if(y0<0)y0=0;if(z0<0)z0=0;if(x1>256)x1=256;if(y1>128)y1=128;if(z1>256)z1=256;for(x=x0;x<x1;x++)for(z=z0;z<z1;z++)for(y=y0;y<y1;y++){AABB a;if(MC026_TileBox(s,x,y,z,TRUE,&a) && MC025_Intersects(&a,box))MCVector_Push(out,&a);}}
U0 MC026_ClipMove(MCBlockShapes026 *s,AABB *box,F32 *dx,F32 *dy,F32 *dz){AABB expanded;AABB_expand(box,*dx,*dy,*dz,&expanded);MCVector cubes;MC026_GetCubes(s,&expanded,&cubes);I32 i;for(i=0;i<cubes.size;i++)*dy=AABB_clipYCollide(MCVector_At(&cubes,i),box,*dy);AABB_move(box,0,*dy,0);for(i=0;i<cubes.size;i++)*dx=AABB_clipXCollide(MCVector_At(&cubes,i),box,*dx);AABB_move(box,*dx,0,0);for(i=0;i<cubes.size;i++)*dz=AABB_clipZCollide(MCVector_At(&cubes,i),box,*dz);AABB_move(box,0,0,*dz);MCVector_Destroy(&cubes);}
Bool MC026_ClipTile(MCBlockShapes026 *s,I32 x,I32 y,I32 z,Vec3 *start,Vec3 *end,HitResult *out){AABB box;if(!MC026_TileBox(s,x,y,z,FALSE,&box)){HitResult_Init(out);return FALSE;}AABB_clip(&box,start,end,out);if(out->hitType!=0)return FALSE;out->x=x;out->y=y;out->z=z;return TRUE;}
