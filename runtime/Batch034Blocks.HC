  Entity_moveTo(&p->mob.entity,g32_gx+0.5,b->y,g32_gz+0.5,0,30);b->prevX=b->x;b->prevZ=b->z;s->lightsDirty=TRUE;printf("DEMO032 scene at=%d,%d,%d tes=%d\n",g32_gx,g32_gy,g32_gz,g32_teN);}
