  ItemInstance bm;ItemInstance_Init(&bm,&s->catalog.registry,351,1,15);MC032_UseOn(s,&bm,g32_gx-3,g32_gy+1,g32_gz+9,1);ItemInstance cake;ItemInstance_Init(&cake,&s->catalog.registry,92,1,0);b->health=14;MC032_TileUse(s,g32_gx+1,g32_gy+1,g32_gz+7);printf("DEMO032 hp after cake=%d cake=%d\n",b->health,Level_getData(l,g32_gx+1,g32_gy+1,g32_gz+7));}
