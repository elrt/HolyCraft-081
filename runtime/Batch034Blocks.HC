 else if(id==92){MC028_UV(&v->uv[0],97,0);MC028_UV(&v->uv[1],99,0);for(i=2;i<6;i++)MC028_UV(&v->uv[i],100,0);if(meta>0)MC028_UV(&v->uv[4],98,0);MC32_Set6(b,(1+meta*2)/16.0,0,0.0625,0.9375,0.5,0.9375);MC32_Bounds(v,b);MC32_Faces(s,v,x,y,z,0);}
 MC32_Bounds(v,save);return TRUE;}
// ---- PrimedTnt rendering (TntRenderer: swelling + white flash every 5 ticks) ----
U0 MC32_Quad(TextureUVCoordinateSet *uv,F32 x0,F32 y0,F32 z0,F32 x1,F32 y1,F32 z1,F32 x2,F32 y2,F32 z2,F32 x3,F32 y3,F32 z3){hcgl028_glTexCoord2f(uv->minX,uv->maxY);hcgl028_glVertex3f(x0,y0,z0);hcgl028_glTexCoord2f(uv->maxX,uv->maxY);hcgl028_glVertex3f(x1,y1,z1);hcgl028_glTexCoord2f(uv->maxX,uv->minY);hcgl028_glVertex3f(x2,y2,z2);hcgl028_glTexCoord2f(uv->minX,uv->minY);hcgl028_glVertex3f(x3,y3,z3);}
U0 MC32_Cube(TextureUVCoordinateSet *side,TextureUVCoordinateSet *top,TextureUVCoordinateSet *bot,F32 l,F32 tb){F32 a=-0.5,b=0.5;hcgl028_glBegin(7);
 hcgl028_glColor4f(l*0.8,l*0.8,l*0.8,tb);MC32_Quad(side,a,0,a,b,0,a,b,1,a,a,1,a);MC32_Quad(side,b,0,b,a,0,b,a,1,b,b,1,b);hcgl028_glColor4f(l*0.6,l*0.6,l*0.6,tb);MC32_Quad(side,a,0,b,a,0,a,a,1,a,a,1,b);MC32_Quad(side,b,0,a,b,0,b,b,1,b,b,1,a);
 hcgl028_glColor4f(l,l,l,tb);MC32_Quad(top,a,1,a,b,1,a,b,1,b,a,1,b);hcgl028_glColor4f(l*0.5,l*0.5,l*0.5,tb);MC32_Quad(bot,a,0,b,b,0,b,b,0,a,a,0,a);hcgl028_glEnd();}
U0 MC032_Render(MCApp028 *s,F32 partial){if(!g32_tntN)return;TextureUVCoordinateSet side,top,bot;MC028_UV(&side,15,0);MC028_UV(&top,15,1);MC028_UV(&bot,15,2);I32 i;hcgl028_glEnable(0xDE1);hcgl028_glBindTexture(0xDE1,s->terrainTex);
 for(i=0;i<g32_tntN;i++){MC32Tnt *t=&g32_tnt[i];F32 x=t->px+(t->x-t->px)*partial,y=t->py+(t->y-t->py)*partial,z=t->pz+(t->z-t->pz)*partial,l=MC028_Brightness(s,floorf(x),floorf(y+0.5),floorf(z));hcgl028_glPushMatrix();hcgl028_glTranslatef(x,y,z);
  F32 f=t->fuse-partial+1;if(f<10){F32 k=1-f/10;if(k<0)k=0;if(k>1)k=1;k=k*k;k=k*k;F32 sc=1+k*0.3;hcgl028_glScalef(sc,sc,sc);}
  MC32_Cube(&side,&top,&bot,l,1);
  if(((t->fuse/5)&1)==0){hcgl028_glDisable(0xDE1);hcgl028_glEnable(0xBE2);hcgl028_glBlendFunc(0x302,0x304);F32 al=(1-f/100)*0.8;hcgl028_glDepthFunc(0x203);hcgl028_glColor4f(1,1,1,al);MC32_Cube(&side,&top,&bot,1,al);hcgl028_glBlendFunc(0x302,0x303);hcgl028_glDisable(0xBE2);hcgl028_glEnable(0xDE1);}
  hcgl028_glPopMatrix();}hcgl028_glColor4f(1,1,1,1);}
// ---- tiles032.dat (magic 'M23D', v1): kind,x,y,z,burn,burnDur,cook,0 + 27 x (id,count,aux) ----
#define MC32_REC 356
Bool MC032_SaveTiles(MCApp028 *s,U8 *stage){I32 n=0,i,j,k=0;for(i=0;i<g32_teN;i++){I32 id=Level_getTile(&s->level,g32_te[i]->x,g32_te[i]->y,g32_te[i]->z);if((g32_te[i]->kind==1 && id==54) || (g32_te[i]->kind==2 && (id==61 || id==62)))n++;}
 I32 size=16+n*MC32_REC;U8 *buf=MC_Alloc(size);memset(buf,0,size);I32 *h=buf(I32*);h[0]=0x4433324D;h[1]=1;h[2]=n;
 for(i=0;i<g32_teN;i++){MC32TE *t=g32_te[i];I32 id=Level_getTile(&s->level,t->x,t->y,t->z);if(!((t->kind==1 && id==54) || (t->kind==2 && (id==61 || id==62))))continue;I32 *w=(buf+16+k*MC32_REC)(I32*);w[0]=t->kind;w[1]=t->x;w[2]=t->y;w[3]=t->z;w[4]=t->burn;w[5]=t->burnDur;w[6]=t->cook;
  for(j=0;j<MC32_SLOTS;j++){ItemInstance *it=t->it[j];if(!MC029_ValidItem(it))continue;w[8+j*3]=ItemInstance_getId(it);w[9+j*3]=it->count;w[10+j*3]=it->metadata;}k++;}
 h[3]=MC028_Hash(buf,size);MCString path;MCString_FromC(&path,stage);MC025_Append(&path,"/tiles032.dat");U0 *file=fopen(path.data,"wb");Bool ok=FALSE;if(file){ok=fwrite(buf,1,size,file)==size;if(fclose(file))ok=FALSE;}MCString_Destroy(&path);free(buf);return ok;}
I32 MC32_LoadTiles(MCApp028 *s){MCString path;MCString_FromC(&path,s->activePath);MC025_Append(&path,"/tiles032.dat");U0 *file=fopen(path.data,"rb");MCString_Destroy(&path);if(!file)return 0;
 if(fseek(file,0,2)){fclose(file);return -1;}I64 size=ftell(file);if(size<16 || size>16+MC32_MAXTE*MC32_REC){fclose(file);return -1;}rewind(file);U8 *buf=MC_Alloc(size);Bool ok=fread(buf,1,size,file)==size;fclose(file);if(!ok){free(buf);return -1;}
 I32 *h=buf(I32*);if(h[0]!=0x4433324D || h[1]!=1 || h[2]<0 || h[2]>MC32_MAXTE || size!=16+h[2]*MC32_REC){free(buf);return -1;}U32 expected=h[3];h[3]=0;if(MC028_Hash(buf,size)!=expected){free(buf);return -1;}
 I32 i,j,n=h[2];for(i=0;i<n;i++){I32 *w=(buf+16+i*MC32_REC)(I32*);if(w[0]<1 || w[0]>2 || !Level_InBounds(w[1],w[2],w[3]) || w[4]<0 || w[4]>20000 || w[5]<0 || w[5]>20000 || w[6]<0 || w[6]>199){free(buf);MC032_Clear();return -1;}
  MC32TE *t=MC32_Get(w[0],w[1],w[2],w[3]);if(!t)break;t->burn=w[4];t->burnDur=w[5];t->cook=w[6];
  for(j=0;j<MC32_SLOTS;j++){I32 id=w[8+j*3],c=w[9+j*3],a=w[10+j*3];if(!id)continue;if(id<1 || id>511 || !s->catalog.itemExists[id] || c<1 || c>64 || a<0 || a>32767){free(buf);MC032_Clear();return -1;}t->it[j]=MC32_Item(s,id,c,a);}}
 free(buf);return 1;}
U0 MC32_Demo(MCApp028 *s);
Bool MC032_Start(MCApp028 *s,I32 active){MC032_Clear();g32_app=s;g032_box.f=&MC32_BoxHook;s->catalog.texIndex[96]=63;g32_smelted=0;g32_explosions=0;g32_primed=0;g32_grown=0;
 if(active==1){I32 r=MC32_LoadTiles(s);if(r<0)return FALSE;if(r==1)printf("TILES032 loaded=%d\n",g32_teN);}MC32_Demo(s);return TRUE;}
