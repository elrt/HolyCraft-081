MCApp028 *g32_app;
class MC32Tnt {F32 x,y,z,px,py,pz,mx,my,mz;I32 fuse;};
#define MC32_MAXTNT 96
MC32Tnt g32_tnt[MC32_MAXTNT];I32 g32_tntN;
I32 g32_demo,g32_randomTicks,g32_grown;
F32 MC32_R(){return Random_nextFloat(&g31_rng);}
I32 MC32_RI(I32 n){if(n<=1)return 0;I32 v=Random_genrand_int32(&g32_app->level.world.random)&0x7FFFFFFF;return v%n;}
Player *MC32_P(MCApp028 *s){return &s->minecraft.player->player;}
// ---- tile entities ----
MC32TE *MC32_Find(I32 x,I32 y,I32 z){I32 i;for(i=0;i<g32_teN;i++){MC32TE *t=g32_te[i];if(t->x==x && t->y==y && t->z==z)return t;}return NULL;}
MC32TE *MC32_Get(I32 kind,I32 x,I32 y,I32 z){MC32TE *t=MC32_Find(x,y,z);if(t){if(t->kind==kind)return t;t->kind=kind;return t;}if(g32_teN>=MC32_MAXTE)return NULL;t=MC_Alloc(sizeof(MC32TE));memset(t,0,sizeof(MC32TE));t->kind=kind;t->x=x;t->y=y;t->z=z;g32_te[g32_teN++]=t;return t;}
U0 MC32_FreeTE(MC32TE *t){I32 i,j;for(i=0;i<MC32_SLOTS;i++)if(t->it[i])free(t->it[i]);if(g32_open==t || g32_pair==t){g32_open=NULL;g32_pair=NULL;}for(i=0;i<g32_teN;i++)if(g32_te[i]==t){for(j=i;j+1<g32_teN;j++)g32_te[j]=g32_te[j+1];g32_teN--;break;}free(t);}
U0 MC32_Spill(MCApp028 *s,MC32TE *t){I32 i;for(i=0;i<MC32_SLOTS;i++){ItemInstance *it=t->it[i];if(!MC029_ValidItem(it))continue;MC027_DropAt(&s->level,t->x,t->y,t->z,ItemInstance_getId(it),it->count,it->metadata);ItemInstance_setNull(it);}}
U0 MC032_Clear(){while(g32_teN>0)MC32_FreeTE(g32_te[g32_teN-1]);g32_open=NULL;g32_pair=NULL;g32_tntN=0;g32_openReq=FALSE;}
I32 MC32_Dir(MCApp028 *s){F32 yaw=MC32_P(s)->mob.entity.body.yaw;I32 d=floorf(yaw*4/360+0.5);return d&3;}
Bool MC32_Air(MCApp028 *s,I32 x,I32 y,I32 z){if(!Level_InBounds(x,y,z))return FALSE;I32 t=Level_getTile(&s->level,x,y,z);return !t || t==31 || t==32 || t==78 || t==51;}
Bool MC32_Solid(MCApp028 *s,I32 x,I32 y,I32 z){if(!Level_InBounds(x,y,z))return FALSE;I32 t=Level_getTile(&s->level,x,y,z);return t>0 && s->catalog.registry.tiles[t].solid && s->catalog.registry.tiles[t].cube;}
U0 MC32_Use1(MCApp028 *s,ItemInstance *item){if(s->creative)return;item->count--;if(item->count<=0)ItemInstance_setNull(item);}
// ---- shapes (DoorTile::updateShape, TrapDoorTile::_setShape, FenceGateTile, CakeTile, BedTile) ----
I32 MC32_DoorData(MCApp028 *s,I32 x,I32 y,I32 z){Level *l=&s->level;I32 d=Level_getData(l,x,y,z),up=(d>>3)&1,lo,hi;if(up){lo=Level_getData(l,x,y-1,z);hi=d;}else{lo=d;hi=Level_getData(l,x,y+1,z);}I32 c=(lo&7)|(up<<3);if(hi&1)c|=16;return c;}
U0 MC32_Set6(F32 *b,F32 a,F32 c,F32 d,F32 e,F32 f,F32 g){b[0]=a;b[1]=c;b[2]=d;b[3]=e;b[4]=f;b[5]=g;}
U0 MC32_DoorBox(I32 c,F32 *b){F32 r=0.1875;I32 dir=c&3,side;Bool open=(c&4)!=0,hinge=(c&16)!=0;MC32_Set6(b,0,0,0,1,1,1);
 if(dir==0){if(open){side=0;if(hinge)side=1;}else side=2;}else if(dir==1){if(open){side=3;if(hinge)side=2;}else side=0;}else if(dir==2){if(open){side=1;if(hinge)side=0;}else side=3;}else{if(open){side=2;if(hinge)side=3;}else side=1;}
 if(side==0)b[5]=r;if(side==1)b[2]=1-r;if(side==2)b[3]=r;if(side==3)b[0]=1-r;}
U0 MC32_TrapBox(I32 m,F32 *b){MC32_Set6(b,0,0,0,1,0.1875,1);if(m&4){I32 d=m&3;if(d==0)MC32_Set6(b,0,0,0.8125,1,1,1);if(d==1)MC32_Set6(b,0,0,0,1,1,0.1875);if(d==2)MC32_Set6(b,0.8125,0,0,1,1,1);if(d==3)MC32_Set6(b,0,0,0,0.1875,1,1);}}
// local shape; returns 0 = not ours, 1 = box, 2 = no collision box
I32 MC32_Shape(MCApp028 *s,I32 id,I32 x,I32 y,I32 z,Bool collision,F32 *b){I32 m;I32 r34=MC034_Shape(s,id,x,y,z,collision,b);if(r34)return r34;
 if(id==64 || id==71){MC32_DoorBox(MC32_DoorData(s,x,y,z),b);return 1;}
 if(id==96){MC32_TrapBox(Level_getData(&s->level,x,y,z),b);return 1;}
 if(id==107){m=Level_getData(&s->level,x,y,z);if(collision && (m&4))return 2;F32 h=1;if(collision)h=1.5;if((m&3)==0 || (m&3)==2)MC32_Set6(b,0,0,0.375,1,h,0.625);else MC32_Set6(b,0.375,0,0,0.625,h,1);return 1;}
 if(id==92){m=Level_getData(&s->level,x,y,z);MC32_Set6(b,(1+m*2)/16.0,0,0.0625,0.9375,0.5,0.9375);return 1;}
 return 0;}
I32 MC32_BoxHook(U0 *lvl,I32 id,I32 x,I32 y,I32 z,Bool collision,AABB *out){if(!g32_app || &g32_app->level!=lvl)return 0;F32 b[6];I32 r=MC32_Shape(g32_app,id,x,y,z,collision,b);if(r==1)AABB_Init(out,x+b[0],y+b[1],z+b[2],x+b[3],y+b[4],z+b[5]);return r;}
Bool MC032_Box(MCApp028 *s,I32 id,I32 x,I32 y,I32 z,Bool collision,AABB *out){F32 b[6];if(MC32_Shape(s,id,x,y,z,collision,b)!=1)return FALSE;AABB_Init(out,x+b[0],y+b[1],z+b[2],x+b[3],y+b[4],z+b[5]);return TRUE;}
// ---- placement ----
I32 MC032_Placed(MCApp028 *s,I32 id,I32 meta,I32 face){I32 d=MC32_Dir(s),fm[4]={2,5,3,4};if(id==54 || id==61 || id==62)return fm[d];if(id==107)return d;return meta;}
I32 MC32_ChestsNear(MCApp028 *s,I32 x,I32 y,I32 z){I32 n=0;if(Level_getTile(&s->level,x-1,y,z)==54)n++;if(Level_getTile(&s->level,x+1,y,z)==54)n++;if(Level_getTile(&s->level,x,y,z-1)==54)n++;if(Level_getTile(&s->level,x,y,z+1)==54)n++;return n;}
Bool MC32_PlaceTile(MCApp028 *s,ItemInstance *item,I32 x,I32 y,I32 z,I32 tile,I32 meta){if(!Level_setTileAndData(&s->level,x,y,z,tile,meta,3))return FALSE;MC030_PlaceSound(s,tile,x,y,z);MC32_Use1(s,item);s->unsaved=TRUE;printf("ACTION032 place id=%d meta=%d at=%d,%d,%d\n",tile,meta,x,y,z);return TRUE;}
I32 MC32_Door(MCApp028 *s,ItemInstance *item,I32 x,I32 y,I32 z,I32 face,I32 tile){if(face!=1)return 0;y++;if(!MC32_Air(s,x,y,z) || !MC32_Air(s,x,y+1,z) || !MC32_Solid(s,x,y-1,z))return 0;
 F32 yaw=MC32_P(s)->mob.entity.body.yaw;I32 dir=floorf((yaw+180)*4/360-0.5);dir&=3;I32 xra=0,zra=0;if(dir==0)zra=1;if(dir==1)xra=-1;if(dir==2)zra=-1;if(dir==3)xra=1;
 I32 sl=MC32_Solid(s,x-xra,y,z-zra)+MC32_Solid(s,x-xra,y+1,z-zra),sr=MC32_Solid(s,x+xra,y,z+zra)+MC32_Solid(s,x+xra,y+1,z+zra);Level *l=&s->level;
 Bool dl=Level_getTile(l,x-xra,y,z-zra)==tile || Level_getTile(l,x-xra,y+1,z-zra)==tile,dr=Level_getTile(l,x+xra,y,z+zra)==tile || Level_getTile(l,x+xra,y+1,z+zra)==tile,flip=FALSE;if(dl && !dr)flip=TRUE;else if(sr>sl)flip=TRUE;
 I32 up=8;if(flip)up=9;Level_setTileAndData(l,x,y,z,tile,dir,3);Level_setTileAndData(l,x,y+1,z,tile,up,3);MC028_Dirty(s,x,y,z);MC030_PlaceSound(s,tile,x,y,z);MC32_Use1(s,item);s->unsaved=TRUE;printf("ACTION032 door id=%d dir=%d flip=%d at=%d,%d,%d\n",tile,dir,flip,x,y,z);return 1;}
I32 MC32_Bed(MCApp028 *s,ItemInstance *item,I32 x,I32 y,I32 z,I32 face){if(face!=1)return 0;y++;I32 dir=MC32_Dir(s),hx=x,hz=z;if(dir==0)hz++;if(dir==1)hx--;if(dir==2)hz--;if(dir==3)hx++;
 if(!MC32_Air(s,x,y,z) || !MC32_Air(s,hx,y,hz) || !MC32_Solid(s,x,y-1,z) || !MC32_Solid(s,hx,y-1,hz))return 0;Level_setTileAndData(&s->level,x,y,z,26,dir,3);Level_setTileAndData(&s->level,hx,y,hz,26,dir|8,3);MC030_PlaceSound(s,26,x,y,z);MC32_Use1(s,item);s->unsaved=TRUE;printf("ACTION032 bed dir=%d at=%d,%d,%d\n",dir,x,y,z);return 1;}
// generic "place next to the clicked face" used by cake / reeds / trapdoor
Bool MC32_Next(MCApp028 *s,I32 *x,I32 *y,I32 *z,I32 face){I32 dx[6]={0,0,0,0,-1,1},dy[6]={-1,1,0,0,0,0},dz[6]={0,0,-1,1,0,0};if(face<0 || face>5)return FALSE;I32 t=Level_getTile(&s->level,*x,*y,*z);if(t!=31 && t!=32 && t!=78){*x+=dx[face];*y+=dy[face];*z+=dz[face];}return MC32_Air(s,*x,*y,*z) && *y>0;}
// Batch035 planting and tree growth.
Bool MC35_Crop(I32 id){return id==59 || id==141 || id==142 || id==244 || id==104 || id==105;}
Bool MC35_Tree(MCApp028 *s,I32 x,I32 y,I32 z,I32 meta){Level *l=&s->level;Random *r=&l->world.random;Bool ok=FALSE;Level_setTileAndData(l,x,y,z,0,0,3);
 if((meta&3)==1){SpruceFeature f;SpruceFeature_Init(&f,TRUE);ok=SpruceFeature_place(&f,&s->features,r,x,y,z);}
 else if((meta&3)==2){BirchFeature f;BirchFeature_Init(&f,TRUE);ok=BirchFeature_place(&f,&s->features,r,x,y,z);}
 else{TreeFeature f;TreeFeature_Init(&f,TRUE,0);ok=TreeFeature_place(&f,&s->features,r,x,y,z);}
 if(!ok)Level_setTileAndData(l,x,y,z,6,meta,3);return ok;}
I32 MC032_UseOn(MCApp028 *s,ItemInstance *item,I32 x,I32 y,I32 z,I32 face){g32_app=s;I32 id=ItemInstance_getId(item),target=Level_getTile(&s->level,x,y,z);Level *l=&s->level;
 if(id>=290 && id<=294){if(face==0 || Level_getTile(l,x,y+1,z) || (target!=2 && target!=3))return 0;Level_setTileAndData(l,x,y,z,60,0,3);MC030_Play("step.gravel",x+0.5,y+0.5,z+0.5,0.5,0.8);if(!s->creative){Player *hp=MC32_P(s);ItemInstance_hurtAndBreak(item,1,&hp->view);}s->unsaved=TRUE;printf("ACTION032 till at=%d,%d,%d\n",x,y,z);return 1;}
 if(id==295){if(face!=1 || target!=60 || !MC32_Air(s,x,y+1,z))return 0;return MC32_PlaceTile(s,item,x,y+1,z,59,0);}
 if(id==391 || id==392 || id==458 || id==361 || id==362){if(face!=1 || target!=60 || !MC32_Air(s,x,y+1,z))return 0;I32 tile=141;if(id==392)tile=142;if(id==458)tile=244;if(id==361)tile=104;if(id==362)tile=105;return MC32_PlaceTile(s,item,x,y+1,z,tile,0);}
 if(id==351 && item->metadata==15 && target!=59){I32 m=Level_getData(l,x,y,z);Bool did=FALSE;if(target==6)did=MC35_Tree(s,x,y,z,m);else if(MC35_Crop(target) && m<7){Level_setTileAndData(l,x,y,z,target,7,3);did=TRUE;}else if(target==2 && !Level_getTile(l,x,y+1,z)){I32 k,j,px,py,pz;for(k=0;k<64;k++){px=x;py=y+1;pz=z;for(j=0;j<k/16;j++){px+=MC32_RI(3)-1;py+=(MC32_RI(3)-1)*MC32_RI(3)/2;pz+=MC32_RI(3)-1;}if(Level_getTile(l,px,py-1,pz)==2 && !Level_getTile(l,px,py,pz)){I32 plant=31,meta=1;if(MC32_RI(8)==0){plant=37;meta=0;if(MC32_RI(2))plant=38;}Level_setTileAndData(l,px,py,pz,plant,meta,3);did=TRUE;}}}if(did){I32 q;for(q=0;q<8;q++)MC31_Particle(2,x+MC32_R(),y+MC32_R()*0.5+0.3,z+MC32_R(),0,0,0);MC32_Use1(s,item);s->unsaved=TRUE;return 1;}return 0;}

 if(id==351 && item->metadata==15){if(target==59 && Level_getData(l,x,y,z)<7){Level_setTileAndData(l,x,y,z,59,7,3);I32 i;for(i=0;i<8;i++)MC31_Particle(2,x+MC32_R(),y+MC32_R()*0.5+0.3,z+MC32_R(),0,0,0);MC32_Use1(s,item);s->unsaved=TRUE;printf("ACTION032 bonemeal crops at=%d,%d,%d\n",x,y,z);return 1;}return 0;}
 if(id==324 || id==64)return MC32_Door(s,item,x,y,z,face,64);if(id==330 || id==71)return MC32_Door(s,item,x,y,z,face,71);
 if(id==355 || id==26)return MC32_Bed(s,item,x,y,z,face);
 if(id==354 || id==92){if(!MC32_Next(s,&x,&y,&z,face) || !MC32_Solid(s,x,y-1,z))return 0;return MC32_PlaceTile(s,item,x,y,z,92,0);}
 if(id==338 || id==83){if(!MC32_Next(s,&x,&y,&z,face))return 0;I32 b=Level_getTile(l,x,y-1,z);if(b!=83){if(b!=2 && b!=3 && b!=12)return 0;I32 w1=Level_getTile(l,x-1,y-1,z),w2=Level_getTile(l,x+1,y-1,z),w3=Level_getTile(l,x,y-1,z-1),w4=Level_getTile(l,x,y-1,z+1);if(!(w1==8 || w1==9 || w2==8 || w2==9 || w3==8 || w3==9 || w4==8 || w4==9))return 0;}return MC32_PlaceTile(s,item,x,y,z,83,0);}
 if(id==96){if(face<2 || !MC32_Solid(s,x,y,z))return 0;if(!MC32_Next(s,&x,&y,&z,face))return 0;I32 fm[6]={0,0,0,1,2,3};return MC32_PlaceTile(s,item,x,y,z,96,fm[face]);}
 if(id==54){I32 px=x,py=y,pz=z;if(!MC32_Next(s,&px,&py,&pz,face))return -1;I32 n=MC32_ChestsNear(s,px,py,pz);if(n>1)return 0;if(n==1){I32 k,ox[4]={-1,1,0,0},oz[4]={0,0,-1,1};for(k=0;k<4;k++)if(Level_getTile(l,px+ox[k],py,pz+oz[k])==54 && MC32_ChestsNear(s,px+ox[k],py,pz+oz[k])>0)return 0;}return -1;}
 {I32 r34=MC034_UseOn(s,item,x,y,z,face);if(r34>=0)return r34;}
 return -1;}
// ---- use (Tile::use) ----
U0 MC32_DoorSound(MCApp028 *s,I32 x,I32 y,I32 z,Bool open){if(open)MC030_Play("random.door_open",x+0.5,y+0.5,z+0.5,1.0,Random_nextFloat(&g30_rng)*0.1+0.9);else MC030_Play("random.door_close",x+0.5,y+0.5,z+0.5,1.0,Random_nextFloat(&g30_rng)*0.1+0.9);}
Bool MC032_TileUse(MCApp028 *s,I32 x,I32 y,I32 z){g32_app=s;Level *l=&s->level;I32 id=Level_getTile(l,x,y,z),m=Level_getData(l,x,y,z);
 if(id==54)return MC033_ChestUse(s,x,y,z);
 if(id==61 || id==62){MC32TE *t=MC32_Get(2,x,y,z);if(!t)return TRUE;g32_open=t;g32_pair=NULL;g32_openReq=TRUE;return TRUE;}
 if(id==64){I32 c=MC32_DoorData(s,x,y,z);I32 ly=y;if(c&8)ly=y-1;Level_setTileAndData(l,x,ly,z,64,(c&7)^4,3);MC028_Dirty(s,x,ly,z);MC028_Dirty(s,x,ly+1,z);MC32_DoorSound(s,x,y,z,((c&4)==0));s->unsaved=TRUE;printf("ACTION032 door open=%d at=%d,%d,%d\n",((c&4)==0),x,ly,z);return TRUE;}
 if(id==71)return TRUE;
 if(id==96){Level_setTileAndData(l,x,y,z,96,m^4,3);MC32_DoorSound(s,x,y,z,((m&4)==0));s->unsaved=TRUE;printf("ACTION032 trapdoor open=%d\n",((m&4)==0));return TRUE;}
 if(id==107){if(m&4)m&=~4;else{I32 d=MC32_Dir(s);if((m&3)==((d+2)&3))m=d;m|=4;}Level_setTileAndData(l,x,y,z,107,m,3);MC32_DoorSound(s,x,y,z,(m&4)!=0);s->unsaved=TRUE;printf("ACTION032 gate open=%d\n",(m&4)!=0);return TRUE;}
 if(id==26)return MC033_BedUse(s,x,y,z,m);
 if(id==92){Player *p=MC32_P(s);if(p->mob.entity.body.health>=20 && !s->creative)return TRUE;p->mob.entity.body.health+=2;if(p->mob.entity.body.health>20)p->mob.entity.body.health=20;MC030_EatSound(s);m++;if(m>=6)Level_setTileAndData(l,x,y,z,0,0,3);else Level_setTileAndData(l,x,y,z,92,m,3);s->unsaved=TRUE;printf("ACTION032 cake bites=%d\n",m);return TRUE;}
 return FALSE;}
// ---- TNT / Explosion ----
U0 MC32_Prime(MCApp028 *s,F32 x,F32 y,F32 z,I32 fuse){if(g32_tntN>=MC32_MAXTNT)return;MC32Tnt *t=&g32_tnt[g32_tntN++];F32 a=MC32_R()*3.14159265*2;t->x=x;t->y=y;t->z=z;t->px=x;t->py=y;t->pz=z;t->mx=-sin(a)*0.02;t->my=0.2;t->mz=-cos(a)*0.02;t->fuse=fuse;g32_primed++;}
Bool MC032_UseHeld(MCApp028 *s,ItemInstance *held,I32 tile,I32 x,I32 y,I32 z){g32_app=s;if(ItemInstance_getId(held)!=259 || tile!=46)return FALSE;Level_setTileAndData(&s->level,x,y,z,0,0,3);MC32_Prime(s,x+0.5,y,z+0.5,80);MC030_Play("random.fuse",x+0.5,y+0.5,z+0.5,1.0,1.0);if(!s->creative){Player *hp=MC32_P(s);ItemInstance_hurtAndBreak(held,1,&hp->view);}s->unsaved=TRUE;printf("ACTION032 tnt primed at=%d,%d,%d\n",x,y,z);return TRUE;}
F32 MC32_Resist(MCApp028 *s,I32 id){if(id==7 || id==95)return 1.0e9;if(id>=8 && id<=11)return 100;if(id==49)return 1200;if(id==1 || id==4 || id==45 || id==48 || id==98 || id==43 || id==44 || id==67 || id==108 || id==109 || id==41 || id==42 || id==57 || id==139 || id==155)return 6;F32 h=s->catalog.tiles[id].hardness;if(h<0)return 1.0e9;return h;}
U0 MC32_Explode(MCApp028 *s,F32 cx,F32 cy,F32 cz,F32 r){U8 mark[4096];memset(mark,0,4096);I32 ox=floorf(cx)-8,oy=floorf(cy)-8,oz=floorf(cz)-8,i,j,k,n=0;
 for(i=0;i<16;i++)for(j=0;j<16;j++)for(k=0;k<16;k++){if(i!=0 && i!=15 && j!=0 && j!=15 && k!=0 && k!=15)continue;F32 dx=i/15.0*2-1,dy=j/15.0*2-1,dz=k/15.0*2-1,d=sqrt(dx*dx+dy*dy+dz*dz);dx/=d;dy/=d;dz/=d;F32 power=r*(0.7+MC32_R()*0.6),x=cx,y=cy,z=cz;
  while(power>0){I32 bx=floorf(x),by=floorf(y),bz=floorf(z);I32 id=Level_getTile(&s->level,bx,by,bz);if(id>0)power-=(MC32_Resist(s,id)+0.3)*0.3;if(power>0 && id>0){I32 a=bx-ox,b=by-oy,c=bz-oz;if(a>=0 && a<16 && b>=0 && b<16 && c>=0 && c<16)mark[a+b*16+c*256]=1;}x+=dx*0.3;y+=dy*0.3;z+=dz*0.3;power-=0.3*0.75;}}
 // entities (Explosion::explode: damage = (impact^2+impact)/2*8*2r+1, seen fraction treated as 1)
