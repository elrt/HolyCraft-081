Bool MC029_AutoWorld(MCApp028 *s,U8 *dir,I32 seed,Bool seedSet,Bool creative){U8 path[512],act[4096];snprintf(path,512,"worlds/%s",dir);
 if(hc028_active(path,act,4096)>=1){LevelData ld;LevelData_Init(&ld);Bool ok=ExternalFileLevelStorage_readLevelData(act,&ld);I32 sd=ld.seed,gt=ld.gameType;LevelData_Destroy(&ld);if(!ok){MC029_Status("Invalid level.dat");return FALSE;}return MC029_OpenWorld(s,dir,sd,gt==1);}
 if(!seedSet)seed=getEpochTimeS();if(!MC029_OpenWorld(s,dir,seed,creative))return FALSE;MC024_SetString(&s->level.data.levelName,dir);s->level.data.gameType=creative;if(!MC028_Save(s))MC029_Status(s->notice);return TRUE;}

// ---- requests raised by screens / HUD / tiles, then the pending setScreen ----
U0 MC029_Requests(MCApp028 *s){Bool game=s->worldReady && !s->failed;
 if(g29_invRequest){g29_invRequest=FALSE;if(g29_screen!=G29S_NONE)MC029_Go(G29S_NONE);else if(game)MC029_OpenInventory(s);}
 if(g29_chatRequest){g29_chatRequest=FALSE;if(game && g29_screen==G29S_NONE){g29_chatPrefill[0]=0;MC030_PlayUI("random.click",1.0,1.0);MC029_Go(G29S_CHAT);}}
 if(g29_workbenchOpen){g29_workbenchOpen=FALSE;if(game && g29_screen==G29S_NONE){g29_craftSize=1;g29_craftStone=FALSE;MC029_Go(G29S_CRAFT);}}
 if(g29_stonecutterOpen){g29_stonecutterOpen=FALSE;if(game && g29_screen==G29S_NONE){g29_craftSize=1;g29_craftStone=TRUE;MC029_Go(G29S_CRAFT);}}
 if(g32_openReq){g32_openReq=FALSE;if(game && g29_screen==G29S_NONE && g32_open){if(g32_open->kind==1)MC029_Go(G32S_CHEST);else MC029_Go(G32S_FURNACE);}else{g32_open=NULL;g32_pair=NULL;}}
 if(game && g29_screen==G29S_NONE && g29_pending<0){MCBody023 *b=&s->minecraft.player->player.mob.entity.body;if(b->dead || b->health<=0)MC029_Go(G29S_DEATH);}
 if(g29_reqLoad>=0){I32 i=g29_reqLoad;g29_reqLoad=-1;if(i<g29_worldN)MC029_OpenWorld(s,g29_world[i].dir,g29_world[i].seed,g29_world[i].gameType==1);}
 if(g29_reqCreate){g29_reqCreate=FALSE;MC029_CreateWorld(s);}
 if(g29_reqDelete){g29_reqDelete=FALSE;MC029_DeleteWorld(s);}
 if(g29_reqRespawn){g29_reqRespawn=FALSE;if(s->worldReady)MC028_Respawn(s);if(!g29_reqQuitTitle)MC029_Go(G29S_NONE);}
 if(g29_reqQuitTitle){g29_reqQuitTitle=FALSE;MC029_CloseWorld(s,TRUE);MC029_Go(G29S_START);}
 if(g29_reqResume){g29_reqResume=FALSE;MC029_Go(G29S_NONE);}
 if(g29_quit)s->running=FALSE;
 Bool pauseOpen=g29_pending==G29S_PAUSE && g29_screen==G29S_NONE && game;MC029_ApplyPending(s);
 // Minecraft::setScreen saves the level when an in-game screen opens (done for the pause screen here).
 if(pauseOpen && s->unsaved){if(!MC028_Save(s))MC029_Status(s->notice);}}

// ---- GameRenderer::render: level (when the screen renders the game behind) -> Gui::render -> screen ----
U0 MC029_Frame(MCApp028 *s,F32 partial){I32 id=g29_screen;Bool world=g29_bound && s->worldReady && !s->failed,behind=FALSE;
 if(world){if(id==G29S_NONE || id==G33S_BED || id==G34S_SIGN || id==G29S_PAUSE || id==G29S_DEATH || id==G29S_CHAT || id==G29S_OPTIONS)behind=TRUE;else if(g29_opt.fancy && (id==G29S_CREATIVE || id==G29S_SURVIVAL))behind=TRUE;}
 hcgl028_glViewport(0,0,g29_W,g29_H);
 if(behind){MC033_ClearColor(s,partial);hcgl028_glClear(0x4100);MC028_RenderWorld(s,partial);MC029_GuiBegin();MC033_Overlay(s);MC035_AnimMode(s,1);MC029_RenderHud(s,partial,id!=G29S_NONE);}
 else{hcgl028_glClearColor(0,0,0,1);hcgl028_glClear(0x4100);MC029_GuiBegin();}
 if(world && id!=G29S_NONE)MC035_AnimMode(s,2);
 if(id==G29S_START)MC029_StartRender();else if(id==G29S_PLAY)MC029_PlayRender();else if(id==G29S_CREATE)MC029_CreateRender();else if(id==G29S_DELETE)MC029_DeleteRender();
 else if(id==G29S_PROGRESS)MC029_ProgressRender();else if(id==G29S_PAUSE)MC029_PauseRender();else if(id==G29S_OPTIONS)MC029_OptionsRender();else if(id==G29S_DEATH)MC029_DeathRender();
 else if(id==G29S_CREATIVE)MC029_CreativeRender(s,partial);else if(id==G29S_SURVIVAL)MC029_SurvivalRender(s,partial);else if(id==G29S_CRAFT)MC029_CraftRender(s);else if(id==G29S_CHAT)MC029_ChatRender();else if(id==G32S_CHEST || id==G32S_FURNACE)MC032_ScreenRender(s,partial);else if(id==G33S_ARMOR)MC033_ArmorRender(s,partial);else if(id==G33S_BED)MC033_BedRender(s);else if(id==G34S_SIGN)MC034_SignRender(s);
 MC029_RenderStatus();MC029_White();}

// ---- startup / shutdown ----
U0 MC029_Init(MCApp028 *s){memset(s,0,sizeof(MCApp028));s->running=TRUE;s->width=1280;s->height=720;s->guiWidth=320;s->guiHeight=180;MCVector_Init(&s->restored,1);NinecraftApp_initSinTable();MC028_CatalogInit(&s->catalog);s->initialized=TRUE;mkdir("worlds",493);}
Bool MC029_GraphicsInit(MCApp028 *s){if(!MC028_GraphicsInit(s))return FALSE;if(!MC029_GuiInit(s))return FALSE;MC029_InvInit();MC029_TiltInit();if(!MC029_LangLoad("assets/029/en_US.lang"))printf("Language file missing; item names fall back to ids\n");
 F64 p=hc029_ppm();if(p<=0)p=3.78;g29_ppm=p;MC029_OptLoad();g29_W=s->width;g29_H=s->height;MC029_ComputeScale();MC029_HudConfig();MC029_ApplyViewDistance();g29_t0=getTimeS();MC029_Go(G29S_START);MC029_ApplyPending(s);return TRUE;}
U0 MC029_Destroy(MCApp028 *s){if(!s->initialized)return;if(g29_bound)MC029_CloseWorld(s,FALSE);MCVector_Destroy(&s->restored);MC028_CatalogDestroy(&s->catalog);if(s->locked){hc028_unlock();s->locked=FALSE;}s->initialized=FALSE;}
