// CreateWorldScreen::getSeed (text.size()<=1 -> epoch time; trimmed; sscanf %d; else Util::hashCode)
I32 MC029_SeedFrom(U8 *t){I32 n=strlen(t);if(n<=1)return getEpochTimeS();I32 st=0,en=n;while(st<en && (t[st]==32 || t[st]==9))st++;while(en>st && (t[en-1]==32 || t[en-1]==9))en--;if(en<=st)return getEpochTimeS();
