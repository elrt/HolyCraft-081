  while(n<32){e=readdir(d);if(!e)break;if(!strcmp(e->name,".") || !strcmp(e->name,".."))continue;strncpy(names[n],e->name,255);names[n][255]=0;isDir[n]=e->type==4;n++;}closedir(d);if(!n)break;
