U0 MC32_Load(I32 k){g29_ip=g32_pane[k];I32 i;for(i=0;i<256;i++)g29_ipItem[i]=g32_pItem[k][i];}
U0 MC32_Save(I32 k){g32_pane[k]=g29_ip;}
U0 MC32_Items(MCApp028 *s){I32 n,i;ItemInstance **inv=MC32_InvSlots(s,&n);if(n>256)n=256;
 if(g29_screen==G32S_CHEST){for(i=0;i<n;i++)g32_pItem[0][i]=inv[i];if(g32_pane[0].n!=n){MC32_Load(0);MC029_PaneCount(n);MC32_Save(0);}I32 m=MC32_ChestSlots();for(i=0;i<m;i++)g32_pItem[1][i]=*g32_cs[i];if(g32_pane[1].n!=m){MC32_Load(1);MC029_PaneCount(m);MC32_Save(1);}return;}
 I32 k=0,rid,raux;for(i=0;i<n && k<256;i++){ItemInstance *it=inv[i];if(!MC029_ValidItem(it))continue;if(MC32_Fuel(s,it)>0 || MC32_Smelt(s,ItemInstance_getId(it),&rid,&raux)){g32_pItem[0][k]=it;g32_pIdx[k]=i;k++;}}
 if(g32_pane[0].n!=k){MC32_Load(0);MC029_PaneCount(k);MC32_Save(0);}}
Bool MC32_Allowed(MCApp028 *s,ItemInstance *it){I32 rid,raux;if(!MC029_ValidItem(it))return FALSE;if(g32_sel==1)return MC32_Fuel(s,it)>0;if(g32_sel==0)return MC32_Smelt(s,ItemInstance_getId(it),&rid,&raux);return FALSE;}
// furnace slot rectangles (FurnaceScreen::setupPositions, slot = 32x32 nine-patch)
