// FurnaceScreen::takeAndClearSlot
U0 MC32_Take(MCApp028 *s,I32 slot){if(!g32_open)return;ItemInstance *it=g32_open->it[slot];if(!MC029_ValidItem(it))return;I32 n;ItemInstance **inv=MC32_InvSlots(s,&n);I32 id=ItemInstance_getId(it);MC32_Put(s,inv,n,it,it->count);if(MC029_ValidItem(it))MC32_DropItem(s,it);printf("CONTAINER032 took furnace slot %d id=%d\n",slot,id);s->unsaved=TRUE;MC32_Items(s);}
I32 MC32_SlotAt(){I32 i;for(i=0;i<3;i++)if(MC029_Inside(g32_sx[i],g32_sy[i],32,32))return i;return -1;}
U0 MC032_ScreenPress(MCApp028 *s){MC029_PressButtons();if(g29_pressId>=0 && g29_pressId<50)return;g29_pressId=-1;g32_active=-1;g32_slotPress=-1;g32_moved=FALSE;g32_pressAt=getTimeS();
