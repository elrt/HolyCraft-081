// move count items of pane k entry i to the other side
Bool MC32_Transfer(MCApp028 *s,I32 k,I32 i,I32 count){I32 n;ItemInstance **inv=MC32_InvSlots(s,&n);ItemInstance *src=g32_pItem[k][i];if(!MC029_ValidItem(src))return FALSE;I32 moved=0,srcId=ItemInstance_getId(src);
