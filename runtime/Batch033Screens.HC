// queryHoldTime: after 200 ms a share grows over (10*count+700) ms; at 100% the whole stack moves.
F32 MC32_Hold(MCApp028 *s){if(g32_active<0 || g32_moved || !g29_mouseDown)return -1;MCInvPane029 *p=&g32_pane[g32_active];if(p->press<0 || p->sc.drag)return -1;ItemInstance *it=g32_pItem[g32_active][p->press];if(!MC029_ValidItem(it) || it->count<2)return -1;
