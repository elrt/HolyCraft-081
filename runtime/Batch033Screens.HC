 if(g29_screen==G32S_CHEST){U8 *title="Chest";if(g32_pair)title="Large Chest";MC029_Add(50,2,0,0,w/2,26,"Inventory");MC029_Add(51,2,w/2,0,w-w/2,26,title);MC029_AddImg(4,w-19,0,19,19,&g29_texSprite,60,0,18,18,18,18);
  I32 half=w/2,a5=half-5;if(a5<0)a5=half+26;a5&=0xFFFFFFE0;if(a5<32)a5=32;I32 x=(half-a5)/2;MC32_Load(0);MC029_PaneSet(x,30,a5,h-36,32,4,FALSE,0);g29_ip.f248=0;g29_ip.f24C=0;g29_ip.real=TRUE;MC32_Save(0);
