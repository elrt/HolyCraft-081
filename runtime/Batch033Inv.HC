// ---- PaneCraftingScreen ----
class MCCItem029 {I32 rec,id,aux,count,have,reqN;Bool can;U8 name[128],key[136];I32 rId[9],rAux[9],rNeed[9],rHave[9];};
MCCItem029 g29_ci[G29_REC_N];I32 g29_ciN=0;
