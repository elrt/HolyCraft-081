 for(j=0;j<c->reqN;j++){U8 a[8],b[8],t[24];MC029_CountText(c->rHave[j],a);MC029_CountText(c->rNeed[j],b);sprintf(t,"%s/%s",a,b);F32 tx=(v11+v9*(j&1))*1.5+4.0,ty=(v12+v10*(j>>1))*1.5+23.0;
  if(c->rHave[j]<c->rNeed[j]){MC029_DrawText(t,tx+1,ty+1,0xC0AAAAAA,FALSE);MC029_DrawText(t,tx,ty,0xC0635558,FALSE);}else MC029_Shadow(t,tx,ty,0xFFF0F0F0);}
 hcgl028_glPopMatrix();MC029_White();MC029_Wrap(g29_crDesc,g29_gw-95,20+62+6,88,0xFFF0F0F0,TRUE,TRUE);MC029_White();}
U0 MC029_CraftPress(MCApp028 *s){MC029_PressButtons();g29_crPress=-1;if(g29_pressId>=0 || g29_crCat<0)return;if(!MC029_ScrollPress(&g29_crSc))return;I32 off=g29_crSc.off;I32 i=(g29_my-g29_crPY+off)/22;if(i>=0 && i<g29_catN[g29_crCat])g29_crPress=i;}
