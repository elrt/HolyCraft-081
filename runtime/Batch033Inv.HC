Bool MC029_LangTo(U8 *k,U8 *out){U8 *v=MC029_Lang(k);if(!v)return FALSE;strncpy(out,v,590);out[590]=0;return TRUE;}
U0 MC029_Desc(MCApp028 *s,I32 id,I32 aux,U8 *out){U8 base[200],low[220],k[240];I32 i;out[0]=0;
 if(id==35){if(aux)MC029_Get("desc.wool",out);else MC029_Get("desc.woolstring",out);return;}
 if(id==107){MC029_Get("desc.fence",out);return;}if(id==44){MC029_Get("desc.slab",out);return;}
 base[0]=0;if(id>0 && id<512 && G29_Desc[id]!=NULL)strncpy(base,G29_Desc[id],150);base[150]=0;
 if(id==351){I32 c=aux&15;sprintf(base,"item.dyePowder.%s",g29_colorName[c]);}
 if(id==155){if(aux==1)strcpy(base,"tile.quartzBlockChiseled");else if(aux==2)strcpy(base,"tile.quartzBlockPillar");}
 for(i=0;base[i];i++){U8 c=base[i];if(c>='A' && c<='Z')c+=32;low[i]=c;}low[i]=0;
 if(low[0]=='t')MC029_ReplacePrefix5(low,"tile.","desc.");if(low[0]=='i')MC029_ReplacePrefix5(low,"item.","desc.");
 if(MC029_LangTo(low,out))return;for(i=0;i<9;i++)MC029_RemoveAll(low,g29_descWords[i]);if(MC029_LangTo(low,out))return;
 if(!strcmp(base,"tile.workbench") && MC029_LangTo("desc.craftingtable",out))return;
 if(!strcmp(base,"tile.quartzBlockChiseled") && MC029_LangTo("desc.quartzBlockChiseled",out))return;
 if(!strcmp(base,"tile.quartzBlockPillar") && MC029_LangTo("desc.quartzBlockPillar",out))return;
 snprintf(k,230,"%s : couldn't find desc",base);strcpy(out,k);}
// ---- recipes -> CItems (initCategories/addItem/recheckRecipes/_resortRecipes) ----
Bool MC029_CItemLess(MCCItem029 *a,MCCItem029 *b){if(a->can==b->can)return strcmp(a->key,b->key)<0;return a->can;}
U0 MC029_CraftResort(){I32 c,i,j;for(c=0;c<g29_nCat;c++){for(i=1;i<g29_catN[c];i++){I32 v=g29_catL[c][i];j=i-1;while(j>=0 && MC029_CItemLess(&g29_ci[v],&g29_ci[g29_catL[c][j]])){g29_catL[c][j+1]=g29_catL[c][j];j--;}g29_catL[c][j+1]=v;}}
 if(g29_crCat>=0){for(i=0;i<g29_catN[g29_crCat];i++)if(g29_catL[g29_crCat][i]==g29_crCur)g29_crRow=i;}}
