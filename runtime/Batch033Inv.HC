U0 MC029_PackAdd(I32 k,I32 c){I32 i;for(i=0;i<g29_pkN;i++)if(g29_pkKey[i]==k){g29_pkCnt[i]+=c;return;}if(g29_pkN<96){g29_pkKey[g29_pkN]=k;g29_pkCnt[g29_pkN]=c;g29_pkN++;}}
I32 MC029_PackGet(I32 k){I32 i;for(i=0;i<g29_pkN;i++)if(g29_pkKey[i]==k)return g29_pkCnt[i];return 0;}
// Recipe::isAnyAuxValue / ItemInstance::isDamageableItem / ItemPack::getIdForItemInstance
Bool MC029_AnyAux(I32 id){return id<=255 && id!=35 && id!=44 && id!=24 && id!=17 && id!=5;}
Bool MC029_Damageable(MCApp028 *s,I32 id){if(id<1 || id>511)return FALSE;MCItemDef023 *d=s->catalog.registry.items[id];if(!d)return FALSE;return d->maxDamage>0;}
I32 MC029_PackKey(MCApp028 *s,I32 id,I32 aux){if(MC029_AnyAux(id) || MC029_Damageable(s,id))aux=-1;return id*512+aux;}
// CraftingFilters::isStonecutterItem (tiles of Material::stone / Material::sand)
I32 G29_StoneIds[31]={1,4,7,12,13,14,15,16,21,24,43,44,45,48,49,56,67,73,74,87,95,98,108,109,112,114,128,139,155,156,246};
Bool MC029_StoneItem(I32 id,I32 aux){if(id<1 || id>=256 || id==22 || id==61 || id==245)return FALSE;if(id==44 && aux==2)return FALSE;I32 i;for(i=0;i<31;i++)if(G29_StoneIds[i]==id)return TRUE;return FALSE;}
// ---- I18n::getDescriptionString ----
U8 *g29_descWords[9]={"wood","iron","stone","diamond","gold","brick","emerald","lapis","cloth"};
U0 MC029_RemoveAll(U8 *s,U8 *w){I32 n=strlen(w),L=strlen(s),i=0,o=0;U8 t[256];if(L>250)L=250;while(i<L){I32 k=0;if(i+n<=L){while(k<n && s[i+k]==w[k])k++;}if(k==n && n>0)i+=n;else t[o++]=s[i++];}t[o]=0;strcpy(s,t);}
