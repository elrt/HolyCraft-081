 for(i=0;i<g29_ciN;i++){MCCItem029 *c=&g29_ci[i];c->can=TRUE;c->have=MC029_PackGet(MC029_PackKey(s,c->id,c->aux));
  for(j=0;j<c->reqN;j++){I32 id=c->rId[j],aux=c->rAux[j],h=0;if(MC029_AnyAux(id) || aux!=-1)h=MC029_PackGet(MC029_PackKey(s,id,aux));else{for(a=0;a<16;a++)h+=MC029_PackGet(MC029_PackKey(s,id,a));}c->rHave[j]=h;if(c->can)c->can=h>=c->rNeed[j];}}
 MC029_CraftResort();}
U0 MC029_CraftOpen(MCApp028 *s){I32 i,j;if(g29_craftStone){g29_nCat=1;g29_catMask[0]=1;g29_catIcon[0]=5;}else{g29_nCat=4;for(i=0;i<4;i++){g29_catMask[i]=1<<i;g29_catIcon[i]=i;}}for(i=0;i<4;i++)g29_catN[i]=0;g29_ciN=0;
 for(i=0;i<G29_REC_N;i++){if(G29_RecSize[i]>g29_craftSize)continue;I32 id=G29_RecRes[i*6],aux=G29_RecRes[i*6+1];if(id<1 || id>511 || !s->catalog.itemExists[id])continue;if(MC029_StoneItem(id,aux)!=g29_craftStone)continue;
  MCCItem029 *c=&g29_ci[g29_ciN];memset(c,0,sizeof(MCCItem029));c->rec=i;c->id=id;c->aux=aux;c->count=G29_RecRes[i*6+2];MC029_ItemName(s,id,aux,c->name);
  if(id==35)snprintf(c->key,130,"Wool %s",c->name);else if(id==351)snprintf(c->key,130,"ZDye %s",c->name);else strcpy(c->key,c->name);
  c->reqN=G29_RecIngN[i];if(c->reqN>9)c->reqN=9;for(j=0;j<c->reqN;j++){c->rId[j]=G29_RecIng[i*27+j*3];c->rAux[j]=G29_RecIng[i*27+j*3+1];c->rNeed[j]=G29_RecIng[i*27+j*3+2];}
  I32 cat=G29_CraftCat[id];if(cat>=0){for(j=0;j<g29_nCat;j++)if(g29_catMask[j]&cat)g29_catL[j][g29_catN[j]++]=g29_ciN;}g29_ciN++;}
 g29_crCat=-1;g29_crCur=-1;g29_crRow=-1;g29_crPress=-1;g29_crHasPane=FALSE;g29_crDesc[0]=0;MC029_ScrollZero(&g29_crSc);MC029_CraftRecheck(s);}
U0 MC029_CraftSelect(MCApp028 *s,I32 cat,I32 ci){g29_crCur=ci;MCCItem029 *c=&g29_ci[ci];MC029_Desc(s,c->id,c->aux,g29_crDesc);if(cat!=g29_crCat){MC029_ScrollZero(&g29_crSc);g29_crHasPane=TRUE;g29_crCat=cat;}}
U0 MC029_CraftCategory(MCApp028 *s,I32 i){if(i<0 || i>=g29_nCat)return;if(g29_catN[i]>0){MC029_CraftSelect(s,i,g29_catL[i][0]);g29_crRow=0;}g29_crCat=i;I32 k;for(k=0;k<g29_btnN;k++)if(g29_btn[k].id>=100)g29_btn[k].highlight=g29_btn[k].id==100+i;MC029_CraftResort();}
// init + setupPositions
U0 MC029_CraftInit(MCApp028 *s){g29_btnN=0;I32 nc=g29_nCat,i;if(nc<4)nc=4;I32 v7=(g29_gh-16)/nc;
 MCButton029 *cb=MC029_Add(1,3,g29_gw-95,20,88,62,NULL);cb->normal=&g29_pSetBg;cb->down=&g29_pSetBgDown;MC029_Add(2,6,g29_gw-19,0,19,19,NULL);
 for(i=0;i<g29_nCat;i++){MCButton029 *b=MC029_Add(100+i,4,6,6+i*(v7+1),v7,v7,NULL);I32 ic=g29_catIcon[i];MC029_SetImage(b,&g29_texSprite,32*(ic/2),32*((ic&1)+2),32,32,v7,v7);}
 g29_crPX=v7+12;g29_crPY=8;g29_crPW=g29_gw-(v7+12)-100;g29_crPH=g29_gh-16;I32 c=0;if(g29_crHasPane && g29_crCat>=0)c=g29_crCat;g29_crCat=-1;MC029_CraftCategory(s,c);}
U0 MC029_CraftClose(MCApp028 *s){if(g29_opt.useTouch && g29_craftSize==0){if(s->creative)MC029_Go(G29S_CREATIVE);else MC029_Go(G29S_SURVIVAL);}else MC029_Go(G29S_NONE);}
U0 MC029_DropStack(MCApp028 *s,I32 id,I32 aux,I32 n){Vec3 eye,end;I32 mode=g29_dirMode;g29_dirMode=0;MC028_Direction(s,&eye,&end,1);g29_dirMode=mode;I32 before=s->level.drops.size;MCWorldEvent023 ev;memset(&ev,0,sizeof(ev));ev.op=MC023_DROP;ev.id=id;ev.meta=aux;ev.count=n;ev.a=end.x;ev.b=end.y-0.25;ev.c=end.z;MC025_LevelEvent(&s->level,&ev);
 if(s->level.drops.size>before){ItemEntity *d=s->level.drops.data[before];d->pickupDelay=40;d->motionX=(end.x-eye.x)*0.2;d->motionY=(end.y-eye.y)*0.2+0.1;d->motionZ=(end.z-eye.z)*0.2;}}
// craftSelectedItem
U0 MC029_CraftDo(MCApp028 *s){if(g29_crCur<0 || g29_crCur>=g29_ciN)return;MCCItem029 *c=&g29_ci[g29_crCur];if(!c->can)return;Inventory *inv=&s->minecraft.player->player.inventory;FillingContainer temp;MC024_ImportInventory(&temp,inv);I32 j;ItemInstance it;
 for(j=0;j<c->reqN;j++){I32 id=c->rId[j],aux=c->rAux[j],n=c->rNeed[j];if(id==24 && aux==-1){ItemInstance_Init(&it,&s->catalog.registry,24,n,0);n=FillingContainer_removeResource(&temp,&it,TRUE);}if(n>0){ItemInstance_Init(&it,&s->catalog.registry,id,n,aux);FillingContainer_removeResource(&temp,&it,FALSE);}}
 I32 r=c->rec;for(j=0;j<2;j++){I32 id=G29_RecRes[r*6+j*3],aux=G29_RecRes[r*6+j*3+1],n=G29_RecRes[r*6+j*3+2];if(id<1 || id>511 || n<1 || !s->catalog.itemExists[id])continue;ItemInstance_Init(&it,&s->catalog.registry,id,n,aux);FillingContainer_add(&temp,&it);if(it.count>0)MC029_DropStack(s,id,aux,it.count);}
 MC024_CommitInventory(inv,&temp);FillingContainer_Destroy(&temp);s->unsaved=TRUE;MC029_CraftRecheck(s);}
// ItemPane::renderBatch
U0 MC029_CraftList(MCApp028 *s){if(g29_crCat<0)return;I32 n=g29_catN[g29_crCat],i;if(n<=0)return;MCScroll029 *p=&g29_crSc;I32 px=g29_crPX,py=g29_crPY,pw=g29_crPW,ph=g29_crPH;MC029_ScrollSet(p,px,py,pw,ph,n*22);MC029_ScrollFrame(p);
 MC029_Scissor(TRUE,px,py,pw,ph);
 for(i=0;i<n;i++){F32 y=py+i*22-p->off;if(y+22<py || y>py+ph)continue;MCPatch029 *pt=&g29_pRow;if(i==g29_crRow)pt=&g29_pRowSel;MC029_White();MC029_Patch(pt,MC029_AlignPx(px-1.0),MC029_AlignPx(y),pw+4,22);}
 for(i=0;i<n;i++){F32 y=py+i*22-p->off;if(y+22<py || y>py+ph)continue;MCCItem029 *c=&g29_ci[g29_catL[g29_crCat][i]];MC029_RenderItem(s,c->id,c->aux,MC029_AlignPx(pw+px-16.0),MC029_AlignPx(y+2),1,1,1);}
 for(i=0;i<n;i++){F32 y=py+i*22-p->off;if(y+22<py || y>py+ph)continue;MCCItem029 *c=&g29_ci[g29_catL[g29_crCat][i]];U8 num[16];sprintf(num,"%d",c->have);I32 L=strlen(num);F32 x23=px-1.0;
  F32 nx=MC029_AlignPx((x23+pw-4*L)*1.5),ny=MC029_AlignPx((22+y-8)*1.5);
  if(c->can){MC029_Shadow(c->name,MC029_AlignPx(x23+5),MC029_AlignPx(y+6),0xFFF0F0F0);hcgl028_glPushMatrix();hcgl028_glScalef(0.6667,0.6667,1);MC029_Shadow(num,nx,ny,0xFFF0F0F0);hcgl028_glPopMatrix();}
  else{F32 tx=MC029_AlignPx(x23+5),ty=MC029_AlignPx(y+7);MC029_DrawText(c->name,tx+1,ty+1,0xC0AAAAAA,FALSE);MC029_DrawText(c->name,tx,ty,0xC0635558,FALSE);hcgl028_glPushMatrix();hcgl028_glScalef(0.6667,0.6667,1);MC029_DrawText(num,nx,ny,0xC0635558,FALSE);hcgl028_glPopMatrix();}}
 MC029_White();MC029_Gradient(px,py,px+pw,py+40,0x44000000,0);MC029_Gradient(px,py+ph-40,px+pw,py+ph,0,0x44000000);MC029_Scissor(FALSE,0,0,0,0);
 if(p->max>0 && p->bar>0){F32 bh=p->h*p->h/(p->h+p->max);if(bh<8)bh=8;F32 by=p->y+(p->h-bh)*p->off/p->max;I32 a=p->bar*255;if(a>255)a=255;MC029_Fill(px+pw,by,px+pw+2,by+bh,(a<<24)|0xFFFFFF);}MC029_White();}
U0 MC029_CraftRender(MCApp028 *s){MC029_White();MC029_Patch(&g29_pCraftBg,0,0,g29_gw,g29_gh);MC029_RenderButtons();
 MCButton029 *cl=MC029_Find(2);if(cl){F32 u=60;if(MC029_BtnDown(cl))u=78;MC029_White();MC029_BlitUV(&g29_texSprite,cl->x,cl->y+1,19,19,u/128.0,0,(u+18)/128.0,18/128.0);}
 MC029_White();MC029_PatchEx(&g29_pCraftFrame,g29_crPX-1,g29_crPY-2,g29_crPW+2,g29_crPH+4,16);MC029_CraftList(s);
 if(g29_crCur<0 || g29_crCur>=g29_ciN)return;MCCItem029 *c=&g29_ci[g29_crCur];F32 v9=44,v10=31,v11=g29_gw-95+22-8.0,v12=20+15.5-9.0;I32 j;
 for(j=0;j<c->reqN;j++){I32 aux=c->rAux[j];if(aux==-1)aux=0;MC029_RenderItem(s,c->rId[j],aux,v11+v9*(j&1),v12+v10*(j>>1),1,1,1);}
