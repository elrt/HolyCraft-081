// Despite upstream namespace name, this is a zlib-wrapped stream, not RFC1952 gzip.
I32 compression_gzip_compressFile(U0 *source,U0 *dest,I32 level) { I32 ret,flush;U32 have;MCZStream stream;U8 in[16384],out[16384];memset(&stream,0,sizeof(MCZStream));ret=deflateInit_(&stream,level,zlibVersion(),sizeof(MCZStream));if(ret!=0)return ret;do { stream.avail_in=fread(in,1,16384,source);if(ferror(source)) { deflateEnd(&stream);return -1; }flush=0;if(feof(source))flush=4;stream.next_in=in;do { stream.avail_out=16384;stream.next_out=out;ret=deflate(&stream,flush);if(ret==-2) { deflateEnd(&stream);return ret; }have=16384-stream.avail_out;if(fwrite(out,1,have,dest)!=have || ferror(dest)) { deflateEnd(&stream);return -1; } }while(stream.avail_out==0); }while(flush!=4);deflateEnd(&stream);if(ret!=1)return -3;return 0; }
I32 compression_gzip_decompressFile(U0 *source,U0 *dest) { I32 ret;U32 have;MCZStream stream;U8 in[16384],out[16384];memset(&stream,0,sizeof(MCZStream));ret=inflateInit_(&stream,zlibVersion(),sizeof(MCZStream));if(ret!=0)return ret;do { stream.avail_in=fread(in,1,16384,source);if(ferror(source)) { inflateEnd(&stream);return -1; }if(stream.avail_in==0)break;stream.next_in=in;do { stream.avail_out=16384;stream.next_out=out;ret=inflate(&stream,0);if(ret==-2 || ret==2 || ret==-3 || ret==-4) { inflateEnd(&stream);if(ret==2)ret=-3;return ret; }have=16384-stream.avail_out;if(fwrite(out,1,have,dest)!=have || ferror(dest)) { inflateEnd(&stream);return -1; } }while(stream.avail_out==0); }while(ret!=1);inflateEnd(&stream);if(ret==1)return 0;return -3; }
