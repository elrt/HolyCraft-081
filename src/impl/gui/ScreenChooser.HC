U0 *ScreenChooser_createScreen(ScreenChooser *s,I32 id){MCScreenHost012 *h=s->host;I32 kind,arg=0;switch(id){case START_MENU_SCREEN:kind=MC012_START;break;case JOIN_GAME_SCREEN:kind=MC012_JOIN;break;case PAUSE_SCREEN_0:kind=MC012_PAUSE;break;case PAUSE_SCREEN_1:kind=MC012_PAUSE;arg=1;break;case SELECT_WORLD_SCREEN:kind=MC012_SELECT;break;case INVENTORY_SCREEN:if(h->isCreative(h->host))kind=MC012_CREATIVE_INV;else kind=MC012_TOUCH_INV;break;case CHAT_SCREEN:kind=MC012_CHAT;break;default:return NULL;}return h->createScreen(h->host,kind,arg);}U0 ScreenChooser_setScreen(ScreenChooser *s,I32 id){U0 *screen=ScreenChooser_createScreen(s,id);s->host->setScreen(s->host->host,screen);}
