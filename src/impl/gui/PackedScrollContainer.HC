// Batch022: gui/PackedScrollContainer; explicit host ABI, see docs/BATCH022.md.
U0 PackedScrollContainer_Init(PackedScrollContainer *s,Bool adaptive,I32 x,I32 y,MC022DrawHost *host) {memset(s,0,sizeof(PackedScrollContainer));MC022_Box(&s->bounds,0,0,24,24);MCVector_Init(&s->children,sizeof(MC022OptionRow));s->adaptive=adaptive;s->padX=x;s->padY=y;s->host=host;}
U0 PackedScrollContainer_Destroy(PackedScrollContainer *s) {MCVector_Destroy(&s->children);}
U0 PackedScrollContainer_setupPositions(PackedScrollContainer *s) {I32 pass;I64 i;MC022OptionRow *r=s->children.data(MC022OptionRow*);for(pass=0;pass<2;pass++){I32 off=s->offset,y=off+s->bounds.y+s->padY;for(i=0;i<s->children.size;i++){r[i].box.x=s->bounds.x+s->padX;r[i].box.w=s->bounds.w-2*s->padX;r[i].box.y=y+s->padY;MC022OptionRow *row=&r[i];if(row->layout!=NULL)row->layout(row->ctx,&row->box);y+=r[i].box.h;}I32 content=y-off-s->bounds.y;if(s->hasPane && content==s->contentHeight && content!=0)break;s->flags=513;if(s->adaptive && content<s->bounds.h)s->flags=529;s->contentHalfHeight=s->bounds.h;if(content>s->contentHalfHeight)s->contentHalfHeight=content;s->contentHalfHeight/=2;F32 minOff=s->bounds.h-content;if(minOff>0.0)minOff=0.0;if(s->offset<minOff)s->offset=minOff;s->contentHeight=content;s->hasPane=TRUE;}}
Bool PackedScrollContainer_childVisible(PackedScrollContainer *s,MC022Box *b) {I32 left=s->bounds.x+s->padX,right=s->bounds.x+s->bounds.w+1-2*s->padX,top=s->bounds.y+s->padY,bottom=s->bounds.y+s->bounds.h-s->padY;return b->x+b->w>=left && b->x<=right && b->y+b->h>=top && b->y<bottom;}
U0 PackedScrollContainer_render(PackedScrollContainer *s,F32 scale,I32 physicalHeight) {PackedScrollContainer_setupPositions(s);I32 x=(s->bounds.x+s->padX)*scale,y=physicalHeight-((s->bounds.y+s->bounds.h-s->padY)*scale)(I32),w=(s->bounds.w+1-2*s->padX)*scale,h=(s->bounds.h-2*s->padY)*scale;MC022_Clip(s->host,TRUE,x,y,w,h);I64 i;MC022OptionRow *r=s->children.data(MC022OptionRow*);for(i=0;i<s->children.size;i++)if(PackedScrollContainer_childVisible(s,&r[i].box))MC022_Event(s->host,100,i,&r[i]);MC022_Clip(s->host,FALSE,0,0,0,0);}
U0 PackedScrollContainer_mouseClicked(PackedScrollContainer *s,I32 x,I32 y,I32 button) {if(!MC022_Hit(&s->bounds,x,y))return;I64 i;MC022OptionRow *r=s->children.data(MC022OptionRow*);for(i=0;i<s->children.size;i++)MC022_Event(s->host,101,button,&r[i]);}
