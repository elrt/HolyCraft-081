// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 Gui_Init(Gui *s,Minecraft *mc,MCUIHost026 *host,MCUI025 *ui,F32 scale){memset(s,0,sizeof(Gui));s->minecraft=mc;s->host=host;s->ui=ui;MCVector_Init(&s->messages,sizeof(GuiMessage));MCString_Init(&s->nowPlaying);MCString_Init(&s->tip);s->slots=4;s->flash=2;s->inventoryDirty=TRUE;s->slotDropCounter=s->slotToDrop=-1;s->scale=scale;if(scale<=0)s->scale=3;s->invScale=1.0/s->scale;}
U0 Gui_Destroy(Gui *s){I32 i;for(i=0;i<s->messages.size;i++)GuiMessage_Destroy(MCVector_At(&s->messages,i));MCVector_Destroy(&s->messages);MCString_Destroy(&s->nowPlaying);MCString_Destroy(&s->tip);}
I32 Gui_itemCountItoa(U8 *out,I32 n){if(n<0)return 0;if(n>9){if(n>99){strcpy(out,"99+");return 3;}out[0]=n/10+48;out[2]=0;out[1]=n+48-10*(n/10);return 2;}out[0]=n+48;out[1]=0;return 1;}
F32 Gui_cubeSmoothStep(F32 n,F32 unusedA,F32 unusedB){return (n*n)*(3-(n+n));}
F32 Gui_floorAlignToScreenPixel(Gui *s,F32 n){return (n*s->scale)(I32)*s->invScale;}
I32 Gui_getNumSlots(Gui *s){return s->slots;}
U0 Gui_onConfigChanged(Gui *s,I32 width,Bool touch,Bool joypad,F32 guiScale,F32 norm){if(!touch){s->slots=9;return;}I32 n=6,x0,x1,y;if(!joypad && width>480){while(n<8){x0=(s->minecraft->width*s->invScale)(I32)/2-10*s->slots;x1=x0+20*n;if((width-(x1-x0)*guiScale)*norm<80)break;n++;}}s->slots=n;}
U0 Gui_getRectangleArea(Gui *s,I32 side,RectangleArea *out){F32 center=s->minecraft->width/2+2,v=(10*s->slots+4)*s->scale,h=s->minecraft->height;F32 left=center-v,right=center+v+2;if(side<0)left=0;else if(side>0)right=s->minecraft->width;RectangleArea_Init(out,TRUE,left,h-25*s->scale,right,h);}
I32 Gui_getSlotIdAt(Gui *s,I32 x,I32 y){I32 w=(s->minecraft->width*s->invScale)(I32),h=(s->minecraft->height*s->invScale)(I32),yy=(y*s->invScale)(I32);if(yy<h-19 || yy>h)return -1;I32 dx=(x*s->invScale)(I32)-(w/2+2-10*s->slots);if(dx<0)return -1;I32 id=dx/20;if(id>=s->slots)return -1;return id;}
I32 Gui_getSlotPos(Gui *s,I32 slot,I32 *x,I32 *y){I32 w=(s->minecraft->width*s->invScale)(I32),h=(s->minecraft->height*s->invScale)(I32),base=w/2-10*s->slots;*x=base+20*slot;*y=h-22;return base;}
U0 Gui_addMessage(Gui *s,MCString *author,MCString *message,I32 ticks){GuiMessage msg;GuiMessage_Init(&msg,author,message,ticks);MCVector_Insert(&s->messages,0,&msg);if(s->messages.size>30){GuiMessage_Destroy(MCVector_At(&s->messages,s->messages.size-1));s->messages.size--;}}
U0 Gui_displayClientMessage(Gui *s,MCString *message){MCString a;MCString_Init(&a);Gui_addMessage(s,&a,message,200);MCString_Destroy(&a);}
U0 Gui_flashSlot(Gui *s,I32 slot){s->flashedSlot=slot;s->flashedAt=MC_GetTimeS();}
U0 Gui_showTipMessage(Gui *s,MCString *text){MCString_Assign(&s->tip,text);s->tipTimeLeft=40;}
U0 Gui_setNowPlaying(Gui *s,MCString *text){MCString_Assign(&s->nowPlaying,text);s->nowPlayingLeft=60;}
U0 Gui_handleClick(Gui *s,I32 button,I32 x,I32 y){if(button!=1)return;I32 id=Gui_getSlotIdAt(s,x,y);if(id<0)return;if(id==s->slots-1){MC026_Command(s->host,MC026_NAVIGATE,NULL,NULL,100,0);return;}Player *p=MC026_Player(s->host);if(p)Inventory_selectSlot(&p->inventory,id);}
U0 Gui_handleKeyPressed(Gui *s,I32 key){Player *p=MC026_Player(s->host);if(!p)return;I32 slot=p->inventory.selectedSlot;if(key==99 && slot>0)p->inventory.selectedSlot--;else if(key==4 && slot<s->slots-2)p->inventory.selectedSlot++;else if(key==100)MC026_Command(s->host,MC026_NAVIGATE,NULL,NULL,100,0);}
U0 Gui_tickItemDrop(Gui *s,Bool down,I32 x,I32 y){Bool dropping=FALSE;Player *p=MC026_Player(s->host);if(down && p){I32 slot=Gui_getSlotIdAt(s,x,y);if(slot>=0 && slot<s->slots-1){if(slot!=s->slotToDrop || s->minecraft->currentScreen){s->slotDropCounter=0;s->slotToDrop=slot;}dropping=TRUE;s->slotDropCounter++;if(s->slotDropCounter>=40){ItemInstance *item=Inventory_getLinked(&p->inventory,slot);if(item){ItemInstance copy=*item;MC026_Drop(p,&copy);Inventory_clearSlot(&p->inventory,slot);}dropping=FALSE;}}}if(!dropping){s->slotToDrop=-1;s->slotDropCounter=-1;}}
U0 Gui_tick(Gui *s){if(s->nowPlayingLeft>0)s->nowPlayingLeft--;if(s->tipTimeLeft>0)s->tipTimeLeft--;s->ticks++;if(s->flash<2)s->flash+=0.05;I32 i;for(i=0;i<s->messages.size;i++){GuiMessage *m=MCVector_At(&s->messages,i);m->tickCounter++;}}
U0 Gui_renderChatMessages(Gui *s,Bool hide){if(hide)return;I32 i,shown=0;for(i=0;i<s->messages.size;i++){GuiMessage *m=MCVector_At(&s->messages,i);if(m->tickCounter>=m->ticksShown || m->ticksShown<=0)continue;F32 fade=(1.0-m->tickCounter(F32)/m->ticksShown)*10;if(fade<0)fade=0;if(fade>1)fade=1;I32 alpha=fade*fade*255;if(alpha>0 && shown<10){shown++;MC025_Text(s->ui,&m->fullMessage,2,9*shown+18,(alpha<<24)|0xffffff);}}}
