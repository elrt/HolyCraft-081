// Batch022: gui/screens/AddExternalServerScreen; explicit host ABI, see docs/BATCH022.md.
U0 AddExternalServerScreen_Init(AddExternalServerScreen *s,I32 width,I32 height,MC022DrawHost *h) {memset(s,0,sizeof(AddExternalServerScreen));s->width=width;s->height=height;s->host=h;MC022_Box(&s->back,4,4,38,18);MC022_Box(&s->header,0,0,width,26);MC022_Box(&s->add,0,0,120,24);MC022_Box(&s->nameBox,0,0,0,18);MC022_Box(&s->addressBox,0,0,0,18);MC022_Box(&s->portBox,0,0,0,18);MC022_Box(&s->info,0,0,0,10);MCString_Init(&s->server.name);MCString_FromC(&s->server.address,"127.0.0.1");MCString_FromC(&s->server.port,"19132");AddExternalServerScreen_setupPositions(s);}
U0 AddExternalServerScreen_Destroy(AddExternalServerScreen *s) {MCString_Destroy(&s->server.name);MCString_Destroy(&s->server.address);MCString_Destroy(&s->server.port);}
U0 AddExternalServerScreen_setupPositions(AddExternalServerScreen *s) {I32 y=s->header.h;s->header.w=s->width;s->nameLabel.x=10;s->nameLabel.y=y+10;s->nameBox.x=10;s->nameBox.y=y+22;s->nameBox.w=s->width/2-10;s->addressLabel.x=10;s->addressLabel.y=s->nameBox.y+s->nameBox.h+8;s->addressBox.x=10;s->addressBox.y=s->addressLabel.y+10;s->addressBox.w=s->width/2-10;s->portLabel.x=10;s->portLabel.y=s->addressBox.y+s->addressBox.h+8;s->portBox.x=10;s->portBox.y=s->portLabel.y+10;s->portBox.w=s->width/2-10;s->info.x=s->width/2+10;s->info.y=s->header.h+10;s->info.w=s->width/2-20;s->add.x=s->add.w/-2+3*((s->width-10)/4);s->add.y=s->info.y+s->info.h+30;}
Bool AddExternalServerScreen_handleBackEvent(AddExternalServerScreen *s,Bool down,Bool suppressOtherGUI) {if(!down && !suppressOtherGUI)MC022_Event(s->host,MC022_PLAY,1,s);return TRUE;}
Bool AddExternalServerScreen_buttonClicked(AddExternalServerScreen *s,I32 id) {if(id==1){MC022_Event(s->host,MC022_PLAY,1,s);return TRUE;}if(id==2){I64 port=strtoll(MCString_CStr(&s->server.port),NULL,0);if(port>0 && s->server.name.size && s->server.address.size){MC022_Event(s->host,MC022_ADD_SERVER,port,&s->server);MC022_Event(s->host,MC022_PLAY,1,s);return TRUE;}}return FALSE;}


U0 AddExternalServerScreen_render(AddExternalServerScreen *s,Bool suppressed) {if(!suppressed){MC022_Texture(s->host,"gui/spritesheet.png");MC022_Event(s->host,121,0,s);}MC022_Event(s->host,120,1,&s->back);MC022_Event(s->host,120,0,&s->header);MC022_Event(s->host,120,2,&s->add);MC022_Text(s->host,"Server Name",s->nameLabel.x,s->nameLabel.y,0xFFFFFFFF,TRUE);MC022_Text(s->host,"Address",s->addressLabel.x,s->addressLabel.y,0xFFFFFFFF,TRUE);MC022_Text(s->host,"Port",s->portLabel.x,s->portLabel.y,0xFFFFFFFF,TRUE);MC022_Text(s->host,"Add server by IP/Address.",s->info.x,s->info.y,0xFFFFFFFF,TRUE);MC022_Event(s->host,122,0,&s->nameBox);MC022_Event(s->host,122,1,&s->addressBox);MC022_Event(s->host,122,2,&s->portBox);}

