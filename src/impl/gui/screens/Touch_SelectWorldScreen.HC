// Batch026; algorithms and omissions documented in docs/BATCH026.md.
Bool TouchSelectWorldScreen_submit(TouchSelectWorldScreen *s,MCString *name,MCString *seed,MCString *mode,I32 epoch){if(s->generated)return FALSE;MCString trim,dir;Util_stringTrim(&trim,name);MCString_Init(&dir);MCString display;MCString_CopyInit(&display,&trim);if(!trim.size)MC024_SetString(&trim,"no_name");SelectWorldScreen_getUniqueLevelName(&s->select,&trim,&dir);MCString number;Util_stringTrim(&number,seed);I32 value=epoch;if(number.size && sscanf(number.data,"%d",&value)<=0)value=Util_hashCode(&number);Bool creative=!MC025_Str(mode,"survival");Bool ok=MC026_Command(s->select.menu.host,MC026_CREATE_LOCAL,&dir,&display,value,creative);s->generated=ok;s->awaitingInput=FALSE;s->select.failed=!ok;MCString_Destroy(&number);MCString_Destroy(&display);MCString_Destroy(&dir);MCString_Destroy(&trim);return ok;}
U0 TouchSelectWorldScreen_tick(TouchSelectWorldScreen *s,Bool down){if(s->awaitingInput)return;TouchWorldSelectionList_tick(&s->touch,down);WorldSelectionList *b=&s->touch.base;if(b->activated){if(b->activation==b->items.size)s->awaitingInput=TRUE;else if(b->activation>=0 && b->activation<b->items.size){LevelSummary *v=MCVector_At(&b->items,b->activation);s->generated=MC026_Command(s->select.menu.host,MC026_LOAD_LOCAL,&v->levelDir,&v->levelName,-1,-1);s->select.failed=!s->generated;}b->activated=FALSE;}}
U0 TouchSelectWorldScreen_Init(TouchSelectWorldScreen *s,MCUIHost026 *h,MCUI025 *ui){memset(s,0,sizeof(TouchSelectWorldScreen));SelectWorldScreen_Init(&s->select,h,ui);s->select.menu.onTick=NULL;TouchWorldSelectionList_Init(&s->touch,320,200);}
U0 TouchSelectWorldScreen_Destroy(TouchSelectWorldScreen *s){TouchWorldSelectionList_Destroy(&s->touch);SelectWorldScreen_Destroy(&s->select);}
