U0 ConfirmScreen_Init(ConfirmScreen *s,MCGuiHost014 *h,U0 *parent,U8 *q,U8 *info,U8 *yes,U8 *no,I32 id){memset(s,0,sizeof(ConfirmScreen));s->host=h;s->parent=parent;s->confirmId=id;MCString_FromC(&s->question,q);MCString_FromC(&s->info,info);MCString_FromC(&s->confirmText,yes);MCString_FromC(&s->cancelText,no);s->postResult=&ConfirmScreen_postResult;}U0 ConfirmScreen_Destroy(ConfirmScreen *s){if(s->confirmButton)s->host->destroyButton(s->host->host,s->confirmButton);if(s->cancelButton)s->host->destroyButton(s->host->host,s->cancelButton);MCString_Destroy(&s->question);MCString_Destroy(&s->info);MCString_Destroy(&s->confirmText);MCString_Destroy(&s->cancelText);}U0 ConfirmScreen_render(ConfirmScreen *s,I32 x,I32 y,F32 pt){MCGuiHost014 *h=s->host;h->dirt(h->host);h->centered(h->host,MCString_CStr(&s->question),h->width/2,50,0xffffff);h->centered(h->host,MCString_CStr(&s->info),h->width/2,70,0xffffff);h->renderBase(h->host,x,y,pt);}U0 ConfirmScreen_init(ConfirmScreen *s){MCGuiHost014 *h=s->host;s->confirmButton=h->createButton(h->host,0,MCString_CStr(&s->confirmText));s->cancelButton=h->createButton(h->host,1,MCString_CStr(&s->cancelText));h->addButton(h->host,s->confirmButton);h->addButton(h->host,s->cancelButton);h->addFocus(h->host,s->confirmButton);h->addFocus(h->host,s->cancelButton);}U0 ConfirmScreen_setupPositions(ConfirmScreen *s){MCGuiHost014 *h=s->host;h->setBounds(h->host,s->confirmButton,h->width/2-124,h->height/6+72,120,24);h->setBounds(h->host,s->cancelButton,h->width/2+4,h->height/6+72,120,24);}Bool ConfirmScreen_handleBackEvent(ConfirmScreen *s,Bool pressed){if(!pressed)s->postResult(s,FALSE);return TRUE;}U0 ConfirmScreen_buttonClicked(ConfirmScreen *s,I32 id){s->postResult(s,id==0);}U0 ConfirmScreen_postResult(ConfirmScreen *s,Bool result){s->host->parentConfirm(s->host->host,s->parent,result,s->confirmId);}
