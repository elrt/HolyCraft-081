U0 InBedScreen_Init(InBedScreen *s,MCInBedHost012 *h){s->host=h;s->leaveBedButton=NULL;}U0 InBedScreen_Destroy(InBedScreen *s){if(s->leaveBedButton)s->host->destroyButton(s->host->host,s->leaveBedButton);}U0 InBedScreen_render(InBedScreen *s,I32 x,I32 y,F32 pt){s->host->renderBackground(s->host->host,0);s->host->renderScreen(s->host->host,x,y,pt);}U0 InBedScreen_init(InBedScreen *s){MCInBedHost012 *h=s->host;s->leaveBedButton=h->createButton(h->host,1,"Leave Bed",FALSE);h->initButton(h->host,s->leaveBedButton);h->addButton(h->host,s->leaveBedButton);h->addFocusButton(h->host,s->leaveBedButton);}U0 InBedScreen_setupPositions(InBedScreen *s){MCInBedHost012 *h=s->host;I32 w=h->width/3,ht=(h->height*0.15)(I32),x=h->width/2-w/2,y=h->height-(ht*1.5)(I32);h->setBounds(h->host,s->leaveBedButton,x,y,w,ht);}Bool InBedScreen_handleBackEvent(InBedScreen *s,Bool pressed){if(!pressed)s->host->stopSleep(s->host->host,TRUE,TRUE,TRUE);return TRUE;}Bool InBedScreen_renderGameBehind(InBedScreen *s){return TRUE;}U0 InBedScreen_buttonClicked(InBedScreen *s,U0 *button){if(s->leaveBedButton==button)InBedScreen_handleBackEvent(s,FALSE);}
