// Batch026; algorithms and omissions documented in docs/BATCH026.md.
Bool ManageMCOServerScreen_hasInvite(ManageMCOServerScreen *s,MCString *name){I32 i;for(i=0;i<s->invites.size;i++)if(MC026_Same(MCVector_At(&s->invites,i),name))return TRUE;return FALSE;}
Bool ManageMCOServerScreen_addInvite(ManageMCOServerScreen *s,MCString *name,Bool serverConfirmed){if(!name->size || ManageMCOServerScreen_hasInvite(s,name))return FALSE;if(!serverConfirmed){s->pending=MC026_Command(s->menu.host,MC026_MCO_INVITE,name,NULL,s->server.serverId,0);s->failed=!s->pending;return s->pending;}MCString copy;MCString_CopyInit(&copy,name);MCVector_Push(&s->invites,&copy);s->pending=FALSE;return TRUE;}
Bool ManageMCOServerScreen_removeInvite(ManageMCOServerScreen *s,MCString *name,Bool serverConfirmed){I32 i;for(i=0;i<s->invites.size;i++)if(MC026_Same(MCVector_At(&s->invites,i),name)){if(!serverConfirmed){s->pending=MC026_Command(s->menu.host,MC026_MCO_REMOVE,name,NULL,s->server.serverId,0);s->failed=!s->pending;return s->pending;}MCString_Destroy(MCVector_At(&s->invites,i));MCVector_Erase(&s->invites,i);s->pending=FALSE;return TRUE;}return FALSE;}
Bool ManageMCOServerScreen_update(ManageMCOServerScreen *s,MCString *name,Bool open){Bool ok=MC026_Command(s->menu.host,MC026_MCO_UPDATE,name,NULL,s->server.serverId,open);s->failed=!ok;s->pending=ok;return ok;}
U0 ManageMCOServerScreen_action(MCMenu026 *m,I32 id){if(id==1)MC026_Command(m->host,MC026_NAVIGATE,NULL,NULL,107,0);else MC026_MenuBack(m,FALSE);}
U0 ManageMCOServerScreen_Init(ManageMCOServerScreen *s,MCUIHost026 *h,MCUI025 *ui,MCOServerListItem *server){memset(s,0,sizeof(ManageMCOServerScreen));MC026_MenuInit(&s->menu,h,ui,"Manage realm");MCOServerListItem_CopyInit(&s->server,server);MCVector_Init(&s->invites,sizeof(MCString));MCString_Init(&s->error);I32 i;for(i=0;i<server->invited.size;i++){MCString copy;MCString_CopyInit(&copy,MCVector_At(&server->invited,i));MCVector_Push(&s->invites,&copy);}s->menu.onAction=&ManageMCOServerScreen_action;MC026_Button(&s->menu,0,"Back",4,170,70,20);MC026_Button(&s->menu,1,"Reset",200,170,85,20);}
U0 ManageMCOServerScreen_Destroy(ManageMCOServerScreen *s){MCStringVector_Destroy(&s->invites);MCString_Destroy(&s->error);MCOServerListItem_Destroy(&s->server);MC026_MenuDestroy(&s->menu);}
