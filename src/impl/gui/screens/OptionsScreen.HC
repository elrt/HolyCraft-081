// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 OptionsScreen_selectCategory(OptionsScreen *s,I32 index){I32 i;for(i=0;i<4;i++)s->highlight[i]=index==i;if(index>=0 && index<4)s->category=index;}
Bool OptionsScreen_toggle(OptionsScreen *s,I32 id,I32 delta){if(!s->options || !Options_canModify(s->options,id))return FALSE;Options_toggle(s->options,id,delta);return TRUE;}
Bool OptionsScreen_setProgress(OptionsScreen *s,I32 id,F32 value){if(!s->options || !Options_canModify(s->options,id))return FALSE;Options_setFloat(s->options,id,value);return TRUE;}
U0 OptionsScreen_action(MCMenu026 *m,I32 id){OptionsScreen *s=m;if(id<4)OptionsScreen_selectCategory(s,id);else{TextBox_loseFocus(&s->name);if(s->options)Options_save(s->options);MC026_MenuBack(m,FALSE);}}
U0 OptionsScreen_Init(OptionsScreen *s,MCUIHost026 *h,MCUI025 *ui,Bool inGame){memset(s,0,sizeof(OptionsScreen));MC026_MenuInit(&s->menu,h,ui,"Options");s->inGame=inGame;if(h && h->minecraft)s->options=&h->minecraft->options;s->menu.onAction=&OptionsScreen_action;I32 i;for(i=0;i<4;i++)MC026_Button(&s->menu,i,"Category",5+i*78,25,72,20);MC026_Button(&s->menu,4,"Back",4,170,70,20);AppPlatform *p=NULL;if(h && h->minecraft)p=h->minecraft->platform;TextBox_Init(&s->name,p,ui,"Name",16,NULL,0,22);s->name.options=s->options;s->name.option=22;s->name.base.y=60;s->name.base.x=10;if(s->options)MCString_Assign(&s->name.text,&s->options->username);MCPtrVector_Push(&s->menu.screen.elements,&s->name.widget);OptionsScreen_selectCategory(s,0);}
U0 OptionsScreen_Destroy(OptionsScreen *s){TextBox_Destroy(&s->name);MC026_MenuDestroy(&s->menu);}
