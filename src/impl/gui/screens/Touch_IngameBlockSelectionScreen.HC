// Batch026; algorithms and omissions documented in docs/BATCH026.md.
Bool TouchIngameBlockSelectionScreen_isAllowed(TouchIngameBlockSelectionScreen *s,I32 index){Player *p=MC026_Player(s->menu.host);return p && index>=0 && index<p->inventory.size;}
Bool TouchIngameBlockSelectionScreen_addItem(TouchIngameBlockSelectionScreen *s,I32 index){Player *p=MC026_Player(s->menu.host);if(!p || index<0 || index+9>=p->inventory.size || !p->inventory.items[index+9])return FALSE;Inventory *inv=&p->inventory;I32 linked=Inventory_getLinkedSlotForItem(inv,index+9),slots=9;Gui *gui=s->menu.host->gui;if(gui)slots=gui->slots;if(linked<0 || linked>=slots-1)Inventory_moveToSelectionSlot(inv,inv->selectedSlot,index+9);else inv->selectedSlot=linked;if(gui)Gui_flashSlot(gui,inv->selectedSlot);return TRUE;}
U0 TouchIngameBlockSelectionScreen_action(MCMenu026 *m,I32 id){I32 target=0;if(id==2)target=105;else if(id==3)target=106;else if(id==4)target=104;MC026_Command(m->host,MC026_NAVIGATE,NULL,NULL,target,0);}
U0 TouchIngameBlockSelectionScreen_Init(TouchIngameBlockSelectionScreen *s,MCUIHost026 *h,MCUI025 *ui){memset(s,0,sizeof(TouchIngameBlockSelectionScreen));MC026_MenuInit(&s->menu,h,ui,"Touch inventory");Player *p=MC026_Player(h);if(p)s->count=p->inventory.size-9;s->menu.onAction=&TouchIngameBlockSelectionScreen_action;MC026_Button(&s->menu,1,"Back",4,170,55,20);MC026_Button(&s->menu,2,"Menu",65,170,55,20);MC026_Button(&s->menu,3,"Craft",130,170,55,20);MC026_Button(&s->menu,4,"Armor",200,170,70,20);}
U0 TouchIngameBlockSelectionScreen_Destroy(TouchIngameBlockSelectionScreen *s){MC026_MenuDestroy(&s->menu);}
