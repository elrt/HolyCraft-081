U0 DeleteWorldScreen_Init(DeleteWorldScreen *s,MCGuiHost014 *h,LevelSummary *summary){MCString msg;MCString_FromC(&msg,"'");MC013_appendC(&msg,MCString_CStr(&summary->levelName));MC013_appendC(&msg,"' will be lost forever!");ConfirmScreen_Init(&s->base,h,NULL,"Are you sure you want to delete this world?",MCString_CStr(&msg),"Delete","Cancel",0);MCString_Destroy(&msg);s->base.context=s;s->base.postResult=&DeleteWorldScreen_postResult;LevelSummary_CopyInit(&s->summary,summary);}U0 DeleteWorldScreen_Destroy(DeleteWorldScreen *s){LevelSummary_Destroy(&s->summary);ConfirmScreen_Destroy(&s->base);}U0 DeleteWorldScreen_postResult(ConfirmScreen *base,Bool yes){DeleteWorldScreen *s=base->context;MCGuiHost014 *h=base->host;if(yes)h->deleteLevel(h->host,&s->summary.levelDir);h->chooseScreen(h->host,SELECT_WORLD_SCREEN);}
