U0 InvalidLicenseScreen_Init(InvalidLicenseScreen *s,MCLicenseHost015 *h,I32 err,Bool quit){memset(s,0,sizeof(InvalidLicenseScreen));s->host=h;s->err=err;s->quitMode=quit;MCString_Init(&s->line1);MCString_Init(&s->line2);MCString_Init(&s->line3);}
U0 InvalidLicenseScreen_Destroy(InvalidLicenseScreen *s){MCGuiHost014 *g=s->host->gui;if(s->okButton)g->destroyButton(g->host,s->okButton);if(s->buyButton)g->destroyButton(g->host,s->buyButton);MCString_Destroy(&s->line1);MCString_Destroy(&s->line2);MCString_Destroy(&s->line3);}
U0 InvalidLicenseScreen_render(InvalidLicenseScreen *s,I32 x,I32 y,F32 pt){MCGuiHost014 *g=s->host->gui;g->dirt(g->host);g->centered(g->host,MCString_CStr(&s->line1),g->width/2,s->titleY,0xffffff);g->centered(g->host,MCString_CStr(&s->line2),g->width/2,s->titleY+24,0xffffff);g->centered(g->host,MCString_CStr(&s->line3),g->width/2,s->titleY+60,0xffffff);g->renderBase(g->host,x,y,pt);}
U0 InvalidLicenseScreen_init(InvalidLicenseScreen *s){MCGuiHost014 *g=s->host->gui;U8 buf[32];s->okButton=g->createButton(g->host,1,"Ok");s->buyButton=g->createButton(g->host,2,"Buy");if(s->quitMode){s->host->setLabel(g->host,s->okButton,"Quit");}if(s->err(U32)>1){snprintf(buf,32,"%d",s->err);MCString_Destroy(&s->line1);MCString_FromC(&s->line1,"License verification failed (error ");MC013_appendC(&s->line1,buf);MC013_appendC(&s->line1,")");MCString_Destroy(&s->line2);MCString_FromC(&s->line2,"Try again later.");MCString_Destroy(&s->line3);MCString_FromC(&s->line3,"You need to be connected to the internet\nonce while you start the game.");}g->addButton(g->host,s->okButton);g->addFocus(g->host,s->okButton);if(s->quitMode){g->addButton(g->host,s->buyButton);g->addFocus(g->host,s->buyButton);}}
U0 InvalidLicenseScreen_setupPositions(InvalidLicenseScreen *s){MCGuiHost014 *g=s->host->gui;I32 x=(g->width-200)/2,buyY,okY;s->titleY=g->height/5-18;buyY=s->titleY+84;okY=buyY+s->host->buttonHeight(g->host,s->buyButton)+4;if(!s->quitMode)okY-=24;g->setBounds(g->host,s->buyButton,x,buyY,200,-1);g->setBounds(g->host,s->okButton,x,okY,200,-1);}
U0 InvalidLicenseScreen_tick(InvalidLicenseScreen *s){}U0 InvalidLicenseScreen_buttonClicked(InvalidLicenseScreen *s,I32 id){if(id==1)s->host->quit(s->host->gui->host);if(id==2)s->host->buy(s->host->gui->host);}
