U0 DisconnectionScreen_Init(DisconnectionScreen *s,MCGuiHost014 *h,MCString *reason){s->host=h;MCString_CopyInit(&s->reason,reason);s->okButton=NULL;}U0 DisconnectionScreen_Destroy(DisconnectionScreen *s){if(s->okButton)s->host->destroyButton(s->host->host,s->okButton);MCString_Destroy(&s->reason);}U0 DisconnectionScreen_render(DisconnectionScreen *s,I32 x,I32 y,F32 pt){MCGuiHost014 *h=s->host;I32 width;h->dirt(h->host);h->renderBase(h->host,x,y,pt);width=h->textWidth(h->host,MCString_CStr(&s->reason));h->textShadow(h->host,MCString_CStr(&s->reason),(h->width-width)/2,h->height/2-32,-1);}U0 DisconnectionScreen_init(DisconnectionScreen *s){MCGuiHost014 *h=s->host;s->okButton=h->createButton(h->host,1,"Ok");h->addButton(h->host,s->okButton);h->addFocus(h->host,s->okButton);h->setBounds(h->host,s->okButton,(h->width-128)/2,h->height/2,128,-1);}Bool DisconnectionScreen_isInGameScreen(DisconnectionScreen *s){return FALSE;}U0 DisconnectionScreen_buttonClicked(DisconnectionScreen *s,I32 id){if(id==1)s->host->leaveGame(s->host->host,FALSE,TRUE);}
