// Batch026; algorithms and omissions documented in docs/BATCH026.md.
Bool ChatScreen_sendChatMessage(ChatScreen *s){if(!s->input.text.size)return FALSE;Player *p=MC026_Player(s->menu.host);if(!p)return FALSE;Bool sent=MC026_Command(s->menu.host,MC026_CHAT_SEND,&s->input.text,&p->name,0,0);if(s->online && !sent)return FALSE;if(!s->online && s->gui)Gui_addMessage(s->gui,&p->name,&s->input.text,200);MCString copy;MCString_CopyInit(&copy,&s->input.text);MCVector_Push(&s->history,&copy);s->historyIndex=s->history.size;MC024_SetString(&s->input.text,"");if(s->input.platform)AppPlatform_updateTextBoxText(s->input.platform,&s->input.text);return TRUE;}
U0 ChatScreen_setHistory(ChatScreen *s,I32 delta){I32 i=s->historyIndex+delta;if(i<0)i=0;if(i>s->history.size)i=s->history.size;s->historyIndex=i;if(i==s->history.size)MC024_SetString(&s->input.text,"");else MCString_Assign(&s->input.text,MCVector_At(&s->history,i));}
Bool ChatScreen_guiMessagesUpdated(ChatScreen *s){if(!s->gui)return FALSE;if(s->snapshot.size!=s->gui->messages.size)return TRUE;I32 i;for(i=0;i<s->snapshot.size;i++){GuiMessage *m=MCVector_At(&s->gui->messages,i);if(!MC026_Same(&m->fullMessage,MCVector_At(&s->snapshot,i)))return TRUE;}return FALSE;}
U0 ChatScreen_action(MCMenu026 *m,I32 id){ChatScreen *s=m;if(id==1)ChatScreen_sendChatMessage(s);else if(id==2){s->keyboardVisible=!s->keyboardVisible;if(s->keyboardVisible)TextBox_setFocus(&s->input);else TextBox_loseFocus(&s->input);}else{TextBox_loseFocus(&s->input);MC026_MenuBack(m,FALSE);}}
U0 ChatScreen_draw(MCMenu026 *m){ChatScreen *s=m;if(s->gui)Gui_renderChatMessages(s->gui,FALSE);s->messageCount=0;if(s->gui){s->messageCount=s->gui->messages.size;MCStringVector_Destroy(&s->snapshot);MCVector_Init(&s->snapshot,sizeof(MCString));I32 i;for(i=0;i<s->gui->messages.size;i++){GuiMessage *msg=MCVector_At(&s->gui->messages,i);MCString copy;MCString_CopyInit(&copy,&msg->fullMessage);MCVector_Push(&s->snapshot,&copy);}}}
U0 ChatScreen_Init(ChatScreen *s,MCUIHost026 *h,MCUI025 *ui,Bool online){memset(s,0,sizeof(ChatScreen));MC026_MenuInit(&s->menu,h,ui,"Chat");s->menu.screen.pause=FALSE;s->menu.screen.closeOnHurt=TRUE;s->menu.onAction=&ChatScreen_action;s->menu.draw=&ChatScreen_draw;s->online=online;if(h)s->gui=h->gui;MCVector_Init(&s->history,sizeof(MCString));MCVector_Init(&s->snapshot,sizeof(MCString));AppPlatform *platform=NULL;if(h && h->minecraft)platform=h->minecraft->platform;TextBox_Init(&s->input,platform,ui,"",160,NULL,0,0);s->input.base.x=5;s->input.base.y=145;s->input.base.width=240;MCPtrVector_Push(&s->menu.screen.elements,&s->input.widget);MC026_Button(&s->menu,0,"Back",4,175,50,20);MC026_Button(&s->menu,1,"Send",250,145,60,20);MC026_Button(&s->menu,2,"Keyboard",180,175,110,20);}
U0 ChatScreen_Destroy(ChatScreen *s){TextBox_loseFocus(&s->input);TextBox_Destroy(&s->input);MCStringVector_Destroy(&s->history);MCStringVector_Destroy(&s->snapshot);MC026_MenuDestroy(&s->menu);}
