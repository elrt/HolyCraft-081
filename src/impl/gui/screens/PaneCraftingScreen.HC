// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 PaneCraftingScreen_recheckRecipes(PaneCraftingScreen *s){I32 i,j;for(i=0;i<s->rows.size;i++){MCCraftRow026 *row=MCVector_At(&s->rows,i);row->craftable=s->player!=NULL;for(j=0;j<row->required.size;j++){MCRecipeItem *need=MCVector_At(&row->required,j);if(!s->player || MC026_Count(&s->player->inventory,need)<need->count)row->craftable=FALSE;}if(row->results->size && s->player)row->owned=MC026_Count(&s->player->inventory,MCVector_At(row->results,0));}s->order.size=0;for(i=0;i<s->rows.size;i++){MCCraftRow026 *row=MCVector_At(&s->rows,i);j=0;for(;j<s->order.size;j++){I32 idx=*(MCVector_At(&s->order,j)(I32*));MCCraftRow026 *other=MCVector_At(&s->rows,idx);if((row->craftable && !other->craftable) || (row->craftable==other->craftable && strcmp(row->name.data,other->name.data)<0))break;}MCVector_Insert(&s->order,j,&i);}}
U0 PaneCraftingScreen_loadRecipes(PaneCraftingScreen *s){I32 i;for(i=0;i<s->recipes->book.entries.size;i++){MCRecipeEntry009 *e=MCVector_At(&s->recipes->book.entries,i);MCVector *results;Recipe *base;I32 size;if(e->shaped){ShapedRecipe *r=e->recipe;results=&r->results;base=&r->base;size=ShapedRecipe_getCraftingSize(r);}else{ShapelessRecipe *r=e->recipe;results=&r->results;base=&r->base;size=ShapelessRecipe_getCraftingSize(r);}if(size>s->craftSize || !results->size)continue;MCCraftRow026 row;memset(&row,0,sizeof(row));row.entry=e;row.results=results;ItemPack_getItemInstances(&base->items,&row.required);MCRecipeItem *out=MCVector_At(results,0);U8 buf[64];sprintf(buf,"%d:%d",out->id,out->aux);MCString_FromC(&row.name,buf);MCVector_Push(&s->rows,&row);}PaneCraftingScreen_recheckRecipes(s);}
Bool PaneCraftingScreen_craftSelectedItem(PaneCraftingScreen *s){if(!s->player || s->selected<0 || s->selected>=s->rows.size)return FALSE;PaneCraftingScreen_recheckRecipes(s);MCCraftRow026 *row=MCVector_At(&s->rows,s->selected);if(!row->craftable)return FALSE;/* Stage all removals in a cloned container: overlapping wildcard demands cannot consume half a recipe. */FillingContainer clone;MC024_ImportInventory(&clone,&s->player->inventory);I32 j;Bool ok=TRUE;for(j=0;j<row->required.size;j++){MCRecipeItem *r=MCVector_At(&row->required,j);ItemInstance it;ItemInstance_Init(&it,clone.registry,r->id,r->count,r->aux);Bool exact=r->aux!=-1 && !r->damageable && !Recipe_isAnyAuxValue(r->id);I32 removed=FillingContainer_removeResource(&clone,&it,exact);if(removed!=0){ok=FALSE;break;}}if(ok){ok=MC024_CommitInventory(&s->player->inventory,&clone);if(ok)for(j=0;j<row->results->size;j++){MCRecipeItem *r=MCVector_At(row->results,j);ItemInstance it;ItemInstance_Init(&it,s->player->inventory.registry,r->id,r->count,r->aux);MC026_Return(s->player,&it);}}FillingContainer_Destroy(&clone);PaneCraftingScreen_recheckRecipes(s);return ok;}
U0 PaneCraftingScreen_action(MCMenu026 *m,I32 id){PaneCraftingScreen *s=m;if(id==1)PaneCraftingScreen_craftSelectedItem(s);else MC026_MenuBack(m,FALSE);}
U0 PaneCraftingScreen_Init(PaneCraftingScreen *s,MCUIHost026 *h,MCUI025 *ui,Recipes *recipes,I32 size){memset(s,0,sizeof(PaneCraftingScreen));MC026_MenuInit(&s->menu,h,ui,"Crafting");s->player=MC026_Player(h);s->recipes=recipes;s->craftSize=size;s->selected=-1;MCVector_Init(&s->rows,sizeof(MCCraftRow026));MCVector_Init(&s->order,sizeof(I32));s->menu.onAction=&PaneCraftingScreen_action;MC026_Button(&s->menu,1,"Craft",210,170,90,20);MC026_Button(&s->menu,2,"Back",4,170,70,20);if(recipes)PaneCraftingScreen_loadRecipes(s);}
U0 PaneCraftingScreen_Destroy(PaneCraftingScreen *s){I32 i;for(i=0;i<s->rows.size;i++){MCCraftRow026 *row=MCVector_At(&s->rows,i);MCVector_Destroy(&row->required);MCString_Destroy(&row->name);}MCVector_Destroy(&s->rows);MCVector_Destroy(&s->order);MC026_MenuDestroy(&s->menu);}
