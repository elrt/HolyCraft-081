// Batch026; algorithms and omissions documented in docs/BATCH026.md.
I32 ArmorScreen_slot(ArmorScreen *s,ItemInstance *item){if(ItemInstance_isNull(item) || !item->itemClass || !item->itemClass->armor || !s->menu.host || s->menu.host->armorSlot==NULL)return -1;return s->menu.host->armorSlot(s->menu.host->context,item);}
Bool ArmorScreen_canMoveToSlot(ArmorScreen *s,I32 slot,ItemInstance *item){return slot>=0 && slot<4 && ArmorScreen_slot(s,item)==slot;}
U0 ArmorScreen_updateItems(ArmorScreen *s){s->slots.size=0;if(!s->player)return;I32 i;for(i=9;i<s->player->inventory.size;i++)if(ArmorScreen_slot(s,s->player->inventory.items[i])>=0)MCVector_Push(&s->slots,&i);s->performUpdate=FALSE;}
Bool ArmorScreen_takeAndClearSlot(ArmorScreen *s,I32 slot){if(!s->player || slot<0 || slot>3)return FALSE;ItemInstance *item=&s->player->armor[slot];if(ItemInstance_isNull(item))return FALSE;I32 empty=Inventory_getEmptySlotsCount(&s->player->inventory);ItemInstance copy=*item;ItemInstance_setNull(item);MC026_Return(s->player,&copy);s->performUpdate=s->performUpdate || empty!=Inventory_getEmptySlotsCount(&s->player->inventory);return s->performUpdate;}
Bool ArmorScreen_addItem(ArmorScreen *s,I32 index){if(!s->player || index<0 || index>=s->slots.size)return FALSE;I32 physical=*(MCVector_At(&s->slots,index)(I32*));ItemInstance *item=s->player->inventory.items[physical];I32 slot=ArmorScreen_slot(s,item);if(slot<0 || slot>3)return FALSE;ItemInstance old=s->player->armor[slot];s->player->armor[slot]=*item;Inventory_clearSlot(&s->player->inventory,physical);if(!ItemInstance_isNull(&old))MC026_Return(s->player,&old);s->performUpdate=TRUE;ArmorScreen_updateItems(s);return TRUE;}
U0 ArmorScreen_action(MCMenu026 *m,I32 id){ArmorScreen *s=m;if(id>=0 && id<4)ArmorScreen_takeAndClearSlot(s,id);else MC026_MenuBack(m,FALSE);}
U0 ArmorScreen_Init(ArmorScreen *s,MCUIHost026 *h,MCUI025 *ui){memset(s,0,sizeof(ArmorScreen));MC026_MenuInit(&s->menu,h,ui,"Armor");s->menu.onAction=&ArmorScreen_action;s->player=MC026_Player(h);MCVector_Init(&s->slots,sizeof(I32));I32 i;for(i=0;i<4;i++)MC026_Button(&s->menu,i,"Armor",10+i*60,30,55,20);MC026_Button(&s->menu,4,"Back",4,170,70,20);ArmorScreen_updateItems(s);}
U0 ArmorScreen_Destroy(ArmorScreen *s){MCVector_Destroy(&s->slots);MC026_MenuDestroy(&s->menu);}
