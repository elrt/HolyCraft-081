// Batch022: gui/screens/ProgressScreen; explicit host ABI, see docs/BATCH022.md.
U0 ProgressScreen_Init(ProgressScreen *s,I32 w,I32 h,MC022DrawHost *host) {s->ticks=0;s->width=w;s->height=h;s->host=host;MC022_Box(&s->cancel,w/2-60,h/2+42,120,24);}
U0 ProgressScreen_tick(ProgressScreen *s,I32 status) {s->ticks++;if(s->ticks==200 && !status)MC022_Event(s->host,MC022_DISCONNECT,0,"Could not connect to server. Try again.");}
Bool ProgressScreen_handleBackEvent(ProgressScreen *s,Bool down,I32 stage) {if(!down && stage==4)MC022_Event(s->host,MC022_START,0,s);return TRUE;}
U0 ProgressScreen_buttonClicked(ProgressScreen *s,I32 id,I32 stage) {if(id==0 && stage==4)MC022_Event(s->host,MC022_START,0,s);}
U0 ProgressScreen_render(ProgressScreen *s,I32 stage,Bool generated,I32 progress,I32 status,U8 *message,F64 time) {s->cancel.visible=stage==4;if(generated){MC022_Event(s->host,MC022_CLOSE,0,s);return;}GuiComponent022 g;GuiComponent022_Init(&g,s->host);MC022_Texture(s->host,"gui/background.png");if(progress>=0){GuiComponent022_fill(&g,s->width/2-50,s->height/2+16,s->width/2+50,s->height/2+18,0xFF808080);GuiComponent022_fill(&g,s->width/2-50,s->height/2+16,s->width/2-50+progress,s->height/2+18,0xFF80FF80);}MC022_Center(s->host,"Generating world",s->width/2,s->height/2-20,0xFFFFFF);MC022_Center(s->host,message,s->width/2,s->height/2+4,0xFFFFFF);if(status==0 || status==4){U8 spinner[2];U8 *syms="-\\|/";I32 i=time*5.5;i=i%4;if(i<0)i+=4;spinner[0]=syms[i];spinner[1]=0;MC022_Center(s->host,spinner,s->width/2+MC022_TextWidth(s->host,message)/2+6,s->height/2+4,0xFFFFFFFF);}}
