// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 TouchStartMenuScreen_updateLicense(TouchStartMenuScreen *s,I32 license){s->license=license;s->invalid=license>1;Bool enabled=license>=0 && license<=1;s->menu.buttons[0].base.active=enabled;s->menu.buttons[1].base.active=enabled;if(s->invalid)MC026_Command(s->menu.host,MC026_INVALID_LICENSE,NULL,NULL,license,0);}
U0 TouchStartMenuScreen_setupPlayButtons(TouchStartMenuScreen *s,Bool realms){s->realms=realms;Button *a=&s->menu.buttons[0],*b=&s->menu.buttons[1];a->base.width=b->base.width=100;a->base.height=b->base.height=30;a->base.x=b->base.x=s->menu.screen.width/2-50;I32 y=s->menu.screen.height/2+10;if(realms)y=s->menu.screen.height/2-15;a->base.y=y;b->base.y=y+40;b->base.visible=realms;}
U0 TouchStartMenuScreen_chooseRandomSplash(TouchStartMenuScreen *s,Random *rng){s->currentSplash=Random_genrand_int32(rng)%MC026_SplashCount;MC024_SetString(&s->splash,MC026_Splashes[s->currentSplash]);}
U0 TouchStartMenuScreen_action(MCMenu026 *m,I32 id){if(id==4)MC026_Command(m->host,MC026_BUY,NULL,NULL,0,0);else MC026_Command(m->host,MC026_NAVIGATE,NULL,NULL,108,id);}
U0 TouchStartMenuScreen_draw(MCMenu026 *m){TouchStartMenuScreen *s=m;MC025_Text(m->screen.ui,&s->splash,15,45,0xffff00);}
U0 TouchStartMenuScreen_Init(TouchStartMenuScreen *s,MCUIHost026 *h,MCUI025 *ui){memset(s,0,sizeof(TouchStartMenuScreen));MC026_MenuInit(&s->menu,h,ui,"Minecraft PE 0.8.1 — HolyC WIP");s->menu.screen.inGame=FALSE;s->menu.onAction=&TouchStartMenuScreen_action;s->menu.draw=&TouchStartMenuScreen_draw;MCString_Init(&s->splash);MC026_Button(&s->menu,1,"Play",0,0,100,30);MC026_Button(&s->menu,2,"Realms",0,0,100,30);MC026_Button(&s->menu,3,"Options",4,170,70,20);MC026_Button(&s->menu,4,"Buy",240,170,65,20);TouchStartMenuScreen_setupPlayButtons(s,FALSE);TouchStartMenuScreen_updateLicense(s,-1);}
U0 TouchStartMenuScreen_Destroy(TouchStartMenuScreen *s){MCString_Destroy(&s->splash);MC026_MenuDestroy(&s->menu);}
