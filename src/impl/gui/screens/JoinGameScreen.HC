// Batch022: gui/screens/JoinGameScreen; explicit host ABI, see docs/BATCH022.md.
U0 JoinGameScreen_Init(JoinGameScreen *s,I32 w,I32 h,MC022DrawHost *host) {memset(s,0,sizeof(JoinGameScreen));s->width=w;s->height=h;s->host=host;MC022_Box(&s->join,0,0,120,24);MC022_Box(&s->back,0,0,120,24);s->join.active=FALSE;Touch_AvailableGamesList_Init(&s->list,host,w);JoinGameScreen_setupPositions(s);}
U0 JoinGameScreen_Destroy(JoinGameScreen *s) {Touch_AvailableGamesList_Destroy(&s->list);}
U0 JoinGameScreen_setupPositions(JoinGameScreen *s) {s->join.y=s->height-26;s->back.y=s->height-26;s->join.w=120;s->back.w=120;s->join.x=s->width/2-124;s->back.x=s->width/2+4;}
Bool JoinGameScreen_isIndexValid(JoinGameScreen *s,I32 index) {return index>=0 && index<s->list.servers.size;}
U0 MC022_FilterServers(MCVector *out,MCVector *all) {MCVector_Init(out,sizeof(MC022Server));MC022Server *p=all->data(MC022Server*);I64 i;for(i=0;i<all->size;i++)if(p[i].name.size){MC022Server copy;MCString_CopyInit(&copy.name,&p[i].name);MCString_CopyInit(&copy.address,&p[i].address);copy.badge=p[i].badge;MCVector_Push(out,&copy);}}
U0 JoinGameScreen_tick(JoinGameScreen *s,MCVector *all) {MCVector current;MC022_FilterServers(&current,all);MC022Server *fresh=current.data(MC022Server*),*old=s->list.servers.data(MC022Server*);I64 i,j;if(current.size==s->list.servers.size){for(i=s->list.servers.size-1;i>=0;i--)for(j=0;j<current.size;j++)if(MCString_Equal(&fresh[j].address,&old[i].address))MCString_Assign(&old[i].name,&fresh[j].name);}else{/* Original non-touch code never assigns current to servers; preserve this quirk. */I32 saved=s->list.selected;s->list.selected=-1;if(JoinGameScreen_isIndexValid(s,saved))for(i=0;i<s->list.servers.size;i++)if(MCString_Equal(&old[i].address,&old[saved].address)){s->list.selected=i;break;}}s->join.active=JoinGameScreen_isIndexValid(s,s->list.selected);MC022_ServerListClear(&current);}
Bool JoinGameScreen_handleBackEvent(JoinGameScreen *s,Bool down) {if(!down){MC022_Event(s->host,MC022_CANCEL_LOCATE,0,s);MC022_Event(s->host,MC022_START,0,s);}return TRUE;}
U0 JoinGameScreen_buttonClicked(JoinGameScreen *s,I32 id) {if(id==2 && JoinGameScreen_isIndexValid(s,s->list.selected)){MC022Server *p=s->list.servers.data(MC022Server*);MC022_Event(s->host,MC022_JOIN,0,&p[s->list.selected]);s->join.active=FALSE;s->back.active=FALSE;}if(id==3)JoinGameScreen_handleBackEvent(s,FALSE);}
U0 JoinGameScreen_render(JoinGameScreen *s,Bool network,F64 time) {if(!network){MC022_Center(s->host,"WiFi is disabled",s->width/2,s->height/2-8,0xFFFFFFFF);return;}MC022_Center(s->host,"Scanning for WiFi Games...",s->width/2,8,0xFFFFFFFF);U8 spin[2],*syms="-\\|/";I32 i=time*5.5;i=i%4;if(i<0)i+=4;spin[0]=syms[i];spin[1]=0;MC022_Center(s->host,spin,s->width/2+MC022_TextWidth(s->host,"Scanning for WiFi Games...")/2+6,8,0xFFFFFFFF);}
