// Batch022: gui/screens/PauseScreen; explicit host ABI, see docs/BATCH022.md.
U0 PauseScreen_Init(PauseScreen *s,Bool copyMap,MC022DrawHost *host) {memset(s,0,sizeof(PauseScreen));s->copyMap=copyMap;s->host=host;MCVector_Init(&s->players,sizeof(MC022Player));MC022_Box(&s->back,0,0,120,24);MC022_Box(&s->quit,0,0,120,24);MC022_Box(&s->copy,0,0,120,24);MC022_Box(&s->options,0,0,120,24);}
U0 PauseScreen_Destroy(PauseScreen *s) {I64 i;MC022Player *p=s->players.data(MC022Player*);for(i=0;i<s->players.size;i++)MCString_Destroy(&p[i].name);MCVector_Destroy(&s->players);}
U0 PauseScreen_setupPositions(PauseScreen *s,I32 width,I32 height,I32 labelWidth) {I32 x=width/20,y=height/10;s->back.w=8*x;s->quit.w=8*x;s->copy.w=8*x;s->options.w=8*x;s->back.x=x;s->options.x=x;s->quit.x=x;s->back.y=48;s->options.y=80;s->quit.y=112;s->copy.x=(width-s->copy.w)/2;s->copy.y=144;s->label.x=x+s->back.w/2-labelWidth/2;s->label.y=31;s->playersBox.w=8*x;s->playersBox.h=8*y;s->playersBox.x=width-s->playersBox.w-x;s->playersBox.y=y;}
Bool PauseScreen_playerListChanged(PauseScreen *s,MCVector *players) {if(players->size!=s->players.size)return TRUE;I64 i;MC022Player *a=s->players.data(MC022Player*),*b=players->data(MC022Player*);for(i=0;i<players->size;i++)if(a[i].identity!=b[i].identity)return TRUE;return FALSE;}
U0 PauseScreen_rebuildPlayerList(PauseScreen *s,MCVector *players) {if(players==&s->players)return;PauseScreen_Destroy(s);MCVector_Init(&s->players,sizeof(MC022Player));I64 i;MC022Player *p=players->data(MC022Player*);for(i=0;i<players->size;i++){MC022Player copy;copy.identity=p[i].identity;MCString_CopyInit(&copy.name,&p[i].name);MCVector_Push(&s->players,&copy);}}
U0 PauseScreen_tick(PauseScreen *s,MCVector *players) {if(PauseScreen_playerListChanged(s,players))PauseScreen_rebuildPlayerList(s,players);s->ticks++;}
U0 PauseScreen_buttonClicked(PauseScreen *s,I32 id) {if(id==1)MC022_Event(s->host,MC022_CLOSE,0,s);else if(id==2)MC022_Event(s->host,MC022_LEAVE,0,s);else if(id==3)MC022_Event(s->host,MC022_LEAVE,1,s);else if(id==4)MC022_Event(s->host,MC022_OPTIONS,1,s);}
U0 PauseScreen_renderPlayers(PauseScreen *s,MCString *local) {I64 i;MC022Player *p=s->players.data(MC022Player*);for(i=0;i<s->players.size;i++){U32 color=0xFF777777;if(MCString_Equal(&p[i].name,local))color=0xFFFFFFFF;MC022_Text(s->host,MCString_CStr(&p[i].name),s->playersBox.x+3,s->playersBox.y+4+i*15,color,TRUE);}}
