U0 Touch_PromotionStartMenuScreen_Init(Touch_PromotionStartMenuScreen *s,MCPromotionHost014 *h){s->host=h;s->playButton2=NULL;s->realmsButton2=NULL;}
U0 Touch_PromotionStartMenuScreen_init(Touch_PromotionStartMenuScreen *s){MCPromotionHost014 *h=s->host;U0 *settings;h->baseInit(h->host);s->playButton2=h->getButton(h->host,0);s->realmsButton2=h->getButton(h->host,1);settings=h->getButton(h->host,2);h->setLabel(h->host,s->playButton2,"Creative");h->setLabel(h->host,s->realmsButton2,"Survival");h->setActiveVisible(h->host,settings,FALSE,FALSE);}
U0 Touch_PromotionStartMenuScreen_buttonClicked(Touch_PromotionStartMenuScreen *s,U0 *b){MCPromotionHost014 *h=s->host;if(b==s->playButton2){h->selectLevel(h->host,"creative","creative",0,-1);h->showProgress(h->host);}else if(b==s->realmsButton2){h->selectLevel(h->host,"survival","survival",0,-1);h->showProgress(h->host);}else h->baseClick(h->host,b);}
