U0 DeathScreen_Init(DeathScreen *s,MCGuiHost014 *h){memset(s,0,sizeof(DeathScreen));s->host=h;}U0 DeathScreen_Destroy(DeathScreen *s){MCGuiHost014 *h=s->host;if(s->respawnButton)h->destroyButton(h->host,s->respawnButton);if(s->quitButton)h->destroyButton(h->host,s->quitButton);}U0 DeathScreen_render(DeathScreen *s,I32 x,I32 y,F32 pt){MCGuiHost014 *h=s->host;h->gradient(h->host,0,0,h->width,h->height,0x60500000,0xA0803030);h->titleScale(h->host,"You died!",h->width/4,h->height/8);if(s->tickCounter>29)h->renderBase(h->host,x,y,pt);}U0 DeathScreen_init(DeathScreen *s){MCGuiHost014 *h=s->host;s->respawnButton=h->createButton(h->host,1,"Respawn!");s->quitButton=h->createButton(h->host,2,"Main menu");h->addButton(h->host,s->respawnButton);h->addButton(h->host,s->quitButton);h->addFocus(h->host,s->respawnButton);h->addFocus(h->host,s->quitButton);}U0 DeathScreen_setupPositions(DeathScreen *s){MCGuiHost014 *h=s->host;I32 w=h->width/4;h->setBounds(h->host,s->respawnButton,h->width/2-w-10,h->height/2,w,-1);h->setBounds(h->host,s->quitButton,h->width/2+10,h->height/2,w,-1);}U0 DeathScreen_tick(DeathScreen *s){s->tickCounter++;}Bool DeathScreen_renderGameBehind(DeathScreen *s){return TRUE;}U0 DeathScreen_buttonClicked(DeathScreen *s,U0 *b){MCGuiHost014 *h=s->host;if(s->tickCounter>29){if(b==s->respawnButton){h->respawn(h->host);h->setScreenNull(h->host);}if(b==s->quitButton)h->leaveGame(h->host,FALSE,TRUE);}}
