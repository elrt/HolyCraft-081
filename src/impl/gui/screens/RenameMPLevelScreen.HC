U0 RenameMPLevelScreen_Init(RenameMPLevelScreen *s,MCGuiHost014 *h,MCString *name){s->host=h;MCString_CopyInit(&s->name,name);}U0 RenameMPLevelScreen_Destroy(RenameMPLevelScreen *s){MCString_Destroy(&s->name);}U0 RenameMPLevelScreen_render(RenameMPLevelScreen *s,I32 x,I32 y,F32 pt){MCGuiHost014 *h=s->host;I32 status,i;I64 j;U8 forbidden[15]={47,10,13,9,0,12,96,63,42,92,60,62,124,34,58};Bool skip;MCString input,dest;U8 *buf;h->background(h->host);status=h->inputStatus(h->host);if(status<0)return;if(status==1 && h->firstInput(h->host,&input)){buf=MC_Alloc(input.size+1);j=0;for(i=0;i<input.size;i++){I32 k;skip=FALSE;for(k=0;k<15;k++)if(input.data[i]==forbidden[k]){skip=TRUE;break;}if(!skip)buf[j++]=input.data[i];}MCString_FromBytes(&dest,buf,j);free(buf);MCString_Destroy(&input);if(!j){MCString_Destroy(&dest);MCString_FromC(&dest,"saved_world");}h->renameLevel(h->host,&s->name,&dest);MCString_Destroy(&dest);}h->chooseScreen(h->host,START_MENU_SCREEN);}U0 RenameMPLevelScreen_init(RenameMPLevelScreen *s){s->host->showDialog(s->host->host,4);s->host->createUserInput(s->host->host);}
