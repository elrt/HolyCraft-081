// Batch026; algorithms and omissions documented in docs/BATCH026.md.
Bool FurnaceScreen_isAllowedItem(FurnaceScreen *s,ItemInstance *item){if(!s->furnace || ItemInstance_isNull(item))return FALSE;if(s->selectedSlot==1)return FurnaceTileEntity_getBurnDuration(item)>0;if(s->selectedSlot==0)return FurnaceRecipes_isFurnaceItem(s->furnace->recipes,ItemInstance_getId(item));return FALSE;}
Bool FurnaceScreen_canMoveToFurnace(FurnaceScreen *s,ItemInstance *item){if(!FurnaceScreen_isAllowedItem(s,item))return FALSE;ItemInstance *dst=&s->furnace->inventory[s->selectedSlot];if(ItemInstance_isNull(dst))return TRUE;return ItemInstance_canStack(dst,item) && dst->count<MC026_MaxStack(dst);}
U0 FurnaceScreen_recheckRecipes(FurnaceScreen *s){s->fuels.size=s->ingredients.size=0;if(!s->player || !s->furnace)return;I32 i;for(i=9;i<s->player->inventory.size;i++){ItemInstance *item=s->player->inventory.items[i];if(ItemInstance_isNull(item))continue;if(FurnaceTileEntity_getBurnDuration(item)>0)MCVector_Push(&s->fuels,&i);if(FurnaceRecipes_isFurnaceItem(s->furnace->recipes,ItemInstance_getId(item)))MCVector_Push(&s->ingredients,&i);}s->dirty=FALSE;}
Bool FurnaceScreen_moveOver(FurnaceScreen *s,ItemInstance *item,I32 limit,ItemInstance *out){ItemInstance_Init(out,s->player->inventory.registry,0,0,0);if(ItemInstance_isNull(item) || limit<=0)return FALSE;I32 n=MC026_Amount(item->count,s->percent,s->heldTicks);if(n>limit)n=limit;if(n>item->count)n=item->count;MCRecipeItem need;need.id=ItemInstance_getId(item);need.count=n;need.aux=item->metadata;need.damageable=FALSE;ItemInstance copy=*item;copy.count=n;if(!MC026_Remove(&s->player->inventory,&need))return FALSE;*out=copy;s->dirty=TRUE;return TRUE;}
Bool FurnaceScreen_handleAddItem(FurnaceScreen *s,ItemInstance *item){if(!s->player || !FurnaceScreen_canMoveToFurnace(s,item))return FALSE;I32 slot=s->selectedSlot;ItemInstance *dst=&s->furnace->inventory[slot];I32 limit=MC026_MaxStack(item);if(!ItemInstance_isNull(dst))limit-=dst->count;ItemInstance moved;if(!FurnaceScreen_moveOver(s,item,limit,&moved))return FALSE;if(ItemInstance_isNull(dst))FurnaceTileEntity_setItem(s->furnace,slot,&moved);else{dst->count+=moved.count;s->furnace->changed++;}FurnaceScreen_recheckRecipes(s);return TRUE;}
Bool FurnaceScreen_takeAndClearSlot(FurnaceScreen *s,I32 slot){if(!s->player || !s->furnace || slot<0 || slot>2)return FALSE;ItemInstance *item=&s->furnace->inventory[slot];if(ItemInstance_isNull(item))return FALSE;ItemInstance copy=*item;ItemInstance_setNull(item);s->furnace->changed++;MC026_Return(s->player,&copy);FurnaceScreen_recheckRecipes(s);return TRUE;}
U0 FurnaceScreen_action(MCMenu026 *m,I32 id){FurnaceScreen *s=m;if(id<3){s->selectedSlot=id;FurnaceScreen_takeAndClearSlot(s,id);}else MC026_MenuBack(m,FALSE);}
U0 FurnaceScreen_Init(FurnaceScreen *s,MCUIHost026 *h,MCUI025 *ui,FurnaceTileEntity *furnace){memset(s,0,sizeof(FurnaceScreen));MC026_MenuInit(&s->menu,h,ui,"Furnace");s->player=MC026_Player(h);s->furnace=furnace;s->percent=100;MCVector_Init(&s->fuels,sizeof(I32));MCVector_Init(&s->ingredients,sizeof(I32));s->menu.onAction=&FurnaceScreen_action;I32 i;for(i=0;i<3;i++)MC026_Button(&s->menu,i,"Slot",20+i*80,30,70,24);MC026_Button(&s->menu,4,"Back",4,170,70,20);FurnaceScreen_recheckRecipes(s);}
U0 FurnaceScreen_Destroy(FurnaceScreen *s){MCVector_Destroy(&s->fuels);MCVector_Destroy(&s->ingredients);MC026_MenuDestroy(&s->menu);}
