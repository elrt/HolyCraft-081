// Batch026; algorithms and omissions documented in docs/BATCH026.md.
I32 CreateWorldScreen_getSeed(CreateWorldScreen *s,I32 epoch){if(s->seed.text.size<=1)return epoch;MCString trim;Util_stringTrim(&trim,&s->seed.text);I32 n=epoch;if(trim.size && sscanf(trim.data,"%d",&n)<=0)n=Util_hashCode(&trim);MCString_Destroy(&trim);return n;}
U0 CreateWorldScreen_getLevelName(CreateWorldScreen *s,MCString *out){if(!s->name.text.size)MCString_Assign(out,&s->name.text);else MC024_SetString(out,"Level");}
U0 CreateWorldScreen_setGameType(CreateWorldScreen *s,Bool creative){s->creative=creative;}
Bool CreateWorldScreen_generateLocalGame(CreateWorldScreen *s,I32 epoch){if(s->waiting || s->type!=0)return FALSE;MCString name,dir;MCString_CopyInit(&name,&s->name.text);MCString_Init(&dir);if(!name.size)MC024_SetString(&name,"Level");SelectWorldScreen_getUniqueLevelName(&s->select,&name,&dir);Bool ok=MC026_Command(s->select.menu.host,MC026_CREATE_LOCAL,&dir,&name,CreateWorldScreen_getSeed(s,epoch),s->creative);s->waiting=ok;s->failed=!ok;MCString_Destroy(&dir);MCString_Destroy(&name);return ok;}
U0 CreateWorldScreen_action(MCMenu026 *m,I32 id){CreateWorldScreen *s=m;if(id==4)CreateWorldScreen_setGameType(s,TRUE);else if(id==5)CreateWorldScreen_setGameType(s,FALSE);else if(id==1)CreateWorldScreen_generateLocalGame(s,MC024_Epoch());else MC026_MenuBack(m,FALSE);}
U0 CreateWorldScreen_Init(CreateWorldScreen *s,MCUIHost026 *h,MCUI025 *ui,I32 type){memset(s,0,sizeof(CreateWorldScreen));SelectWorldScreen_Init(&s->select,h,ui);MC024_SetString(&s->select.menu.title,"Create world");s->select.menu.onAction=&CreateWorldScreen_action;s->select.menu.onTick=NULL;s->select.menu.draw=NULL;s->type=type;AppPlatform *p=NULL;if(h && h->minecraft)p=h->minecraft->platform;TextBox_Init(&s->name,p,ui,"World",40,NULL,0,0);TextBox_Init(&s->seed,p,ui,"Seed",40,NULL,0,1);s->name.base.x=s->seed.base.x=10;s->name.base.y=40;s->seed.base.y=80;s->name.base.width=s->seed.base.width=130;MCPtrVector_Push(&s->select.menu.screen.elements,&s->name.widget);MCPtrVector_Push(&s->select.menu.screen.elements,&s->seed.widget);MC026_Button(&s->select.menu,4,"Creative",165,40,130,25);MC026_Button(&s->select.menu,5,"Survival",165,80,130,25);}
U0 CreateWorldScreen_Destroy(CreateWorldScreen *s){TextBox_Destroy(&s->name);TextBox_Destroy(&s->seed);SelectWorldScreen_Destroy(&s->select);}
