// Inline implementation from PlayScreenStateSetting.hpp.
U0 PlayScreenStateSetting_InitValues(PlayScreenStateSetting *s,Bool a,Bool b,Bool c,Bool d,Bool external,Bool newButton,I32 panel){s->showEditButton=a;s->field_1=b;s->field_2=c;s->field_3=d;s->showExternalButton=external;s->showNewButton=newButton;s->panel=panel;MCString_FromC(&s->field_C,"");}U0 PlayScreenStateSetting_Init(PlayScreenStateSetting *s){PlayScreenStateSetting_InitValues(s,FALSE,FALSE,FALSE,FALSE,FALSE,FALSE,NONE);}U0 PlayScreenStateSetting_Destroy(PlayScreenStateSetting *s){MCString_Destroy(&s->field_C);}
