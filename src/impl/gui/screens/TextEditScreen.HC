// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
SignTileEntity *TextEditScreen_getSign(TextEditScreen *s){LevelChunk *c=Level_getChunk(s->level,s->x>>4,s->z>>4,FALSE);if(!c)return NULL;I32 i;for(i=0;i<c->blockEntities.size;i++){MCTileEntity025 *p=MCVector_At(&c->blockEntities,i);if(p->x==s->x && p->y==s->y && p->z==s->z && p->kind==4)return p->object;}return NULL;}
U0 TextEditScreen_close(TextEditScreen *s){AppPlatform_hideKeyboard(s->platform);s->closed=TRUE;if(s->screen.minecraft)Minecraft_setScreen(s->screen.minecraft,NULL);}
Bool TextEditScreen_keyHook(U0 *object,I32 key){TextEditScreen *s=object;SignTileEntity *sign=TextEditScreen_getSign(s);if(!sign){TextEditScreen_close(s);return TRUE;}if(key==8){if(sign->textLines[s->currentLine].size){MC025_PopChar(&sign->textLines[s->currentLine]);return TRUE;}s->currentLine--;if(s->currentLine<0)s->currentLine=3;}else if(key==13)s->currentLine=(s->currentLine+1)%4;else return FALSE;AppPlatform_updateTextBoxText(s->platform,&sign->textLines[s->currentLine]);return TRUE;}
Bool TextEditScreen_textHook(U0 *object,MCString *text,Bool composing){TextEditScreen *s=object;SignTileEntity *sign=TextEditScreen_getSign(s);if(!sign){TextEditScreen_close(s);return TRUE;}MCString t;MCString_CopyInit(&t,&sign->textLines[s->currentLine]);MCString_AppendBytes017(&t,text->data,text->size);I32 n=MC025_UTFCount(&t);if(n>=0 && n<=15)MCString_Assign(&sign->textLines[s->currentLine],&t);MCString_Destroy(&t);return TRUE;}
Bool TextEditScreen_backHook(U0 *object,Bool held){TextEditScreen *s=object;SignTileEntity *sign=TextEditScreen_getSign(s);if(sign && s->changed!=NULL)s->changed(s->context,sign);TextEditScreen_close(s);return TRUE;}
U0 TextEditScreen_Init(TextEditScreen *s,Level *level,SignTileEntity *sign,AppPlatform *platform,MCUI025 *ui){memset(s,0,sizeof(TextEditScreen));Screen_Init(&s->screen,ui);s->level=level;s->platform=platform;s->x=sign->x;s->y=sign->y;s->z=sign->z;s->screen.context=s;s->screen.keyHook=&TextEditScreen_keyHook;s->screen.textHook=&TextEditScreen_textHook;s->screen.backHook=&TextEditScreen_backHook;}
Bool TextEditScreen_open(TextEditScreen *s){SignTileEntity *sign=TextEditScreen_getSign(s);if(!sign)return FALSE;AppPlatform_showKeyboard(s->platform,&sign->textLines[s->currentLine],15,FALSE);s->opened=TRUE;return TRUE;}
U0 TextEditScreen_setTextboxText(TextEditScreen *s,MCString *text){SignTileEntity *sign=TextEditScreen_getSign(s);if(sign)MCString_Assign(&sign->textLines[s->currentLine],text);}
U0 TextEditScreen_tick(TextEditScreen *s){s->tickCounter++;}
U0 TextEditScreen_renderText(TextEditScreen *s){SignTileEntity *sign=TextEditScreen_getSign(s);if(!sign){TextEditScreen_close(s);return;}I32 i;for(i=0;i<4;i++){MCString t;MCString_Init(&t);if(i==s->currentLine && MC025_UTFCount(&sign->textLines[i])<=13){MC025_Append(&t,"> ");MC025_Append(&t,sign->textLines[i].data);MC025_Append(&t," <");}else MCString_Assign(&t,&sign->textLines[i]);MC025_Text(s->screen.ui,&t,5,10+i*10,0xff000000);MCString_Destroy(&t);}}
