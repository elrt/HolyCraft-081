// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 SelectWorldScreen_getUniqueLevelName(SelectWorldScreen *s,MCString *name,MCString *out){MCString_Assign(out,name);Bool exists=TRUE;I32 i;while(exists){exists=FALSE;for(i=0;i<s->selection.items.size;i++){LevelSummary *v=MCVector_At(&s->selection.items,i);if(MC026_Same(&v->levelDir,out)){exists=TRUE;MC025_Append(out,"-");break;}}}}
Bool SelectWorldScreen_isIndexValid(SelectWorldScreen *s,I32 index){return index>=0 && index<s->selection.items.size;}
Bool SelectWorldScreen_select(SelectWorldScreen *s,I32 index){if(s->loading || !SelectWorldScreen_isIndexValid(s,index))return FALSE;LevelSummary *v=MCVector_At(&s->selection.items,index);Bool ok=MC026_Command(s->menu.host,MC026_LOAD_LOCAL,&v->levelDir,&v->levelName,-1,-1);s->failed=!ok;s->loading=ok;return ok;}
U0 SelectWorldScreen_action(MCMenu026 *m,I32 id){SelectWorldScreen *s=m;if(id==1)SelectWorldScreen_select(s,s->selection.selected);else if(id==2)MC026_Command(m->host,MC026_NAVIGATE,NULL,NULL,103,0);else MC026_MenuBack(m,FALSE);}
U0 SelectWorldScreen_tickMenu(MCMenu026 *m){SelectWorldScreen *s=m;WorldSelectionList_tick(&s->selection,FALSE);if(s->selection.activated){SelectWorldScreen_select(s,s->selection.activation);s->selection.activated=FALSE;}}
U0 SelectWorldScreen_draw(MCMenu026 *m){SelectWorldScreen *s=m;I32 i;for(i=0;i<s->selection.items.size && i<10;i++){LevelSummary *v=MCVector_At(&s->selection.items,i);MC025_Text(m->screen.ui,&v->levelName,12,30+i*12,0xffffff);}}
U0 SelectWorldScreen_Init(SelectWorldScreen *s,MCUIHost026 *h,MCUI025 *ui){memset(s,0,sizeof(SelectWorldScreen));MC026_MenuInit(&s->menu,h,ui,"Select world");s->menu.screen.inGame=FALSE;s->menu.onAction=&SelectWorldScreen_action;s->menu.onTick=&SelectWorldScreen_tickMenu;s->menu.draw=&SelectWorldScreen_draw;WorldSelectionList_Init(&s->selection,320,200);MC026_Button(&s->menu,0,"Back",4,170,65,20);MC026_Button(&s->menu,1,"Play",100,170,65,20);MC026_Button(&s->menu,2,"New",210,170,65,20);}
U0 SelectWorldScreen_Destroy(SelectWorldScreen *s){WorldSelectionList_Destroy(&s->selection);MC026_MenuDestroy(&s->menu);}
