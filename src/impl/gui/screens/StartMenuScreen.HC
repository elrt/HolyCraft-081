// Batch022: gui/screens/StartMenuScreen; explicit host ABI, see docs/BATCH022.md.
U0 StartMenuScreen_Init(StartMenuScreen *s,I32 w,I32 h,MCString *version,MC022DrawHost *host) {memset(s,0,sizeof(StartMenuScreen));s->width=w;s->height=h;s->host=host;MC022_Box(&s->start,0,0,160,24);MC022_Box(&s->join,0,0,160,24);MC022_Box(&s->options,0,0,78,22);MC022_Box(&s->buy,0,0,78,22);MC022_Box(&s->create,0,0,78,22);MCString_FromC(&s->copyright,"\xFFMojang AB");MCString_CopyInit(&s->version,version);s->start.active=FALSE;s->join.active=FALSE;s->options.active=FALSE;StartMenuScreen_setupPositions(s);}
U0 StartMenuScreen_Destroy(StartMenuScreen *s) {MCString_Destroy(&s->copyright);MCString_Destroy(&s->version);}
U0 StartMenuScreen_setupPositions(StartMenuScreen *s) {s->start.y=s->height/2-3;s->join.y=s->height/2+25;s->options.y=s->height/2+55;s->buy.y=s->options.y;s->create.y=s->options.y;s->start.x=(s->width-s->start.w)/2;s->join.x=(s->width-s->join.w)/2;s->options.x=s->join.x;s->buy.x=s->join.x+s->options.w+4;s->create.x=s->buy.x;s->copyrightX=s->width-MC022_TextWidth(s->host,MCString_CStr(&s->copyright))-1;s->versionX=(s->width-MC022_TextWidth(s->host,MCString_CStr(&s->version)))/2;}
U0 StartMenuScreen_updateLicense(StartMenuScreen *s,I32 license,Bool buyButton) {if(license>1){MC022_Event(s->host,MC022_INVALID_LICENSE,license,s);return;}Bool ok=license>=0;s->start.active=ok;s->join.active=ok;s->options.active=ok;}
U0 StartMenuScreen_buttonClicked(StartMenuScreen *s,I32 id) {if(id==2)MC022_Event(s->host,MC022_SELECT_WORLD,0,s);if(id==3){MC022_Event(s->host,MC022_LOCATE,0,s);MC022_Event(s->host,MC022_PLAY,1,s);}if(id==4)MC022_Event(s->host,MC022_OPTIONS,0,s);if(id==5)MC022_Event(s->host,MC022_BUY,0,s);}
Bool StartMenuScreen_handleBackEvent(StartMenuScreen *s,Bool down) {MC022_Event(s->host,MC022_QUIT,0,s);return TRUE;}
U0 StartMenuScreen_render(StartMenuScreen *s,I32 textureWidth,I32 textureHeight) {if(textureWidth>0){F32 half=textureWidth*0.5;if(s->width*0.5<=half)half=s->width*0.5;F32 scale=(half+half)/textureWidth;MC022Vertex q[4];MC022_V(&q[0],s->width*0.5-half,scale*textureHeight+4.0,0.0,0.0,1.0,0xFFFFFFFF);MC022_V(&q[1],s->width*0.5+half,scale*textureHeight+4.0,0.0,1.0,1.0,0xFFFFFFFF);MC022_V(&q[2],s->width*0.5+half,4.0,0.0,1.0,0.0,0xFFFFFFFF);MC022_V(&q[3],s->width*0.5-half,4.0,0.0,0.0,0.0,0xFFFFFFFF);MC022_Texture(s->host,"gui/title.png");if(s->host && (s->host->quad!=NULL))s->host->quad(s->host->ctx,q,TRUE);}MC022_Text(s->host,MCString_CStr(&s->version),s->versionX,62,0xFFCCCCCC,TRUE);MC022_Text(s->host,MCString_CStr(&s->copyright),s->copyrightX,s->height-10,0xFFFFFF,TRUE);}
