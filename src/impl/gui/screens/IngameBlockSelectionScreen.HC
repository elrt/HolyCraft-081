// Batch026; algorithms and omissions documented in docs/BATCH026.md.
I32 IngameBlockSelectionScreen_getSlotHeight(IngameBlockSelectionScreen *s){if(s->columns==9)return 22;return 20;}
I32 IngameBlockSelectionScreen_getSlotPosX(IngameBlockSelectionScreen *s,I32 column){return -10*s->columns+s->menu.screen.width/2+20*column+2;}
I32 IngameBlockSelectionScreen_getSlotPosY(IngameBlockSelectionScreen *s,I32 row){I32 base=3;if(s->columns==9)base=8;return base+IngameBlockSelectionScreen_getSlotHeight(s)*row;}
I32 IngameBlockSelectionScreen_getSelectedSlot(IngameBlockSelectionScreen *s,I32 x,I32 y){I32 left=-10*s->columns+s->menu.screen.width/2,top=IngameBlockSelectionScreen_getSlotPosY(s,0)-4;if(x<left || y<top)return -1;I32 column=(x-left)/20;if(column>=s->columns)return -1;return column+s->columns*((y-top)/IngameBlockSelectionScreen_getSlotHeight(s));}
Bool IngameBlockSelectionScreen_isAllowed(IngameBlockSelectionScreen *s,I32 index){return index>=0 && index<s->count;}
Bool IngameBlockSelectionScreen_selectSlotAndClose(IngameBlockSelectionScreen *s){Player *p=MC026_Player(s->menu.host);if(!p || !IngameBlockSelectionScreen_isAllowed(s,s->selected) || !p->inventory.items[s->selected+9])return FALSE;Inventory_moveToSelectionSlot(&p->inventory,0,s->selected+9);Inventory_selectSlot(&p->inventory,0);s->menu.closed=TRUE;if(s->menu.host->gui)Gui_flashSlot(s->menu.host->gui,0);MC026_Command(s->menu.host,MC026_NAVIGATE,NULL,NULL,0,0);return TRUE;}
U0 IngameBlockSelectionScreen_keyPressed(IngameBlockSelectionScreen *s,I32 key){Player *p=MC026_Player(s->menu.host);if(!p || s->columns<1)return;Options *o=&s->menu.host->minecraft->options;I32 n=s->selected,c=n%s->columns;if(key==o->keyCodes[2] && c>0)n--;else if(key==o->keyCodes[3] && c<s->columns-1)n++;else if(key==o->keyCodes[1] && n/s->columns<s->rows-1)n+=s->columns;else if(key==o->keyCodes[0] && n/s->columns>0)n-=s->columns;if(IngameBlockSelectionScreen_isAllowed(s,n))s->selected=n;if(key==o->keyCodes[14])IngameBlockSelectionScreen_selectSlotAndClose(s);if(key==o->keyCodes[15])MC026_MenuBack(&s->menu,FALSE);}
U0 IngameBlockSelectionScreen_action(MCMenu026 *m,I32 id){if(id==1)MC026_Command(m->host,MC026_NAVIGATE,NULL,NULL,104,0);else MC026_MenuBack(m,FALSE);}
U0 IngameBlockSelectionScreen_Init(IngameBlockSelectionScreen *s,MCUIHost026 *h,MCUI025 *ui,I32 columns){memset(s,0,sizeof(IngameBlockSelectionScreen));MC026_MenuInit(&s->menu,h,ui,"Inventory");s->columns=columns;if(columns<1)s->columns=1;Player *p=MC026_Player(h);if(p)s->count=p->inventory.size-9;s->rows=(s->count+s->columns-1)/s->columns;s->menu.onAction=&IngameBlockSelectionScreen_action;MC026_Button(&s->menu,1,"Armor",220,170,80,20);}
U0 IngameBlockSelectionScreen_Destroy(IngameBlockSelectionScreen *s){MC026_MenuDestroy(&s->menu);}
