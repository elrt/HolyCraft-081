// Inline original from AvailableGamesList.hpp.
U0 AvailableGamesList_Init(AvailableGamesList *s,MCAvailableGamesHost012 *h,I32 w,I32 ht){s->host=h;s->base=h->createBase(h->host,w,ht,24,w-30,28);MCVector_Init(&s->servers,sizeof(PingedCompatibleServer));}U0 AvailableGamesList_Destroy(AvailableGamesList *s){I64 i;PingedCompatibleServer *e;for(i=0;i<s->servers.size;i++){e=MCVector_At(&s->servers,i);PingedCompatibleServer_Destroy(e);}MCVector_Destroy(&s->servers);s->host->destroyBase(s->host->host,s->base);}U0 AvailableGamesList_addServer(AvailableGamesList *s,PingedCompatibleServer *e){PingedCompatibleServer copy;PingedCompatibleServer_CopyInit(&copy,e);MCVector_Push(&s->servers,&copy);}I32 AvailableGamesList_getNumberOfItems(AvailableGamesList *s){return s->servers.size;}U0 AvailableGamesList_selectItem(AvailableGamesList *s,I32 i,Bool b){s->selectedItem=i;}Bool AvailableGamesList_isSelectedItem(AvailableGamesList *s,I32 i){return i==s->selectedItem;}U0 AvailableGamesList_renderItem(AvailableGamesList *s,I32 i,I32 x,I32 y){PingedCompatibleServer *e=MCVector_At(&s->servers,i);U32 color=0xffffa0;if(e->field_1C)color=0xff00b0;s->host->drawString(s->host->host,MCString_CStr(&e->name),x,y+2,color);s->host->drawString(s->host->host,e->host->toStringNoPort(e->host->host,e->address),x,y+16,0xffffa0);}
