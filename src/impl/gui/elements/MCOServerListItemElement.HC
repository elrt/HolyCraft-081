// Batch022: gui/elements/MCOServerListItemElement; explicit host ABI, see docs/BATCH022.md.
U0 MCOServerListItemElement_Init(MCOServerListItemElement *s,MCOServerListItem *item,Bool manage,MC022DrawHost *h) {memset(s,0,sizeof(MCOServerListItemElement));MC022_Box(&s->bounds,0,0,24,32);MC022_Box(&s->join,0,0,120,32);MC022_Box(&s->manage,0,0,32,32);s->hasManage=manage;s->manage.active=item->myWorld;s->manage.visible=item->myWorld;MCOServerListItem_CopyInit(&s->item,item);s->host=h;}
U0 MCOServerListItemElement_Destroy(MCOServerListItemElement *s) {MCOServerListItem_Destroy(&s->item);}
U0 MCOServerListItemElement_layout(MCOServerListItemElement *s) {s->manage.x=s->bounds.x+s->bounds.w-32;s->manage.y=s->bounds.y;s->join.x=s->bounds.x;s->join.y=s->bounds.y;s->join.w=s->bounds.w;if(s->hasManage && s->manage.visible)s->join.w-=32;}
U0 MCOServerListItemElement_tick(MCOServerListItemElement *s,F32 x,F32 y) {if(fabsf(x-s->downX)>20.0 || fabsf(y-s->downY)>20.0){s->pressed=0;s->join.pressed=FALSE;s->manage.pressed=FALSE;}}
U0 MCOServerListItemElement_mouseClicked(MCOServerListItemElement *s,I32 x,I32 y,F32 rawX,F32 rawY) {I32 id=0;if(s->hasManage && MC022_Hit(&s->manage,x,y))id=2;else if(s->item.open && MC022_Hit(&s->join,x,y))id=1;if(id){s->pressed=id;s->downX=rawX;s->downY=rawY;if(id==1)s->join.pressed=TRUE;else s->manage.pressed=TRUE;}}
U0 MCOServerListItemElement_mouseReleased(MCOServerListItemElement *s,I32 x,I32 y,Bool network) {if(s->pressed==2 && MC022_Hit(&s->manage,x,y)){MC022_Event(s->host,MC022_MANAGE_SERVER,0,&s->item);return;}if(s->pressed==1 && MC022_Hit(&s->join,x,y)){if(s->item.open && !s->joining){s->joining=TRUE;MC022_Event(s->host,MC022_JOIN,network,&s->item);}return;}s->pressed=0;s->join.pressed=FALSE;s->manage.pressed=FALSE;}
U0 MCOServerListItemElement_render(MCOServerListItemElement *s) {MCOServerListItemElement_layout(s);I32 x=s->bounds.x,y=s->bounds.y;U32 color=0xFFFFFFFF;if(s->join.pressed)color=0xFFFFA0;MC022_Text(s->host,MCString_CStr(&s->item.worldName),x+5,y+6,color,TRUE);MC022_Text(s->host,MCString_CStr(&s->item.ownerName),x+5,y+18,0xFFBBBBBB,TRUE);U8 count[64];snprintf(count,64,"%d/%d",s->item.playerNames.size(I32),s->item.maxNrPlayers);MC022_Text(s->host,count,x+s->join.w-10-MC022_TextWidth(s->host,count),y+12,0xFFFFFFFF,TRUE);GuiComponent022 g;GuiComponent022_Init(&g,s->host);MC022_Texture(s->host,"gui/gui.png");I32 u=182;if(s->item.open)u=200;GuiComponent022_blit(&g,x+s->join.w-50,y+11,u,0,9,10,9,10);}
