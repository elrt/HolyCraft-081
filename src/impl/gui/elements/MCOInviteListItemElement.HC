// Batch022: gui/elements/MCOInviteListItemElement; explicit host ABI, see docs/BATCH022.md.
U0 MCOInviteListItemElement_Init(MCOInviteListItemElement *s,MCString *name,MC022DrawHost *h) {memset(s,0,sizeof(MCOInviteListItemElement));MC022_Box(&s->bounds,0,0,24,24);MC022_Box(&s->remove,0,0,11,11);s->remove.active=FALSE;s->remove.visible=FALSE;MCString_CopyInit(&s->name,name);s->host=h;}
U0 MCOInviteListItemElement_Destroy(MCOInviteListItemElement *s) {MCString_Destroy(&s->name);}
U0 MCOInviteListItemElement_onFriendSearchCompleted(MCOInviteListItemElement *s,MCString *name) {if(s->completed)return;MCString_Assign(&s->name,name);s->remove.active=TRUE;s->remove.visible=TRUE;s->completed=TRUE;}
U0 MCOInviteListItemElement_setupPositions(MCOInviteListItemElement *s) {s->remove.x=s->bounds.x+s->bounds.w-s->remove.w-5;s->remove.y=s->bounds.y+(s->bounds.h-s->remove.h)/2;}
U0 MCOInviteListItemElement_mouseClicked(MCOInviteListItemElement *s,I32 x,I32 y,I32 button) {if(button!=1)return;s->pressed=MC022_Hit(&s->remove,x,y);s->remove.pressed=s->pressed;}
U0 MCOInviteListItemElement_mouseReleased(MCOInviteListItemElement *s,I32 x,I32 y,I32 button) {if(button!=1 || !s->pressed)return;if(MC022_Hit(&s->remove,x,y))MC022_Event(s->host,MC022_REMOVE_FRIEND,0,&s->name);else{s->pressed=FALSE;s->remove.pressed=FALSE;}}
U0 MCOInviteListItemElement_render(MCOInviteListItemElement *s) {GuiComponent022 g;GuiComponent022_Init(&g,s->host);I32 x=s->bounds.x,y=s->bounds.y,w=s->bounds.w,h=s->bounds.h;GuiComponent022_fill(&g,x,y,x+w,y+1,0xFFCFC6BE);GuiComponent022_fill(&g,x,y+1,x+w,y+h-1,0xFF948681);GuiComponent022_fill(&g,x,y+h-1,x+w,y+h,0xFF312D31);if(s->completed)MC022_Text(s->host,MCString_CStr(&s->name),x+5,y+(h-10)/2,0xFFFFFFFF,TRUE);else MC022_Text(s->host,"searching...",x+5,y+(h-10)/2,0xFFD4C521,FALSE);if(s->remove.visible){MC022_Texture(s->host,"gui/gui.png");GuiComponent022_blit(&g,s->remove.x,s->remove.y,182,10,11,11,11,11);}}
