// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 LocalServerListItemElement_Init(LocalServerListItemElement *s,MCUIHost026 *h){memset(s,0,sizeof(LocalServerListItemElement));s->host=h;MCString_Init(&s->name);MCString_Init(&s->address);LevelSummary_Init(&s->summary);}
U0 LocalServerListItemElement_setLevel(LocalServerListItemElement *s,LevelSummary *level){s->local=TRUE;s->type=0;LevelSummary_Assign(&s->summary,level);MCString_Assign(&s->name,&level->levelName);}
U0 LocalServerListItemElement_setExternal(LocalServerListItemElement *s,ExternalServer *server){s->local=FALSE;s->type=2;s->port=server->port;MCString_Assign(&s->name,&server->name);MCString_Assign(&s->address,&server->ip);}
U0 LocalServerListItemElement_getLastPlayedString(LocalServerListItemElement *s,I32 epoch,MCString *out){if(!s->local){MC024_SetString(out,"");return;}I32 delta=epoch-s->summary.lastPlayed;U8 buf[64];if(delta<=86399)strcpy(buf,"Today");else if(delta<=172799)strcpy(buf,"Yesterday");else if(delta<=604799)sprintf(buf,"%d days ago",delta/86400);else if(delta<=2419199)sprintf(buf,"%d weeks ago",delta/604800);else strcpy(buf,"long ago");MC024_SetString(out,buf);}
U0 LocalServerListItemElement_mouseClicked(LocalServerListItemElement *s,F32 x,F32 y,Bool deleteButton){s->pressed=TRUE;s->deletePressed=deleteButton && s->edit;s->pressX=x;s->pressY=y;}
U0 LocalServerListItemElement_tick(LocalServerListItemElement *s,F32 x,F32 y){if(fabsf(x-s->pressX)>20 || fabsf(y-s->pressY)>20)s->pressed=FALSE;s->ticks++;}
Bool LocalServerListItemElement_mouseReleased(LocalServerListItemElement *s,Bool inside){Bool run=s->pressed && inside;s->pressed=FALSE;if(!run)return FALSE;if(s->local && !s->deletePressed)return MC026_Command(s->host,MC026_LOAD_LOCAL,&s->summary.levelDir,&s->name,-1,-1);if(s->deletePressed)return MC026_Command(s->host,MC026_NAVIGATE,&s->summary.levelDir,NULL,101,0);return MC026_Command(s->host,MC026_NAVIGATE,&s->address,&s->name,102,s->port);}
U0 LocalServerListItemElement_Destroy(LocalServerListItemElement *s){MCString_Destroy(&s->name);MCString_Destroy(&s->address);LevelSummary_Destroy(&s->summary);}
