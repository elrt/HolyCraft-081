U0 Label_Init(Label *s,MCGuiHost011 *h,U8 *text,I32 color,I32 xbase,I32 ybase,I32 width,Bool shadow){GuiElement_Init(&s->base,h,TRUE,TRUE,0,0,24,24);MCString_FromC(&s->text,text);s->textColor=color;s->widthBase=xbase;s->heightBase=ybase;s->field_3A=0;s->fixedWidth=width>0;s->base.width=width;s->textShadow=shadow;Label_setupPositions(s);}
U0 Label_render(Label *s){GuiElement *g=&s->base;MCGuiHost011 *h=g->host;GuiElement_render(g);h->wordWrap(h->host,MCString_CStr(&s->text),s->widthBase+g->x,g->y+s->heightBase,g->width-s->widthBase+1.0,s->textColor,s->textShadow,s->field_3A);}
U0 Label_setupPositions(Label *s){GuiElement *g=&s->base;MCGuiHost011 *h=g->host;if(!s->fixedWidth)g->width=s->widthBase+h->textWidth(h->host,MCString_CStr(&s->text));g->height=s->heightBase+h->fontHeight(h->host,MCString_CStr(&s->text),g->width-s->widthBase);}U8 *Label_getText(Label *s){return MCString_CStr(&s->text);}U0 Label_setText(Label *s,U8 *text){MCString_Destroy(&s->text);MCString_FromC(&s->text,text);Label_setupPositions(s);}U0 Label_setWidth(Label *s,I32 width){s->base.width=width;s->fixedWidth=TRUE;}U0 Label_Destroy(Label *s){MCString_Destroy(&s->text);GuiElement_Destroy(&s->base);}
