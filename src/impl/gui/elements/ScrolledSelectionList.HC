// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 ScrolledSelectionList_Init(ScrolledSelectionList *s,I32 width,I32 height,I32 top,I32 bottom,I32 slot,I32 count){memset(s,0,sizeof(ScrolledSelectionList));s->width=width;s->height=height;s->top=top;s->bottom=bottom;s->slotHeight=slot;s->count=count;s->pressed=-2;s->startY=-1;s->renderSelection=TRUE;}
U0 ScrolledSelectionList_setRenderHeader(ScrolledSelectionList *s,Bool render,I32 height){s->header=0;if(render)s->header=height;}
I32 ScrolledSelectionList_getMaxPosition(ScrolledSelectionList *s){return s->count*s->slotHeight+s->header;}
I32 ScrolledSelectionList_getItemAtPosition(ScrolledSelectionList *s,I32 x,I32 y){if(s->slotHeight<=0 || x<s->width/2-110 || x>s->width/2+110)return -1;I32 raw=(((y-s->top)-s->header)+s->scroll(I32))-4,index=raw/s->slotHeight;if(raw<0 || index<0 || index>=s->count)return -1;return index;}
F32 ScrolledSelectionList_capYPosition(ScrolledSelectionList *s){I32 total=ScrolledSelectionList_getMaxPosition(s);F32 max=total-((s->bottom-s->top)-4);if(max<0)max*=0.5;if(s->scroll<0)s->scroll=0;if(s->scroll>max)s->scroll=max;return total;}
I32 ScrolledSelectionList_updateInput(ScrolledSelectionList *s,I32 x,I32 y,Bool down,I32 now){I32 selected=-1;if(down){if(y>=s->top && y<=s->bottom && y!=s->lastY){if(s->pressed==-1)s->pressed=1;else if(s->pressed>=0){if(s->pressed==1){s->startTime=now;s->startY=y;}else{F32 delta=y-s->previousY;s->scroll-=delta;s->velocity+=delta;}s->pressed=0;}s->lastY=-1;}}else{if(s->pressed>=0){if(fabs(s->velocity)<2)s->velocity=0;if(now-s->startTime<300 && s->slotHeight>0){I32 raw=(((y-s->top)-s->header)+s->scroll(I32))-4,index=raw/s->slotHeight;if(index>=0 && MC023_Abs(s->startY-y)<s->slotHeight){selected=index;s->velocity=0;}}}s->scroll-=s->velocity;s->pressed=-1;}s->velocity*=0.75;s->previousY=y;ScrolledSelectionList_capYPosition(s);return selected;}
