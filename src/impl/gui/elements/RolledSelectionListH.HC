// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 RolledSelectionListH_Init(RolledSelectionListH *s,I32 width,I32 height,I32 left,I32 right,I32 top,I32 bottom,I32 slot,I32 count){memset(s,0,sizeof(RolledSelectionListH));s->width=width;s->height=height;s->left=left;s->right=right;s->top=top;s->bottom=bottom;s->slotWidth=slot;s->count=count;s->pressed=-2;s->initialItem=-1;s->scroll=(slot-width)*0.5;s->previous=s->scroll;s->prior=s->scroll;}
I32 RolledSelectionListH_getItemAtXPositionRaw(RolledSelectionListH *s,I32 raw){if(s->slotWidth<=0 || raw<0)return -1;I32 i=raw/s->slotWidth;if(i<0 || i>=s->count)return -1;return i;}
I32 RolledSelectionListH_getItemAtPosition(RolledSelectionListH *s,I32 x,I32 y){if(y<s->top || y>s->bottom)return -1;return RolledSelectionListH_getItemAtXPositionRaw(s,(((x-s->left)-s->header)+s->scroll(I32))-4);}
Bool RolledSelectionListH_capXPosition(RolledSelectionListH *s){F32 bound=(s->slotWidth-s->width)*0.5;if(s->scroll>=bound){bound+=(s->count-1)*s->slotWidth;if(s->scroll<=bound)return FALSE;}s->scroll=bound;s->velocity=0;return TRUE;}
U0 RolledSelectionListH_tick(RolledSelectionListH *s){F32 old=s->previous;s->delta=s->prior-old;s->prior=old;s->previous=s->scroll-s->velocity;}
F32 RolledSelectionListH_getPos(RolledSelectionListH *s,F32 partial){return s->previous-partial*s->velocity;}
I32 RolledSelectionListH_updateInput(RolledSelectionListH *s,I32 x,I32 y,Bool down,I32 now,F32 partial){I32 select=-1;if(down){if(y>=s->top && y<=s->bottom){if(s->pressed==-1){s->initialTime=now;s->initialX=x;s->initialItem=RolledSelectionListH_getItemAtPosition(s,x,s->height/2);}else if(s->pressed>=0){s->scroll-=x-s->mouse;s->previous=s->scroll;}s->pressed=0;}}else{if(s->pressed>=0){F32 v=s->delta;if(v>20)v=20;else if(v < -20)v=-20;if(fabs(v)<=2.0001)v=0;s->velocity=v;I32 item=RolledSelectionListH_getItemAtPosition(s,x,s->height/2);if(fabs(v)<=10 && now-s->initialTime<300 && item>=0 && item==s->initialItem && MC023_Abs(s->initialX-x)<=9)select=item;}s->pressed=-1;s->scroll=RolledSelectionListH_getPos(s,partial);}s->mouse=x;RolledSelectionListH_capXPosition(s);return select;}
