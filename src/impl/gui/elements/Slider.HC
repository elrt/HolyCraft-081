// Batch022: gui/elements/Slider; explicit host ABI, see docs/BATCH022.md.
U0 Slider_Init(Slider *s,F32 min,F32 max,F32 current,MC022DrawHost *host) {memset(s,0,sizeof(Slider));MC022_Box(&s->bounds,0,0,24,24);MCVector_Init(&s->steps,sizeof(I32));s->minValue=min;s->maxValue=max;s->host=host;if(max!=min)s->progress=(current-min)/(max-min);}
U0 Slider_InitSteps(Slider *s,I32 *values,I32 count,I32 current,MC022DrawHost *host) {Slider_Init(s,0.0,1.0,0.0,host);s->step=TRUE;s->value=current;I32 i;Bool found=FALSE;for(i=0;i<count;i++){MCVector_Push(&s->steps,&values[i]);if(values[i]==current && !found){s->index=i;found=TRUE;}}if(count>1)s->progress=s->index(F32)/(count-1);}
U0 Slider_Destroy(Slider *s) {MCVector_Destroy(&s->steps);}
U0 Slider_setOption(Slider *s) {if(s->step){if((s->setInt!=NULL) && (!(s->getInt!=NULL) || s->getInt(s->ctx)!=s->value))s->setInt(s->ctx,s->value);}else{F32 v=s->minValue+(s->maxValue-s->minValue)*s->progress;if((s->setProgress!=NULL) && (!(s->getProgress!=NULL) || s->getProgress(s->ctx)!=v))s->setProgress(s->ctx,v(F32));}}
U0 Slider_tick(Slider *s,I32 mouseX,Bool hasScreen) {if(hasScreen && s->dragging && s->bounds.w>0){s->progress=MC022_Clamp((mouseX-s->bounds.x)(F32)/s->bounds.w);Slider_setOption(s);}}
U0 Slider_mouseClicked(Slider *s,I32 x,I32 y) {if(MC022_Hit(&s->bounds,x,y))s->dragging=TRUE;}
U0 Slider_mouseReleased(Slider *s) {if(s->dragging && s->step && s->steps.size>1){I32 last=s->steps.size-1;s->index=floorf(last*s->progress+0.5);I32 i=s->index;if(i>last)i=last;if(i<0)i=0;I32 *values=s->steps.data(I32*);s->value=values[i];s->progress=s->index(F32)/last;Slider_setOption(s);}s->dragging=FALSE;}
U0 Slider_render(Slider *s,I32 mouseX,Bool hasScreen) {if(hasScreen && s->dragging && s->bounds.w>0)s->progress=MC022_Clamp((mouseX-s->bounds.x)(F32)/s->bounds.w);GuiComponent022 g;GuiComponent022_Init(&g,s->host);I32 x=s->bounds.x,y=s->bounds.y,w=s->bounds.w;GuiComponent022_fill(&g,x+5,y+7,x+w-5,y+10,-9408400);if(s->step && s->steps.size>1){I32 i,step=(w-10)/(s->steps.size-1),tick=x+4;for(i=0;i<s->steps.size;i++){GuiComponent022_fill(&g,tick,y+5,tick+4,y+12,-7303024);tick+=step;}}MC022_Texture(s->host,"gui/touchgui.png");GuiComponent022_blit(&g,x+((w-10)*s->progress)(I32),y,225,125,11,17,11,17);}
