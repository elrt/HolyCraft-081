U0 OptionsItem_Init(OptionsItem *s,MCGuiHost011 *h,U0 *option,MCGuiChild011 *child){GuiElementContainer_Init(&s->base,h,FALSE,TRUE,0,0,24,12);s->option=option;GuiElementContainer_addChild(&s->base,child);}
U0 OptionsItem_render(OptionsItem *s,I32 x,I32 y){GuiElement *g=&s->base.base;MCGuiHost011 *h=g->host;h->textShadow(h->host,h->optionDescription(h->host,s->option),g->x,g->y+(g->height-8)/2,0xffbbbbbb);GuiElementContainer_render(&s->base,x,y);}
U0 OptionsItem_setupPositions(OptionsItem *s){I64 i;I32 y=0;MCGuiChild011 *c;GuiElement *g=&s->base.base;for(i=0;i<s->base.children.size;i++){c=s->base.children.data[i];c->element->x=g->x+g->width-c->element->width-15;c->element->y=g->y+y;y+=c->element->height;}g->height=y;}U0 OptionsItem_Destroy(OptionsItem *s){GuiElementContainer_Destroy(&s->base);}
