U0 MC022_ServerListClear(MCVector *v) {I64 i;MC022Server *p=v->data(MC022Server*);for(i=0;i<v->size;i++){MCString_Destroy(&p[i].name);MCString_Destroy(&p[i].address);}MCVector_Destroy(v);}
U0 MC022_ServerListCopy(MCVector *dst,MCVector *src) {MCVector_Init(dst,sizeof(MC022Server));I64 i;MC022Server *p=src->data(MC022Server*);for(i=0;i<src->size;i++){MC022Server copy;MCString_CopyInit(&copy.name,&p[i].name);MCString_CopyInit(&copy.address,&p[i].address);copy.badge=p[i].badge;MCVector_Push(dst,&copy);}}
U0 Touch_AvailableGamesList_Init(Touch_AvailableGamesList *s,MC022DrawHost *host,I32 width) {s->pressed=-1;s->selected=-1;s->left=0;s->right=width;s->host=host;MCVector_Init(&s->servers,sizeof(MC022Server));}
U0 Touch_AvailableGamesList_Destroy(Touch_AvailableGamesList *s) {MC022_ServerListClear(&s->servers);}
U0 Touch_AvailableGamesList_selectStart(Touch_AvailableGamesList *s,I32 i) {s->pressed=i;}U0 Touch_AvailableGamesList_selectCancel(Touch_AvailableGamesList *s) {s->pressed=-1;}U0 Touch_AvailableGamesList_selectItem(Touch_AvailableGamesList *s,I32 i) {s->selected=i;}
U0 Touch_AvailableGamesList_renderItem(Touch_AvailableGamesList *s,I32 i,I32 y,I32 height,Bool pointerDownOrReleased) {if(i<0 || i>=s->servers.size)return;MC022Server *p=s->servers.data(MC022Server*);GuiComponent022 g;GuiComponent022_Init(&g,s->host);if(s->pressed==i && pointerDownOrReleased)GuiComponent022_fill(&g,s->left,y,s->right,y+height,0x809E684F);I32 x=s->left+24;U32 color=0xFFFFB0;if(p[i].badge){color=0x6090A0;MC022_Texture(s->host,"gui/badge/minecon140.png");GuiComponent022_blit(&g,x,y+6,0,0,37,8,140,240);x=s->left+74;}MC022_Text(s->host,MCString_CStr(&p[i].name),x,y+6,color,TRUE);MC022_Text(s->host,MCString_CStr(&p[i].address),s->left+24,y+18,16777120,TRUE);}
