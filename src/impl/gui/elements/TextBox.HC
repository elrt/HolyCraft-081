// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
Bool TextBox_modal(U0 *object){TextBox *s=object;return s->focused;}
U0 TextBox_setText(TextBox *s,MCString *text){MCString_Assign(&s->text,text);}
U0 TextBox_setTextboxText(U0 *object,MCString *text){TextBox *s=object;if(s->focused)TextBox_setText(s,text);}
U0 TextBox_setFocus(TextBox *s){if(s->focused)return;AppPlatform_showKeyboard(s->platform,&s->text,s->maxLength,s->validChars!=NULL);s->focused=TRUE;}
Bool TextBox_loseFocus(TextBox *s){if(!s->focused)return FALSE;if(s->updated!=NULL)s->updated(s->owner,s->key);AppPlatform_hideKeyboard(s->platform);s->focused=FALSE;return TRUE;}
U0 TextBox_blur(U0 *object){TextBox_loseFocus(object);}
U0 TextBox_updateText(TextBox *s){if(s->options && s->option==22){Options_setString(s->options,22,&s->text);MCString_Assign(&s->text,&s->options->username);}}
U0 TextBox_keyPressed(U0 *object,I32 key){TextBox *s=object;if(!s->focused)return;if(key==8)MC025_PopChar(&s->text);else if(key==13)TextBox_loseFocus(s);}
U0 TextBox_keyboardNewChar(U0 *object,MCString *text,Bool composing){TextBox *s=object;if(!s->focused || !text->size)return;Bool allowed=s->validChars==NULL;I32 i;for(i=0;!allowed && i<s->validCount;i++)if(text->data[0]==s->validChars[i])allowed=TRUE;if(!allowed)return;MCString candidate;MCString_CopyInit(&candidate,&s->text);if(s->composing)MC025_PopChar(&candidate);MCString_AppendBytes017(&candidate,text->data,text->size);s->composing=composing;I32 count=MC025_UTFCount(&candidate);if(count>=0 && count<=s->maxLength)MCString_Assign(&s->text,&candidate);MCString_Destroy(&candidate);}
Bool TextBox_backPressed(U0 *object,Bool held){TextBox *s=object;if(!s->focused)return FALSE;TextBox_loseFocus(s);TextBox_updateText(s);return TRUE;}
U0 TextBox_tick(U0 *object){TextBox *s=object;if(s->options){s->editable=Options_canModify(s->options,s->option);if(s->focused && !s->editable){s->focused=FALSE;AppPlatform_hideKeyboard(s->platform);}}}
U0 TextBox_render(U0 *object,Bool top,I32 epoch){TextBox *s=object;if(top){if(!s->focused)return;MC025_Rect(s->ui,0,0,s->screenWidth,s->screenHeight,0xff000000);MC025_Text(s->ui,&s->title,5,5,-3355444);MCString t;MCString_CopyInit(&t,&s->text);if(epoch&1)MC025_Append(&t,"_");MC025_Text(s->ui,&t,10,25,-1);MCString_Destroy(&t);return;}I32 c=0xff808080;if(s->editable){MC025_Rect(s->ui,s->base.x,s->base.y,s->base.x+s->base.width,s->base.y+s->base.height,0xff373535);c=-1;}MC025_Text(s->ui,&s->text,s->base.x+5,s->base.y+5,c);}
U0 TextBox_mouse(U0 *object,I32 x,I32 y,I32 button,Bool down,Bool modal){TextBox *s=object;if(modal){Bool done=x>=s->screenWidth-38 && y>=0 && y<38;if(down)s->doneArmed=done;else{if(s->focused && s->doneArmed && done){TextBox_loseFocus(s);TextBox_updateText(s);}s->doneArmed=FALSE;}return;}if(down)s->armed=!s->focused && GuiElement_pointInside(&s->base,x,y);else{if(s->armed && GuiElement_pointInside(&s->base,x,y))TextBox_setFocus(s);s->armed=FALSE;}}
U0 TextBox_Init(TextBox *s,AppPlatform *platform,MCUI025 *ui,U8 *title,I32 maxLength,U8 *validChars,I32 validCount,I32 key){memset(s,0,sizeof(TextBox));GuiElement_Init(&s->base,NULL,TRUE,TRUE,0,0,24,18);s->platform=platform;s->ui=ui;s->maxLength=maxLength;s->validChars=validChars;s->validCount=validCount;s->key=key;s->editable=TRUE;s->option=-1;s->screenWidth=320;s->screenHeight=240;MCString_Init(&s->text);MCString_FromC(&s->title,title);s->widget.object=s;s->widget.modal=&TextBox_modal;s->widget.key=&TextBox_keyPressed;s->widget.text=&TextBox_keyboardNewChar;s->widget.setText=&TextBox_setTextboxText;s->widget.render=&TextBox_render;s->widget.mouse=&TextBox_mouse;s->widget.back=&TextBox_backPressed;s->widget.tick=&TextBox_tick;s->widget.blur=&TextBox_blur;}
U0 TextBox_Destroy(TextBox *s){TextBox_loseFocus(s);MCString_Destroy(&s->text);MCString_Destroy(&s->title);GuiElement_Destroy(&s->base);}
