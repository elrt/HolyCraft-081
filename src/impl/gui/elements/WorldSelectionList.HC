// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 WorldSelectionList_Init(WorldSelectionList *s,I32 width,I32 height){memset(s,0,sizeof(WorldSelectionList));RolledSelectionListH_Init(&s->list,width,height,0,width,26,height-32,120,0);MCVector_Init(&s->items,sizeof(LevelSummary));LevelSummary_Init(&s->chosen);s->selected=-1;s->activation=-1;}
U0 WorldSelectionList_Destroy(WorldSelectionList *s){I32 i;for(i=0;i<s->items.size;i++)LevelSummary_Destroy(MCVector_At(&s->items,i));MCVector_Destroy(&s->items);LevelSummary_Destroy(&s->chosen);}
U0 WorldSelectionList_add(WorldSelectionList *s,LevelSummary *item){LevelSummary copy;LevelSummary_CopyInit(&copy,item);MCVector_Push(&s->items,&copy);s->list.count=s->items.size;}
U0 WorldSelectionList_commit(WorldSelectionList *s){s->list.count=s->items.size;s->selected=-1;if(s->items.size)s->selected=0;}
U0 WorldSelectionList_tweenInited(WorldSelectionList *s){F32 a=MC026_Ease(s->time,s->duration,s->from,s->to);s->list.velocity=a-MC026_Ease(s->time+1,s->duration,s->from,s->to);}
U0 WorldSelectionList_step(WorldSelectionList *s,I32 step){if(step<0 && s->selected<=0)return;if(step>0 && (s->selected<0 || s->selected>=s->list.count-1))return;s->from=s->list.scroll;s->to=s->from+step*s->list.slotWidth;s->time=0;s->duration=8;s->tween=TRUE;WorldSelectionList_tweenInited(s);}
Bool WorldSelectionList_capXPosition(WorldSelectionList *s){Bool cap=RolledSelectionListH_capXPosition(&s->list);if(cap)s->tween=FALSE;return cap;}
U0 WorldSelectionList_selectItem(WorldSelectionList *s,I32 index,Bool ignored){if(s->selected>=0 && s->selected<s->items.size && s->selected==index && !s->activated){s->activated=TRUE;s->activation=index;LevelSummary_Assign(&s->chosen,MCVector_At(&s->items,index));}}
F32 WorldSelectionList_getPos(WorldSelectionList *s,F32 partial){if(!s->tween)return RolledSelectionListH_getPos(&s->list,partial);F32 v=MC026_Ease(s->time,s->duration,s->from,s->to);return v+(MC026_Ease(s->time+1,s->duration,s->from,s->to)-v)*partial;}
U0 WorldSelectionList_tick(WorldSelectionList *s,Bool down){RolledSelectionListH *l=&s->list;RolledSelectionListH_tick(l);s->ticks++;if(down || l->pressed==0)return;s->selected=-1;if(s->tween){s->time++;if(s->time==s->duration){l->velocity=0;s->tween=FALSE;l->scroll=s->to;l->previous=s->to;s->selected=RolledSelectionListH_getItemAtPosition(l,l->width/2,l->height/2);return;}WorldSelectionList_tweenInited(s);return;}F32 speed=fabsf(l->velocity);if(speed>=5){l->velocity*=0.9;return;}l->velocity*=0.8;if(speed<1 && l->pressed<0){F32 x=(l->width-l->slotWidth)/2+l->scroll;I32 item=RolledSelectionListH_getItemAtXPositionRaw(l,(x-l->velocity*10)(I32));F32 d=item*l->slotWidth-x;if(d<l->slotWidth/-2)d+=l->slotWidth;F32 dist=fabsf(d);if(dist<1 && speed<0.1){s->selected=RolledSelectionListH_getItemAtPosition(l,l->width/2,l->height/2);return;}s->time=0;s->from=l->scroll;s->to=l->scroll+d;s->duration=(dist*0.25)(I32)+1;if(s->duration>=7)s->duration=7;s->tween=TRUE;WorldSelectionList_tweenInited(s);}}
