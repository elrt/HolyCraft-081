// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 RolledSelectionListV_Init(RolledSelectionListV *s,I32 width,I32 height,I32 left,I32 right,I32 top,I32 bottom,I32 slot,I32 count){memset(s,0,sizeof(RolledSelectionListV));s->width=width;s->height=height;s->left=left;s->right=right;s->top=top;s->bottom=bottom;s->slotHeight=slot;s->count=count;s->pressed=-2;s->initialY=-1;s->initialItem=-1;}
I32 RolledSelectionListV_getItemAtYPositionRaw(RolledSelectionListV *s,I32 raw){if(s->slotHeight<=0 || raw<0)return -1;I32 i=raw/s->slotHeight;if(i<0 || i>=s->count)return -1;return i;}
I32 RolledSelectionListV_getItemAtPosition(RolledSelectionListV *s,I32 x,I32 y){if(x<s->left || x>s->right)return -1;return RolledSelectionListV_getItemAtYPositionRaw(s,(((y-s->top)-s->header)+s->scroll(I32))-4);}
I32 RolledSelectionListV_getMaxPosition(RolledSelectionListV *s){return s->count*s->slotHeight+s->header;}
I32 RolledSelectionListV_capYPosition(RolledSelectionListV *s){F32 max=RolledSelectionListV_getMaxPosition(s)-((s->bottom-s->top)-4);if(max<0)max*=0.5;if(s->scroll<0)s->scroll=0;if(s->scroll>max)s->scroll=max;return 0;}
U0 RolledSelectionListV_tick(RolledSelectionListV *s,Bool down){if(down)s->delta=s->prior-s->previous;F32 next=s->scroll-s->velocity;s->prior=s->previous;s->previous=next;}
F32 RolledSelectionListV_getPos(RolledSelectionListV *s,F32 partial){return s->previous-partial*s->velocity;}
U0 RolledSelectionListV_evaluate(RolledSelectionListV *s,I32 y){if(fabs(s->initialY-y)>9){s->initialItem=-1;s->cancelled=TRUE;}}
I32 RolledSelectionListV_updateInput(RolledSelectionListV *s,I32 x,I32 y,Bool down,F32 partial){I32 select=-1;if(down){if(y>=s->top && y<=s->bottom){if(s->pressed==-1){s->initialY=y;s->initialItem=RolledSelectionListV_getItemAtPosition(s,s->width/2,y);s->dragBudget=10;s->cancelled=FALSE;}else if(s->pressed>=0){F32 delta=y-s->mouse;if(fabs(delta)<=s->dragBudget)s->dragBudget-=fabs(delta);else{s->dragBudget=0;s->scroll-=delta;s->previous=s->scroll;}}s->pressed=0;}}else{if(s->pressed>=0){F32 v=s->delta;if(v>=10)v=10;else if(v <= -10)v=-10;s->velocity=v;if(fabs(v)<=2.0001)s->velocity=0;I32 item=RolledSelectionListV_getItemAtPosition(s,s->width/2,y);if(x>=s->left && x<=s->right && item>=0 && item==s->initialItem && MC023_Abs(s->initialY-y)<=9)select=item;}s->pressed=-1;s->scroll=RolledSelectionListV_getPos(s,partial);}s->mouse=y;RolledSelectionListV_evaluate(s,y);RolledSelectionListV_capYPosition(s);return select;}
