// Batch022: gui/pane/ItemPane; explicit host ABI, see docs/BATCH022.md.
U0 ItemPane_Init(ItemPane *s,MC022Box *bounds,I32 columns,I32 cellHeight,I32 physicalHeight,Bool vertical,F32 scale,MC022DrawHost *host) {memset(s,0,sizeof(ItemPane));s->bounds=*bounds;s->columns=columns;s->rows=columns;s->cellW=bounds->w;s->cellH=22;s->physicalHeight=physicalHeight;s->vertical=vertical;s->scale=scale;s->host=host;s->flags=514;if(vertical){s->flags=513;s->rows=1;}else{s->cellW=32;s->cellH=bounds->h;}/* cellHeight is source field_5C maxY, not cell dimensions. */}
F32 MC022_Pixel(ItemPane *s,F32 v) {if(s->scale<=0.0)return v;return floorf(v*s->scale)/s->scale;}
U0 ItemPane_drawScrollBar(ItemPane *s,F32 x,F32 y,F32 w,F32 h,F32 opacity) {if(opacity<=0.0)return;GuiComponent022 g;GuiComponent022_Init(&g,s->host);GuiComponent022_fill(&g,x+2.0,y,x+2.0+w,y+h,((opacity*255.0)(I32)<<24)|0xFFFFFF);}
U0 ItemPane_renderBatch(ItemPane *s,MCVector *grid,MCVector *items) {if(!items->size)return;MC022_Clip(s->host,TRUE,(s->bounds.x*s->scale)(I32),s->physicalHeight-((s->bounds.y+s->bounds.h)*s->scale)(I32),(s->bounds.w*s->scale)(I32),(s->bounds.h*s->scale)(I32));I32 phase;I64 i;MC022GridItem *g=grid->data(MC022GridItem*);MC022ItemRow *rows=items->data(MC022ItemRow*);for(phase=0;phase<3;phase++)for(i=0;i<grid->size;i++){if(g[i].index<0 || g[i].index>=items->size)continue;MC022ItemDraw cmd;cmd.item=&rows[g[i].index];cmd.phase=phase;cmd.scale=1.0;cmd.x=MC022_Pixel(s,g[i].x-1.0);cmd.y=MC022_Pixel(s,g[i].y);if(phase==1){cmd.x=MC022_Pixel(s,s->cellW+g[i].x-16.0);cmd.y=MC022_Pixel(s,g[i].y+2.0);}MC022_Event(s->host,110+phase,g[i].selected,&cmd);if(phase==2){U32 color=0xC0635558;I32 dy=7;if(cmd.item->craftable){color=0xFFF0F0F0;dy=6;}MC022_Text(s->host,MCString_CStr(&cmd.item->label),MC022_Pixel(s,g[i].x+4.0)(I32),MC022_Pixel(s,g[i].y+dy)(I32),color,cmd.item->craftable);U8 count[32];snprintf(count,32,"%d",cmd.item->count);cmd.x=MC022_Pixel(s,(g[i].x-1.0+s->cellW-4*MC_StrLen(count))*1.5);cmd.y=MC022_Pixel(s,(s->cellH+g[i].y-8.0)*1.5);cmd.scale=0.6667;MC022_Event(s->host,113,0,&cmd);}}GuiComponent022 comp;GuiComponent022_Init(&comp,s->host);I32 x=s->bounds.x,y=s->bounds.y,w=s->bounds.w,h=s->bounds.h;if(s->vertical){GuiComponent022_gradient(&comp,x,y,x+w,y+40,0x44000000,0,FALSE);GuiComponent022_gradient(&comp,x,y+h-40,x+w,y+h,0,0x44000000,FALSE);}else{GuiComponent022_gradient(&comp,x,y,x+28,y+h,0xBB000000,0,TRUE);GuiComponent022_gradient(&comp,x+w-28,y,x+w,y+h,0,0xBB000000,TRUE);}MC022_Clip(s->host,FALSE,0,0,0,0);}
Bool ItemPane_onSelect(ItemPane *s,I32 index,Bool selected) {if(selected)MC022_Event(s->host,MC022_ITEM_SELECTED,index,s);return selected;}
