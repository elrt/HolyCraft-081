// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 ScrollingPane_adjustContentSize(ScrollingPane *s){s->contentWidth=s->columns*s->cell.width;s->contentHeight=s->rows*s->cell.height;if(s->contentWidth<s->viewport.width)s->contentWidth=s->viewport.width;if(s->contentHeight<s->viewport.height)s->contentHeight=s->viewport.height;s->minX=s->viewport.width-s->contentWidth;s->minY=s->viewport.height-s->contentHeight;}
Bool ScrollingPane_Init(ScrollingPane *s,I32 flags,IntRectangle *viewport,IntRectangle *cell,I32 columns,I32 count,F32 scale){memset(s,0,sizeof(ScrollingPane));if(cell->width<=0 || cell->height<=0 || count<0 || scale<=0)return FALSE;s->viewport=*viewport;s->cell=*cell;s->flags=flags;s->scale=scale;s->count=count;s->columns=columns;if(columns<=0){s->columns=viewport->width/cell->width;if(s->columns<=0)s->columns=1;}s->rows=(count-1)/s->columns+1;s->selected=-1;s->startItem=-1;s->startTime=-1;s->selections=MC_Alloc(count+1);memset(s->selections,0,count+1);s->dirty=TRUE;ScrollingPane_adjustContentSize(s);return TRUE;}
U0 ScrollingPane_Destroy(ScrollingPane *s){free(s->selections);s->selections=NULL;}
U0 ScrollingPane_setContentOffset(ScrollingPane *s,F32 x,F32 y){s->offsetX=x;s->offsetY=y;}
U0 ScrollingPane_getItemForPos(ScrollingPane *s,F32 x,F32 y,Bool screen,MCGridItem025 *out){if(screen){x-=s->viewport.minX;y-=s->viewport.minY;}x-=s->offsetX;y-=s->offsetY;if((s->flags&4) && s->columns>0)x=fmod(x,s->cell.width*s->columns);if((s->flags&8) && s->rows>0)y=fmod(y,s->cell.height*s->rows);F32 col=x/s->cell.width,row=y/s->cell.height;out->column=col(I32);out->row=row(I32);out->index=out->column+s->columns*out->row;out->x=col;out->y=row;}
U0 ScrollingPane_getGridItem(ScrollingPane *s,I32 index,MCGridItem025 *out){out->index=index;out->column=index%s->columns;out->row=index/s->columns;out->x=s->viewport.minX+s->offsetX+out->column*s->cell.width;out->y=s->viewport.minY+s->offsetY+out->row*s->cell.height;}
U0 ScrollingPane_setSelected(ScrollingPane *s,I32 index,Bool selected){if(index<0 || index>=s->count)return;if(s->flags&32)s->selections[index]=selected;else if(selected)s->selected=index;else if(index==s->selected)s->selected=-1;s->dirty=TRUE;}
U0 ScrollingPane_onSelect(ScrollingPane *s,I32 index){if(index<0 || index>=s->count)return;Bool yes=TRUE;if(s->flags&32)yes=!s->selections[index];if(s->select!=NULL)yes=s->select(s->context,index,yes);if(s->flags&32)s->selections[index]=yes;else if(yes && index!=s->selected){if(s->select!=NULL)s->select(s->context,s->selected,FALSE);s->selected=index;}s->dirty=TRUE;}
F32 MC025_PaneClamp(F32 v,F32 min){if(v<min)v=min;if(v>0)v=0;return v;}
U0 ScrollingPane_snapContentOffsetToBounds(ScrollingPane *s){if(s->paging){s->offsetX=floorf(s->offsetX/s->viewport.width+0.5)*s->viewport.width;s->offsetY=floorf(s->offsetY/s->viewport.height+0.5)*s->viewport.height;}else if(!(s->flags&16)){s->offsetX=MC025_PaneClamp(s->offsetX,s->minX);s->offsetY=MC025_PaneClamp(s->offsetY,s->minY);}}
U0 ScrollingPane_startDecelerationAnimation(ScrollingPane *s,I32 now,Bool force){F32 time=(now-s->startTime)/15.0;if(time>0){s->velocityX=(s->offsetX-s->initialOffsetX)/time;s->velocityY=(s->offsetY-s->initialOffsetY)/time;}else{s->velocityX=0;s->velocityY=0;}s->lowerX=s->minX;s->lowerY=s->minY;s->upperX=s->upperY=0;s->spring=0.03;s->brake=0.08;F32 threshold=0.3333;if(s->paging){s->lowerX=floorf(s->offsetX/s->viewport.width)*s->viewport.width;if(s->lowerX<s->minX)s->lowerX=s->minX;s->lowerY=floorf(s->offsetY/s->viewport.height)*s->viewport.height;if(s->lowerY<s->minY)s->lowerY=s->minY;s->upperX=ceilf(s->offsetX/s->viewport.width)*s->viewport.width;if(s->upperX>0)s->upperX=0;s->upperY=ceilf(s->offsetY/s->viewport.height)*s->viewport.height;if(s->upperY>0)s->upperY=0;s->spring=0.15;threshold=1.3333;}s->decelerating=force || fabs(s->velocityX)>threshold || fabs(s->velocityY)>threshold;}
U0 ScrollingPane_stepThroughDecelerationAnimation(ScrollingPane *s){if(!s->decelerating)return;F32 x=s->offsetX+s->velocityX,y=s->offsetY+s->velocityY;if(s->flags&16){F32 cx=MC025_PaneClamp(x,s->minX),cy=MC025_PaneClamp(y,s->minY);if(cx!=x)s->velocityX=0;if(cy!=y)s->velocityY=0;x=cx;y=cy;}s->offsetX=x;s->offsetY=y;if(!s->paging){s->velocityX*=0.95;s->velocityY*=0.95;}if(fabs(s->velocityX)<=0.01 && fabs(s->velocityY)<=0.01){s->decelerating=FALSE;return;}if(!(s->flags&16)){F32 dx=0,dy=0;if(x<s->lowerX)dx=s->lowerX-x;else if(x>s->upperX)dx=s->upperX-x;if(y<s->lowerY)dy=s->lowerY-y;else if(y>s->upperY)dy=s->upperY-y;if(dx!=0){if(dx*s->velocityX>0)s->velocityX=dx*s->brake;else s->velocityX+=dx*s->spring;}if(dy!=0){if(dy*s->velocityY>0)s->velocityY=dy*s->brake;else s->velocityY+=dy*s->spring;}}}
U0 ScrollingPane_touchesBegan(ScrollingPane *s,F32 x,F32 y,I32 now){if(s->tracking)return;s->decelerating=FALSE;ScrollingPane_adjustContentSize(s);ScrollingPane_snapContentOffsetToBounds(s);s->tracking=TRUE;s->dragging=FALSE;s->beginX=x;s->beginY=y;s->anchorX=x;s->anchorY=y;s->initialOffsetX=s->offsetX;s->initialOffsetY=s->offsetY;s->startTime=now;s->lastMoveTime=now;MCGridItem025 item;ScrollingPane_getItemForPos(s,x,y,TRUE,&item);s->startItem=item.index;if(x<s->viewport.minX || x>s->viewport.minX+s->viewport.width || y<s->viewport.minY || y>s->viewport.minY+s->viewport.height || item.index<0 || item.index>=s->count)s->startItem=-1;}
F32 MC025_PaneRubber(F32 v,F32 min){if(v<min)return v-(v-min)*0.5;if(v>0)return v*0.5;return v;}
U0 ScrollingPane_touchesMoved(ScrollingPane *s,F32 x,F32 y,I32 now){if(!s->tracking)return;F32 dx=x-s->anchorX,dy=y-s->anchorY;Bool first=FALSE;if(!s->dragging && ((fabs(dx)>=5 && !(s->flags&1)) || (fabs(dy)>=5 && !(s->flags&2)))){s->dragging=TRUE;first=TRUE;}if(!s->dragging)return;F32 xc=s->offsetX,yc=s->offsetY;if(!(s->flags&1))xc=s->initialOffsetX+dx;if(!(s->flags&2))yc=s->initialOffsetY+dy;if(s->flags&16){xc=MC025_PaneClamp(xc,s->minX);yc=MC025_PaneClamp(yc,s->minY);}else{xc=MC025_PaneRubber(xc,s->minX);yc=MC025_PaneRubber(yc,s->minY);}if(first){s->anchorX=x;s->anchorY=y;}else{ScrollingPane_setContentOffset(s,xc,yc);s->lastMoveTime=now;}}
U0 ScrollingPane_touchesEnded(ScrollingPane *s,F32 x,F32 y,I32 now){if(!s->tracking)return;s->tracking=FALSE;if(s->dragging){s->dragging=FALSE;if(now-s->lastMoveTime<=100)ScrollingPane_startDecelerationAnimation(s,now,FALSE);}if(!s->decelerating){if(-s->offsetY>=0 && -s->offsetY<=s->viewport.height)ScrollingPane_snapContentOffsetToBounds(s);else ScrollingPane_startDecelerationAnimation(s,now,TRUE);}F32 dx=s->anchorX-x,dy=s->anchorY-y;if(dx*dx+dy*dy<=36 && s->startItem>=0)ScrollingPane_onSelect(s,s->startItem);}
U0 ScrollingPane_translate(ScrollingPane *s,F32 x,F32 y){s->viewport.minX+=x(I32);s->viewport.minY+=y(I32);}
