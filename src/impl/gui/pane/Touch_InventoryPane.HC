// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
Bool TouchInventoryPane_onSelect(U0 *object,I32 index,Bool selected){TouchInventoryPane *s=object;if(index<0 || index>=s->pane.count)return FALSE;if(s->allowed!=NULL && !s->allowed(s->context,index))return FALSE;Bool ok=FALSE;if(s->addItem!=NULL)ok=s->addItem(s->context,index);else if(s->inventory)ok=Inventory_moveToSelectedSlot(s->inventory,index);if(ok){s->selectedItem=index;s->invTicker=7;}return FALSE;}
Bool TouchInventoryPane_Init(TouchInventoryPane *s,IntRectangle *viewport,I32 count,I32 cellSize,F32 scale,I32 margin,Inventory *inventory,ItemRenderer *renderer){memset(s,0,sizeof(TouchInventoryPane));IntRectangle cell;cell.minX=cell.minY=0;cell.width=cell.height=cellSize;if(!ScrollingPane_Init(&s->pane,1537,viewport,&cell,0,count,scale))return FALSE;s->pane.context=s;s->pane.select=&TouchInventoryPane_onSelect;s->inventory=inventory;s->renderer=renderer;s->selectedItem=-1;s->heldItem=-1;s->invTicker=-1;s->margin=margin;s->renderDecorations=TRUE;return TRUE;}
U0 TouchInventoryPane_tick(TouchInventoryPane *s){s->invTicker--;}
F32 TouchInventoryPane_selectedBrightness(TouchInventoryPane *s,I32 index){if(index==s->selectedItem && s->invTicker>0)return (-15*s->invTicker+255)/255.0;return 1;}
U0 TouchInventoryPane_itemPosition(TouchInventoryPane *s,I32 index,F32 *x,F32 *y){F32 scale=s->pane.scale;*x=floorf((s->pane.viewport.minX+s->margin+s->pane.cell.width*(index%s->pane.columns)+4)*scale)/scale;*y=floorf((s->pane.viewport.minY+s->margin+s->pane.cell.height*(index/s->pane.columns)+4)*scale)/scale;}
U0 TouchInventoryPane_Destroy(TouchInventoryPane *s){ScrollingPane_Destroy(&s->pane);}
