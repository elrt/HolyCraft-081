// Batch022: gui/LoginOption; explicit host ABI, see docs/BATCH022.md.
U0 LoginOption_Init(LoginOption *s,MojangConnector *connector,MC022DrawHost *host) {memset(s,0,sizeof(LoginOption));MC022_Box(&s->bounds,0,0,24,24);MC022_Box(&s->login,0,0,120,18);MC022_Box(&s->logout,0,0,120,18);s->connector=connector;s->host=host;}
U0 LoginOption_setupPositions(LoginOption *s) {s->login.x=s->bounds.x;s->logout.x=s->bounds.x;s->login.y=s->bounds.y+3;s->logout.y=s->bounds.y+3;s->login.h=18;s->logout.h=18;s->bounds.h=24;}
U0 LoginOption_tick(LoginOption *s) {I32 status=s->connector->status;Bool login=FALSE,logout=FALSE;if(status==STATUS_CONNECTED)logout=TRUE;else if(status==STATUS_0)login=TRUE;else if(status!=STATUS_1)return;if(s->login.visible==login && s->logout.visible==logout && status!=STATUS_1)return;s->login.active=login;s->login.visible=login;s->logout.active=logout;s->logout.visible=logout;s->pressed=0;LoginOption_setupPositions(s);}
U0 LoginOption_mouseClicked(LoginOption *s,I32 x,I32 y) {if(MC022_Hit(&s->login,x,y)){s->pressed=1;s->login.pressed=TRUE;}else if(MC022_Hit(&s->logout,x,y)){s->pressed=2;s->logout.pressed=TRUE;}}
U0 LoginOption_mouseReleased(LoginOption *s,I32 x,I32 y) {if(s->pressed==1 && MC022_Hit(&s->login,x,y))MC022_Event(s->host,MC022_LOGIN_WINDOW,0,s);else if(s->pressed==2 && MC022_Hit(&s->logout,x,y)){MCString body;MCOStringify_signOut(&body,&s->connector->login.accessToken,&s->connector->login.clientId);if((s->invalidate!=NULL))s->invalidate(s->ctx,&body);MCString_Destroy(&body);}s->pressed=0;s->login.pressed=FALSE;s->logout.pressed=FALSE;}
