U0 BuyButton_Init(BuyButton *s,MCGuiHost011 *h,I32 id){ImageDef img;ImageButton_Init(&s->base,h,id,"",NULL);ImageDef_Init(&img);img.texXStart=64;img.texYStart=182;img.texWidth=190;img.texHeight=55;img.width=75;img.height=21.711;ImageButton_setImageDef(&s->base,&img,TRUE);ImageDef_Destroy(&img);}
U0 BuyButton_Destroy(BuyButton *s){ImageButton_Destroy(&s->base);}
U0 BuyButton_render(BuyButton *s,I32 x,I32 y){ImageButton *im=&s->base;Button *b=&im->base;GuiElement *g=&b->base;ImageDef *i=&im->image;MCGuiHost011 *h=g->host;Bool sel=g->active && Button_isInside(b,x,y);F32 hw,hh,cx,cy,tw,th,u0,v0,u1,v1;U32 color;h->rgba(h->host,im->color.r,im->color.g,im->color.b,im->color.a);b->bgFn(b,x,y);if(h->bind(h->host,MCString_CStr(&i->texture))){h->begin(h->host,4);if(!g->active)color=0xff808080;else if(sel || b->text)color=0xffcccccc;else color=0xffffffff;h->color(h->host,color);hw=i->width*0.5;hh=i->height*0.5;cx=g->x+i->xOff+hw;cy=g->y+i->yOff+hh;if(sel){hw*=0.95;hh*=0.95;}if(i->initialized && h->textureSize(h->host,MCString_CStr(&i->texture),&tw,&th)){u0=i->texXStart/tw;u1=(i->texXStart+i->texWidth)/tw;v0=i->texYStart/th;v1=(i->texYStart+i->texHeight)/th;MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,u0,v0,u1,v1);}h->draw(h->host,TRUE);}}
