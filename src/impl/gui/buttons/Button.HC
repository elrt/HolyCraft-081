U0 Button_Init(Button *s,MCGuiHost011 *h,I32 id,I32 x,I32 y,I32 w,I32 height,U8 *msg){memset(s,0,sizeof(Button));GuiElement_Init(&s->base,h,TRUE,TRUE,x,y,w,height);MCString_FromC(&s->message,msg);s->id=id;s->bgFn=&Button_renderBg;s->faceFn=&Button_renderFace;}
U0 Button_Destroy(Button *s){MCString_Destroy(&s->message);GuiElement_Destroy(&s->base);}Bool Button_isInside(Button *s,I32 x,I32 y){GuiElement *g=&s->base;return x>=g->x && y>=g->y && x<g->x+g->width && y<g->y+g->height;}Bool Button_hovered(Button *s,I32 x,I32 y){return s->pressed && Button_isInside(s,x,y);}Bool Button_isPressed(Button *s,I32 x,I32 y){return Button_hovered(s,x,y);}Bool Button_clicked(Button *s,I32 x,I32 y){return s->base.active && Button_isInside(s,x,y);}U0 Button_setMsg(Button *s,U8 *msg){MCString_Destroy(&s->message);MCString_FromC(&s->message,msg);}U0 Button_released(Button *s){s->pressed=FALSE;}U0 Button_setPressed(Button *s){s->pressed=TRUE;}I32 Button_getYImage(Button *s,Bool selected){if(!s->base.active)return 0;if(selected)return 2;return 1;}
U0 Button_render(Button *s,I32 x,I32 y){if(s->base.visible){s->bgFn(s,x,y);s->faceFn(s,x,y);}}
U0 Button_renderBg(Button *s,I32 x,I32 y){GuiElement *g=&s->base;MCGuiHost011 *h=g->host;I32 v=20*Button_getYImage(s,s->text || Button_hovered(s,x,y))+46;h->bind(h->host,"gui/gui.png");h->rgba(h->host,1,1,1,1);h->blit(h->host,g->x,g->y,0,v,g->width/2,g->height,0,20);h->blit(h->host,g->x+g->width/2,g->y,200-g->width/2,v,g->width/2,g->height,0,20);}
U0 Button_renderFace(Button *s,I32 x,I32 y){GuiElement *g=&s->base;U32 color=0xffa0a0a0;if(g->active){color=0xe0e0e0;if(Button_hovered(s,x,y) || s->text)color=0xffffa0;}g->host->text(g->host->host,MCString_CStr(&s->message),g->x+g->width/2,g->y+(g->height-8)/2,color,TRUE);}

U0 Button_InitAt(Button *s,MCGuiHost011 *h,I32 id,I32 x,I32 y,U8 *msg){Button_Init(s,h,id,x,y,200,24,msg);}U0 Button_InitDefault(Button *s,MCGuiHost011 *h,I32 id,U8 *msg){Button_InitAt(s,h,id,0,0,msg);}Bool Button_isOveridingScreenRendering(Button *s){return s->overriding;}U0 Button_setOverrideScreenRendering(Button *s,Bool b){s->overriding=b;}
