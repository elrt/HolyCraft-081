U0 CraftButton_Init(CraftButton *s,MCGuiHost011 *h,I32 id){ImageButton_Init(&s->base,h,id,"",NULL);s->normal=s->highlight=NULL;s->field_78=0;s->base.base.bgFn=&CraftButton_renderBg;}
U0 CraftButton_initPatches(CraftButton *s){MCGuiHost011 *h=s->base.base.base.host;IntRectangle r;IntRectangle_Init(&r,112,0,8,67);s->normal=h->patchCreate(h->host,"gui/spritesheet.png",&r,2,2,32,32);r.minX=120;s->highlight=h->patchCreate(h->host,"gui/spritesheet.png",&r,2,2,32,32);}
U0 CraftButton_setSize(CraftButton *s,F32 w,F32 height){GuiElement *g=&s->base.base.base;MCGuiHost011 *h=g->host;g->width=w;g->height=height;if(s->normal && s->highlight){h->patchSize(h->host,s->normal,w,height);h->patchSize(h->host,s->highlight,w,height);}}
U0 CraftButton_getItemPos(CraftButton *s,IntRectangle *out){IntRectangle_Init(out,0,0,1,1);}U0 CraftButton_renderBg(Button *b,I32 x,I32 y){CraftButton *s=b->derived;GuiElement *g=&b->base;U0 *p=s->normal;if(s->normal && s->highlight){if((g->active && b->pressed && Button_isInside(b,x,y)) || b->text)p=s->highlight;g->host->patchDraw(g->host->host,p,g->x,g->y);}}
U0 CraftButton_Destroy(CraftButton *s){MCGuiHost011 *h=s->base.base.base.host;if(s->normal)h->patchDestroy(h->host,s->normal);if(s->highlight)h->patchDestroy(h->host,s->highlight);ImageButton_Destroy(&s->base);}
