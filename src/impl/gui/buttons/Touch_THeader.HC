U0 Touch_THeader_Init(Touch_THeader *s,MCGuiHost011 *h,I32 id,I32 x,I32 y,I32 w,I32 height,U8 *msg){Button_Init(&s->base,h,id,x,y,w,height,msg);s->base.base.active=FALSE;s->textX=-99999;s->base.derived=s;s->base.bgFn=&Touch_THeader_renderBg;}
U0 Touch_THeader_renderBg(Button *b,I32 x,I32 y){GuiElement *g=&b->base;MCGuiHost011 *h=g->host;h->bind(h->host,"gui/touchgui.png");h->rgba(h->host,1,1,1,1);h->blit(h->host,g->x,g->y,150,26,2,g->height-1,2,25);h->blit(h->host,g->x+2,g->y,153,26,g->width-3,g->height-1,8,25);h->blit(h->host,g->x+g->width-2,g->y,162,26,2,g->height-1,2,25);h->blit(h->host,g->x,g->y+g->height-1,153,52,g->width,3,8,3);}
U0 Touch_THeader_render(Touch_THeader *s,I32 x,I32 y){GuiElement *g=&s->base.base;I32 tx=s->textX;Touch_THeader_renderBg(&s->base,x,y);if(tx==-99999)tx=g->x+g->width/2;g->host->text(g->host->host,MCString_CStr(&s->base.message),tx,g->y+(g->height-8)/2,0xe0e0e0,TRUE);}U0 Touch_THeader_Destroy(Touch_THeader *s){Button_Destroy(&s->base);}
