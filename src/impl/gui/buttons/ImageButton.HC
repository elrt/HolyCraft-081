U0 MC011_copyImage(ImageDef *d,ImageDef *s){*d=*s;MCString_CopyInit(&d->texture,&s->texture);}
U0 ImageButton_Init(ImageButton *s,MCGuiHost011 *h,I32 id,U8 *msg,ImageDef *image){Button_Init(&s->base,h,id,0,0,200,24,msg);s->base.derived=s;s->base.bgFn=&ImageButton_emptyBg;Color4_Init(&s->color,1,1,1,1);if(image)MC011_copyImage(&s->image,image);else ImageDef_Init(&s->image);s->yOffset=16;s->secondFn=&ImageButton_isSecondImage;ImageButton_setupDefault(s);}
U0 ImageButton_Destroy(ImageButton *s){ImageDef_Destroy(&s->image);Button_Destroy(&s->base);}U0 ImageButton_setupDefault(ImageButton *s){s->base.base.width=48;s->base.base.height=48;s->shrink=TRUE;}U0 ImageButton_setImageDef(ImageButton *s,ImageDef *image,Bool resize){ImageDef_Destroy(&s->image);MC011_copyImage(&s->image,image);if(resize){s->base.base.width=image->width;s->base.base.height=image->height;}}Bool ImageButton_isSecondImage(ImageButton *s,Bool selected){return selected;}U0 ImageButton_emptyBg(Button *s,I32 x,I32 y){}
U0 ImageButton_render(ImageButton *s,I32 x,I32 y){Button *b=&s->base;GuiElement *g=&b->base;ImageDef *i=&s->image;MCGuiHost011 *h=g->host;Bool selected,second;F32 hw,hh,cx,cy,tw,th,u0,v0,u1,v1;U32 color;I32 textX,textY;if(!g->visible)return;h->rgba(h->host,s->color.r,s->color.g,s->color.b,s->color.a);selected=g->active && b->pressed && Button_isInside(b,x,y);second=s->secondFn(s,selected);b->bgFn(b,x,y);if(i->texture.size && h->bind(h->host,MCString_CStr(&i->texture))){h->begin(h->host,4);color=0xff808080;if(g->active)color=0xffffffff;h->color(h->host,color);hw=i->width*0.5*(g->width/i->width);hh=i->height*0.5*(g->height/i->height);cx=g->x+i->xOff+hw;cy=g->y+i->yOff+hh;if(s->shrink && selected){hw*=0.95;hh*=0.95;}if(i->initialized){if(h->textureSize(h->host,MCString_CStr(&i->texture),&tw,&th)){u0=(i->texXStart+second*i->texWidth)/tw;u1=(i->texXStart+i->texWidth*(1+second))/tw;v0=i->texYStart/th;v1=(i->texYStart+i->texHeight)/th;MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,u0,v0,u1,v1);}}else MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,0,0,1,1);h->draw(h->host,TRUE);}color=0xffa0a0a0;textX=g->y+g->width/2;textY=g->y+s->yOffset;if(g->active){textX=g->x+g->width/2;color=0xe0e0e0;if(selected || b->text){color=0xffffa0;textY++;}}h->text(h->host,MCString_CStr(&b->message),textX,textY,color,TRUE);}
