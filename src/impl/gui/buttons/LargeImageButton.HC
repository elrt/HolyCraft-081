U0 LargeImageButton_setupDefault(LargeImageButton *s){s->scale=1;s->base.base.base.width=72;s->base.base.base.height=72;}
U0 LargeImageButton_Init(LargeImageButton *s,MCGuiHost011 *h,I32 id,U8 *msg,ImageDef *image){ImageButton_Init(&s->base,h,id,msg,image);LargeImageButton_setupDefault(s);}
U0 LargeImageButton_Destroy(LargeImageButton *s){ImageButton_Destroy(&s->base);}
U0 LargeImageButton_render(LargeImageButton *s,I32 x,I32 y){ImageButton *im=&s->base;Button *b=&im->base;GuiElement *g=&b->base;ImageDef *i=&im->image;MCGuiHost011 *h=g->host;Bool selected;F32 hw,hh,cx,cy,tw,th,u0,v0,u1,v1;if(!g->visible)return;h->rgba(h->host,im->color.r,im->color.g,im->color.b,im->color.a);selected=g->active && b->pressed && Button_isInside(b,x,y);b->bgFn(b,x,y);if(i->texture.size && h->bind(h->host,MCString_CStr(&i->texture))){h->begin(h->host,4);if(g->active)h->color(h->host,0xffffffff);else h->color(h->host,0xff808080);hw=i->width*0.5;hh=i->height*0.5;cx=g->x+i->xOff+hw;cy=g->y+i->yOff+hh;if(selected){s->scale-=0.025;if(s->scale<=0.95)s->scale=0.95;}else{s->scale+=0.025;if(s->scale>=1)s->scale=1;}hw*=s->scale;hh*=s->scale;if(i->initialized){if(h->textureSize(h->host,MCString_CStr(&i->texture),&tw,&th)){u0=(i->texXStart+selected*i->texWidth)/tw;u1=(i->texXStart+i->texWidth*(1+selected))/tw;v0=i->texYStart/th;v1=(i->texYStart+i->texHeight)/th;MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,u0,v0,u1,v1);}}else MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,0,0,1,1);h->draw(h->host,TRUE);}if(g->active)h->text(h->host,MCString_CStr(&b->message),g->x+g->width/2,g->y+11,0xffffa0,TRUE);else h->text(h->host,MCString_CStr(&b->message),g->x+g->width/2,g->y+11,0xffa0a0a0,TRUE);}
