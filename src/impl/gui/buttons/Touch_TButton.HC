U0 Touch_TButton_Init(Touch_TButton *s,MCGuiHost011 *h,I32 id,I32 x,I32 y,I32 w,I32 height,U8 *msg,Bool init){IntRectangle r1,r2;Button_Init(&s->base,h,id,x,y,w,height,msg);s->base.derived=s;s->base.bgFn=&Touch_TButton_renderBg;s->normal=s->highlight=NULL;if(init){IntRectangle_Init(&r1,8,32,8,8);IntRectangle_Init(&r2,0,32,8,8);Touch_TButton_initPatches(s,"gui/spritesheet.png",&r1,&r2,2,2,w,height);}}
U0 Touch_TButton_initPatches(Touch_TButton *s,U8 *path,IntRectangle *a,IntRectangle *b,I32 dx,I32 dy,I32 w,I32 height){GuiElement *g=&s->base.base;MCGuiHost011 *h=g->host;g->width=w;g->height=height;s->normal=h->patchCreate(h->host,path,a,dx,dy,w,height);s->highlight=h->patchCreate(h->host,path,b,dx,dy,w,height);}
U0 Touch_TButton_renderBg(Button *b,I32 x,I32 y){Touch_TButton *s=b->derived;GuiElement *g=&b->base;MCGuiHost011 *h=g->host;U0 *p=s->normal;h->patchSize(h->host,s->normal,g->width,g->height);h->patchSize(h->host,s->highlight,g->width,g->height);if(g->active && b->pressed && Button_isInside(b,x,y))p=s->highlight;h->patchDraw(h->host,p,g->x,g->y);}
U0 Touch_TButton_Destroy(Touch_TButton *s){MCGuiHost011 *h=s->base.base.host;if(s->normal)h->patchDestroy(h->host,s->normal);if(s->highlight)h->patchDestroy(h->host,s->highlight);Button_Destroy(&s->base);}
