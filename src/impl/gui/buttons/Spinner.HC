U0 Spinner_Init(Spinner *s,MCGuiHost011 *h){GuiElement_Init(&s->base,h,TRUE,TRUE,0,0,12,12);}U0 Spinner_Destroy(Spinner *s){GuiElement_Destroy(&s->base);}U0 Spinner_render(Spinner *s){MCGuiHost011 *h=s->base.host;I32 index,w;U8 *c;if(!s->base.visible)return;index=(h->time(h->host)*5.5)(I32)%4;if(index==0)c="-";else if(index==1)c="\\";else if(index==2)c="|";else if(index==3)c="/";else{printf("Spinner negative time\n");exit(99);}w=h->textWidth(h->host,c);h->text(h->host,c,s->base.x-w/2,s->base.y,0xffffffff,FALSE);}
