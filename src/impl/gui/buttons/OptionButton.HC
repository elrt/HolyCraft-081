U0 OptionButton_Init(OptionButton *s,MCGuiHost011 *h,U0 *option,Bool value,Bool isFloat,F32 min,F32 max){ImageButton_Init(&s->base,h,9999999,"",NULL);s->option=option;s->boolValue=value;s->isFloat=isFloat;s->minValue=min;s->maxValue=max;s->curValue=0;s->base.secondFn=&OptionButton_isSecondImage;}
Bool OptionButton_isSet(OptionButton *s,Bool hasOptions){MCGuiHost011 *h=s->base.base.base.host;if(hasOptions && s->option)return h->optionGetBool(h->host,s->option);return s->boolValue;}
U0 OptionButton_updateImage(OptionButton *s){MCGuiHost011 *h=s->base.base.base.host;if(s->isFloat){s->curValue=h->optionGetFloat(h->host,s->option);s->boolValue=fabsf(s->curValue-s->minValue)<0.01;}else if(s->option)s->boolValue=h->optionGetBool(h->host,s->option);else s->boolValue=!s->boolValue;}
U0 OptionButton_toggle(OptionButton *s){MCGuiHost011 *h=s->base.base.base.host;F32 v;if(s->option){if(s->isFloat){v=s->minValue;if(fabsf(s->curValue-s->minValue)<0.01)v=s->maxValue;h->optionSetFloat(h->host,s->option,v);}else h->optionToggle(h->host,s->option);}OptionButton_updateImage(s);}
U0 OptionButton_mouseClicked(OptionButton *s,I32 x,I32 y,I32 button){if(button==1 && Button_clicked(&s->base.base,x,y))OptionButton_toggle(s);}Bool OptionButton_isSecondImage(ImageButton *im,Bool selected){OptionButton *s=im;return s->boolValue;}U0 OptionButton_Destroy(OptionButton *s){ImageButton_Destroy(&s->base);}
