U0 ImageWithBackground_Init(ImageWithBackground *s,MCGuiHost011 *h,I32 id){LargeImageButton_Init(&s->base,h,id,"",NULL);s->normal=s->highlight=NULL;s->base.base.base.bgFn=&ImageWithBackground_renderBg;}
U0 ImageWithBackground_initPatches(ImageWithBackground *s,I32 w,I32 height,IntRectangle *a,IntRectangle *b,I32 dx,I32 dy,U8 *path){MCGuiHost011 *h=s->base.base.base.base.host;s->normal=h->patchCreate(h->host,path,a,dx,dy,w,height);s->highlight=h->patchCreate(h->host,path,b,dx,dy,w,height);}
U0 ImageWithBackground_setSize(ImageWithBackground *s,F32 w,F32 height){GuiElement *g=&s->base.base.base.base;MCGuiHost011 *h=g->host;g->width=w;g->height=height;if(s->normal && s->highlight){h->patchSize(h->host,s->normal,w,height);h->patchSize(h->host,s->highlight,w,height);}}
U0 ImageWithBackground_renderBg(Button *b,I32 x,I32 y){ImageWithBackground *s=b->derived;GuiElement *g=&b->base;MCGuiHost011 *h=g->host;U0 *p=s->normal;if(!s->normal || !s->highlight){printf("ImageWithBackground missing patch\n");exit(99);}h->patchSize(h->host,s->normal,g->width,g->height);h->patchSize(h->host,s->highlight,g->width,g->height);if((g->active && b->pressed && Button_isInside(b,x,y)) || b->text)p=s->highlight;h->patchDraw(h->host,p,g->x,g->y);}
U0 ImageWithBackground_render(ImageWithBackground *s,I32 x,I32 y){LargeImageButton *l=&s->base;ImageButton *im=&l->base;Button *b=&im->base;GuiElement *g=&b->base;ImageDef *i=&im->image;MCGuiHost011 *h=g->host;Bool selected;I32 w,ht;F32 hw,hh,cx,cy,tw,th,u0,v0,u1,v1;if(!g->visible)return;h->rgba(h->host,1,1,1,1);selected=g->active && b->pressed && Button_isInside(b,x,y);b->bgFn(b,x,y);if(i->texture.size && h->bind(h->host,MCString_CStr(&i->texture))){h->begin(h->host,4);if(g->active)h->color(h->host,0xffffffff);else h->color(h->host,0xff808080);w=i->width;ht=i->height;cx=g->x+i->xOff+w*0.5+(g->width-w)*0.5;cy=g->y+i->yOff+ht*0.5+(g->height-ht)*0.5;if(selected){l->scale-=0.025;if(l->scale<=0.95)l->scale=0.95;}else{l->scale+=0.025;if(l->scale>=1)l->scale=1;}hw=w*0.5*l->scale;hh=ht*0.5*l->scale;if(i->initialized){if(h->textureSize(h->host,MCString_CStr(&i->texture),&tw,&th)){u0=i->texXStart/tw+0.001;u1=(i->texXStart+i->texWidth)/tw-0.001;v0=i->texYStart/th+0.001;v1=(i->texYStart+i->texHeight)/th-0.001;MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,u0,v0,u1,v1);}}else MC011_quadGUI(h,cx-hw,cy-hh,cx+hw,cy+hh,g->zLayer,0,0,1,1);h->draw(h->host,TRUE);}if(g->active)h->text(h->host,MCString_CStr(&b->message),g->x+g->width/2,g->y+11,0xffffa0,TRUE);else h->text(h->host,MCString_CStr(&b->message),g->x+g->width/2,g->y+11,0xffa0a0a0,TRUE);}
U0 ImageWithBackground_Destroy(ImageWithBackground *s){MCGuiHost011 *h=s->base.base.base.base.host;if(s->normal)h->patchDestroy(h->host,s->normal);if(s->highlight)h->patchDestroy(h->host,s->highlight);LargeImageButton_Destroy(&s->base);}
