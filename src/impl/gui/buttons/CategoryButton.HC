U0 CategoryButton_Init(CategoryButton *s,MCGuiHost011 *h,I32 id,U8 *msg,U0 *normal,U0 *highlight,Button **selected){ImageButton_Init(&s->base,h,id,msg,NULL);s->normal=normal;s->highlight=highlight;s->selected=selected;s->base.base.bgFn=&CategoryButton_renderBg;s->base.secondFn=&CategoryButton_isSecondImage;}
U0 CategoryButton_renderBg(Button *b,I32 x,I32 y){CategoryButton *s=b->derived;GuiElement *g=&b->base;U0 *p=s->normal;if((g->active && b->pressed && Button_isInside(b,x,y)) || *s->selected==b)p=s->highlight;g->host->patchDraw(g->host->host,p,g->x,g->y);}Bool CategoryButton_isSecondImage(ImageButton *s,Bool active){return FALSE;}U0 CategoryButton_Destroy(CategoryButton *s){ImageButton_Destroy(&s->base);}
