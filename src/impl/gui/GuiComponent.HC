// Batch022: gui/GuiComponent; explicit host ABI, see docs/BATCH022.md.
U0 GuiComponent022_Init(GuiComponent022 *s,MC022DrawHost *host) {s->zLayer=0.0;s->host=host;}
U0 MC022_V(MC022Vertex *v,F32 x,F32 y,F32 z,F32 u,F32 t,U32 color) {v->x=x;v->y=y;v->z=z;v->u=u;v->v=t;v->color=color;}
U0 GuiComponent022_blit(GuiComponent022 *s,F32 x,F32 y,I32 u,I32 v,F32 w,F32 h,I32 tw,I32 th) {if(!tw)tw=w;if(!th)th=h;MC022Vertex q[4];MC022_V(&q[0],x,y+h,s->zLayer,u*0.0039062,(v+th)*0.0039062,0xFFFFFFFF);MC022_V(&q[1],x+w,y+h,s->zLayer,(u+tw)*0.0039062,(v+th)*0.0039062,0xFFFFFFFF);MC022_V(&q[2],x+w,y,s->zLayer,(u+tw)*0.0039062,v*0.0039062,0xFFFFFFFF);MC022_V(&q[3],x,y,s->zLayer,u*0.0039062,v*0.0039062,0xFFFFFFFF);if(s->host && (s->host->quad!=NULL))s->host->quad(s->host->ctx,q,TRUE);}
U0 GuiComponent022_fill(GuiComponent022 *s,F32 x1,F32 y1,F32 x2,F32 y2,U32 color) {MC022Vertex q[4];MC022_V(&q[0],x1,y2,0.0,0.0,0.0,color);MC022_V(&q[1],x2,y2,0.0,0.0,0.0,color);MC022_V(&q[2],x2,y1,0.0,0.0,0.0,color);MC022_V(&q[3],x1,y1,0.0,0.0,0.0,color);if(s->host && (s->host->quad!=NULL))s->host->quad(s->host->ctx,q,FALSE);}
U0 GuiComponent022_gradient(GuiComponent022 *s,F32 x1,F32 y1,F32 x2,F32 y2,U32 c1,U32 c2,Bool horizontal) {MC022Vertex q[4];MC022_V(&q[0],x2,y1,0.0,0.0,0.0,c1);MC022_V(&q[1],x1,y1,0.0,0.0,0.0,c1);MC022_V(&q[2],x1,y2,0.0,0.0,0.0,c2);MC022_V(&q[3],x2,y2,0.0,0.0,0.0,c2);if(horizontal){q[0].color=c2;q[1].color=c1;q[2].color=c1;q[3].color=c2;}if(s->host && (s->host->quad!=NULL))s->host->quad(s->host->ctx,q,FALSE);}
U0 GuiComponent022_drawRect(GuiComponent022 *s,I32 x1,I32 y1,I32 x2,I32 y2,U32 top,U32 bottom,U32 left,U32 right,I32 thick) {GuiComponent022_fill(s,x1,y1,x1+thick,y2,left);GuiComponent022_fill(s,x2-thick,y1,x2,y2,right);GuiComponent022_fill(s,x1,y1,x2,y1+thick,top);GuiComponent022_fill(s,x1,y2-thick,x2,y2,bottom);}
