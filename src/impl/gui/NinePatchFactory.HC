U0 NinePatchFactory_Init(NinePatchFactory *s,MCNinePatchFactoryHost012 *h,U8 *name){s->host=h;MCString_FromC(&s->imagePath,name);s->width=1;s->height=1;{I32 w=1,ht=1;if(h->textureSize(h->host,name,&w,&ht)){s->width=w;s->height=ht;}}}U0 NinePatchFactory_Destroy(NinePatchFactory *s){MCString_Destroy(&s->imagePath);}U0 *NinePatchFactory_createSymmetrical(NinePatchFactory *s,IntRectangle *r,I32 a,I32 b,F32 w,F32 h){NinePatchDescription d;NinePatchDescription_createSymmetrical(s->width,s->height,r,a,b,&d);return s->host->createLayer(s->host->host,&d,MCString_CStr(&s->imagePath),w,h);}
