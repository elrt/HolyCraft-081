U0 NinePatchLayer_Init(NinePatchLayer *s,NinePatchDescription *d,MCString *texture,MCNineHost015 *h,F32 w,F32 height){s->width2=-1;s->height2=-1;s->patch=*d;MCString_CopyInit(&s->texture,texture);s->host=h;s->excluded=0;NinePatchLayer_setSize(s,w,height);}
U0 NinePatchLayer_Destroy(NinePatchLayer *s){MCString_Destroy(&s->texture);}
U0 NinePatchLayer_getPatchInfo(NinePatchLayer *s,I32 col,I32 row,F32 *x0,F32 *x1,F32 *y0,F32 *y1){switch(col){case 0:*x0=0;*x1=s->patch.field_20;break;case 1:*x0=s->patch.field_20;*x1=s->width2-s->patch.field_24;break;case 2:*x0=s->width2-s->patch.field_24;*x1=s->width2;break;}switch(row){case 0:*y0=0;*y1=s->patch.field_28;break;case 1:*y0=s->patch.field_28;*y1=s->height2-s->patch.field_2C;break;case 2:*y0=s->height2-s->patch.field_2C;*y1=s->height2;break;}}
U0 NinePatchLayer_buildQuad(NinePatchLayer *s,I32 n){I32 row=n/3,col=n%3;MCCachedQuad015 *q=&s->quads[n];F32 *u=&s->patch.field_0,*v=&s->patch.field_10;q->u0=u[col];q->u1=u[col+1];q->v0=v[row];q->v1=v[row+1];q->z=0;NinePatchLayer_getPatchInfo(s,col,row,&q->x0,&q->x1,&q->y0,&q->y1);}
U0 NinePatchLayer_setSize(NinePatchLayer *s,F32 w,F32 h){I32 i;if(w!=s->width2||h!=s->height2){s->width2=w;s->height2=h;for(i=0;i<9;i++)NinePatchLayer_buildQuad(s,i);}}
NinePatchLayer *NinePatchLayer_setExcluded(NinePatchLayer *s,I32 v){s->excluded=v;return s;}NinePatchLayer *NinePatchLayer_exclude(NinePatchLayer *s,I32 v){return NinePatchLayer_setExcluded(s,(1<<v)|s->excluded);}
U0 NinePatchLayer_d(NinePatchLayer *s,MCCachedQuad015 *q){MCNineHost015 *h=s->host;h->vertexUV(h->host,q->x0,q->y1,q->z,q->u0,q->v1);h->vertexUV(h->host,q->x1,q->y1,q->z,q->u1,q->v1);h->vertexUV(h->host,q->x1,q->y0,q->z,q->u1,q->v0);h->vertexUV(h->host,q->x0,q->y0,q->z,q->u0,q->v0);}
U0 NinePatchLayer_draw(NinePatchLayer *s,F32 x,F32 y){I32 i,mask=1;MCNineHost015 *h=s->host;h->bind(h->host,&s->texture);h->begin(h->host,36);h->offset(h->host,x,y,(0)(F32));for(i=0;i<9;i++){if(!(s->excluded&mask))NinePatchLayer_d(s,&s->quads[i]);mask*=2;}h->offset(h->host,-x,-y,(0)(F32));h->draw(h->host,TRUE);}
