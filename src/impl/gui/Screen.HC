// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Screen_Init(Screen *s,MCUI025 *ui){memset(s,0,sizeof(Screen));s->ui=ui;s->width=1;s->height=1;s->pause=TRUE;s->inGame=TRUE;MCPtrVector_Init(&s->elements);MCPtrVector_Init(&s->buttons);}
U0 Screen_Destroy(Screen *s){MCPtrVector_Destroy(&s->elements);MCPtrVector_Destroy(&s->buttons);}
U0 Screen_setSize(Screen *s,I32 w,I32 h){s->width=w;s->height=h;}
U0 Screen_attach(Screen *s,Minecraft *mc,I32 w,I32 h){s->minecraft=mc;Screen_setSize(s,w,h);}
Bool Screen_suppressedBySubWindow(Screen *s){I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->modal!=NULL && e->modal(e->object))return TRUE;}return FALSE;}
U0 Screen_toGUICoordinate(Screen *s,I32 physicalW,I32 physicalH,I32 *x,I32 *y){if(physicalW<=0 || physicalH<=0)return;*x=s->width*(*x)/physicalW;*y=s->height*(*y)/physicalH-1;}
U0 Screen_render(Screen *s,I32 epoch){Bool modal=Screen_suppressedBySubWindow(s);I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->render!=NULL)e->render(e->object,modal,epoch);}if(!modal)for(i=0;i<s->buttons.size;i++){Button *b=s->buttons.data[i];if(!b->base.visible || b->overriding)continue;U32 color=0xff808080;if(!b->base.active)color=0xff404040;if(b->pressed)color=0xff7f89bf;MC025_Rect(s->ui,b->base.x,b->base.y,b->base.x+b->base.width,b->base.y+b->base.height,color);MC025_Text(s->ui,&b->message,b->base.x+4,b->base.y+4,-1);}}
U0 Screen_mouse(Screen *s,I32 x,I32 y,I32 button,Bool down){Bool modal=Screen_suppressedBySubWindow(s);I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(modal && (e->modal==NULL || !e->modal(e->object)))continue;if(e->mouse!=NULL)e->mouse(e->object,x,y,button,down,modal);}if(modal || button!=1)return;if(down){for(i=0;i<s->buttons.size;i++){Button *b=s->buttons.data[i];if(b->base.active && Button_clicked(b,x,y)){Button_setPressed(b);s->lastPressed=b;}}}else{Button *last=s->lastPressed;if(last){if(Button_clicked(last,x,y)){if(s->buttonClicked!=NULL)s->buttonClicked(s->context,last);Button_released(last);}s->lastPressed=NULL;}}}
U0 Screen_keyPressed(Screen *s,I32 key,Bool touch,Options *options){if(s->keyHook!=NULL && s->keyHook(s->context,key))return;I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->key!=NULL)e->key(e->object,key);}I32 n=s->buttons.size;if(touch || !n || !options)return;if(key==options->keyCodes[12]){s->tab++;if(s->tab==n)s->tab=0;}if(key==options->keyCodes[13]){s->tab--;if(s->tab<0)s->tab=n-1;}if(key==options->keyCodes[14]){Button *b=s->buttons.data[s->tab];if(b->base.active && s->buttonClicked!=NULL)s->buttonClicked(s->context,b);}}
U0 Screen_keyboardNewChar(Screen *s,MCString *text,Bool composing){if(s->textHook!=NULL && s->textHook(s->context,text,composing))return;I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->modal!=NULL && e->modal(e->object) && e->text!=NULL)e->text(e->object,text,composing);}}
U0 Screen_setTextboxText(Screen *s,MCString *text){I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->modal!=NULL && e->modal(e->object) && e->setText!=NULL)e->setText(e->object,text);}}
Bool Screen_handleBackEvent(Screen *s,Bool held){if(s->backHook!=NULL && s->backHook(s->context,held))return TRUE;I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->back!=NULL && e->back(e->object,held))return TRUE;}return FALSE;}
U0 Screen_tick(Screen *s){s->ticks++;I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->tick!=NULL)e->tick(e->object);}}
U0 Screen_lostFocus(Screen *s){I32 i;for(i=0;i<s->elements.size;i++){MCWidget025 *e=s->elements.data[i];if(e->blur!=NULL)e->blur(e->object);}}
