U0 AgableMob_Init(AgableMob *s,MCAgableHost013 *h){s->host=h;s->age=-1;h->defineByte(h->host,14,0);AgableMob_setAge(s,0);}I32 AgableMob_getAge(AgableMob *s){return s->age;}U0 AgableMob_setAge(AgableMob *s,I32 age){MCAgableHost013 *h=s->host;if(age>=0 && s->age<0)h->clearFlag(h->host,14,0);else if(s->age>=0 && age<0)h->setFlag(h->host,14,0);s->age=age;}
F32 AgableMob_getShadowRadius(AgableMob *s){F32 r=s->host->entityWidth*0.8;if(AgableMob_isBaby(s))r*=0.5;return r;}U0 AgableMob_readAdditionalSaveData(AgableMob *s,U0 *tag){MCAgableHost013 *h=s->host;h->readBase(h->host,tag);AgableMob_setAge(s,h->getInt(h->host,tag,"Age"));}U0 AgableMob_addAdditonalSaveData(AgableMob *s,U0 *tag){MCAgableHost013 *h=s->host;h->writeBase(h->host,tag);h->putInt(h->host,tag,"Age",s->age);}U0 AgableMob_aiStep(AgableMob *s){s->host->mobAiStep(s->host->host);if(s->age>0)AgableMob_setAge(s,s->age-1);else if(s->age<0)AgableMob_setAge(s,s->age+1);}Bool AgableMob_isBaby(AgableMob *s){if(!s->host->isClient)return s->age<0;return s->host->getByte(s->host->host,14)&1;}
