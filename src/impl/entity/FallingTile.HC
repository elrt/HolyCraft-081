// Batch023: entity/FallingTile; explicit simulation ABI, see docs/BATCH023.md.
U0 FallingTile_Init(FallingTile *s,MCWorld023 *w,F32 x,F32 y,F32 z,I32 id,I32 data) {memset(s,0,sizeof(FallingTile));MC023_BodyInit(s,w,66,0.98,0.98);s->x=s->prevX=x;s->y=s->prevY=y;s->z=s->prevZ=z;s->tile=id;s->data=data;}
U0 FallingTile_tick(FallingTile *s) {if(!s->tile){MC023_Remove(s);return;}s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;s->motionY-=0.04;s->fallTime++;MC023_Move(s);s->motionX*=0.98;s->motionY*=0.98;s->motionZ*=0.98;if(s->w->isClient)return;I32 x=floorf(s->x),y=floorf(s->y),z=floorf(s->z);if(s->fallTime==1){if(MC023_Tile(s->w,x,y,z)!=s->tile){MC023_Remove(s);return;}MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);}if(s->onGround){s->motionX*=0.7;s->motionZ*=0.7;s->motionY*= -0.5;MC023_Remove(s);if(!MC023_Get(s->w,MC023_MAYPLACE,x,y,z) || !MC023_Set(s->w,MC023_SET_TILE,x,y,z,s->tile,s->data,3))MC023_Event(s->w,MC023_DROP,x,y,z,s->tile,0,1);}else if(s->fallTime>100)MC023_Remove(s);}
U0 FallingTile_save(FallingTile *s,CompoundTag *t) {MC023_NBTPut(t,"Tile",s->tile,TRUE);MC023_NBTPut(t,"Data",s->data,TRUE);MC023_NBTPut(t,"Time",s->fallTime,TRUE);}
U0 FallingTile_load(FallingTile *s,CompoundTag *t) {s->tile=MC023_NBTGet(t,"Tile",TRUE);s->data=MC023_NBTGet(t,"Data",TRUE);s->fallTime=MC023_NBTGet(t,"Time",TRUE);}
