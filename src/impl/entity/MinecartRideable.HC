U0 MinecartRideable_Init(MinecartRideable *s,MCMinecartHost012 *h){s->host=h;s->base=h->createBase(h->host,FALSE,0,0,0);}U0 MinecartRideable_InitAt(MinecartRideable *s,MCMinecartHost012 *h,F32 x,F32 y,F32 z){s->host=h;s->base=h->createBase(h->host,TRUE,x,y,z);}U0 MinecartRideable_Destroy(MinecartRideable *s){s->host->destroyBase(s->host->host,s->base);}Bool MinecartRideable_interactWithPlayer(MinecartRideable *s,U0 *p){MCMinecartHost012 *h=s->host;U0 *r=h->getRider(h->host,s->base);if(r && h->isPlayer(h->host,r) && r==p)return TRUE;if(!r || r==p){if(!h->isClient(h->host))h->ride(h->host,p,s->base);return TRUE;}return FALSE;}I32 MinecartRideable_getType(MinecartRideable *s){return 0;}
