// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Entity_setPos(Entity *s,F32 x,F32 y,F32 z){s->body.x=x;s->body.y=y;s->body.z=z;F32 r=s->body.width*0.5,my=(y-s->ridingHeight)+s->ySize;AABB_Init(&s->box,x-r,my,z-r,x+r,my+s->body.height,z+r);s->body.minYBound=my;}
U0 Entity_Init(Entity *s,Level *level,I32 type,F32 width,F32 height){memset(s,0,sizeof(Entity));s->level=level;MCWorld023 *w=NULL;if(level)w=&level->world;MC023_BodyInit(&s->body,w,type,width,height);s->air=300;Entity_setPos(s,0,0,0);}
U0 Entity_setSize(Entity *s,F32 width,F32 height){s->body.width=width;s->body.height=height;}
U0 Entity_setRot(Entity *s,F32 yaw,F32 pitch){s->body.prevYaw=yaw;s->body.yaw=yaw;s->body.prevPitch=pitch;s->body.pitch=pitch;}
U0 Entity_moveTo(Entity *s,F32 x,F32 y,F32 z,F32 yaw,F32 pitch){Entity_setPos(s,x,y+s->ridingHeight,z);s->body.prevX=x;s->body.prevY=s->body.y;s->body.prevZ=z;Entity_setRot(s,yaw,pitch);}
U0 Entity_turn(Entity *s,F32 dx,F32 dy){F32 oldYaw=s->body.yaw,oldPitch=s->body.pitch;s->body.yaw+=dx*0.15;s->body.pitch-=dy*0.15;if(s->body.pitch < -90)s->body.pitch=-90;if(s->body.pitch>90)s->body.pitch=90;s->body.prevYaw+=s->body.yaw-oldYaw;s->body.prevPitch+=s->body.pitch-oldPitch;}
U0 Entity_interpolateTurn(Entity *s,F32 dx,F32 dy){s->body.yaw+=dx*0.15;s->body.pitch-=dy*0.15;if(s->body.pitch < -90)s->body.pitch=-90;if(s->body.pitch>90)s->body.pitch=90;}
U0 Entity_moveRelative(Entity *s,F32 strafe,F32 forward,F32 speed){F32 n=sqrt(strafe*strafe+forward*forward);if(n<0.01)return;if(n<1)n=1;F32 scale=speed/n,x=strafe*scale,z=forward*scale,r=(s->body.yaw*3.1416)/180,sn=sin(r),cs=cos(r);s->body.motionX+=(x*cs)-(z*sn);s->body.motionZ+=(x*sn)+(z*cs);}
Bool Entity_isFree(Entity *s,F32 dx,F32 dy,F32 dz){if(!s->level)return TRUE;AABB a=s->box;AABB_move(&a,dx,dy,dz);MCVector v;Level_getCubes(s->level,&a,&v);Bool ok=v.size==0;MCVector_Destroy(&v);return ok;}
F32 MC025_SneakReduce(F32 v){if(v<0.05 && v>=-0.05)return 0;if(v<=0)return v+0.05;return v-0.05;}
U0 Entity_move(Entity *s,F32 dx,F32 dy,F32 dz){MCBody023 *b=&s->body;if(s->noclip || !s->level){AABB_move(&s->box,dx,dy,dz);}else{if(s->inWeb){s->inWeb=FALSE;b->motionX=0;b->motionY=0;b->motionZ=0;dx*=0.25;dy*=0.05;dz*=0.25;}AABB original=s->box;if(b->onGround && s->sneaking){while(dx!=0 && Entity_isFree(s,dx,-1,0))dx=MC025_SneakReduce(dx);while(dz!=0 && Entity_isFree(s,0,-1,dz))dz=MC025_SneakReduce(dz);while(dx!=0 && dz!=0 && Entity_isFree(s,dx,-1,dz)){dx=MC025_SneakReduce(dx);dz=MC025_SneakReduce(dz);}}F32 x=dx,y=dy,z=dz;Level_clipMove(s->level,&s->box,&x,&y,&z);if(s->stepHeight>0 && (b->onGround || (dy!=y && dy<0)) && s->ySize<0.05 && (dx!=x || dz!=z)){AABB flat=s->box,step=original;F32 sx=dx,sy=s->stepHeight,sz=dz;Level_clipMove(s->level,&step,&sx,&sy,&sz);if(x*x+z*z<sx*sx+sz*sz){s->box=step;s->ySize+=0.5;x=sx;y=sy;z=sz;}else s->box=flat;}s->horizontalCollision=dx!=x || dz!=z;s->verticalCollision=dy!=y;s->collided=s->horizontalCollision || s->verticalCollision;b->onGround=dy!=y && dy<0;if(b->onGround)s->fallDistance=0;else if(y<0)s->fallDistance-=y;if(dx!=x)b->motionX=0;if(dy!=y)b->motionY=0;if(dz!=z)b->motionZ=0;}
 b->x=(s->box.minX+s->box.maxX)*0.5;b->y=(s->box.minY+s->ridingHeight)-s->ySize;b->z=(s->box.minZ+s->box.maxZ)*0.5;b->minYBound=s->box.minY;if(!s->noclip)s->ySize*=0.4;}
U0 Entity_remove(Entity *s){s->body.dead=TRUE;s->body.alive=FALSE;}
U0 MC025_PutFloat(CompoundTag *t,U8 *name,F32 value){MCString n;MCString_FromC(&n,name);CompoundTag_putFloat(t,&n,value);MCString_Destroy(&n);}
F32 MC025_GetFloat(CompoundTag *t,U8 *name){MCString n;MCString_FromC(&n,name);F32 v=CompoundTag_getFloat(t,&n);MCString_Destroy(&n);return v;}
U0 MC025_PutShort(CompoundTag *t,U8 *name,I32 value){MCString n;MCString_FromC(&n,name);CompoundTag_putShort(t,&n,value);MCString_Destroy(&n);}
I32 MC025_GetShort(CompoundTag *t,U8 *name){MCString n;MCString_FromC(&n,name);I32 v=CompoundTag_getShort(t,&n);MCString_Destroy(&n);return v;}
U0 MC025_PutByte(CompoundTag *t,U8 *name,I32 value){MCString n;MCString_FromC(&n,name);CompoundTag_putByte(t,&n,value);MCString_Destroy(&n);}
I32 MC025_GetByte(CompoundTag *t,U8 *name){MCString n;MCString_FromC(&n,name);I32 v=CompoundTag_getByte(t,&n);MCString_Destroy(&n);return v;}
U0 MC025_FloatList(CompoundTag *t,U8 *name,F32 *values,I32 n){ListTagFloatAdder a;a.tag=NULL;I32 i;for(i=0;i<n;i++)ListTagFloatAdder_Apply(&a,values[i]);MCString key;MCString_FromC(&key,name);CompoundTag_put(t,&key,a.tag);MCString_Destroy(&key);}
ListTag *MC025_List(CompoundTag *t,U8 *name,I32 minSize){MCString key;MCString_FromC(&key,name);Tag *tag=CompoundTag_get(t,&key);MCString_Destroy(&key);if(!tag || tag->id!=9)return NULL;ListTag *list=tag;if(list->value.size<minSize || list->tagType!=5)return NULL;return list;}
U0 Entity_saveWithoutId(Entity *s,CompoundTag *t){F32 pos[3]={s->body.x,s->body.y,s->body.z},motion[3]={s->body.motionX,s->body.motionY,s->body.motionZ},rot[2]={s->body.yaw,s->body.pitch};MC025_FloatList(t,"Pos",pos,3);MC025_FloatList(t,"Motion",motion,3);MC025_FloatList(t,"Rotation",rot,2);MC025_PutFloat(t,"FallDistance",s->fallDistance);MC025_PutShort(t,"Fire",s->fire);MC025_PutShort(t,"Air",s->air);MC025_PutByte(t,"OnGround",s->body.onGround);}
Bool Entity_save(Entity *s,CompoundTag *t){if(s->body.dead || s->body.type==0 || s->rider)return FALSE;MC024_PutInt(t,"id",s->body.type);Entity_saveWithoutId(s,t);return TRUE;}
Bool Entity_load(Entity *s,CompoundTag *t){ListTag *p=MC025_List(t,"Pos",3),*m=MC025_List(t,"Motion",3),*r=MC025_List(t,"Rotation",2);if(!p || !m || !r)return FALSE;s->body.motionX=ListTag_getFloat(m,0);s->body.motionY=ListTag_getFloat(m,1);s->body.motionZ=ListTag_getFloat(m,2);if(fabs(s->body.motionX)>10)s->body.motionX=0;if(fabs(s->body.motionY)>10)s->body.motionY=0;if(fabs(s->body.motionZ)>10)s->body.motionZ=0;F32 x=ListTag_getFloat(p,0),y=ListTag_getFloat(p,1),z=ListTag_getFloat(p,2),edge=s->body.width*0.5+0.001;if(x>256-edge)x=256-edge;else if(x<=edge)x=edge;if(z>256-edge)z=256-edge;else if(z<=edge)z=edge;Entity_setPos(s,x,y,z);s->body.prevX=x;s->body.prevY=y;s->body.prevZ=z;Entity_setRot(s,fmod(ListTag_getFloat(r,0),360),fmod(ListTag_getFloat(r,1),360));s->fallDistance=MC025_GetFloat(t,"FallDistance");s->fire=MC025_GetShort(t,"Fire");s->air=MC025_GetShort(t,"Air");s->body.onGround=MC025_GetByte(t,"OnGround")!=0;return t->field_0==0;}

// Original resetPos search; finite world needs <=129 steps. Defensive cap 256.
U0 Entity_resetPos(Entity *s,Bool resetHealth){MCBody023 *b=&s->body;if(!s->level)return;I32 tries=0;while(b->y>0 && tries<256){Entity_setPos(s,b->x,b->y,b->z);MCVector cubes;Level_getCubes(s->level,&s->box,&cubes);Bool clear=cubes.size==0;MCVector_Destroy(&cubes);if(clear)break;b->y+=1;tries++;}b->motionX=b->motionY=b->motionZ=0;b->pitch=0;}
