// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
F32 HangingEntity_offs(I32 n){if(n==32 || n==64)return 0.5;return 0;}
U0 HangingEntity_setDir(HangingEntity *s,I32 dir){if(dir<0 || dir>3)return;s->direction=dir;I32 opposite[4]={2,3,0,1};s->body.yaw=90*dir;F32 wx=s->widthPx,wz=s->widthPx;if(dir==0 || dir==2){wz=2;s->body.yaw=90*opposite[dir];}else wx=2;s->body.prevYaw=s->body.yaw;F32 x=s->tileX+0.5,y=s->tileY+0.5+HangingEntity_offs(s->heightPx),z=s->tileZ+0.5,off=HangingEntity_offs(s->widthPx);if(dir==0){z+=0.5625;x+=off;}if(dir==1){x-=0.5625;z+=off;}if(dir==2){z-=0.5625;x-=off;}if(dir==3){x+=0.5625;z-=off;}s->body.x=x;s->body.y=y;s->body.z=z;MC023_Shape(&s->bounds,x-wx*0.03125+0.03125,y-s->heightPx*0.03125+0.03125,z-wz*0.03125+0.03125,x+wx*0.03125-0.03125,y+s->heightPx*0.03125-0.03125,z+wz*0.03125-0.03125);}
U0 HangingEntity_Init(HangingEntity *s,MCWorld023 *world,I32 x,I32 y,I32 z,I32 width,I32 height,I32 direction){memset(s,0,sizeof(HangingEntity));MC023_BodyInit(&s->body,world,0,0.5,0.5);s->tileX=x;s->tileY=y;s->tileZ=z;s->widthPx=width;s->heightPx=height;HangingEntity_setDir(s,direction);}
U0 HangingEntity_move(HangingEntity *s,F32 x,F32 y,F32 z){if(!s->body.w->isClient && !s->body.dead && x*x+y*y+z*z>0){if(s->drop!=NULL)s->drop(s->ctx,s);MC023_Remove(&s->body);}}
U0 HangingEntity_tick(HangingEntity *s){I32 old=s->ticker++;if(old==100 && !s->body.w->isClient){s->ticker=0;if(!s->body.dead && s->survives!=NULL && !s->survives(s->ctx,s)){MC023_Remove(&s->body);if(s->drop!=NULL)s->drop(s->ctx,s);}}}
Bool HangingEntity_hurt(HangingEntity *s,Bool player,Bool creative){if(!s->body.dead && !s->body.w->isClient){MC023_Remove(&s->body);if((!player || !creative) && s->drop!=NULL)s->drop(s->ctx,s);}return TRUE;}
U0 HangingEntity_save(HangingEntity *s,CompoundTag *t){I32 legacy[4]={2,1,0,3};MC023_NBTPut(t,"Direction",s->direction,TRUE);MC023_NBTPut(t,"Dir",legacy[s->direction],TRUE);MC024_PutInt(t,"TileX",s->tileX);MC024_PutInt(t,"TileY",s->tileY);MC024_PutInt(t,"TileZ",s->tileZ);}
U0 HangingEntity_load(HangingEntity *s,CompoundTag *t){I32 dir;if(MC024_Contains(t,"Direction",1))dir=MC023_NBTGet(t,"Direction",TRUE);else{I32 map[4]={2,1,0,3},old=MC023_NBTGet(t,"Dir",TRUE);dir=0;if(old<4)dir=map[old];}s->tileX=MC024_Int(t,"TileX");s->tileY=MC024_Int(t,"TileY");s->tileZ=MC024_Int(t,"TileZ");HangingEntity_setDir(s,dir);}
