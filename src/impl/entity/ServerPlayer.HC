// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 ServerPlayer_Init(ServerPlayer *s,MCPlayer023 *player){memset(s,0,sizeof(ServerPlayer));s->player=player;s->lastSentHealth=-999;s->counter=1;}
U0 ServerPlayer_nextContainerCounter(ServerPlayer *s){s->counter++;if(s->counter>99)s->counter=1;}
U0 ServerPlayer_setPlayerInput(ServerPlayer *s,F32 strafe,F32 forward,Bool jump,Bool sneak){if(!s->riding)return;if(strafe>=-1 && strafe<=1)s->strafe=strafe;if(forward>=-1 && forward<=1)s->forward=forward;s->jumping=jump;s->sneaking=sneak;}
U0 ServerPlayer_tick(ServerPlayer *s){MC023_BaseTick(s->player(MCBody023*));if(s->player->inventory && Inventory_getSelected(s->player->inventory))s->useDuration--;if(s->container && s->menu!=NULL)s->menu(s->ctx,1,s->container,NULL);if(s->player->health!=s->lastSentHealth){s->lastSentHealth=s->player->health;SetHealthPacket packet;SetHealthPacket_InitValues(&packet,s->lastSentHealth);if(s->send!=NULL)s->send(s->ctx,(&packet)(Packet*));}}
U0 ServerPlayer_open(ServerPlayer *s,I32 type,I32 slots,I32 x,I32 y,I32 z,U0 *object){ServerPlayer_nextContainerCounter(s);ContainerOpenPacket packet;ContainerOpenPacket_InitValues(&packet,s->counter,type,slots,x,y,z);if(s->send!=NULL)s->send(s->ctx,(&packet)(Packet*));s->container=s->counter;if(s->menu!=NULL)s->menu(s->ctx,0,type,object);}
U0 ServerPlayer_openContainer(ServerPlayer *s,ChestTileEntity *chest){ServerPlayer_open(s,0,ChestTileEntity_getContainerSize(chest),chest->base.x,chest->base.y,chest->base.z,chest);}
U0 ServerPlayer_openFurnace(ServerPlayer *s,FurnaceTileEntity *f){ServerPlayer_open(s,2,3,f->x,f->y,f->z,f);}
U0 ServerPlayer_closeContainer(ServerPlayer *s){if(!s->container)return;ContainerClosePacket packet;ContainerClosePacket_InitValues(&packet,s->container);packet.packetReliabilityMaybe=3;if(s->send!=NULL)s->send(s->ctx,(&packet)(Packet*));if(s->menu!=NULL)s->menu(s->ctx,2,s->container,NULL);s->container=0;}
U0 ServerPlayer_slotChanged(ServerPlayer *s,I32 slot,ItemInstance *item,Bool suppress){if(suppress)return;MCPacketItem009 value;memset(&value,0,sizeof(value));if(item){value.id=ItemInstance_getId(item);value.count=item->count;value.aux=item->metadata;}ContainerSetSlotPacket packet;ContainerSetSlotPacket_InitValues(&packet,0,s->container,slot,&value);if(s->send!=NULL)s->send(s->ctx,(&packet)(Packet*));}
Bool ServerPlayer_hasResource(I32 unused){return TRUE;}
