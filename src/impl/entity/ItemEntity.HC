// Batch023: entity/ItemEntity; explicit simulation ABI, see docs/BATCH023.md.
U0 ItemEntity_Init(ItemEntity *s,MCWorld023 *w,F32 x,F32 y,F32 z,ItemInstance *item,U32 seed) {memset(s,0,sizeof(ItemEntity));MC023_BodyInit(s,w,64,0.25,0.25);Random_setSeed(&s->rng,seed);s->x=x;s->y=y;s->z=z;s->healthValue=5;s->lifetime=6000;ItemInstance_cloneSafe(&s->item,w->registry,item);s->hover=Random_nextFloat(&s->rng)*6.283185307;s->yaw=Random_nextFloat(&s->rng)*360.0;s->motionX=Random_nextFloat(&s->rng)*0.2-0.1;s->motionY=0.2;s->motionZ=Random_nextFloat(&s->rng)*0.2-0.1;}
Bool ItemEntity_checkInTile(ItemEntity *s) {I32 x=floorf(s->x),y=floorf(s->y),z=floorf(s->z);if(!MC023_Solid(s->w,x,y,z))return FALSE;I32 dx[6]={-1,1,0,0,0,0},dy[6]={0,0,-1,1,0,0},dz[6]={0,0,0,0,-1,1},i,best=-1;F32 f[6],d=999;f[0]=s->x-x;f[1]=1-f[0];f[2]=s->y-y;f[3]=1-f[2];f[4]=s->z-z;f[5]=1-f[4];for(i=0;i<6;i++)if(!MC023_Solid(s->w,x+dx[i],y+dy[i],z+dz[i]) && f[i]<d){best=i;d=f[i];}F32 speed=Random_nextFloat(&s->rng)*0.2+0.1;if(best==0)s->motionX=-speed;if(best==1)s->motionX=speed;if(best==2)s->motionY=-speed;if(best==3)s->motionY=speed;if(best==4)s->motionZ=-speed;if(best==5)s->motionZ=speed;return FALSE;}
U0 ItemEntity_tick(ItemEntity *s) {MC023_BaseTick(s);if(s->pickupDelay>0)s->pickupDelay--;s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;s->motionY-=0.04;if(MC023_Material(s->w,floorf(s->x),floorf(s->y),floorf(s->z))==4){s->motionY=0.2;s->motionX=(Random_nextFloat(&s->rng)-Random_nextFloat(&s->rng))*0.2;s->motionZ=(Random_nextFloat(&s->rng)-Random_nextFloat(&s->rng))*0.2;MC023_Sound(s->w,"random.fizz",s->x,s->y,s->z,0.4,2.0+Random_nextFloat(&s->rng)*0.4);}ItemEntity_checkInTile(s);MC023_Move(s);F32 friction=0.98;if(s->onGround){friction=0.588;I32 tile=MC023_Tile(s->w,floorf(s->x),floorf(s->minYBound)-1,floorf(s->z));MCTileDef023 *t=MC023_Def(s->w,tile);if(tile && t)friction=t->slipperiness*0.98;}s->motionX*=friction;s->motionZ*=friction;s->motionY*=0.98;if(s->onGround)s->motionY*= -0.5;s->itemAge++;s->ticks++;if(s->itemAge>=s->lifetime)MC023_Remove(s);}
Bool ItemEntity_hurt(ItemEntity *s,I32 damage) {s->healthValue-=damage;if(s->healthValue<=0)MC023_Remove(s);return FALSE;}
U0 ItemEntity_playerTouch(ItemEntity *s,MCPlayer023 *p) {if(s->w->isClient || s->pickupDelay || p->dead)return;I32 count=s->item.count;if(Inventory_add(p->inventory,&s->item)){MC023_Sound(s->w,"random.pop",s->x,s->y,s->z,0.3,((Random_nextFloat(&s->rng)-Random_nextFloat(&s->rng))*0.7+1.0)*2);MC023_Event(s->w,MC023_TAKE,0,0,0,0,0,count,p,s);MC023_Remove(s);/* Source removes also on partial add; retained, not claimed fixed. */}}
U0 ItemEntity_save(ItemEntity *s,CompoundTag *t) {MC023_NBTPut(t,"Health",s->healthValue,FALSE);MC023_NBTPut(t,"Age",s->ticks,FALSE);CompoundTag *i=MC_Alloc(sizeof(CompoundTag));CompoundTag_InitEmpty(i);ItemInstance_save(&s->item,i);MC023_TagPut(t,"Item",i);}
U0 ItemEntity_load(ItemEntity *s,CompoundTag *t) {s->healthValue=MC023_NBTGet(t,"Health",FALSE);s->ticks=MC023_NBTGet(t,"Age",FALSE);Tag *i=MC023_TagGet(t,"Item");if(i && Tag_getId(i)==10)ItemInstance_load(&s->item,i(CompoundTag*));}
