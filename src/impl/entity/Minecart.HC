// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Minecart_Init(Minecart *s,Level *level,F32 x,F32 y,F32 z){memset(s,0,sizeof(Minecart));Entity_Init(&s->entity,level,84,0.98,0.7);s->entity.ridingHeight=s->entity.body.height*0.5;Entity_setPos(&s->entity,x,y+s->entity.ridingHeight,z);s->hurtDir=1;s->displayOffset=6;MCString_Init(&s->customName);}
U0 Minecart_Destroy(Minecart *s){MCString_Destroy(&s->customName);}
U0 Minecart_applyNaturalSlowdown(Minecart *s){F32 f=0.96;if(s->entity.rider)f=0.997;s->entity.body.motionX*=f;s->entity.body.motionY*=0;s->entity.body.motionZ*=f;}
U0 Minecart_comeOffTrack(Minecart *s,F32 maxSpeed){MCBody023 *b=&s->entity.body;if(b->motionX < -maxSpeed)b->motionX=-maxSpeed;if(b->motionX>maxSpeed)b->motionX=maxSpeed;if(b->motionZ < -maxSpeed)b->motionZ=-maxSpeed;if(b->motionZ>maxSpeed)b->motionZ=maxSpeed;if(b->onGround){b->motionX*=0.5;b->motionY*=0.5;b->motionZ*=0.5;}Entity_move(&s->entity,b->motionX,b->motionY,b->motionZ);if(!b->onGround){b->motionX*=0.95;b->motionY*=0.95;b->motionZ*=0.95;}}
U0 Minecart_animateHurt(Minecart *s){s->hurtDir=-s->hurtDir;s->hurtTime=10;s->damage+=s->damage*10;}
Bool Minecart_hurt(Minecart *s,Entity *attacker,I32 amount,Bool creative){if(s->entity.body.dead)return TRUE;if(s->entity.level->world.isClient)return TRUE;s->hurtDir=-s->hurtDir;s->hurtTime=10;s->damage+=10*amount;if(!attacker){Entity_remove(&s->entity);return TRUE;}if(creative || s->damage>40){if(!creative || s->customName.size>0)MC023_Event(&s->entity.level->world,MC023_DROP,floorf(s->entity.body.x),floorf(s->entity.body.y),floorf(s->entity.body.z),328,0,1);Entity_remove(&s->entity);}return TRUE;}
U0 Minecart_setDisplay(Minecart *s,I32 id,I32 data,I32 offset){s->displayId=id;s->displayPacked=(id&65535)|(data<<16);s->displayOffset=offset;s->customDisplay=TRUE;}
I32 Minecart_getDisplayData(Minecart *s){if(s->customDisplay)return s->displayPacked>>16;return 0;}
I32 Minecart_getDisplayOffset(Minecart *s){if(s->customDisplay)return s->displayOffset;return 6;}
U0 Minecart_addSaveData(Minecart *s,CompoundTag *t){Entity_saveWithoutId(&s->entity,t);if(s->customDisplay){MC025_PutByte(t,"CustomDisplayTile",1);MC024_PutInt(t,"DisplayTile",s->displayId);MC024_PutInt(t,"DisplayData",Minecart_getDisplayData(s));MC024_PutInt(t,"DisplayOffset",s->displayOffset);}if(s->customName.size)MC024_PutString(t,"CustomName",&s->customName);}
U0 Minecart_readAdditionalSaveData(Minecart *s,CompoundTag *t){s->customDisplay=MC025_GetByte(t,"CustomDisplayTile")!=0;if(s->customDisplay)Minecart_setDisplay(s,MC024_Int(t,"DisplayTile"),MC024_Int(t,"DisplayData"),MC024_Int(t,"DisplayOffset"));MCString text;MC024_GetString(t,"CustomName",&text);MCString_Assign(&s->customName,&text);MCString_Destroy(&text);}
