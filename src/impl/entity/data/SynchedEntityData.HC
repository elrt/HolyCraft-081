U0 SynchedEntityData_Init(SynchedEntityData *s) {MCVector_Init(&s->data,sizeof(MCSynchedEntry021));s->isDirty=FALSE;}
DataItem2 *SynchedEntityData_Find(SynchedEntityData *s,I32 id) {MCSynchedEntry021 *items=s->data.data(MCSynchedEntry021*);I64 i;for(i=0;i<s->data.size;i++)if(items[i].id==id)return items[i].item;return NULL;}
Bool SynchedEntityData_DefineOwned(SynchedEntityData *s,DataItem2 *item) {if(!item)return FALSE;if(item->dataId>31 || SynchedEntityData_Find(s,item->dataId)){DataItem2_Delete(item);return FALSE;}MCSynchedEntry021 e;e.id=item->dataId;e.item=item;MCVector_Push(&s->data,&e);MCSynchedEntry021 *items=s->data.data(MCSynchedEntry021*);I64 i=s->data.size-1;while(i>0 && items[i-1].id>e.id){items[i]=items[i-1];--i;}items[i]=e;return TRUE;}
U0 SynchedEntityData_Destroy(SynchedEntityData *s) {MCSynchedEntry021 *items=s->data.data(MCSynchedEntry021*);I64 i;for(i=0;i<s->data.size;i++)DataItem2_Delete(items[i].item);MCVector_Destroy(&s->data);s->isDirty=FALSE;}
I8 SynchedEntityData_getByte(SynchedEntityData *s,I32 id) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=0)return 0;return p->byteValue;}
I16 SynchedEntityData_getShort(SynchedEntityData *s,I32 id) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=1)return 0;return p->shortValue;}
I32 SynchedEntityData_getInt(SynchedEntityData *s,I32 id) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=2)return 0;return p->intValue;}
F32 SynchedEntityData_getFloat(SynchedEntityData *s,I32 id) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=3)return 0;return p->floatValue;}
U0 SynchedEntityData_getString(SynchedEntityData *s,I32 id,MCString *out) {DataItem2 *p=SynchedEntityData_Find(s,id);MCString_Init(out);if(p && p->typeId==4)MCString_CopyInit(out,&p->stringValue);}
U0 SynchedEntityData_getItemInstance(SynchedEntityData *s,I32 id,MCPacketItem009 *out) {memset(out,0,sizeof(MCPacketItem009));DataItem2 *p=SynchedEntityData_Find(s,id);if(p && p->typeId==5)*out=p->itemValue;}
U0 SynchedEntityData_getPos(SynchedEntityData *s,I32 id,Pos *out) {Pos_Init(out,0,0,0);DataItem2 *p=SynchedEntityData_Find(s,id);if(p && p->typeId==6)*out=p->posValue;}
Bool SynchedEntityData_markDirty(SynchedEntityData *s,I32 id) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p)return FALSE;p->dirty=TRUE;s->isDirty=TRUE;return TRUE;}
Bool SynchedEntityData_SetValue(SynchedEntityData *s,I32 id,DataItem2 *value) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=value->typeId)return FALSE;if(!DataItem2_ValueEqual(p,value)){DataItem2_CopyValue(p,value);p->dirty=TRUE;s->isDirty=TRUE;}return TRUE;}
U0 SynchedEntityData_assignValuesMode(SynchedEntityData *s,MCPtrVector *values,Bool fixByteBug) {I64 i;for(i=0;i<values->size;i++){DataItem2 *p=values->data[i];if(p && (p->typeId!=0 || fixByteBug))SynchedEntityData_SetValue(s,p->dataId,p);}}
U0 SynchedEntityData_assignValues(SynchedEntityData *s,MCPtrVector *values) {SynchedEntityData_assignValuesMode(s,values,FALSE);}
Bool SynchedEntityData_Flag(SynchedEntityData *s,I32 id,I32 bit,Bool set) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=0 || bit<0 || bit>7)return FALSE;I8 old=p->byteValue,value=old;if(set)value=old|(1<<bit);else value=old&~(1<<bit);p->byteValue=value;if(((value>>bit)&1)!=((old>>bit)&1))SynchedEntityData_markDirty(s,id);return TRUE;}
Bool SynchedEntityData_setFlag(SynchedEntityData *s,I32 id,I32 bit) {return SynchedEntityData_Flag(s,id,bit,TRUE);}
Bool SynchedEntityData_clearFlag(SynchedEntityData *s,I32 id,I32 bit) {return SynchedEntityData_Flag(s,id,bit,FALSE);}
U0 SynchedEntityData_packDirty(SynchedEntityData *s,MCPtrVector *out) {MCPtrVector_Init(out);MCSynchedEntry021 *items=s->data.data(MCSynchedEntry021*);I64 i;if(s->isDirty)for(i=0;i<s->data.size;i++)if(items[i].item->dirty){items[i].item->dirty=FALSE;MCPtrVector_Push(out,items[i].item);}s->isDirty=FALSE;}
U0 SynchedEntityData_writeDataItem(IDataOutput *out,DataItem2 *p) {IDataOutput_writeByte(out,(p->dataId&31)|(32*p->typeId));switch(p->typeId){case 0:IDataOutput_writeByte(out,p->byteValue);break;case 1:IDataOutput_writeShort(out,p->shortValue);break;case 2:IDataOutput_writeInt(out,p->intValue);break;case 3:IDataOutput_writeFloat(out,p->floatValue);break;case 4:IDataOutput_writeString(out,&p->stringValue);break;case 5:IDataOutput_writeShort(out,p->itemValue.id);IDataOutput_writeByte(out,p->itemValue.count);IDataOutput_writeShort(out,p->itemValue.aux);break;case 6:IDataOutput_writeInt(out,p->posValue.x);IDataOutput_writeInt(out,p->posValue.y);IDataOutput_writeInt(out,p->posValue.z);break;}}
U0 SynchedEntityData_pack(MCPtrVector *values,IDataOutput *out) {I64 i;if(values)for(i=0;i<values->size;i++)if(values->data[i])SynchedEntityData_writeDataItem(out,values->data[i]);IDataOutput_writeByte(out,127);}
U0 SynchedEntityData_packAll(SynchedEntityData *s,IDataOutput *out) {MCSynchedEntry021 *items=s->data.data(MCSynchedEntry021*);I64 i;for(i=0;i<s->data.size;i++)SynchedEntityData_writeDataItem(out,items[i].item);IDataOutput_writeByte(out,127);}
Bool SynchedEntityData_unpack(IDataInput *input,MCPtrVector *out) {MCPtrVector_Init(out);while(!input->failed && IDataInput_hasBytesLeft(input,1)){U8 header=IDataInput_readByte(input);if(header==127)return TRUE;I32 type=header>>5,id=header&31;if(type>6){input->failed=TRUE;break;}DataItem2 *p=DataItem2_New(type,id);switch(type){case 0:p->byteValue=IDataInput_readByte(input);break;case 1:p->shortValue=IDataInput_readShort(input);break;case 2:p->intValue=IDataInput_readInt(input);break;case 3:p->floatValue=IDataInput_readFloat(input);break;case 4:IDataInput_readString(input,&p->stringValue);break;case 5:p->itemValue.id=IDataInput_readShort(input);p->itemValue.count=IDataInput_readByte(input);p->itemValue.aux=IDataInput_readShort(input);p->itemValue.valid=TRUE;break;case 6:p->posValue.x=IDataInput_readInt(input);p->posValue.y=IDataInput_readInt(input);p->posValue.z=IDataInput_readInt(input);break;}if(input->failed){DataItem2_Delete(p);break;}MCPtrVector_Push(out,p);}input->failed=TRUE;DataItem2_DeleteList(out);MCPtrVector_Init(out);return FALSE;}
Bool SynchedEntityData_setByte(SynchedEntityData *s,I32 id,I8 value) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=0)return FALSE;if(p->byteValue!=value){p->byteValue=value;SynchedEntityData_markDirty(s,id);}return TRUE;}
Bool SynchedEntityData_setShort(SynchedEntityData *s,I32 id,I16 value) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=1)return FALSE;if(p->shortValue!=value){p->shortValue=value;SynchedEntityData_markDirty(s,id);}return TRUE;}
Bool SynchedEntityData_setInt(SynchedEntityData *s,I32 id,I32 value) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=2)return FALSE;if(p->intValue!=value){p->intValue=value;SynchedEntityData_markDirty(s,id);}return TRUE;}
Bool SynchedEntityData_setFloat(SynchedEntityData *s,I32 id,F32 value) {DataItem2 *p=SynchedEntityData_Find(s,id);if(!p || p->typeId!=3)return FALSE;if(p->floatValue!=value){p->floatValue=value;SynchedEntityData_markDirty(s,id);}return TRUE;}
