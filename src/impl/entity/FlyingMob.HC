U0 FlyingMob_Init(FlyingMob *s,MCFlyingHost015 *h){s->host=h;}
U0 FlyingMob_causeFallDamage(FlyingMob *s,F32 d){}Bool FlyingMob_onLadder(FlyingMob *s){return FALSE;}
F32 MCFlying_drag015(FlyingMob *s){I32 id;MCFlyingHost015 *h=s->host;if(!s->onGround)return 0.91;id=h->tile(h->host,floorf(s->posX),floorf(s->minY-0.5),floorf(s->posZ));if(id<=0)return 0.546;return h->slipperiness(h->host,id)*0.91;}
U0 FlyingMob_travel(FlyingMob *s,F32 a,F32 b){MCFlyingHost015 *h=s->host;F32 drag,acc,dx,dz,v;if(h->water(h->host,s)){h->moveRelative(h->host,s,a,b,(0.02)(F32));h->move(h->host,s,s->motionX,s->motionY,s->motionZ);s->motionX*=0.8;s->motionY*=0.8;s->motionZ*=0.8;}else if(h->lava(h->host,s)){h->moveRelative(h->host,s,a,b,(0.02)(F32));h->move(h->host,s,s->motionX,s->motionY,s->motionZ);s->motionX*=0.5;s->motionY*=0.5;s->motionZ*=0.5;}else{drag=MCFlying_drag015(s);if(s->onGround)acc=0.016277/(drag*drag*drag);else acc=0.02;h->moveRelative(h->host,s,a,b,acc);drag=MCFlying_drag015(s);h->move(h->host,s,s->motionX,s->motionY,s->motionZ);s->motionX*=drag;s->motionY*=drag;s->motionZ*=drag;}dx=s->posX-s->prevX;dz=s->posZ-s->prevZ;s->field168=s->field16C;v=sqrtf(dz*dz+dx*dx)*4;if(v>1)v=1;s->field16C+=(v-s->field16C)*0.4;s->field170+=s->field16C;}
