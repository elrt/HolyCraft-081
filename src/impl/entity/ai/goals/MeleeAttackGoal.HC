Bool MeleeAttackGoal_canUse(Goal *b) {MeleeAttackGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=h->target(h->ctx);if(!t)return FALSE;MCGoal020_Target(h,&s->targetId,&s->hasTarget,t);if(s->path)h->deletePath(h->ctx,s->path);s->path=h->createPath(h->ctx,MCGoal020_Lock(h,s->targetId,s->hasTarget));return s->path!=NULL;}
