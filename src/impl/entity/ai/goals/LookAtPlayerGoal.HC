// Batch 009: minecraftpe/impl/entity/ai/goals/LookAtPlayerGoal.cpp
U0 LookAtPlayerGoal_Init(LookAtPlayerGoal *s,MCGoalContext009 *h,F32 distance,F32 chance=0.02) { Goal_Init(&s->base);s->base.context=s;s->base.canUseFn=&LookAtPlayerGoal_canUse;s->base.continueFn=&LookAtPlayerGoal_canContinueToUse;s->base.startFn=&LookAtPlayerGoal_start;s->base.stopFn=&LookAtPlayerGoal_stop;s->base.destroyFn=&LookAtPlayerGoal_stop;s->base.tickFn=&LookAtPlayerGoal_tick;s->holder=h;s->hasTarget=FALSE;s->targetId=0;s->maxDistance=distance;s->startChance=chance;s->ticksLeft=0;Goal_setRequiredControlFlags(&s->base,2); }
Bool LookAtPlayerGoal_canUse(Goal *b) { LookAtPlayerGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;if(Random_nextFloat(h->random)>=s->startChance)return FALSE;t=h->nearestPlayer(h->host,s->maxDistance);if(!t || !s->hasTarget || t->id!=s->targetId) { if(s->hasTarget)h->releaseTarget(h->host,s->targetId);s->hasTarget=FALSE;if(t) { s->targetId=t->id;s->hasTarget=TRUE;h->retainTarget(h->host,t); } }if(!s->hasTarget)return FALSE;return h->lockTarget(h->host,s->targetId)!=NULL; }
Bool LookAtPlayerGoal_canContinueToUse(Goal *b) { LookAtPlayerGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;if(!s->hasTarget)return FALSE;t=h->lockTarget(h->host,s->targetId);if(!t || !t->alive || h->distanceToSqr(h->host,t)>s->maxDistance*s->maxDistance)return FALSE;return s->ticksLeft>0; }
U0 LookAtPlayerGoal_start(Goal *b) { LookAtPlayerGoal *s=b->context;s->ticksLeft=Random_genrand_int32(s->holder->random)%40+40; }
U0 LookAtPlayerGoal_stop(Goal *b) { LookAtPlayerGoal *s=b->context;if(s->hasTarget) { s->holder->releaseTarget(s->holder->host,s->targetId);s->hasTarget=FALSE; } }
U0 LookAtPlayerGoal_tick(Goal *b) { LookAtPlayerGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t=h->lockTarget(h->host,s->targetId);if(!t) { printf("LookAtPlayerGoal: target lost before tick\n");exit(93); }LookControl_setLookAt(h->look,t->x,t->y+t->headHeight,t->z,10,h->maxHeadXRot);--s->ticksLeft; }
