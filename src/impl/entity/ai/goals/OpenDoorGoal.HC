U0 OpenDoorGoal_Init(OpenDoorGoal *s,MCDoorHost012 *h,Bool close){DoorInteractGoal_Init(&s->base,h);s->closeAfter=close;s->base.base.context=s;s->base.base.continueFn=&OpenDoorGoal_canContinueToUse;s->base.base.startFn=&OpenDoorGoal_start;s->base.base.stopFn=&OpenDoorGoal_stop;s->base.base.tickFn=&OpenDoorGoal_tick;}
// Upstream accidentally recursively calls OpenDoorGoal::canContinueToUse(), not the base method.
// Surface this original unbounded recursion as an explicit error rather than silently claiming equivalence.
Bool OpenDoorGoal_canContinueToUse(Goal *g){OpenDoorGoal *s=g->context;if(!s->closeAfter || s->ticksLeft<=0)return FALSE;printf("Original OpenDoorGoal::canContinueToUse recurses indefinitely\n");exit(98);return FALSE;}
U0 OpenDoorGoal_start(Goal *g){OpenDoorGoal *s=g->context;MCDoorHost012 *h=s->base.host;s->ticksLeft=20;h->setDoorOpen(h->host,s->base.doorTile,s->base.doorX,s->base.doorY,s->base.doorZ,TRUE);}U0 OpenDoorGoal_stop(Goal *g){OpenDoorGoal *s=g->context;MCDoorHost012 *h=s->base.host;if(s->closeAfter)h->setDoorOpen(h->host,s->base.doorTile,s->base.doorX,s->base.doorY,s->base.doorZ,FALSE);}U0 OpenDoorGoal_tick(Goal *g){OpenDoorGoal *s=g->context;s->ticksLeft--;DoorInteractGoal_tick(g);}
