// Ported from minecraftpe/impl/entity/ai/goals/BreedGoal.cpp; host-facing representation, not C++ ABI.
U0 BreedGoal_Init(BreedGoal *s,MCGoalHost020 *h,F32 speed) {memset(s,0,sizeof(BreedGoal));Goal_Init(&s->base);s->base.context=s;s->h=h;s->level=h->level;Goal_setRequiredControlFlags(&s->base,3);s->speedMultiplier=speed;s->base.canUseFn=&BreedGoal_canUse;s->base.continueFn=&BreedGoal_canContinueToUse;s->base.stopFn=&BreedGoal_stop;s->base.tickFn=&BreedGoal_tick;s->base.destroyFn=&BreedGoal_Destroy; }
U0 BreedGoal_setLevel(BreedGoal *s,U0 *level) {s->level=level;}
MCActor020 * BreedGoal_getFreePartner(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;MCPtrVector out;MCPtrVector_Init(&out);MCActor020 *a=h->actor,*t=NULL;h->animals(h->ctx,a->type,(a->minX-8)(F32),(a->minY-8)(F32),(a->minZ-8)(F32),(a->maxX+8)(F32),(a->maxY+8)(F32),(a->maxZ+8)(F32),&out);I64 i;for(i=0;i<out.size;i++)if(h->canMate(h->ctx,out.data[i])){t=out.data[i];break;}MCPtrVector_Destroy(&out);return t;}
Bool BreedGoal_canUse(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;if(h->actor->inLove<=0)return FALSE;MCGoal020_Target(h,&s->targetId,&s->hasTarget,BreedGoal_getFreePartner(b));return MCGoal020_Lock(h,s->targetId,s->hasTarget)!=NULL;}
Bool BreedGoal_canContinueToUse(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);return t && t->alive && t->inLove>0 && s->inUseTicks<=59;}
U0 BreedGoal_stop(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;MCGoal020_Target(h,&s->targetId,&s->hasTarget,NULL);s->inUseTicks=0;}
U0 BreedGoal_breed(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget),*baby=h->offspring(h->ctx,t),*a=h->actor;if(baby){h->setAge(h->ctx,a,6000);h->setAge(h->ctx,t,6000);h->resetLove(h->ctx,a);h->resetLove(h->ctx,t);h->setAge(h->ctx,baby,-24000);h->moveBaby(h->ctx,baby,(a->x)(F32),(a->y)(F32),(a->z)(F32));h->addBaby(h->ctx,baby);I32 i;for(i=0;i<7;i++){F32 g=Random_nextGaussian(h->worldRandom),g2=Random_nextGaussian(h->worldRandom),g3=Random_nextGaussian(h->worldRandom);F32 x=a->x+(Random_nextFloat(h->worldRandom)*a->width)*2-a->width;F32 y=(a->y+0.5)+Random_nextFloat(h->worldRandom)*a->height;F32 z=a->z+(Random_nextFloat(h->worldRandom)*a->width)*2-a->width;h->heart(h->ctx,(x)(F32),(y)(F32),(z)(F32),(g*0.02)(F32),(g2*0.02)(F32),(g3*0.02)(F32));}}else{h->resetLove(h->ctx,a);h->resetLove(h->ctx,t);}}
U0 BreedGoal_tick(Goal *b) {BreedGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);h->look(h->ctx,t,(10)(F32),(h->maxHeadXRot)(F32));h->move(h->ctx,t,(s->speedMultiplier)(F32));++s->inUseTicks;if(s->inUseTicks==60)BreedGoal_breed(b);}
U0 BreedGoal_Destroy(Goal *b) {BreedGoal_stop(b);}
