// Ported from minecraftpe/impl/entity/ai/goals/TemptGoal.cpp; host-facing representation, not C++ ABI.
U0 TemptGoal_Init(TemptGoal *s,MCGoalHost020 *h,F32 speed,I32 *ids,I64 count,Bool scare) {memset(s,0,sizeof(TemptGoal));Goal_Init(&s->base);s->base.context=s;s->h=h;s->level=h->level;Goal_setRequiredControlFlags(&s->base,3);s->speedMultiplier=speed;s->field_4C=scare;MCVector_Init(&s->followItemIds,sizeof(I32));I64 i;for(i=0;i<count;i++)MCVector_Push(&s->followItemIds,&ids[i]);s->base.canUseFn=&TemptGoal_canUse;s->base.continueFn=&TemptGoal_canContinueToUse;s->base.startFn=&TemptGoal_start;s->base.stopFn=&TemptGoal_stop;s->base.tickFn=&TemptGoal_tick;s->base.destroyFn=&TemptGoal_Destroy; }
U0 TemptGoal_setLevel(TemptGoal *s,U0 *level) {s->level=level;}
Bool TemptGoal_isRunning(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;return s->running;}
Bool TemptGoal_canUse(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;if(s->timeout>0){--s->timeout;return FALSE;}MCGoal020_Target(h,&s->targetId,&s->hasTarget,h->nearest(h->ctx,(10)(F32)));MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);if(t && t->selected){I64 i;I32 *ids=s->followItemIds.data(I32*);for(i=0;i<s->followItemIds.size;i++)if(t->selected->id==ids[i])return TRUE;}return FALSE;}
Bool TemptGoal_canContinueToUse(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;if(s->field_4C){MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);if(!t)return FALSE;if(h->distanceSqr(h->ctx,t,FALSE)>=36){s->field_10=t->x;s->field_14=t->y;s->field_18=t->z;}else{F32 x=t->x-s->field_10,y=t->y-s->field_14,z=t->z-s->field_18;if(x*x+y*y+z*z>0.16 || fabsf(t->pitch-s->field_1C)>5 || fabsf(t->yaw-s->field_20)>5)return FALSE;}s->field_1C=t->pitch;s->field_20=t->yaw;}return TemptGoal_canUse(b);}
U0 TemptGoal_start(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);s->field_10=t->x;s->field_14=t->y;s->field_18=t->z;s->running=TRUE;s->prevAvoidWater=h->avoidWater;h->avoid(h->ctx,FALSE);}
U0 TemptGoal_stop(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;MCGoal020_Target(h,&s->targetId,&s->hasTarget,NULL);h->stop(h->ctx);s->timeout=100;s->running=FALSE;h->avoid(h->ctx,s->prevAvoidWater);}
U0 TemptGoal_Destroy(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;MCGoal020_Target(h,&s->targetId,&s->hasTarget,NULL);MCVector_Destroy(&s->followItemIds);}
U0 TemptGoal_tick(Goal *b) {TemptGoal *s=b->context;MCGoalHost020 *h=s->h;--s->field_50;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);h->look(h->ctx,t,(30)(F32),(h->maxHeadXRot)(F32));if(h->distanceSqr(h->ctx,t,FALSE)>=6.25){if(s->field_50<=0){h->move(h->ctx,t,(s->speedMultiplier)(F32));s->field_50=h->fastRandom(h->ctx);}}else h->stop(h->ctx);}
