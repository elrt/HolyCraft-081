U0 BreakDoorGoal_Init(BreakDoorGoal *s,MCDoorHost012 *h){DoorInteractGoal_Init(&s->base,h);s->base.base.context=s;s->base.base.canUseFn=&BreakDoorGoal_canUse;s->base.base.continueFn=&BreakDoorGoal_canContinueToUse;s->base.base.startFn=&BreakDoorGoal_start;s->base.base.tickFn=&BreakDoorGoal_tick;}
Bool BreakDoorGoal_canUse(Goal *g){BreakDoorGoal *s=g->context;MCDoorHost012 *h=s->base.host;if(!DoorInteractGoal_canUse(g))return FALSE;return !h->doorIsOpen(h->host,s->base.doorX,s->base.doorY,s->base.doorZ);}Bool BreakDoorGoal_canContinueToUse(Goal *g){BreakDoorGoal *s=g->context;MCDoorHost012 *h=s->base.host;F32 dist=h->distanceSqr(h->host,s->base.doorX,s->base.doorY,s->base.doorZ);return s->ticksLeft>=0 && !h->doorIsOpen(h->host,s->base.doorX,s->base.doorY,s->base.doorZ) && dist<4.0;}U0 BreakDoorGoal_start(Goal *g){BreakDoorGoal *s=g->context;DoorInteractGoal_start(g);s->ticksLeft=240;}U0 BreakDoorGoal_tick(Goal *g){BreakDoorGoal *s=g->context;MCDoorHost012 *h=s->base.host;DoorInteractGoal_tick(g);Random_genrand_int32(h->random);s->ticksLeft--;if(!s->ticksLeft && h->difficulty==3){h->setTile(h->host,s->base.doorX,s->base.doorY,s->base.doorZ,0,4);h->levelEvent(h->host,2001,s->base.doorX,s->base.doorY,s->base.doorZ,h->doorWoodID);}}
