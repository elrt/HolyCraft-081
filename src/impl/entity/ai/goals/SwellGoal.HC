// Batch 009: minecraftpe/impl/entity/ai/goals/SwellGoal.cpp
U0 SwellGoal_Init(SwellGoal *s,MCGoalContext009 *h) { Goal_Init(&s->base);s->base.context=s;s->base.canUseFn=&SwellGoal_canUse;s->base.startFn=&SwellGoal_start;s->base.stopFn=&SwellGoal_stop;s->base.destroyFn=&SwellGoal_stop;s->base.tickFn=&SwellGoal_tick;s->holder=h;s->hasTarget=FALSE;s->targetId=0;Goal_setRequiredControlFlags(&s->base,1); }
Bool SwellGoal_canUse(Goal *b) { SwellGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;if(h->swellDir>0)return TRUE;t=h->currentTarget(h->host);if(t)return h->distanceToSqr(h->host,t)<9;return FALSE; }
U0 SwellGoal_start(Goal *b) { SwellGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;h->navStop(h->host);t=h->currentTarget(h->host);if(!t || !s->hasTarget || t->id!=s->targetId) { if(s->hasTarget)h->releaseTarget(h->host,s->targetId);s->hasTarget=FALSE;if(t) { s->targetId=t->id;s->hasTarget=TRUE;h->retainTarget(h->host,t); } } }
U0 SwellGoal_stop(Goal *b) { SwellGoal *s=b->context;if(s->hasTarget) { s->holder->releaseTarget(s->holder->host,s->targetId);s->hasTarget=FALSE; } }
U0 SwellGoal_tick(Goal *b) { SwellGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t=NULL;I32 dir=-1;if(s->hasTarget)t=h->lockTarget(h->host,s->targetId);if(t && h->distanceToSqr(h->host,t)<=49.0 && h->canSeeTarget(h->host,t))dir=1;h->setSwellDir(h->host,dir); }
