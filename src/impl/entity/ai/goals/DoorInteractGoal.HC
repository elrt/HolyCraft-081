U0 DoorInteractGoal_Init(DoorInteractGoal *s,MCDoorHost012 *h){Goal_Init(&s->base);s->base.context=s;s->base.canUseFn=&DoorInteractGoal_canUse;s->base.continueFn=&DoorInteractGoal_canContinueToUse;s->base.startFn=&DoorInteractGoal_start;s->base.tickFn=&DoorInteractGoal_tick;s->host=h;s->doorX=0;s->doorY=0;s->doorZ=0;s->doorTile=NULL;s->closeToTarget=FALSE;s->targetX=0;s->targetZ=0;}
U0 *DoorInteractGoal_getDoorTile(DoorInteractGoal *s,I32 x,I32 y,I32 z){I32 id=s->host->getTile(s->host->host,x,y,z);if(id==s->host->doorWoodID)return s->host->tileByID(s->host->host,id);return NULL;}
Bool DoorInteractGoal_canUse(Goal *g){DoorInteractGoal *s=g->context;MCDoorHost012 *h=s->host;I32 i,n,index;MCDoorNode012 *node;if(!h->collided || !h->pathPresent || h->pathDone || !h->canOpenDoors)return FALSE;index=h->pathIndex(h->host)+2;n=h->pathSize(h->host);if(index<n)n=index;for(i=0;i<n;i++){node=h->pathNode(h->host,i);s->doorX=node->x;s->doorY=node->y+1;s->doorZ=node->z;if(h->distanceSqr(h->host,node->x,h->y,node->z)<=2.25){s->doorTile=DoorInteractGoal_getDoorTile(s,s->doorX,s->doorY,s->doorZ);if(s->doorTile)return TRUE;}}s->doorX=MC010_floor(h->x);s->doorY=MC010_floor(h->y+1.0);s->doorZ=MC010_floor(h->z);s->doorTile=DoorInteractGoal_getDoorTile(s,s->doorX,s->doorY,s->doorZ);return s->doorTile!=NULL;}
Bool DoorInteractGoal_canContinueToUse(Goal *g){DoorInteractGoal *s=g->context;return !s->closeToTarget;}U0 DoorInteractGoal_start(Goal *g){DoorInteractGoal *s=g->context;s->closeToTarget=FALSE;s->targetX=s->doorX+0.5-s->host->x;s->targetZ=s->doorZ+0.5-s->host->z;}U0 DoorInteractGoal_tick(Goal *g){DoorInteractGoal *s=g->context;F32 v=(s->doorZ+0.5-s->host->z)*s->targetZ+(s->doorX+0.5-s->host->x)*s->targetX;if(v<0)s->closeToTarget=TRUE;}
