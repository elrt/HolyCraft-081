// Batch 009: minecraftpe/impl/entity/ai/goals/FollowParentGoal.cpp
U0 FollowParentGoal_Init(FollowParentGoal *s,MCGoalContext009 *h,F32 speed) { Goal_Init(&s->base);s->base.context=s;s->base.canUseFn=&FollowParentGoal_canUse;s->base.continueFn=&FollowParentGoal_canContinueToUse;s->base.startFn=&FollowParentGoal_start;s->base.stopFn=&FollowParentGoal_stop;s->base.destroyFn=&FollowParentGoal_stop;s->base.tickFn=&FollowParentGoal_tick;s->holder=h;s->speedMultiplier=speed;s->ticksFollowing=0;s->hasParent=FALSE;s->parentId=0; }
Bool FollowParentGoal_canUse(Goal *b) { FollowParentGoal *s=b->context;MCGoalContext009 *h=s->holder;MCPtrVector items;I64 i;MCGoalTarget009 *t,*best=NULL;F32 d,minimum=3.402823466e38;if(h->age>=0)return FALSE;MCPtrVector_Init(&items);h->nearbyAnimals(h->host,h->entityType,h->minX-8,h->actor->minY-4,h->minZ-8,h->maxX+8,h->actor->maxY+4,h->maxZ+8,&items);for(i=0;i<items.size;i++) { t=items.data[i];if(t->age>=0) { d=h->distanceToSqr(h->host,t);if(d<=minimum) { minimum=d;best=t; } } }MCPtrVector_Destroy(&items);if(!best || minimum<9)return FALSE;if(!s->hasParent || s->parentId!=best->id) { if(s->hasParent)h->releaseTarget(h->host,s->parentId);s->parentId=best->id;s->hasParent=TRUE;h->retainTarget(h->host,best); }return TRUE; }
Bool FollowParentGoal_canContinueToUse(Goal *b) { FollowParentGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;F32 d;if(!s->hasParent)return FALSE;t=h->lockTarget(h->host,s->parentId);if(!t || !t->alive)return FALSE;d=h->distanceToSqr(h->host,t);return d>=9 && d<=256; }
U0 FollowParentGoal_start(Goal *b) { FollowParentGoal *s=b->context;s->ticksFollowing=0; }
U0 FollowParentGoal_stop(Goal *b) { FollowParentGoal *s=b->context;if(s->hasParent) { s->holder->releaseTarget(s->holder->host,s->parentId);s->hasParent=FALSE; } }
U0 FollowParentGoal_tick(Goal *b) { FollowParentGoal *s=b->context;MCGoalContext009 *h=s->holder;MCGoalTarget009 *t;if(s->ticksFollowing-1<=0) { s->ticksFollowing=10;t=h->lockTarget(h->host,s->parentId);h->navMoveEntity(h->host,t,s->speedMultiplier); }else --s->ticksFollowing; }
