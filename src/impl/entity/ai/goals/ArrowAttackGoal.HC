// Ported from minecraftpe/impl/entity/ai/goals/ArrowAttackGoal.cpp; host-facing representation, not C++ ABI.
U0 ArrowAttackGoal_Init(ArrowAttackGoal *s,MCGoalHost020 *h,F32 speed,I32 attackType,I32 delay) {memset(s,0,sizeof(ArrowAttackGoal));Goal_Init(&s->base);s->base.context=s;s->h=h;s->level=h->level;Goal_setRequiredControlFlags(&s->base,3);s->speedMultiplier=speed;s->attackType=attackType;s->delayBetweenAttack=delay;s->base.canUseFn=&ArrowAttackGoal_canUse;s->base.continueFn=&ArrowAttackGoal_canContinueToUse;s->base.stopFn=&ArrowAttackGoal_stop;s->base.tickFn=&ArrowAttackGoal_tick;s->base.destroyFn=&ArrowAttackGoal_Destroy; }
U0 ArrowAttackGoal_setLevel(ArrowAttackGoal *s,U0 *level) {s->level=level;}
Bool ArrowAttackGoal_canUse(Goal *b) {ArrowAttackGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=h->target(h->ctx);if(!t)return FALSE;MCGoal020_Target(h,&s->targetId,&s->hasTarget,t);return TRUE;}
Bool ArrowAttackGoal_canContinueToUse(Goal *b) {ArrowAttackGoal *s=b->context;MCGoalHost020 *h=s->h;if(!MCGoal020_Lock(h,s->targetId,s->hasTarget))return FALSE;if(ArrowAttackGoal_canUse(b))return TRUE;return !h->navDone;}
U0 ArrowAttackGoal_stop(Goal *b) {ArrowAttackGoal *s=b->context;MCGoalHost020 *h=s->h;MCGoal020_Target(h,&s->targetId,&s->hasTarget,NULL);}
U0 ArrowAttackGoal_fireAtTarget(Goal *b) {ArrowAttackGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);U0 *p;if(s->attackType!=1 && s->attackType!=2)return;p=h->projectile(h->ctx,s->level,t,s->attackType,(1.6)(F32),(12.0)(F32));if(s->attackType==2){F32 x=t->x-h->actor->x,z=t->z-h->actor->z;F32 y=((t->y+t->headHeight)-1.1)-h->projectileY(h->ctx,p);h->shoot(h->ctx,p,(x)(F32),(y+sqrt(x*x+z*z)*0.200000003)(F32),(z)(F32),(1.6)(F32),(12.0)(F32));}h->bowSound(h->ctx,(1.0/(Random_nextFloat(h->worldRandom)*0.4+0.8))(F32));h->addProjectile(h->ctx,s->level,p);}
U0 ArrowAttackGoal_tick(Goal *b) {ArrowAttackGoal *s=b->context;MCGoalHost020 *h=s->h;MCActor020 *t=MCGoal020_Lock(h,s->targetId,s->hasTarget);F32 d=h->distanceSqr(h->ctx,t,TRUE);Bool see=h->canSee(h->ctx,t);if(see)++s->seenTicks;else s->seenTicks=0;if(d<=100 && s->seenTicks>19)h->stop(h->ctx);else h->move(h->ctx,t,(s->speedMultiplier)(F32));h->look(h->ctx,t,(30)(F32),(30)(F32));I32 n=s->attackTimeout-1;s->attackTimeout=n&~(n>>31);if(!s->attackTimeout && d<=100 && see){ArrowAttackGoal_fireAtTarget(b);s->attackTimeout=s->delayBetweenAttack;}}
U0 ArrowAttackGoal_Destroy(Goal *b) {ArrowAttackGoal_stop(b);}
