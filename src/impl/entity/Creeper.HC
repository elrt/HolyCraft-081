// Batch023: entity/Creeper; explicit simulation ABI, see docs/BATCH023.md.
U0 Creeper_Init(Creeper *s,MCWorld023 *w) {memset(s,0,sizeof(Creeper));MC023_BodyInit(s,w,33,0.6,1.8);s->health=16;s->isMob=TRUE;s->swellDirection=-1;}
F32 Creeper_getSwelling(Creeper *s,F32 t) {return (s->previousSwell+(s->swell-s->previousSwell)*t)/28.0;}
U0 Creeper_checkCantSeeTarget(Creeper *s) {if(!s->w->isClient && s->swell>0 && s->swellDirection!=2){s->swellDirection=-1;s->swell--;}}
Bool Creeper_checkHurtTarget(Creeper *s,F32 distance) {if(s->w->isClient)return FALSE;if(s->swellDirection>0 && distance>=7.0 && s->swellDirection!=2 || s->swellDirection<=0 && distance>=3.0){s->swellDirection=-1;Creeper_checkCantSeeTarget(s);return FALSE;}if(s->swell==0)MC023_Sound(s->w,"random.fuse",s->x,s->y,s->z,1.0,0.5);if(s->swellDirection!=2)s->swellDirection=1;s->swell++;if(s->swell>29){MC023_Event(s->w,MC023_EXPLODE,s->x,s->y,s->z,24,0,0,s);MC023_Remove(s);}s->holdGround=TRUE;return TRUE;}
U0 Creeper_tick(Creeper *s) {s->previousSwell=s->swell;if(s->w->isClient){if(s->swellDirection>0 && !s->swell)MC023_Sound(s->w,"random.fuse",s->x,s->y,s->z,1.0,0.5);s->swell+=s->swellDirection;if(s->swell<0)s->swell=0;if(s->swell>30)s->swell=30;}MC023_BaseTick(s);/* Target acquisition/Monster AI is host-owned, not fabricated here. */}
Bool Creeper_interact(Creeper *s,MCPlayer023 *p) {ItemInstance *item=Inventory_getSelected(p->inventory);if(item && ItemInstance_getId(item)==s->w->registry->flint){if(!s->w->isClient && s->swellDirection!=2){MC023_Sound(s->w,"fire.ignite",p->x+0.5,p->y+0.5,p->z+0.5,1.0,Random_nextFloat(&s->rng)*0.4+0.8);s->swellDirection=2;}ItemInstance_hurtAndBreak(item,1,p);return TRUE;}/* Source recurses forever on fallback; return explicit base interaction event instead. */MC023_Event(s->w,MC023_INTERACT,0,0,0,0,0,0,s,p);return FALSE;}
