U0 CritParticle2_Init(CritParticle2 *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->enabled=TRUE;TextureUVCoordinateSet_Init(&s->base.texture,0.0625,0.25,0.125,0.3125,256,256);s->base.initFn=&CritParticle2_init;s->base.tickFn=&CritParticle2_tick;}
U0 CritParticle2_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){CritParticle2 *p=s->derived;F32 f;s->mx=mx*0.4+s->mx*0.1;s->my=my*0.4+s->my*0.1;s->mz=mz*0.4+s->mz*0.1;f=s->host->random(s->host->host)*0.3+0.6;s->b=s->g=s->r=f;s->scale=s->scale*0.75*arg;p->originalScale=s->scale;f=s->host->random(s->host->host);s->maxAliveTime=6.0/(f*0.8+0.6)*arg;CritParticle2_tick(s);}
U0 CritParticle2_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);MC011_particleMove(s,s->mx,s->my,s->mz);s->g*=0.96;s->b*=0.9;s->mx*=0.7;s->my=s->my*0.7-0.02;s->mz*=0.7;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 CritParticle2_render(CritParticle2 *p,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 f;if(p->enabled){f=(p->base.ticksAlive+pt)/p->base.maxAliveTime*32;if(f<0)f=0;else if(f>1)f=1;p->base.scale=p->originalScale*f;Particle_render(&p->base,pt,a,b,c,d,e);}}
