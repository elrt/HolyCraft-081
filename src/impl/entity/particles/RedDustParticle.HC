U0 RedDustParticle_Init(RedDustParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.initFn=&RedDustParticle_init;s->base.tickFn=&RedDustParticle_tick;}
U0 RedDustParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){RedDustParticle *p=s->derived;F32 v,f;if(!arg)arg=1;s->r=1;s->g=s->b=0;s->mx*=0.1;s->my*=0.1;s->mz*=0.1;v=s->host->random(s->host->host)*0.4+0.6;s->r=(s->host->random(s->host->host)*0.2+0.8)*s->r*v;s->g=(s->host->random(s->host->host)*0.2+0.8)*s->g*v;f=s->host->random(s->host->host);s->b=(f*0.2+0.8)*s->b*v;s->scale=s->scale*0.75*arg;p->originalScale=s->scale;s->maxAliveTime=arg*(8.0/(s->host->random(s->host->host)*0.8+0.2))(I32);}
U0 RedDustParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);if(!s->maxAliveTime){printf("RedDustParticle zero lifetime\n");exit(99);}TextureUVCoordinateSet_fromOldSystem(-8*s->ticksAlive/s->maxAliveTime+7,&s->texture);MC011_particleMove(s,s->mx,s->my,s->mz);if(s->y==s->prevY){s->mx*=1.1;s->mz*=1.1;}s->mx*=0.96;s->my*=0.96;s->mz*=0.96;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 RedDustParticle_render(RedDustParticle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 f=(s->base.ticksAlive+pt)/s->base.maxAliveTime*32;if(f<0)f=0;else if(f>1)f=1;s->base.scale=s->originalScale*f;Particle_render(&s->base,pt,a,b,c,d,e);}
