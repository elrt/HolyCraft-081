U0 HeartParticle_Init(HeartParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.maxAliveTime=16;TextureUVCoordinateSet_Init(&s->base.texture,0,0.3125,0.0625,0.375,256,256);s->base.initFn=&HeartParticle_init;s->base.tickFn=&HeartParticle_tick;}
U0 HeartParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){HeartParticle *p=s->derived;if(!arg)arg=2;s->mx*=0.01;s->mz*=0.01;s->my=s->my*0.01+0.1;s->scale=arg*0.75*s->scale;p->originalScale=s->scale;HeartParticle_tick(s);}
U0 HeartParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);MC011_particleMove(s,s->mx,s->my,s->mz);if(s->y==s->prevY){s->mx*=1.1;s->mz*=1.1;}s->mx*=0.86;s->my*=0.86;s->mz*=0.86;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 HeartParticle_render(HeartParticle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 f=(s->base.ticksAlive+pt)/s->base.maxAliveTime*32;if(f>1)f=1;else if(f<=0)f=0;s->base.scale=s->originalScale*f;Particle_render(&s->base,pt,a,b,c,d,e);}
