U0 ExplodeParticle_Init(ExplodeParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.initFn=&ExplodeParticle_init;s->base.tickFn=&ExplodeParticle_tick;}
U0 ExplodeParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){F32 f;MCParticleHost011 *h=s->host;f=h->random(h->host);s->mx=mx+(f+f-1)*0.05;f=h->random(h->host);s->my=my+(f+f-1)*0.05;f=h->random(h->host);s->mz=mz+(f+f-1)*0.05;f=Random_nextFloat(h->sharedRandom)*0.3+0.7;s->r=s->g=s->b=f;f=Random_nextFloat(h->sharedRandom);s->scale=f*Random_nextFloat(h->sharedRandom)*6+1;s->maxAliveTime=16.0/(Random_nextFloat(h->sharedRandom)*0.8+0.2)+2;}
U0 ExplodeParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);if(!s->maxAliveTime){printf("ExplodeParticle zero lifetime\n");exit(99);}TextureUVCoordinateSet_fromOldSystem(-8*s->ticksAlive/s->maxAliveTime+7,&s->texture);s->my+=0.004;MC011_particleMove(s,s->mx,s->my,s->mz);s->mx*=0.9;s->my*=0.9;s->mz*=0.9;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
