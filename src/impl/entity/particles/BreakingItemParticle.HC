U0 BreakingItemParticle_Init(BreakingItemParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas,I32 id){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->itemID=id;s->base.initFn=&BreakingItemParticle_init;}
U0 BreakingItemParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){BreakingItemParticle *p=s->derived;TextureUVCoordinateSet *t;p->itemID=arg;t=s->host->itemTexture(s->host->host,arg);if(!t){printf("Missing particle item texture\n");exit(99);}s->texture=*t;s->b=s->g=s->r=1;s->scale*=0.5;s->gravity=s->host->tileGravity(s->host->host,-1);}
U0 BreakingItemParticle_render(BreakingItemParticle *p,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){Particle *s=&p->base;F32 x=s->texture.minX+s->field_138*0.25*(s->texture.maxX-s->texture.minX),y=s->texture.minY+s->field_13C*0.25*(s->texture.maxY-s->texture.minY);MC011_particleQuad(s,pt,a,b,c,d,e,s->texture.maxX,y,x,s->texture.maxY,FALSE);}
