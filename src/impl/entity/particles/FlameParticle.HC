U0 FlameParticle_Init(FlameParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.fullBright=TRUE;s->base.noclip=TRUE;TextureUVCoordinateSet_Init(&s->base.texture,0,0.1875,0.0625,0.25,256,256);s->base.initFn=&FlameParticle_init;s->base.tickFn=&FlameParticle_tick;}
U0 FlameParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){I32 i;FlameParticle *f=s->derived;s->mx=mx+s->mx*0.01;s->my=my+s->my*0.01;s->mz=mz+s->mz*0.01;for(i=0;i<6;i++)Random_nextFloat(s->host->sharedRandom);f->originalScale=s->scale;s->b=s->g=s->r=1;s->maxAliveTime=8.0/(s->host->random(s->host->host)*0.8+0.2)+4;}
U0 FlameParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);MC011_particleMove(s,s->mx,s->my,s->mz);s->mx*=0.96;s->my*=0.96;s->mz*=0.96;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 FlameParticle_render(FlameParticle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 f=(s->base.ticksAlive+pt)/s->base.maxAliveTime;s->base.scale=s->originalScale*(1-f*f*0.5);Particle_render(&s->base,pt,a,b,c,d,e);}F32 FlameParticle_getBrightness(FlameParticle *s,F32 pt){return 1;}
