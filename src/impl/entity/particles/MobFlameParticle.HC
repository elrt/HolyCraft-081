extern "c" F32 floorf(F32);
U0 MobFlameParticle_Init(MobFlameParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.fullBright=TRUE;s->base.noclip=TRUE;s->base.r=s->base.g=s->base.b=1;s->xOff=s->yOff=s->zOff=0;s->base.coordMultiplier=-0.25;TextureUVCoordinateSet_Init(&s->base.texture,0,0,1,0.03125,16,512);s->base.initFn=&MobFlameParticle_init;s->base.tickFn=&MobFlameParticle_tick;}
U0 MobFlameParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){MobFlameParticle *p=s->derived;p->entity=NULL;s->maxAliveTime=25;s->mx=mx+s->mx*0.1;s->my=my+s->my*0.1;s->mz=mz+s->mz*0.1;s->scale*=3;p->originalScale=s->scale;}
U0 MobFlameParticle_tick(Particle *s){MobFlameParticle *p=s->derived;MCParticleEntity011 *e;I32 n=s->ticksAlive++;F32 v=p->vertical;if(n>=s->maxAliveTime)MC011_particleRemove(s);else{MC011_particlePrev(s);p->yOff+=v;e=p->entity;if(e){if(e->fire<2 || !e->alive || e->dead)p->entity=NULL;else if(e->onFire){p->vertical+=e->height*0.002;s->x=p->xOff+e->x;s->y=p->yOff+e->y;s->z=p->zOff+e->z;}else{p->entity=NULL;MC011_particleRemove(s);}}else p->vertical=v+0.002;}}
U0 MobFlameParticle_setEntity(MobFlameParticle *p,MCParticleEntity011 *e){Particle *s=&p->base;F32 f;p->entity=e;s->y+=0.7;f=Random_nextFloat(s->host->sharedRandom);p->xOff=(s->x-e->x)*e->width*0.5+(f+f-1)*0.1;p->yOff=s->y-e->y;f=Random_nextFloat(s->host->sharedRandom);p->zOff=(s->z-e->z)*e->width*0.5+(f+f-1)*0.1;s->x=p->xOff+e->x;s->y=p->yOff+e->y;s->z=p->zOff+e->z;p->vertical=e->height*0.5*0.01;MobFlameParticle_tick(s);}
U0 MobFlameParticle_render(MobFlameParticle *p,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 v=floorf((p->base.ticksAlive+pt)/p->base.maxAliveTime*32);p->base.texture.minY=v*0.03125;p->base.texture.maxY=v*0.03125+0.03125;Particle_render(&p->base,pt,a,b,c,d,e);}F32 MobFlameParticle_getBrightness(MobFlameParticle *s,F32 pt){return 1;}
