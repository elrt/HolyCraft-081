// Inline implementation from BubbleParticle.hpp.
U0 BubbleParticle_Init(BubbleParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.r=s->base.g=s->base.b=1;s->base.width=s->base.height=0.02;TextureUVCoordinateSet_Init(&s->base.texture,0,0.125,0.0625,0.1875,256,256);s->base.initFn=&BubbleParticle_init;s->base.tickFn=&BubbleParticle_tick;}
U0 BubbleParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){MCParticleHost011 *h=s->host;F32 f;s->scale*=Random_nextFloat(h->sharedRandom)*0.6+0.2;f=h->random(h->host);s->mx=(f+f-1)*0.02+mx*0.2;f=h->random(h->host);s->my=(f+f-1)*0.02+my*0.2;f=h->random(h->host);s->mz=(f+f-1)*0.02+mz*0.2;s->maxAliveTime=8.0/(h->random(h->host)*0.8+0.2);}
U0 BubbleParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);s->my+=0.002;MC011_particleMove(s,s->mx,s->my,s->mz);s->mx*=0.85;s->my*=0.85;s->mz*=0.85;if(!s->host->isWater(s->host->host,MC010_floor(s->x),MC010_floor(s->y),MC010_floor(s->z)))MC011_particleRemove(s);n=s->maxAliveTime;s->maxAliveTime=n-1;if(n<=0)MC011_particleRemove(s);}
