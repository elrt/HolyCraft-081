U0 TerrainParticle_Init(TerrainParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.r=s->base.g=s->base.b=0.6;s->base.initFn=&TerrainParticle_init;}
U0 TerrainParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){TerrainParticle *p=s->derived;TextureUVCoordinateSet *t;I32 color;p->tileID=arg&0xffff;t=s->host->tileTexture(s->host->host,p->tileID,arg>>16);if(!t){printf("Missing terrain particle texture\n");exit(99);}p->tileTexture=*t;s->gravity=s->host->tileGravity(s->host->host,p->tileID);s->scale*=0.5;if(p->tileID!=s->host->grassID){color=s->host->tileColor(s->host->host,p->tileID,x(I32),y(I32),z(I32));s->r*=((color>>16)&255)/255.0;s->g*=((color>>8)&255)/255.0;s->b*=(color&255)/255.0;}}
U0 TerrainParticle_render(TerrainParticle *p,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){Particle *s=&p->base;F32 dx=p->tileTexture.maxX-p->tileTexture.minX,dy=p->tileTexture.maxY-p->tileTexture.minY,u=p->tileTexture.minX+s->field_138*0.25*dx,v=p->tileTexture.minY+s->field_13C*0.25*dy,minx=p->tileTexture.minX,miny=p->tileTexture.minY,u2,v2;if(u!=0)minx=u;if(v!=0)miny=v;u2=minx+dx*0.015625;v2=miny+dy*0.015609;MC011_particleQuad(s,pt,a,b,c,d,e,u2,v,u,v2,FALSE);}
