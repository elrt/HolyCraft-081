U0 SmokeParticle_Init(SmokeParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.initFn=&SmokeParticle_init;s->base.tickFn=&SmokeParticle_tick;}
U0 SmokeParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){SmokeParticle *p=s->derived;F32 v,f;if(!arg)arg=100;v=arg/100.0;s->mx=mx+s->mx*0.1;s->my=my+s->my*0.1;s->mz=mz+s->mz*0.1;f=s->host->random(s->host->host)*0.5;s->r=s->g=s->b=f;s->scale=s->scale*0.75*v;p->originalScale=s->scale;s->maxAliveTime=v*8.0/(s->host->random(s->host->host)*0.8+0.2);}
U0 SmokeParticle_tick(Particle *s){I32 n;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);s->my+=0.004;MC011_particleMove(s,s->mx,s->my,s->mz);if(s->y==s->prevY){s->mx*=1.1;s->mz*=1.1;}s->mx*=0.96;s->my*=0.96;s->mz*=0.96;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 SmokeParticle_render(SmokeParticle *p,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){Particle *s=&p->base;F32 f;if(!s->maxAliveTime){printf("SmokeParticle zero lifetime\n");exit(99);}f=(s->ticksAlive+pt)/s->maxAliveTime*32;if(f<0)f=0;else if(f>1)f=1;TextureUVCoordinateSet_fromOldSystem(-8*s->ticksAlive/s->maxAliveTime+7,&s->texture);s->scale=p->originalScale*f;Particle_render(s,pt,a,b,c,d,e);}
