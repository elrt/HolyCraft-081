// minecraftpe/impl/entity/particles/Particle.cpp
U0 MC011_particleRemove(Particle *s){s->dead=TRUE;s->host->remove(s->host->host,s);}
U0 MC011_particleMove(Particle *s,F32 x,F32 y,F32 z){s->host->move(s->host->host,s,x,y,z);}
U0 MC011_particlePrev(Particle *s){s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;}
U0 MC011_particleQuad(Particle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e,F32 u0,F32 v0,F32 u1,F32 v1,Bool view){MCParticleHost011 *h=s->host;F32 sc=s->scale*0.1,x=s->prevX+(s->x-s->prevX)*pt-h->xOff,y=s->prevY+(s->y-s->prevY)*pt-h->yOff,z=s->prevZ+(s->z-s->prevZ)*pt-h->zOff,br;if(view){x+=s->coordMultiplier*h->viewX;y+=s->coordMultiplier*h->viewY;z+=s->coordMultiplier*h->viewZ;}br=1;if(!s->fullBright)br=h->brightness(h->host,s,pt);h->color(h->host,br*s->r,br*s->g,br*s->b);h->vertex(h->host,x-a*sc-d*sc,y-b*sc,z-c*sc-e*sc,u1,v1);h->vertex(h->host,x-a*sc+d*sc,y+b*sc,z-c*sc+e*sc,u1,v0);h->vertex(h->host,x+a*sc+d*sc,y+b*sc,z+c*sc+e*sc,u0,v0);h->vertex(h->host,x+a*sc-d*sc,y-b*sc,z+c*sc-e*sc,u0,v1);}
U0 Particle_Init(Particle *s,MCParticleHost011 *h,I32 type,U8 *atlas){memset(s,0,sizeof(Particle));s->host=h;s->type=type;s->atlas=atlas;s->tickFn=&Particle_tick;}
U0 Particle_start(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){F32 a,b,len,weight;MCParticleHost011 *h=s->host;h->reset(h->host,s);s->gravity=0;s->ticksAlive=0;s->b=s->g=s->r=1;s->dead=FALSE;s->width=s->height=0.2;s->ridingHeight=s->height*0.5;s->x=x;s->y=y;s->z=z;s->mx=mx+(h->random(h->host)*2-1)*0.4;s->my=my+(h->random(h->host)*2-1)*0.4;s->mz=mz+(h->random(h->host)*2-1)*0.4;a=h->random(h->host);b=h->random(h->host);len=sqrtf(s->mx*s->mx+s->my*s->my+s->mz*s->mz);weight=(a+b+1)*0.15*0.4/len;s->mx*=weight;s->my=weight*s->my+0.1;s->mz*=weight;s->field_138=Random_nextFloat(h->sharedRandom)*3;s->field_13C=Random_nextFloat(h->sharedRandom)*3;s->scale=(Random_nextFloat(h->sharedRandom)*0.5+0.5)*2;s->maxAliveTime=4.0/(Random_nextFloat(h->sharedRandom)*0.9+0.1);s->initFn(s,x,y,z,mx,my,mz,arg);s->tickFn(s);}
U0 Particle_scale(Particle *s,F32 scale){s->width=scale*0.2;s->height=scale*0.2;s->scale*=scale;}Particle *Particle_setPower(Particle *s,F32 power){s->mx*=power;s->my=(s->my-0.1)*power+0.1;s->mz*=power;return s;}
U0 Particle_tick(Particle *s){MC011_particlePrev(s);s->ticksAlive++;if(s->ticksAlive>=s->maxAliveTime)MC011_particleRemove(s);s->my-=s->gravity*0.04;MC011_particleMove(s,s->mx,s->my,s->mz);s->mx*=0.98;s->my*=0.98;s->mz*=0.98;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 Particle_render(Particle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){MC011_particleQuad(s,pt,a,b,c,d,e,s->texture.minX,s->texture.minY,s->texture.maxX,s->texture.maxY,TRUE);}I32 Particle_getEntityTypeId(Particle *s){return 0;}
