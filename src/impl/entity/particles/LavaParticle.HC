U0 LavaParticle_Init(LavaParticle *s,MCParticleHost011 *h,I32 type,U8 *atlas){Particle_Init(&s->base,h,type,atlas);s->base.derived=s;s->base.fullBright=TRUE;s->base.r=s->base.g=s->base.b=1;TextureUVCoordinateSet_Init(&s->base.texture,0,0.1875,0.125,0.25,256,256);s->base.initFn=&LavaParticle_init;s->base.tickFn=&LavaParticle_tick;}
U0 LavaParticle_init(Particle *s,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 arg){LavaParticle *p=s->derived;F32 f;s->mx*=0.8;s->my*=0.8;s->mz*=0.8;s->my=Random_nextFloat(s->host->sharedRandom)*0.4+0.05;f=Random_nextFloat(s->host->sharedRandom);s->scale=(f+f+0.2)*s->scale;p->originalScale=s->scale;s->maxAliveTime=16.0/(s->host->random(s->host->host)*0.8+0.2);}
U0 LavaParticle_tick(Particle *s){I32 n;F32 f;MC011_particlePrev(s);n=s->ticksAlive++;if(n>=s->maxAliveTime)MC011_particleRemove(s);f=((s->ticksAlive)*1.0)/s->maxAliveTime;if(Random_nextFloat(s->host->sharedRandom)>f)s->host->spawn(s->host->host,3,s->x,s->y,s->z,s->mx,s->my,s->mz,0);s->my-=0.03;MC011_particleMove(s,s->mx,s->my,s->mz);s->mx*=0.999;s->my*=0.999;s->mz*=0.999;if(s->onGround){s->mx*=0.7;s->mz*=0.7;}}
U0 LavaParticle_render(LavaParticle *s,F32 pt,F32 a,F32 b,F32 c,F32 d,F32 e){F32 f=(s->base.ticksAlive+pt)/s->base.maxAliveTime;s->base.scale=s->originalScale*(1-f*f);Particle_render(&s->base,pt,a,b,c,d,e);}F32 LavaParticle_getBrightness(LavaParticle *s,F32 pt){return 1;}
