U0 TripodCamera_Init(TripodCamera *s,MCTripodHost012 *h,U0 *player,F32 x,F32 y,F32 z,F32 yaw,F32 pitch){memset(s,0,sizeof(TripodCamera));s->host=h;s->base=h->createMob(h->host);s->player=player;s->timer=80;s->renderId=TRIPOD_CAMERA;s->prevPitch=s->pitch=pitch;s->prevYaw=s->yaw=yaw;s->field_FC=TRUE;h->setSize(h->host,s->base,1,1.5);s->ridingHeight=0.5;s->x=s->prevX=x;s->y=s->prevY=y;s->z=s->prevZ=z;h->setPos(h->host,s->base,x,y,z);}U0 TripodCamera_Destroy(TripodCamera *s){s->host->destroyMob(s->host->host,s->base);}
U0 TripodCamera_tick(TripodCamera *s){MCTripodHost012 *h=s->host;F32 mx,my,mz;s->motionY-=0.04;s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;h->move(h->host,s,s->motionX,s->motionY,s->motionZ);mx=s->motionX*0.98;my=s->motionY*0.98;mz=s->motionZ*0.98;s->motionX=mx;s->motionY=my;s->motionZ=mz;if(s->onGround){s->motionZ=mz*0.7;s->motionX=mx*0.7;s->motionY=my*-0.5;}if(s->takingPicture){s->timer--;if(s->timer){if(s->timer==8){h->takePicture(h->host,s,s->player);h->addParticle(h->host,PT_EXPLODE,s->x,s->y+0.6,s->z);h->addParticle(h->host,PT_EXPLODE,s->x,s->y+0.8,s->z);h->addParticle(h->host,PT_EXPLODE,s->x,s->y+1.0,s->z);}else if(s->timer>8)h->addParticle(h->host,PT_SMOKE,s->x,s->y+1.0,s->z);}else{ s->dead=TRUE;h->remove(h->host,s);}}}
F32 TripodCamera_getShadowHeightOffs(TripodCamera *s){return 0;}Bool TripodCamera_interactPreventDefault(TripodCamera *s){return TRUE;}Bool TripodCamera_interactWithPlayer(TripodCamera *s,U0 *p){s->takingPicture=TRUE;return TRUE;}Bool TripodCamera_isPickable(TripodCamera *s){return !s->dead;}Bool TripodCamera_isPushable(TripodCamera *s){return FALSE;}I32 TripodCamera_getEntityTypeId(TripodCamera *s){return 0;}F32 TripodCamera_getBaseSpeed(TripodCamera *s){return 0;}
