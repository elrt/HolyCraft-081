// Batch023: entity/PathfinderMob; explicit simulation ABI, see docs/BATCH023.md.
U0 PathfinderMob_Init(PathfinderMob *s,MCWorld023 *w) {memset(s,0,sizeof(PathfinderMob));MC023_BodyInit(s,w,0,0.6,1.8);s->isMob=TRUE;s->baseSpeed=0.7;MCVector_Init(&s->path,sizeof(Vec3));}
U0 PathfinderMob_Destroy(PathfinderMob *s) {MCVector_Destroy(&s->path);}
F32 PathfinderMob_getWalkingSpeedModifier(PathfinderMob *s) {if(s->newAI)return 0.7;if(s->panicTicks>0)return s->baseSpeed*2;return s->baseSpeed;}
U0 PathfinderMob_stroll(PathfinderMob *s) {if(s->walkValue==NULL || s->findPath==NULL)return;I32 i,x=0,y=0,z=0;F32 best=-99999;for(i=0;i<10;i++){I32 xx=floorf(s->x)+(Random_genrand_int32(&s->rng)%13)(I32)-6,yy=floorf(s->y)+(Random_genrand_int32(&s->rng)%7)(I32)-3,zz=floorf(s->z)+(Random_genrand_int32(&s->rng)%13)(I32)-6;F32 v=s->walkValue(s->navigationContext,xx,yy,zz);if(v>best){best=v;x=xx;y=yy;z=zz;}}if(best> -99999){s->path.size=0;s->pathIndex=0;s->findPath(s->navigationContext,s,x(F32),y(F32),z(F32),10.0(F32),&s->path);}}
U0 PathfinderMob_updateAi(PathfinderMob *s) {if(s->panicTicks>0)s->panicTicks--;/* Target lookup, visibility and virtual attack hooks remain host-owned. */if(!s->holdGround && ((!s->path.size && Random_genrand_int32(&s->rng)%180==0) || Random_genrand_int32(&s->rng)%120==0 || s->panicTicks>0 && (s->panicTicks&7)==1) && s->noActionTime<=99)PathfinderMob_stroll(s);s->jumping=FALSE;if(s->pathIndex>=s->path.size){MC023_Event(s->w,MC023_BASE_AI,0,0,0,0,0,0,s);return;}Vec3 *p=s->path.data(Vec3*);F32 dx,dz;while(s->pathIndex<s->path.size){dx=p[s->pathIndex].x-s->x;dz=p[s->pathIndex].z-s->z;if(dx*dx+dz*dz>=s->width*s->width*4)break;s->pathIndex++;}if(s->pathIndex>=s->path.size){s->path.size=0;s->pathIndex=0;return;}dx=p[s->pathIndex].x-s->x;dz=p[s->pathIndex].z-s->z;F32 angle=atan2f(dz,dx)*180.0/3.141592653589793-90-s->yaw;while(angle< -180)angle+=360;while(angle>=180)angle-=360;if(angle>30)angle=30;if(angle< -30)angle=-30;s->yaw+=angle;s->forward=PathfinderMob_getWalkingSpeedModifier(s);if(p[s->pathIndex].y>floorf(s->minYBound+0.5))s->jumping=TRUE;if(s->collidedH && !s->path.size)s->jumping=TRUE;if((s->inWater || s->inLava) && Random_nextFloat(&s->rng)<0.8)s->jumping=TRUE;}
