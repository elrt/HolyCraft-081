U0 PrimedTnt_Init(PrimedTnt *s,MCPrimedHost015 *h){memset(s,0,sizeof(PrimedTnt));s->host=h;s->fieldFC=TRUE;s->field110=1;s->ticksUntilExplode=80;s->renderId=TNT;s->width=0.98;s->height=0.98;s->ridingHeight=s->height*0.5;}
U0 PrimedTnt_InitAt(PrimedTnt *s,MCPrimedHost015 *h,F32 x,F32 y,F32 z){F32 v,ang;PrimedTnt_Init(s,h);s->x=x;s->y=y;s->z=z;v=h->randomFloat(h->host);ang=(v*3.1416+v*3.1416)*0.017453;s->motionX=h->sinAngle(h->host,ang)*-0.02;s->motionY=0.2;s->motionZ=h->cosAngle(h->host,ang)*-0.02;s->prevX=x;s->prevY=y;s->prevZ=z;s->field110=0;}
U0 PrimedTnt_explode(PrimedTnt *s){s->host->explode(s->host->host,s->x,s->y,s->z,(3.1)(F32));}
U0 PrimedTnt_tick(PrimedTnt *s){MCPrimedHost015 *h=s->host;s->motionY-=0.04;s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;h->move(h->host,s,s->motionX,s->motionY,s->motionZ);s->motionX*=0.98;s->motionY*=0.98;s->motionZ*=0.98;if(s->onGround){s->motionZ*=0.7;s->motionX*=0.7;s->motionY*=-0.5;}s->ticksUntilExplode--;if(h->isClient||s->ticksUntilExplode>0)h->smoke(h->host,s->x,(s->y+0.5)(F32),s->z);else{h->remove(h->host,s);PrimedTnt_explode(s);}}
F32 PrimedTnt_getShadowRadius(PrimedTnt *s){return 0;}F32 PrimedTnt_getShadowHeightOffs(PrimedTnt *s){return 0;}Bool PrimedTnt_isPickable(PrimedTnt *s){return !s->isDead;}I32 PrimedTnt_getEntityTypeId(PrimedTnt *s){return 65;}U0 PrimedTnt_readAdditionalSaveData(PrimedTnt *s,U0 *tag){s->ticksUntilExplode=s->host->getByte(s->host->host,tag,"Fuse");}U0 PrimedTnt_addAdditonalSaveData(PrimedTnt *s,U0 *tag){s->host->putByte(s->host->host,tag,"Fuse",s->ticksUntilExplode(I8));}
