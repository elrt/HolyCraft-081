// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Mob_Init(Mob *s,Level *level,I32 type){memset(s,0,sizeof(Mob));Entity_Init(&s->entity,level,type,0.6,1.8);s->entity.body.isMob=TRUE;s->entity.stepHeight=0.5;s->entity.body.health=10;s->jumpMovementFactor=0.02;s->horizontalDrag=1;s->walkingModifier=1;s->invulnerabilityDuration=20;}
F32 Mob_groundFriction(Mob *s){MCBody023 *b=&s->entity.body;if(!b->onGround)return 0.91;I32 id=Level_getTile(s->entity.level,floorf(b->x),floorf(s->entity.box.minY-0.5),floorf(b->z));if(id>0)return s->entity.level->registry->tiles[id].slipperiness*0.91;return 0.546;}
U0 Mob_travel(Mob *s,F32 strafe,F32 forward){Entity *e=&s->entity;MCBody023 *b=&e->body;F32 fr,oldY=b->y;if(b->inWater || b->inLava){Entity_moveRelative(e,strafe,forward,0.02);Entity_move(e,b->motionX,b->motionY,b->motionZ);fr=0.8;if(!b->inWater)fr=0.5;b->motionX*=fr;b->motionY=b->motionY*fr-0.02;b->motionZ*=fr;if(e->horizontalCollision && Entity_isFree(e,b->motionX,((b->motionY+0.6)-b->y)+oldY,b->motionZ))b->motionY=0.3;return;}fr=Mob_groundFriction(s);F32 accel=s->jumpMovementFactor;if(b->onGround)accel=(s->speed*s->walkingModifier)*(0.16277/((fr*fr)*fr));Entity_moveRelative(e,strafe,forward,accel);fr=Mob_groundFriction(s);if(s->onLadder){e->fallDistance=0;if(b->motionY < -0.15)b->motionY=-0.15;if(e->sneaking && b->motionY<0)b->motionY=0;}Entity_move(e,b->motionX,b->motionY,b->motionZ);if(e->horizontalCollision && s->onLadder)b->motionY=0.2;b->motionY=(b->motionY-0.08)*0.98;b->motionX*=fr*s->horizontalDrag;b->motionZ*=fr*s->horizontalDrag;}
U0 Mob_jumpFromGround(Mob *s){s->entity.body.motionY=0.42;}
U0 Mob_knockback(Mob *s,F32 dx,F32 dz){F32 n=sqrt(dx*dx+dz*dz);if(n<=0)return;MCBody023 *b=&s->entity.body;b->motionX=b->motionX*0.5-(dx/n)*0.4;b->motionY=b->motionY*0.5+0.4;b->motionZ=b->motionZ*0.5-(dz/n)*0.4;if(b->motionY>0.4)b->motionY=0.4;}
Bool Mob_hurt(Mob *s,Entity *attacker,I32 damage){MCBody023 *b=&s->entity.body;if((b->w && b->w->isClient) || b->health<=0)return FALSE;Bool fresh=FALSE;I32 amount=damage;if(s->invulnerableTime<=s->invulnerabilityDuration*0.5){s->previousHealth=b->health;s->lastDamage=damage;s->invulnerableTime=s->invulnerabilityDuration;s->hurtTime=10;fresh=TRUE;}else{if(damage<=s->lastDamage)return FALSE;amount=damage-s->lastDamage;s->lastDamage=damage;}b->health-=amount;if(fresh && attacker){F32 dx=attacker->body.x-b->x,dz=attacker->body.z-b->z;if(dx*dx+dz*dz<0.0001){dx=0.01;dz=0.01;}Mob_knockback(s,dx,dz);}if(b->w!=NULL){if(b->health>0){if(fresh)MC023_Sound(b->w,"random.hurt",b->x,s->entity.box.minY,b->z,1.0,1.0);}else MC023_Sound(b->w,"random.hurt",b->x,s->entity.box.minY,b->z,1.0,1.0);}if(b->health<=0)s->deathTime=1;return TRUE;}
U0 Mob_tickTimers(Mob *s){MCBody023 *b=&s->entity.body;b->age++;b->prevX=b->x;b->prevY=b->y;b->prevZ=b->z;b->prevYaw=b->yaw;b->prevPitch=b->pitch;if(s->hurtTime>0)s->hurtTime--;if(s->invulnerableTime>0)s->invulnerableTime--;if(s->deathTime>0 && ++s->deathTime>20)Entity_remove(&s->entity);}
U0 Mob_addSaveData(Mob *s,CompoundTag *t){Entity_saveWithoutId(&s->entity,t);MC025_PutShort(t,"Health",s->entity.body.health);MC025_PutShort(t,"HurtTime",s->hurtTime);MC025_PutShort(t,"DeathTime",s->deathTime);MC025_PutShort(t,"AttackTime",0);}
Bool Mob_load(Mob *s,CompoundTag *t){if(!Entity_load(&s->entity,t))return FALSE;s->entity.body.health=MC025_GetShort(t,"Health");s->hurtTime=MC025_GetShort(t,"HurtTime");s->deathTime=MC025_GetShort(t,"DeathTime");return TRUE;}
