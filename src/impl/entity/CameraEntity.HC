// Inline implementation from CameraEntity.hpp; original cpp only includes header.
U0 CameraEntity_Init(MCCamera011 *s){s->followEid=-1;s->x=128;s->y=72;s->z=128;s->yaw=0;s->pitch=90;s->moveTo(s->host,128,72,128,0,90);}U0 CameraEntity_tick(MCCamera011 *s){F32 x,y,z;if(s->followEid>=0){s->prevPosX=s->prevX=s->x;s->prevPosY=s->prevY=s->y;s->prevPosZ=s->prevZ=s->z;s->prevPitch=s->pitch;s->prevYaw=s->yaw;if(s->findEntity(s->host,s->followEid,&x,&y,&z)){s->x=x;s->y=y+6;s->z=z;s->setPos(s->host,s->x,s->y,s->z);}}}I32 CameraEntity_getEntityTypeId(MCCamera011 *s){return 0;}F32 CameraEntity_getBaseSpeed(MCCamera011 *s){return 0.2;}
