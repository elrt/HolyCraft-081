// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Player_syncView(Player *s){memcpy(&s->view,&s->mob.entity.body,sizeof(MCBody023));s->view.inventory=&s->inventory;s->view.instabuildMode=s->abilities.instabuild;s->view.instabuild=s->abilities.instabuild;s->view.invulnerable=s->abilities.invulnerable;s->view.sleeping=s->sleeping;s->view.bedX=s->bedX;s->view.bedY=s->bedY;s->view.bedZ=s->bedZ;}
U0 Player_Init(Player *s,Level *level,U8 *name,Bool creative){memset(s,0,sizeof(Player));Mob_Init(&s->mob,level,63);MCBody023 *b=&s->mob.entity.body;b->isPlayer=TRUE;b->health=20;s->mob.entity.ridingHeight=1.62;s->mob.speed=0.1;s->spawnX=level->data.xSpawn;s->spawnY=level->data.ySpawn;s->spawnZ=level->data.zSpawn;s->hasRespawnPosition=s->spawnY>=0;s->abilities.instabuild=creative;s->abilities.mayfly=creative;s->abilities.invulnerable=creative;Inventory_Init(&s->inventory,level->registry,b,creative);MCString_FromC(&s->name,name);I32 i;for(i=0;i<4;i++)ItemInstance_Init(&s->armor[i],level->registry,0,0,0);ItemInstance_Init(&s->usingItem,level->registry,0,0,0);Entity_moveTo(&s->mob.entity,level->data.xSpawn+0.5,level->data.ySpawn+1,level->data.zSpawn+0.5,0,0);Player_syncView(s);}
U0 Player_Destroy(Player *s){if(s->mob.entity.level)Level_removeEntity(s->mob.entity.level,&s->mob.entity.body);Inventory_Destroy(&s->inventory);MCString_Destroy(&s->name);}
ItemInstance *Player_getArmor(Player *s,I32 slot){if(slot<0 || slot>3 || ItemInstance_getId(&s->armor[slot])==0)return NULL;return &s->armor[slot];}
I32 Player_getArmorTypeHash(Player *s){U32 h=ItemInstance_getId(&s->armor[0]);h+=(ItemInstance_getId(&s->armor[1])(U32)<<8);h+=(ItemInstance_getId(&s->armor[2])(U32)<<16);h+=(ItemInstance_getId(&s->armor[3])(U32)<<24);return h;}
F32 Player_getSleepRotation(Player *s){if(!s->sleeping)return 0;I32 n=Level_getData(s->mob.entity.level,s->bedX,s->bedY,s->bedZ)&3;if(n==2)return 270;if(n==3)return 180;if(n==1)return 0;return 90;}
Bool Player_hurt(Player *s,Entity *attacker,I32 damage,Bool hostile){if(s->abilities.invulnerable || s->mob.entity.body.health<=0)return FALSE;s->sleeping=FALSE;I32 difficulty=s->mob.entity.level->world.difficulty;if(hostile){if(!difficulty)damage=0;else if(difficulty==1)damage=damage/3+1;else if(difficulty==3)damage=3*damage/2;}if(!damage)return FALSE;return Mob_hurt(&s->mob,attacker,damage);}
U0 Player_startUsingItem(Player *s,ItemInstance *item,I32 duration){s->usingItem=*item;s->useItemDuration=duration;}
U0 Player_stopUsingItem(Player *s){ItemInstance_setNull(&s->usingItem);s->useItemDuration=0;}
U0 Player_pickupNearby(Player *s){Player_syncView(s);Level *level=s->mob.entity.level;MCBody023 *b=&s->mob.entity.body;I32 i;for(i=0;i<level->drops.size;i++){ItemEntity *drop=level->drops.data[i];if(drop->dead || drop->pickupDelay>0)continue;if(fabs(drop->x-b->x)<1.0 && fabs(drop->z-b->z)<1.0 && drop->minYBound<s->mob.entity.box.maxY+0.5 && drop->minYBound+drop->height>s->mob.entity.box.minY)ItemEntity_playerTouch(drop,&s->view);}}
U0 Player_addSaveData(Player *s,CompoundTag *tag){Mob_addSaveData(&s->mob,tag);MC024_PutInt(tag,"Score",s->score);Abilities_addSaveData(&s->abilities,tag);FillingContainer c;MC024_ImportInventory(&c,&s->inventory);ListTag *list=FillingContainer_save(&c);MCString name;MCString_FromC(&name,"Inventory");CompoundTag_put(tag,&name,list);MCString_Destroy(&name);FillingContainer_Destroy(&c);ListTag *armor=MC_Alloc(sizeof(ListTag));ListTag_InitEmpty(armor);I32 i;for(i=0;i<4;i++){CompoundTag *item=MC_Alloc(sizeof(CompoundTag));CompoundTag_InitEmpty(item);ItemInstance_save(&s->armor[i],item);ListTag_add(armor,item);}MC023_TagPut(tag,"Armor",armor);MC024_PutInt(tag,"Dimension",s->dimension);MC025_PutByte(tag,"Sleeping",s->sleeping);MC025_PutShort(tag,"SleepTimer",s->sleepingCounter);MC024_PutInt(tag,"BedPositionX",s->bedX);MC024_PutInt(tag,"BedPositionY",s->bedY);MC024_PutInt(tag,"BedPositionZ",s->bedZ);MC024_PutInt(tag,"SpawnX",s->spawnX);MC024_PutInt(tag,"SpawnY",s->spawnY);MC024_PutInt(tag,"SpawnZ",s->spawnZ);}
Bool Player_load(Player *s,CompoundTag *tag){if(!Mob_load(&s->mob,tag))return FALSE;s->score=MC024_Int(tag,"Score");Abilities_loadSaveData(&s->abilities,tag);MCString key;MCString_FromC(&key,"Inventory");Tag *list=CompoundTag_get(tag,&key);MCString_Destroy(&key);if(list && list->id==9){FillingContainer c;FillingContainer_Init(&c,s->inventory.registry,s->inventory.size,9,64,s->inventory.creative);FillingContainer_load(&c,list);MC024_CommitInventory(&s->inventory,&c);FillingContainer_Destroy(&c);}Tag *armor=MC023_TagGet(tag,"Armor");if(armor && armor->id==9){ListTag *a=armor;I32 i;for(i=0;i<4 && i<a->value.size;i++){Tag *v=a->value.data[i];if(v && v->id==10)ItemInstance_load(&s->armor[i],v);}}s->dimension=MC024_Int(tag,"Dimension");s->bedX=MC024_Int(tag,"BedPositionX");s->bedY=MC024_Int(tag,"BedPositionY");s->bedZ=MC024_Int(tag,"BedPositionZ");s->sleepingCounter=MC025_GetShort(tag,"SleepTimer");s->sleeping=FALSE;if(MC024_Contains(tag,"SpawnX",3) && MC024_Contains(tag,"SpawnY",3) && MC024_Contains(tag,"SpawnZ",3)){s->spawnX=MC024_Int(tag,"SpawnX");s->spawnY=MC024_Int(tag,"SpawnY");s->spawnZ=MC024_Int(tag,"SpawnZ");}s->hasRespawnPosition=s->spawnY>=0;Player_syncView(s);return TRUE;}

U0 Player_travel(Player *s,F32 strafe,F32 forward){if(s->abilities.flying){F32 y=s->mob.entity.body.motionY,jump=s->mob.jumpMovementFactor;s->mob.jumpMovementFactor=0.05;Mob_travel(&s->mob,strafe,forward);s->mob.entity.body.motionY=y*0.6;s->mob.jumpMovementFactor=jump;}else Mob_travel(&s->mob,strafe,forward);}

U0 Player_resetPos(Player *s,Bool heal){if(!s->sleeping){s->mob.entity.ridingHeight=1.62;Entity_setSize(&s->mob.entity,0.6,1.8);Entity_resetPos(&s->mob.entity,heal);}if(heal){s->mob.deathTime=0;s->sleeping=FALSE;s->mob.entity.body.health=20;}Player_syncView(s);}
