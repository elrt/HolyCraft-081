U0 *MobFactory_CreateMob(MCFactoryHost014 *h,I32 id,U0 *level){U0 *m;if(!((id>=10&&id<=13)||(id>=32&&id<=36)))return NULL;m=h->newMob(h->host,id,level);if(m)h->postInit(h->host,m);return m;}U8 *MobFactory_GetMobNameID(I32 id){switch(id){case 10:return "entity.Chicken";case 11:return "entity.Cow";case 12:return "entity.Pig";case 13:return "entity.Sheep";case 32:return "entity.Zombie";case 33:return "entity.Creeper";case 34:return "entity.Skeleton";case 35:return "entity.Spider";case 36:return "entity.PigZombie";default:return "";}}
U0 MobFactory_CacheInit(MCMobCache014 *s,MCFactoryHost014 *h){s->host=h;s->lastLevel=NULL;MCVector_Init(&s->entries,sizeof(MCMobEntry014));}U0 MobFactory_CacheClear(MCMobCache014 *s){I64 i;MCMobEntry014 *e;for(i=0;i<s->entries.size;i++){e=MCVector_At(&s->entries,i);if(e->mob)s->host->destroyEntity(s->host->host,e->mob);}s->entries.size=0;}U0 MobFactory_CacheDestroy(MCMobCache014 *s){MobFactory_CacheClear(s);MCVector_Destroy(&s->entries);}U0 *MobFactory_getStaticTestMob(MCMobCache014 *s,I32 type,U0 *level){Bool clear=!type && !level;U0 *old=s->lastLevel;I64 i;MCMobEntry014 e,*p;s->lastLevel=level;if(clear || level!=old){MobFactory_CacheClear(s);if(clear)return NULL;}for(i=0;i<s->entries.size;i++){p=MCVector_At(&s->entries,i);if(p->type==type)return p->mob;}e.type=type;e.mob=MobFactory_CreateMob(s->host,type,level);MCVector_Push(&s->entries,&e);return e.mob;}
