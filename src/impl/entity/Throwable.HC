// Batch023: entity/Throwable; explicit simulation ABI, see docs/BATCH023.md.
U0 Throwable_Init(Throwable *s,MCWorld023 *w,MCBody023 *owner) {memset(s,0,sizeof(Throwable));MC023_BodyInit(s,w,0,0.25,0.25);s->owner=owner;s->tileX=s->tileY=s->tileZ=-1;s->gravity=0.03;}
U0 Throwable_shoot(Throwable *s,F32 x,F32 y,F32 z,F32 power,F32 spread) {F32 n=sqrtf(x*x+y*y+z*z);if(n<0.001){x=0;y=0;z=0;}else{x/=n;y/=n;z/=n;}s->motionX=x+Random_nextGaussian(&s->rng)*0.0075*spread*power;s->motionY=y+Random_nextGaussian(&s->rng)*0.0075*spread*power;s->motionZ=z+Random_nextGaussian(&s->rng)*0.0075*spread*power;s->yaw=s->prevYaw=atan2f(s->motionX,s->motionZ)*180.0/Mth_PI;s->pitch=s->prevPitch=atan2f(s->motionY*power,sqrtf(s->motionX*s->motionX+s->motionZ*s->motionZ))*180.0/Mth_PI;s->groundTicks=0;}
U0 Throwable_lerpMotion(Throwable *s,F32 x,F32 y,F32 z) {s->motionX=x;s->motionY=y;s->motionZ=z;if(s->prevYaw==0 && s->prevPitch==0){s->yaw=s->prevYaw=atan2f(x,z)*180.0/Mth_PI;s->pitch=s->prevPitch=atan2f(y,sqrtf(x*x+z*z))*180.0/Mth_PI;}}
// Segment/AABB slab intersection, used by both projectile adapters. Not a substitute for Level collision tracing.
Bool MC023_SegmentBox(Vec3 *a,Vec3 *b,MCBody023 *e,F32 *time) {F32 lo[3],hi[3],p[3],v[3],t0=0,t1=1;lo[0]=e->x-e->width*0.5-0.3;hi[0]=e->x+e->width*0.5+0.3;lo[1]=e->y-0.3;hi[1]=e->y+e->height+0.3;lo[2]=e->z-e->width*0.5-0.3;hi[2]=e->z+e->width*0.5+0.3;p[0]=a->x;p[1]=a->y;p[2]=a->z;v[0]=b->x-a->x;v[1]=b->y-a->y;v[2]=b->z-a->z;I32 i;for(i=0;i<3;i++){if(fabsf(v[i])<0.0000001){if(p[i]<lo[i] || p[i]>hi[i])return FALSE;}else{F32 x=(lo[i]-p[i])/v[i],y=(hi[i]-p[i])/v[i];if(x>y){F32 tmp=x;x=y;y=tmp;}if(x>t0)t0=x;if(y<t1)t1=y;if(t0>t1)return FALSE;}}*time=t0;return TRUE;}
MCBody023 *MC023_ProjectileEntity(MCBody023 *s,MCBody023 *owner,I32 ticks,Vec3 *a,Vec3 *b,Vec3 *hit) {MCPtrVector v;F32 xx=a->x,yy=a->y,zz=a->z,xxx=b->x,yyy=b->y,zzz=b->z;if(xx>xxx){F32 t=xx;xx=xxx;xxx=t;}if(yy>yyy){F32 t=yy;yy=yyy;yyy=t;}if(zz>zzz){F32 t=zz;zz=zzz;zzz=t;}MC023_Entities(s->w,s,xx-1,yy-1,zz-1,xxx+1,yyy+1,zzz+1,&v);F32 best=2;MCBody023 *out=NULL;I32 i;for(i=0;i<v.size;i++){MCBody023 *e=v.data[i];F32 time;if(e && e!=s && e->pickable && (e!=owner || ticks>4) && MC023_SegmentBox(a,b,e,&time) && time<best){out=e;best=time;}}if(out){hit->x=a->x+(b->x-a->x)*best;hit->y=a->y+(b->y-a->y)*best;hit->z=a->z+(b->z-a->z)*best;}MCPtrVector_Destroy(&v);return out;}
U0 Throwable_tick(Throwable *s) {s->prevX=s->x;s->prevY=s->y;s->prevZ=s->z;MC023_BaseTick(s);if(s->shake>0)s->shake--;if(s->inGround){if(MC023_Tile(s->w,s->tileX,s->tileY,s->tileZ)==s->inTile){s->groundTicks++;if(s->groundTicks==1200)MC023_Remove(s);return;}s->inGround=FALSE;s->motionX*=Random_nextFloat(&s->rng)*0.2;s->motionY*=Random_nextFloat(&s->rng)*0.2;s->motionZ*=Random_nextFloat(&s->rng)*0.2;s->groundTicks=s->airTicks=0;}else s->airTicks++;Vec3 a,b,hit;a.x=s->x;a.y=s->y;a.z=s->z;b.x=a.x+s->motionX;b.y=a.y+s->motionY;b.z=a.z+s->motionZ;I32 x=0,y=0,z=0;Bool block=FALSE;if(s->w->raycast!=NULL)block=s->w->raycast(s->w->ctx,&a,&b,&x,&y,&z,&hit);if(block)b=hit;MCBody023 *entity=NULL;if(!s->w->isClient)entity=MC023_ProjectileEntity(s,s->owner,s->airTicks,&a,&b,&hit);if(entity || block){if(s->onHit!=NULL)s->onHit(s->hitContext,s,entity,&hit);else MC023_Event(s->w,MC023_HIT,x,y,z,0,0,0,s,entity);}s->x+=s->motionX;s->y+=s->motionY;s->z+=s->motionZ;F32 yaw=atan2f(s->motionX,s->motionZ)*180.0/3.1416,pitch=atan2f(s->motionY,sqrtf(s->motionX*s->motionX+s->motionZ*s->motionZ))*180.0/3.1416;while(pitch-s->prevPitch< -180)s->prevPitch-=360;while(pitch-s->prevPitch>=180)s->prevPitch+=360;while(yaw-s->prevYaw< -180)s->prevYaw-=360;while(yaw-s->prevYaw>=180)s->prevYaw+=360;s->pitch=s->prevPitch+(pitch-s->prevPitch)*0.2;s->yaw=s->prevYaw+(yaw-s->prevYaw)*0.2;F32 drag=0.99;if(s->inWater){I32 i;for(i=0;i<4;i++)MC023_Particle(s->w,4,s->x-s->motionX*0.25,s->y-s->motionY*0.25,s->z-s->motionZ*0.25,s->motionX,s->motionY,s->motionZ);drag=0.8;}s->motionX*=drag;s->motionY=s->motionY*drag-s->gravity;s->motionZ*=drag;}
U0 Throwable_save(Throwable *s,CompoundTag *t) {MC023_NBTPut(t,"xTile",s->tileX,FALSE);MC023_NBTPut(t,"yTile",s->tileY,FALSE);MC023_NBTPut(t,"zTile",s->tileZ,FALSE);MC023_NBTPut(t,"inTile",s->inTile,TRUE);MC023_NBTPut(t,"shake",s->shake,TRUE);MC023_NBTPut(t,"inGround",s->inGround,TRUE);}
U0 Throwable_load(Throwable *s,CompoundTag *t) {s->tileX=MC023_NBTGet(t,"xTile",FALSE);s->tileY=MC023_NBTGet(t,"yTile",FALSE);s->tileZ=MC023_NBTGet(t,"zTile",FALSE);s->inTile=MC023_NBTGet(t,"inTile",TRUE);s->shake=MC023_NBTGet(t,"shake",TRUE);s->inGround=MC023_NBTGet(t,"inGround",TRUE)==1;}
