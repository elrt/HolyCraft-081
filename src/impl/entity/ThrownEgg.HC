// Inline implementation from ThrownEgg.hpp; original cpp only includes header.
U0 ThrownEgg_Init(MCProjectile011 *s){s->renderId=17;}I32 ThrownEgg_getEntityTypeId(MCProjectile011 *s){return 82;}U0 ThrownEgg_onHit(MCProjectile011 *s,HitResult *hit){I32 i,n;if(hit->hitType==1)s->hurt(s->host,hit->entity,0);if(!s->isClient && !(Random_genrand_int32(s->sharedRandom)&7)){n=1;if(!(Random_genrand_int32(s->sharedRandom)&31))n=4;for(i=0;i<n;i++)s->chicken(s->host,s->x,s->y,s->z,s->yaw,-24000);}for(i=0;i<6;i++)s->particle(s->host,10,s->x,s->y,s->z,s->particleItem);if(!s->isClient){s->removed=TRUE;s->remove(s->host);}}
