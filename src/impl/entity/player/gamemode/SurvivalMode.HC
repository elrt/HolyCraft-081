// Batch023: entity/player/gamemode/SurvivalMode; explicit simulation ABI, see docs/BATCH023.md.
U0 SurvivalMode_Init(SurvivalMode *s,MCWorld023 *w,MCPlayer023 *p) {GameMode_Init(s,w,p);s->currentX=-1;s->currentY=-1;s->currentZ=-1;}
U0 SurvivalMode_startDestroyBlock(SurvivalMode *s,I32 x,I32 y,I32 z,I32 side) {ItemInstance *item=Inventory_getSelected(s->player->inventory);if(item && ItemInstance_getId(item)==s->w->registry->bow)return;I32 id=MC023_Tile(s->w,x,y,z);MCTileDef023 *t=MC023_Def(s->w,id);if(id>0 && t){if(s->progress==0.0)MC023_Event(s->w,MC023_TILE_ATTACK,x,y,z,id,0,0,s->player);if(t->breakProgress>=1.0)SurvivalMode_destroyBlock(s,x,y,z,side);}}
Bool SurvivalMode_destroyBlock(SurvivalMode *s,I32 x,I32 y,I32 z,I32 side) {I32 id=MC023_Tile(s->w,x,y,z),meta=MC023_Data(s->w,x,y,z);Bool ok=GameMode_destroyBlock(s,x,y,z,side),can=FALSE;MCInteraction023 *a=s->w->actions;if(a && a->canDestroy!=NULL)can=a->canDestroy(a->ctx,s->player,id);ItemInstance *item=Inventory_getSelected(s->player->inventory);if(item){if(a && a->mine!=NULL)a->mine(a->ctx,item,id,x,y,z,s->player);if(!item->count)Inventory_clearSlot(s->player->inventory,s->player->inventory->selectedSlot);}if(ok && can)MC023_Event(s->w,MC023_PLAYER_DESTROY,x,y,z,id,meta,0,s->player);return ok;}
U0 SurvivalMode_continueDestroyBlock(SurvivalMode *s,I32 x,I32 y,I32 z,I32 side) {if(s->delay>0){s->delay--;return;}if(x!=s->currentX || y!=s->currentY || z!=s->currentZ){s->currentX=x;s->currentY=y;s->currentZ=z;s->progress=0.0;s->previousProgress=0.0;s->hits=0;return;}I32 id=MC023_Tile(s->w,x,y,z);MCTileDef023 *t=MC023_Def(s->w,id);if(!id || !t)return;s->hits++;s->progress+=t->breakProgress;if((s->hits&3)==1 && t->stepSound!=NULL)MC023_Sound(s->w,t->stepSound,x+0.5,y+0.5,z+0.5,(t->soundVolume+1)*0.125,t->soundPitch*0.5);if(s->progress>=1.0){SurvivalMode_destroyBlock(s,x,y,z,side);s->progress=0.0;s->previousProgress=0.0;s->hits=0;s->delay=5;}}
U0 SurvivalMode_stopDestroyBlock(SurvivalMode *s) {s->progress=0.0;s->delay=0;}
U0 SurvivalMode_initAbilities(Abilities *a) {a->flying=FALSE;a->mayfly=FALSE;a->instabuild=FALSE;a->invulnerable=FALSE;}
