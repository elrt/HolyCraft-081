// Batch023: entity/player/gamemode/GameMode; explicit simulation ABI, see docs/BATCH023.md.
U0 GameMode_Init(GameMode *s,MCWorld023 *w,MCPlayer023 *player) {memset(s,0,sizeof(GameMode));s->w=w;s->player=player;}
Bool GameMode_destroyBlock(GameMode *s,I32 x,I32 y,I32 z,I32 side) {I32 id=MC023_Tile(s->w,x,y,z);MCTileDef023 *t=MC023_Def(s->w,id);if(!id || !t || !t->registered)return FALSE;if(s->w->allowInteract && id!=s->w->registry->leaves && !t->plant)return FALSE;I32 meta=MC023_Data(s->w,x,y,z);MC023_Event(s->w,MC023_PARTICLE,x,y,z,id,meta,0);MC023_Event(s->w,MC023_WILL_DESTROY,x,y,z,id,meta,0,s->player);if(!MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3))return FALSE;if(t->breakSound)MC023_Sound(s->w,t->breakSound,x+0.5,y+0.5,z+0.5,(t->soundVolume+1)*0.5,t->soundPitch*0.8);MC023_Event(s->w,MC023_TILE_DESTROY,x,y,z,id,meta,0);if(s->w->destroyVibration)MC023_Event(s->w,MC023_VIBRATE,0,0,0,24,0,0);if(s->w->online)MC023_Event(s->w,MC023_PACKET_REMOVE,x,y,z,s->player->id,0,0);return TRUE;}
U0 GameMode_startDestroyBlock(GameMode *s,I32 x,I32 y,I32 z,I32 side) {ItemInstance *item=Inventory_getSelected(s->player->inventory);if(!item || ItemInstance_getId(item)!=s->w->registry->bow)GameMode_destroyBlock(s,x,y,z,side);}
U0 GameMode_tick(GameMode *s) {s->previousProgress=s->progress;}
F32 GameMode_render(GameMode *s,F32 partial) {if(s->progress>0.0)return s->previousProgress+(s->progress-s->previousProgress)*partial;return 0.0;}
U0 GameMode_attack(GameMode *s,MCBody023 *target) {if((!s->w->enablePVP || !target->isPlayer) && (!s->w->enablePVE || !target->isMob))MC023_Event(s->w,MC023_ATTACK,0,0,0,0,0,0,s->player,target);}
U0 GameMode_interact(GameMode *s,MCBody023 *target) {MC023_Event(s->w,MC023_INTERACT,0,0,0,0,0,0,s->player,target);}
U0 GameMode_releaseUsingItem(GameMode *s) {if(s->w->isClient)MC023_Event(s->w,MC023_PACKET_USE,0,0,0,5,0,0,s->player);MC023_Event(s->w,MC023_RELEASE,0,0,0,0,0,0,s->player);}
Bool GameMode_useItem(GameMode *s,ItemInstance *item) {if(!item || !s->w->actions || s->w->actions->use==NULL)return FALSE;I32 before=item->count;ItemInstance *out=s->w->actions->use(s->w->actions->ctx,item,s->player);if(s->w->isClient)MC023_Event(s->w,MC023_PACKET_USE,s->player->x*32768,s->player->y*32768,s->player->z*32768,255,ItemInstance_getId(item),item->metadata,s->player);return out!=item || (out && out->count!=before);}
Bool GameMode_useItemOn(GameMode *s,I32 x,I32 y,I32 z,I32 face,Vec3 *hit) {ItemInstance *item=Inventory_getSelected(s->player->inventory);if(s->w->isClient)MC023_Event(s->w,MC023_PACKET_USE,x,y,z,face,0,0,item,hit);I32 id=MC023_Tile(s->w,x,y,z);if(id==s->w->registry->invisibleBedrock)return FALSE;MCInteraction023 *a=s->w->actions;if(id>0 && a && a->tileUse!=NULL && a->tileUse(a->ctx,x,y,z,s->player))return TRUE;if(!ItemInstance_isItem(item) || !a || a->useOn==NULL)return FALSE;Vec3 relative;relative.x=hit->x-x;relative.y=hit->y-y;relative.z=hit->z-z;I32 count=item->count,meta=item->metadata;Bool ok=a->useOn(a->ctx,item,s->player,x,y,z,face,&relative);if(s->creative){item->count=count;item->metadata=meta;}return ok;}
