U0 SimpleFoodData_Init(SimpleFoodData *s){s->currentLevel=0;}U0 SimpleFoodData_eat(SimpleFoodData *s,I32 h){I32 n=s->currentLevel+h;if(n>=20)s->currentLevel=20;else s->currentLevel=n;}U0 SimpleFoodData_eatFood(SimpleFoodData *s,FoodItem *it){SimpleFoodData_eat(s,it->healAmount);}U0 SimpleFoodData_tick(SimpleFoodData *s,U0 *p,Bool (*isHurt)(U0 *),U0 (*heal)(U0 *,I32)){if(s->currentLevel>0 && isHurt(p)){heal(p,s->currentLevel);s->currentLevel=0;}}
