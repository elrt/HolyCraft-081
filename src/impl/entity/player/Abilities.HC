// Inline implementation from Abilities.hpp; original cpp only includes header.
U0 Abilities_addSaveData(Abilities *s,CompoundTag *tag) { CompoundTag *v=MC_Alloc(sizeof(CompoundTag));MCString key;CompoundTag_InitEmpty(v);MCString_FromC(&key,"invulnerable");CompoundTag_putBoolean(v,&key,s->invulnerable);MCString_Destroy(&key);MCString_FromC(&key,"flying");CompoundTag_putBoolean(v,&key,s->flying);MCString_Destroy(&key);MCString_FromC(&key,"mayfly");CompoundTag_putBoolean(v,&key,s->mayfly);MCString_Destroy(&key);MCString_FromC(&key,"instabuild");CompoundTag_putBoolean(v,&key,s->instabuild);MCString_Destroy(&key);MCString_FromC(&key,"abilities");CompoundTag_put(tag,&key,v);MCString_Destroy(&key); }
U0 Abilities_loadSaveData(Abilities *s,CompoundTag *tag) { CompoundTag *v;MCString key;MCString_FromC(&key,"abilities");if(!CompoundTag_contains(tag,&key)) { MCString_Destroy(&key);return; }v=CompoundTag_getCompound(tag,&key);MCString_Destroy(&key);MCString_FromC(&key,"invulnerable");s->invulnerable=CompoundTag_getByte(v,&key)!=0;MCString_Destroy(&key);MCString_FromC(&key,"flying");s->flying=CompoundTag_getByte(v,&key)!=0;MCString_Destroy(&key);MCString_FromC(&key,"mayfly");s->mayfly=CompoundTag_getByte(v,&key)!=0;MCString_Destroy(&key);MCString_FromC(&key,"instabuild");s->instabuild=CompoundTag_getByte(v,&key)!=0;MCString_Destroy(&key); }
