U0 RemotePlayer_Init(RemotePlayer *s,MCRemotePlayerHost012 *h,Bool b){s->host=h;s->base=h->createBase(h->host,b);s->usingItem=FALSE;h->setFieldCB4(h->host,s->base,TRUE);}U0 RemotePlayer_Destroy(RemotePlayer *s){s->host->destroyBase(s->host->host,s->base);}U0 RemotePlayer_tick(RemotePlayer *s){MCRemotePlayerHost012 *h=s->host;U0 *item;h->baseTick(h->host,s->base);if(!s->usingItem && h->getSharedFlag(h->host,s->base,4)){s->usingItem=TRUE;item=h->inventoryItem(h->host,s->base,9);if(item && h->itemHasClass(h->host,item))h->startUsingItemCopy(h->host,s->base,item,h->itemMaxUseDuration(h->host,item));}else if(s->usingItem && !h->getSharedFlag(h->host,s->base,4)){h->stopUsingItem(h->host,s->base);s->usingItem=FALSE;}if(!h->currentItemIsNull(h->host,s->base))h->decrementUseDuration(h->host,s->base);}U0 RemotePlayer_aiStep(RemotePlayer *s){s->host->updateAttackAnim(s->host->host,s->base);s->host->baseAiStep(s->host->host,s->base);}
