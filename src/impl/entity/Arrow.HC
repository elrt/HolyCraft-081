// Batch023: entity/Arrow; explicit simulation ABI, see docs/BATCH023.md.
U0 Arrow_Init(Arrow *s,MCWorld023 *w,MCBody023 *owner) {memset(s,0,sizeof(Arrow));Throwable_Init(s,w,owner);s->type=80;s->width=s->height=0.5;s->gravity=0.05;s->playerOwned=owner && owner->isPlayer;}
U0 Arrow_shoot(Arrow *s,F32 x,F32 y,F32 z,F32 power,F32 spread) {F32 n=sqrtf(x*x+y*y+z*z);if(n<0.0000001){s->motionX=s->motionY=s->motionZ=0;return;}s->motionX=(x/n+Random_nextGaussian(&s->rng)*0.0075*spread)*power;s->motionY=(y/n+Random_nextGaussian(&s->rng)*0.0075*spread)*power;s->motionZ=(z/n+Random_nextGaussian(&s->rng)*0.0075*spread)*power;s->yaw=s->prevYaw=atan2f(s->motionX,s->motionZ)*Mth_RADDEG;s->pitch=s->prevPitch=atan2f(s->motionY,sqrtf(s->motionX*s->motionX+s->motionZ*s->motionZ))*Mth_RADDEG;s->groundTicks=0;}
U0 Arrow_tick(Arrow *s) {MC023_BaseTick(s);if(s->shake>0)s->shake--;if(s->inGround){s->motionX=s->motionY=s->motionZ=0;if(MC023_Tile(s->w,s->tileX,s->tileY,s->tileZ)==s->inTile && MC023_Data(s->w,s->tileX,s->tileY,s->tileZ)==s->inData){if(++s->groundTicks==1200)MC023_Remove(s);return;}s->inGround=FALSE;Random_nextFloat(&s->rng);Random_nextFloat(&s->rng);Random_nextFloat(&s->rng);s->groundTicks=s->airTicks=0;}s->airTicks++;Vec3 a,b,hit;a.x=s->x;a.y=s->y;a.z=s->z;b.x=a.x+s->motionX;b.y=a.y+s->motionY;b.z=a.z+s->motionZ;I32 x=0,y=0,z=0;Bool block=FALSE;if(s->w->raycast!=NULL)block=s->w->raycast(s->w->ctx,&a,&b,&x,&y,&z,&hit);if(block)b=hit;MCBody023 *e=MC023_ProjectileEntity(s,s->owner,s->airTicks,&a,&b,&hit);if(e){F32 speed=sqrtf(s->motionX*s->motionX+s->motionY*s->motionY+s->motionZ*s->motionZ);I32 damage=ceilf(speed*2);if(s->critical)damage+=Random_genrand_int32(&s->rng)%(damage/2+2)(U32);if(MC023_Hurt(e,s->owner,damage)){MC023_Event(s->w,MC023_HIT,0,0,0,80,0,1,s,e);MC023_Sound(s->w,"random.bowhit",s->x,s->y,s->z,1.0,1.2/(Random_nextFloat(&s->rng)*0.2+0.9));MC023_Remove(s);}else{s->motionX*= -0.1;s->motionY*= -0.1;s->motionZ*= -0.1;s->yaw+=180;s->prevYaw+=180;s->airTicks=0;}}else if(block){s->tileX=x;s->tileY=y;s->tileZ=z;s->inTile=MC023_Tile(s->w,x,y,z);s->inData=MC023_Data(s->w,x,y,z);s->motionX=hit.x-a.x;s->motionY=hit.y-a.y;s->motionZ=hit.z-a.z;F32 len=sqrtf(s->motionX*s->motionX+s->motionY*s->motionY+s->motionZ*s->motionZ);if(len>0){s->x-=s->motionX/len*0.05;s->y-=s->motionY/len*0.05;s->z-=s->motionZ/len*0.05;}s->inGround=TRUE;s->shake=7;s->critical=FALSE;MC023_Sound(s->w,"random.bowhit",s->x,s->y,s->z,1.0,1.2/(Random_nextFloat(&s->rng)*0.2+0.9));}I32 i;if(s->critical)for(i=0;i<4;i++)MC023_Particle(s->w,5,s->x+s->motionX*i*0.25,s->y+s->motionY*i*0.25,s->z+s->motionZ*i*0.25,-s->motionX,-s->motionY+0.2,-s->motionZ);s->x+=s->motionX;s->y+=s->motionY;s->z+=s->motionZ;s->yaw=s->prevYaw+(atan2f(s->motionX,s->motionZ)*Mth_RADDEG-s->prevYaw)*0.2;s->pitch=s->prevPitch+(atan2f(s->motionY,sqrtf(s->motionX*s->motionX+s->motionZ*s->motionZ))*Mth_RADDEG-s->prevPitch)*0.2;F32 drag=0.99;if(s->inWater){drag=0.8;for(i=0;i<4;i++)MC023_Particle(s->w,4,s->x-s->motionX*0.25,s->y-s->motionY*0.25,s->z-s->motionZ*0.25,s->motionX,s->motionY,s->motionZ);}s->motionX*=drag;s->motionY=s->motionY*drag-0.05;s->motionZ*=drag;}
U0 Arrow_playerTouch(Arrow *s,MCPlayer023 *p) {if(s->w->isClient || !s->inGround || !s->playerOwned || s->shake>0)return;ItemInstance item;ItemInstance_Init(&item,s->w->registry,s->w->registry->arrow,1,0);if(Inventory_add(p->inventory,&item)){MC023_Event(s->w,MC023_TAKE,0,0,0,80,0,1,p,s);MC023_Remove(s);}}
U0 Arrow_save(Arrow *s,CompoundTag *t) {Throwable_save(s,t);MC023_NBTPut(t,"inData",s->inData,TRUE);MC023_NBTPut(t,"player",s->playerOwned,TRUE);}
U0 Arrow_load(Arrow *s,CompoundTag *t) {Throwable_load(s,t);s->inData=MC023_NBTGet(t,"inData",TRUE);s->playerOwned=MC023_NBTGet(t,"player",TRUE)==1;}
