// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 PathNavigation_Init(PathNavigation *s,MCBody023 *mob,MCWorld024 *world,F32 range){memset(s,0,sizeof(PathNavigation));s->mob=mob;s->range=range;PathFinder_Init(&s->finder,world,TRUE,FALSE,FALSE,FALSE);}
U0 PathNavigation_stop(PathNavigation *s){if(s->path){Path_Destroy(s->path);free(s->path);s->path=NULL;}}
U0 PathNavigation_Destroy(PathNavigation *s){PathNavigation_stop(s);PathFinder_Destroy(&s->finder);}
Bool PathNavigation_canUpdatePath(PathNavigation *s){return s->mob->onGround || (s->finder.canFloat && (s->mob->inWater || s->mob->inLava));}
I32 PathNavigation_getSurfaceY(PathNavigation *s){MCBody023 *b=s->mob;if(!b->inWater || !s->finder.canFloat)return (b->minYBound+0.5)(I32);I32 y=b->minYBound,max=y+17,id;while(TRUE){id=MC023_Tile(s->finder.world->w,floorf(b->x),y,floorf(b->z));if(id!=s->finder.world->w->registry->water && id!=s->finder.world->calmWater)return y;y++;if(y==max)return b->minYBound(I32);}return y;}
Bool PathNavigation_moveToPath(PathNavigation *s,Path *p,F32 speed){if(!p){PathNavigation_stop(s);return FALSE;}if(s->path && Path_sameAs(p,s->path)){Path_Destroy(p);free(p);}else{PathNavigation_stop(s);s->path=p;}if(s->avoidSun && !MC023_Get(s->finder.world->w,MC023_SKY,floorf(s->mob->x),(s->mob->minYBound+0.5)(I32),floorf(s->mob->z))){I32 i;for(i=0;i<s->path->size;i++){Node *n=s->path->nodes[i];if(MC023_Get(s->finder.world->w,MC023_SKY,n->xCoord,n->yCoord,n->zCoord)){I32 nsize=i-1;if(nsize<0)nsize=0;Path_setSize(s->path,nsize);break;}}}if(!s->path->size)return FALSE;s->speed=speed;s->lastTick=s->ticks;s->lastPos.x=s->mob->x;s->lastPos.y=PathNavigation_getSurfaceY(s);s->lastPos.z=s->mob->z;return TRUE;}
Bool PathNavigation_moveTo(PathNavigation *s,F32 x,F32 y,F32 z,F32 speed){if(!PathNavigation_canUpdatePath(s))return FALSE;Path *p=PathFinder_findPath(&s->finder,s->mob,floorf(x)+0.5,y(I32)+0.5,floorf(z)+0.5,s->range);return PathNavigation_moveToPath(s,p,speed);}
Bool PathNavigation_canWalkOn(PathNavigation *s,I32 x,I32 y,I32 z,I32 width,I32 height,I32 depth,Vec3 *from,F32 dx,F32 dz){I32 a,b,c,id;x-=width/2;z-=depth/2;for(a=x;a<x+width;a++)for(c=z;c<z+depth;c++){if((a+0.5-from->x)*dx+(c+0.5-from->z)*dz<0)continue;for(b=y;b<y+height;b++)if(!MC024_Passable(s->finder.world,a,b,c))return FALSE;id=MC023_Tile(s->finder.world->w,a,y-1,c);if(id<=0)return FALSE;I32 mat=MC023_Material(s->finder.world->w,a,y-1,c);if(mat==4 || (mat==3 && !s->mob->inWater))return FALSE;}return TRUE;}
Bool PathNavigation_canMoveDirectly(PathNavigation *s,Vec3 *from,Vec3 *to,I32 width,I32 height,I32 depth){F32 dx=to->x-from->x,dz=to->z-from->z,len=dx*dx+dz*dz;if(len<0.000001)return FALSE;len=sqrtf(len);dx/=len;dz/=len;I32 x=floorf(from->x),z=floorf(from->z),tx=floorf(to->x),tz=floorf(to->z),sx=1,sz=1;if(dx<0)sx=-1;if(dz<0)sz=-1;if(!PathNavigation_canWalkOn(s,x,from->y(I32),z,width+2,height,depth+2,from,dx,dz))return FALSE;F32 ix=1.0e30,iz=1.0e30,ax=1.0e30,az=1.0e30;if(dx!=0){ix=1/fabsf(dx);F32 gap=x-from->x;if(dx>=0)gap++;ax=gap/dx;}if(dz!=0){iz=1/fabsf(dz);F32 gap=z-from->z;if(dz>=0)gap++;az=gap/dz;}I32 steps=0;while(sx*(tx-x)>0 || sz*(tz-z)>0){if(++steps>16384)return FALSE;if(ax<az){x+=sx;ax+=ix;}else{z+=sz;az+=iz;}if(!PathNavigation_canWalkOn(s,x,from->y(I32),z,width,height,depth,from,dx,dz))return FALSE;}return TRUE;}
U0 PathNavigation_tick(PathNavigation *s){s->ticks++;if(!s->path || Path_isDone(s->path))return;Vec3 pos;pos.x=s->mob->x;pos.y=PathNavigation_getSurfaceY(s);pos.z=s->mob->z;if(PathNavigation_canUpdatePath(s)){I32 i,end=s->path->size;for(i=s->path->currentIndex;i<s->path->size;i++)if(s->path->nodes[i]->yCoord!=pos.y(I32)){end=i;break;}for(i=s->path->currentIndex;i<end;i++){Vec3 p;Path_getPos(s->path,s->mob->width,i,&p);F32 dx=pos.x-p.x,dy=pos.y-p.y,dz=pos.z-p.z;if(dx*dx+dy*dy+dz*dz<s->mob->width*s->mob->width)Path_setIndex(s->path,i+1);}I32 width=ceilf(s->mob->width),height=s->mob->height+1;for(i=end-1;i>=s->path->currentIndex;i--){Vec3 p;Path_getPos(s->path,s->mob->width,i,&p);if(PathNavigation_canMoveDirectly(s,&pos,&p,width,height,width)){Path_setIndex(s->path,i);break;}}if(s->ticks-s->lastTick>100){F32 dx=pos.x-s->lastPos.x,dy=pos.y-s->lastPos.y,dz=pos.z-s->lastPos.z;if(dx*dx+dy*dy+dz*dz<2.25){PathNavigation_stop(s);return;}s->lastTick=s->ticks;s->lastPos=pos;}}if(s->path && !Path_isDone(s->path) && s->wanted!=NULL){Vec3 next;Path_currentPosForWidth(s->path,s->mob->width,&next);s->wanted(s->ctx,next.x(F32),next.y(F32),next.z(F32),s->speed(F32));}}
