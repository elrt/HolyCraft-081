// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 PathFinder_Init(PathFinder *s,MCWorld024 *world,Bool passDoors,Bool openDoors,Bool avoidWater,Bool canFloat){memset(s,0,sizeof(PathFinder));s->world=world;s->passDoors=passDoors;s->openDoors=openDoors;s->avoidWater=avoidWater;s->canFloat=canFloat;s->maxNodes=16384;MCPtrVector_Init(&s->nodes);BinaryHeap_Init(&s->heap);}
U0 PathFinder_reset(PathFinder *s){BinaryHeap_clear(&s->heap);I32 i;for(i=0;i<s->nodes.size;i++)free(s->nodes.data[i]);s->nodes.size=0;s->limited=FALSE;}
U0 PathFinder_Destroy(PathFinder *s){PathFinder_reset(s);MCPtrVector_Destroy(&s->nodes);BinaryHeap_Destroy(&s->heap);}
Node *PathFinder_getNode(PathFinder *s,I32 x,I32 y,I32 z){U32 hash=Node_createHash(x,y,z);I32 i;for(i=0;i<s->nodes.size;i++){Node *n=s->nodes.data[i];if(n->nodeHash(U32)==hash)return n;}if(s->nodes.size>=s->maxNodes){s->limited=TRUE;return NULL;}Node *n=MC_Alloc(sizeof(Node));Node_Init(n,x,y,z);MCPtrVector_Push(&s->nodes,n);return n;}
I32 PathFinder_isFree(PathFinder *s,MCBody023 *body,I32 x,I32 y,I32 z,Node *size){I32 a,b,c,id;Bool special=FALSE;MCWorld023 *w=s->world->w;for(a=x;a<x+size->xCoord;a++)for(b=y;b<y+size->yCoord;b++)for(c=z;c<z+size->zCoord;c++){id=MC023_Tile(w,a,b,c);if(id<=0)continue;if(!MC024_ValidId(id))return 0;if(id==w->registry->trapdoor)special=TRUE;else if(id==w->registry->water || id==s->world->calmWater){if(s->avoidWater)return -1;special=TRUE;}else if(!s->passDoors && id==w->registry->doorWood)return 0;if(!s->world->passable[id] && (!s->openDoors || id!=w->registry->doorWood)){if(id==s->world->fence || id==s->world->fenceGate)return -3;if(id==w->registry->trapdoor)return -4;if(MC023_Material(w,a,b,c)!=4)return 0;if(!body->inLava)return -2;}}if(special)return 2;return 1;}
Node *PathFinder_walkNode(PathFinder *s,MCBody023 *body,I32 x,I32 y,I32 z,Node *size,I32 step){I32 state=PathFinder_isFree(s,body,x,y,z,size);if(state==2)return PathFinder_getNode(s,x,y,z);Node *n=NULL;if(state==1)n=PathFinder_getNode(s,x,y,z);else{if(step<=0 || state==-3 || state==-4)return NULL;y+=step;if(PathFinder_isFree(s,body,x,y,z,size)!=1)return NULL;n=PathFinder_getNode(s,x,y,z);}if(!n)return NULL;I32 falls=4;while(y>0){state=PathFinder_isFree(s,body,x,y-1,z,size);if(s->avoidWater && state==-1)return NULL;if(state!=1){if(state==-2)return NULL;return n;}falls--;if(!falls)return NULL;y--;if(!y)return n;n=PathFinder_getNode(s,x,y,z);if(!n)return NULL;}return n;}
Path *PathFinder_reconstruct(Node *end){I32 count=0,i;Node *n=end;while(n){count++;n=n->field_20;if(count>16384)return NULL;}Node **nodes=MC_Alloc(count*sizeof(Node*));n=end;for(i=count-1;i>=0;i--){nodes[i]=n;n=n->field_20;}Path *p=MC_Alloc(sizeof(Path));Path_Init(p,nodes,count);free(nodes);return p;}
Path *PathFinder_search(PathFinder *s,MCBody023 *body,Node *start,Node *goal,Node *size,F32 range){if(!start || !goal)return NULL;start->field_14=0;start->field_18=Node_distanceTo(start,goal);start->nodeCost=start->field_18;BinaryHeap_clear(&s->heap);BinaryHeap_insert(&s->heap,start);Node *closest=start,*current,*n;I32 dirs[8]={0,1,-1,0,1,0,0,-1},i,step;while(!BinaryHeap_isEmpty(&s->heap)){current=BinaryHeap_pop(&s->heap);if(Node_equals(current,goal))return PathFinder_reconstruct(goal);if(Node_distanceTo(current,goal)<Node_distanceTo(closest,goal))closest=current;current->field_24=1;step=PathFinder_isFree(s,body,current->xCoord,current->yCoord+1,current->zCoord,size)==1;Node *neighbors[4];for(i=0;i<4;i++)neighbors[i]=PathFinder_walkNode(s,body,current->xCoord+dirs[i*2],current->yCoord,current->zCoord+dirs[i*2+1],size,step);for(i=0;i<4;i++){n=neighbors[i];if(!n || n->field_24 || Node_distanceTo(n,goal)>=range)continue;F32 cost=current->field_14+Node_distanceTo(current,n);Bool open=Node_inOpenSet(n);if(!open || cost<n->field_14){n->field_20=current;n->field_14=cost;n->field_18=Node_distanceTo(n,goal);if(open)BinaryHeap_changeCost(&s->heap,n,cost+n->field_18);else{n->nodeCost=cost+n->field_18;BinaryHeap_insert(&s->heap,n);}}}}if(closest!=start)return PathFinder_reconstruct(closest);return NULL;}
Path *PathFinder_findPath(PathFinder *s,MCBody023 *body,F32 x,F32 y,F32 z,F32 range){PathFinder_reset(s);Bool oldAvoid=s->avoidWater;I32 sy=floorf(body->minYBound+0.5),sx=floorf(body->x-body->width/2),sz=floorf(body->z-body->width/2),id,i,j;if(s->canFloat && body->inWater){sy=body->minYBound;for(i=0;i<256;i++){id=MC023_Tile(s->world->w,floorf(body->x),sy,floorf(body->z));if(id!=s->world->w->registry->water && id!=s->world->calmWater)break;sy++;}s->avoidWater=FALSE;}Node *start=PathFinder_getNode(s,sx,sy,sz);I32 gx=floorf(x-body->width/2),gy=floorf(y),gz=floorf(z-body->width/2);Node *goal=NULL;if(!MC023_Tile(s->world->w,gx,gy-1,gz)){for(i=gx;i<=floorf(x+body->width/2);i++)for(j=gz;j<=floorf(z+body->width/2);j++)if(MC023_Tile(s->world->w,i,gy-1,j)){goal=PathFinder_getNode(s,i,gy,j);break;}if(!goal)while(gy>0 && !MC023_Tile(s->world->w,gx,gy-1,gz))gy--;}if(!goal)goal=PathFinder_getNode(s,gx,gy,gz);I32 width=floorf(body->width+1);Node size;Node_Init(&size,width,floorf(body->height+1),width);Path *p=PathFinder_search(s,body,start,goal,&size,range);s->avoidWater=oldAvoid;return p;}
