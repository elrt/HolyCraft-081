U0 WaterAnimal_Init(WaterAnimal *s,MCWaterAnimalHost012 *h){s->host=h;s->base=h->createBase(h->host);}U0 WaterAnimal_Destroy(WaterAnimal *s){s->host->destroyBase(s->host->host,s->base);}I32 WaterAnimal_getExperienceReward(WaterAnimal *s){return Random_genrand_int32(s->host->random)%3+1;}I32 WaterAnimal_getCreatureBaseType(WaterAnimal *s){return 3;}U0 WaterAnimal_readAdditionalSaveData(WaterAnimal *s,CompoundTag *t){s->host->readAdditional(s->host->host,s->base,t);}U0 WaterAnimal_addAdditonalSaveData(WaterAnimal *s,CompoundTag *t){s->host->writeAdditional(s->host->host,s->base,t);}Bool WaterAnimal_isWaterMob(WaterAnimal *s){return TRUE;}I32 WaterAnimal_getAmbientSoundInterval(WaterAnimal *s){return 120;}F32 WaterAnimal_getBaseSpeed(WaterAnimal *s){return 0.2;}Bool WaterAnimal_canSpawn(WaterAnimal *s){return s->host->isUnobstructed(s->host->host,s->base);}Bool WaterAnimal_removeWhenFarAway(WaterAnimal *s){return TRUE;}
