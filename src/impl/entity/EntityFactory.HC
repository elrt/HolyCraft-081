U0 *EntityFactory_CreateEntity(MCFactoryHost014 *h,I32 id,U0 *level){if((id>=64&&id<=66)||(id>=80&&id<=84))return h->newEntity(h->host,id,level);return NULL;}U0 *EntityFactory_loadEntity(MCFactoryHost014 *h,U0 *tag,U0 *level){I32 id=h->tagGetId(h->host,tag);U0 *e;if(id<0)return NULL;if(id>63)e=EntityFactory_CreateEntity(h,id,level);else e=MobFactory_CreateMob(h,id,level);if(!e)return NULL;h->loadEntity(h->host,e,tag);if(h->itemEntity(h->host,e)&&!h->validItem(h->host,e)){h->destroyEntity(h->host,e);return NULL;}return e;}
