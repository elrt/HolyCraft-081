// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 LocalPlayer_Init(LocalPlayer *s,Level *level,U8 *name,Bool creative,IMoveInput *input){memset(s,0,sizeof(LocalPlayer));Player_Init(&s->player,level,name,creative);s->input=input;s->allowAutojump=TRUE;}
U0 LocalPlayer_Destroy(LocalPlayer *s){Player_Destroy(&s->player);}
U0 LocalPlayer_releaseAllKeys(LocalPlayer *s){if(s->input)IMoveInput_releaseAllKeys(s->input);}
U0 LocalPlayer_setKey(LocalPlayer *s,I32 key,Bool down){if(s->input)IMoveInput_setKey(s->input,key,down);}
Bool LocalPlayer_positionChanged(LocalPlayer *s){MCBody023 *b=&s->player.mob.entity.body;return fabs(b->x-s->lastX)>0.1 || fabs(b->y-s->lastY)>0.01 || fabs(b->z-s->lastZ)>0.1 || fabs(b->yaw-s->lastYaw)>1 || fabs(b->pitch-s->lastPitch)>1;}
U0 LocalPlayer_markPositionSent(LocalPlayer *s){MCBody023 *b=&s->player.mob.entity.body;s->lastX=b->x;s->lastY=b->y;s->lastZ=b->z;s->lastYaw=b->yaw;s->lastPitch=b->pitch;}

U0 LocalPlayer_aiStep(LocalPlayer *s){Player *p=&s->player;Mob *m=&p->mob;MCBody023 *b=&m->entity.body;s->flyToggleCounter--;if(s->input)IMoveInput_tick(s->input,p);F32 strafe=0,forward=0;Bool jump=FALSE;if(s->input){strafe=s->input->strafeInput;forward=s->input->forwardInput;jump=s->input->jumping;m->entity.sneaking=s->input->sneaking;}if(m->entity.sneaking && m->entity.ySize<0.2)m->entity.ySize=0.2;m->horizontalDrag=1;if(p->abilities.mayfly){if(!s->previousJump && jump){if(s->flyToggleCounter>0){s->flyToggleCounter=0;p->abilities.flying=!p->abilities.flying;}else s->flyToggleCounter=7;}if(p->abilities.flying){F32 largest=fabs(strafe);if(largest<fabs(forward))largest=fabs(forward);if(largest<0.01)m->horizontalDrag=0.75;if(s->input && s->input->flyUpPressed)b->motionY+=0.15;if(s->input && s->input->flyDownPressed)b->motionY-=0.15;}}s->previousJump=jump;if(!ItemInstance_isNull(&p->usingItem)){strafe*=0.35;forward*=0.35;}if(jump){if(b->inWater || b->inLava)b->motionY+=0.04;else if(b->onGround)Mob_jumpFromGround(m);}Player_travel(p,strafe,forward);}
U0 LocalPlayer_tick(LocalPlayer *s){Player *p=&s->player;MCBody023 *b=&p->mob.entity.body;Mob_tickTimers(&p->mob);if(b->dead)return;LocalPlayer_aiStep(s);Player_pickupNearby(p);ItemInstance *selected=Inventory_getSelected(&p->inventory);s->lastSelectedId=0;s->lastSelectedMeta=0;if(selected && selected->count>0){s->lastSelectedId=ItemInstance_getId(selected);s->lastSelectedMeta=selected->metadata;}if(p->useItemDuration>0){if(!selected || ItemInstance_getId(selected)!=ItemInstance_getId(&p->usingItem) || selected->metadata!=p->usingItem.metadata)Player_stopUsingItem(p);else p->useItemDuration--;}Player_syncView(p);}
