// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Minecraft_Init(Minecraft *s,AppPlatform *platform,Bool supportNonTouch){memset(s,0,sizeof(Minecraft));s->platform=platform;s->supportsNonTouchScreen=supportNonTouch;F32 ppm=10;if(platform)ppm=platform->pixelsPerMillimeter;Options_Init(&s->options,ppm,supportNonTouch);s->width=854;s->height=480;s->guiScale=3;s->pixelsPerMillimeter=s->options.pixelDensity;}
Bool Minecraft_useTouchscreen(Minecraft *s){return s->options.flags[16] || !s->supportsNonTouchScreen;}
U0 Minecraft_setSize(Minecraft *s,I32 width,I32 height){if(!width)width=240;if(!height)height=140;s->width=width;s->height=height;F32 ppm=10;if(s->platform)ppm=s->platform->pixelsPerMillimeter;if(width>=1000){s->guiScale=4;if(ppm>15)s->guiScale=6;}else if(width>=800)s->guiScale=3;else if(width>=400)s->guiScale=2;else s->guiScale=1;s->pixelsPerMillimeter=s->options.pixelDensity;if(s->currentScreen)Screen_setSize(s->currentScreen,width/s->guiScale,height/s->guiScale);}
U0 Minecraft_setScreen(Minecraft *s,Screen *screen){if(s->inTick){s->pendingScreen=screen;s->hasPendingScreen=TRUE;return;}if(screen && screen->error)return;if(!screen && !s->currentScreen)return;Screen *old=s->currentScreen;if(old){Screen_lostFocus(old);if(old->removed!=NULL)old->removed(old->context);}s->currentScreen=screen;if(screen){Screen_attach(screen,s,s->width/s->guiScale,s->height/s->guiScale);if(s->player)LocalPlayer_releaseAllKeys(s->player);}}
U0 Minecraft_setLevel(Minecraft *s,Level *level,IMoveInput *input,Bool creative){if(s->player && s->ownsPlayer){LocalPlayer_Destroy(s->player);free(s->player);}s->level=level;s->player=NULL;s->ownsPlayer=FALSE;s->input=input;if(!level)return;s->player=MC_Alloc(sizeof(LocalPlayer));LocalPlayer_Init(s->player,level,s->options.username.data,creative,input);s->ownsPlayer=TRUE;Player_resetPos(&s->player->player,FALSE);Level_addEntity(level,&s->player->player.mob.entity.body);GameMode_Init(&s->creativeMode,&level->world,&s->player->player.view);SurvivalMode_Init(&s->survival,&level->world,&s->player->player.view);}
Bool Minecraft_destroyBlock(Minecraft *s,I32 x,I32 y,I32 z,I32 side){if(!s->level || !s->player)return FALSE;Player_syncView(&s->player->player);I32 id=Level_getTile(s->level,x,y,z);if(id>0 && s->level->tileObjects[id] && s->level->tileObjects[id]->hardness<0)return FALSE;if(s->player->player.abilities.instabuild)return GameMode_destroyBlock(&s->creativeMode,x,y,z,side);return SurvivalMode_destroyBlock(&s->survival,x,y,z,side);}
U0 Minecraft_tick(Minecraft *s){s->inTick=TRUE;s->ticks++;if(s->currentScreen)Screen_tick(s->currentScreen);if(s->level && !s->paused){s->level->world.difficulty=s->options.difficulty;if(s->level->world.isClient)s->level->world.difficulty=1;GameMode_tick(&s->survival);if(s->player){Bool blocked=s->currentScreen && !s->currentScreen->dontPreventGameInput;if(blocked){IMoveInput *input=s->player->input;s->player->input=NULL;LocalPlayer_tick(s->player);s->player->input=input;}else LocalPlayer_tick(s->player);}Level_tick(s->level);}s->inTick=FALSE;if(s->hasPendingScreen){Screen *pending=s->pendingScreen;s->hasPendingScreen=FALSE;s->pendingScreen=NULL;Minecraft_setScreen(s,pending);}}
U0 Minecraft_updateTicks(Minecraft *s,I32 ticks,F32 partial){if(ticks<0)ticks=0;if(ticks>10)ticks=10;I32 i;for(i=0;i<ticks;i++)Minecraft_tick(s);if(s->currentScreen)Screen_render(s->currentScreen,s->ticks/20);if(s->frame!=NULL)s->frame(s->context,partial(F32));}
Bool Minecraft_save(Minecraft *s,ExternalFileLevelStorage *storage,I32 epoch){if(!s->level)return FALSE;if(s->player){CompoundTag tag;CompoundTag_InitEmpty(&tag);Player_addSaveData(&s->player->player,&tag);LevelData_setPlayerTag(&s->level->data,&tag);Tag_Destroy(&tag);}if(!Level_saveChunks(s->level,&storage->region))return FALSE;return ExternalFileLevelStorage_writeLevelData(storage->folder.data,&s->level->data,epoch);}
U0 Minecraft_Destroy(Minecraft *s){Minecraft_setScreen(s,NULL);if(s->player && s->ownsPlayer){LocalPlayer_Destroy(s->player);free(s->player);}s->player=NULL;s->level=NULL;Options_Destroy(&s->options);}
F32 Minecraft_refreshDestroyProgress(Minecraft *s,I32 x,I32 y,I32 z){if(!s->level || !s->player)return 0;I32 id=Level_getTile(s->level,x,y,z);if(id<1 || !s->level->tileObjects[id])return 0;ItemInstance *selected=Inventory_getSelected(&s->player->player.inventory);F32 speed=1;if(selected && selected->itemClass)speed=selected->itemClass->destroySpeed;Bool can=MC025_CanDestroy(s->level,&s->player->player.view,id);F32 progress=Tile_getDestroyProgress(s->level->tileObjects[id],can,speed);s->level->registry->tiles[id].breakProgress=progress;return progress;}
U0 Minecraft_startDestroyBlock(Minecraft *s,I32 x,I32 y,I32 z,I32 face){if(!s->level || !s->player)return;Player_syncView(&s->player->player);Minecraft_refreshDestroyProgress(s,x,y,z);if(s->player->player.abilities.instabuild)GameMode_startDestroyBlock(&s->creativeMode,x,y,z,face);else SurvivalMode_startDestroyBlock(&s->survival,x,y,z,face);}
U0 Minecraft_continueDestroyBlock(Minecraft *s,I32 x,I32 y,I32 z,I32 face){if(!s->level || !s->player)return;Player_syncView(&s->player->player);Minecraft_refreshDestroyProgress(s,x,y,z);if(!s->player->player.abilities.instabuild)SurvivalMode_continueDestroyBlock(&s->survival,x,y,z,face);}
