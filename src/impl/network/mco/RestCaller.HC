// Batch022: network/mco/RestCaller; explicit host ABI, see docs/BATCH022.md.
U0 RestCaller_Init(RestCaller *s,MCString *base,MCString *version) {memset(s,0,sizeof(RestCaller));MCString_CopyInit(&s->baseURL,base);MCString_CopyInit(&s->gameVersion,version);MCString_Init(&s->key);MCString_Init(&s->user);MCString_Init(&s->sid);}
U0 RestCaller_Destroy(RestCaller *s) {MCString_Destroy(&s->baseURL);MCString_Destroy(&s->gameVersion);MCString_Destroy(&s->key);MCString_Destroy(&s->user);MCString_Destroy(&s->sid);}
U0 RestCaller_addToCookieData(MCString *out,U8 *key,MCString *value) {if(!value->size)return;if(out->size)MCString_AppendChar017(out,' ');MCString_AppendBytes017(out,key,MC_StrLen(key));MCString_AppendChar017(out,'=');MCString_AppendStr017(out,value);}
U0 RestCaller_getCookieDataAsString(RestCaller *s,MCString *out) {MCString_Init(out);RestCaller_addToCookieData(out,"sid",&s->sid);RestCaller_addToCookieData(out,"user",&s->user);RestCaller_addToCookieData(out,"gameversion",&s->gameVersion);RestCaller_addToCookieData(out,"key",&s->key);}
U0 RestCaller_setSID(RestCaller *s,MCString *v) {MCString_Assign(&s->sid,v);}U0 RestCaller_setUser(RestCaller *s,MCString *v) {MCString_Assign(&s->user,v);}U0 RestCaller_setKey(RestCaller *s,MCString *v) {MCString_Assign(&s->key,v);}
U0 RestCaller_urlEscape(MCString *out,MCString *v) {MCString_Init(out);I64 i;U8 c,*hex="0123456789abcdef";for(i=0;i<v->size;i++){c=v->data[i];if(!c)break;if((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='-' || c=='_' || c=='.' || c=='~')MCString_AppendChar017(out,c);else if(c==' ')MCString_AppendChar017(out,'+');else{MCString_AppendChar017(out,'%');MCString_AppendChar017(out,hex[c>>4]);MCString_AppendChar017(out,hex[c&15]);}}}
Bool RestCaller_call(RestCaller *s,I32 type,I32 interrupt,MCString *path,MCString *body,RestCallTagData *tag) {RestCallerObject obj;RestCallerObject_Init(&obj,type,interrupt,s,MCString_CStr(path),MCString_CStr(body),NULL,NULL,tag,0);Bool ok=FALSE;if((s->makeRequest!=NULL))ok=s->makeRequest(s->ctx,&obj);RestCallerObject_Destroy(&obj);return ok;}
