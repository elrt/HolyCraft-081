// Batch022: network/mco/CurlRestRequestJob; explicit host ABI, see docs/BATCH022.md.
U0 MC022_CurlRunHook(Job *s) {CurlRestRequestJob_run(s);}U0 MC022_CurlStopHook(Job *s) {CurlRestRequestJob_stop(s);}U0 MC022_CurlFinishHook(Job *s) {CurlRestRequestJob_finish(s);}
U0 CurlRestRequestJob_Init(RestRequestJob *s,RestService *service,I32 type,MCRestBackend022 *backend) {RestRequestJob_Init(s,service,type);s->backend=backend;s->runFn=&MC022_CurlRunHook;s->stopFn=&MC022_CurlStopHook;s->finishFn=&MC022_CurlFinishHook;}
Bool CurlRestRequestJob_isRunning(RestRequestJob *s) {return AndroidRestRequestJob_isRunning(s);}
U0 CurlRestRequestJob_onRequestComplete(RestRequestJob *s,I32 code,MCString *data) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));s->httpCode=code;MCString_Assign(&s->response,data);s->completed=TRUE;MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));}
U0 CurlRestRequestJob_stop(RestRequestJob *s) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));Job_trySetStatus(s,JS_STOPPED);s->started=FALSE;MCThread_Check(pthread_cond_broadcast(MC_CondAddress(&s->ready)));MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));}
U0 CurlRestRequestJob_run(RestRequestJob *s) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));if(Job_getStatus(s)==JS_STOPPED){MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));return;}s->started=TRUE;Job_trySetStatus(s,JS_STARTED);MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));MCString url,cookie,data;MC022_Join(&url,&s->service->serviceURL,&s->url);RestService_getCookieDataAsString(s->service,&cookie);MCString_Init(&data);MCString empty;MCString_Init(&empty);MCString *body=&empty;if(s->requestType==RRT_POST || s->requestType==RRT_PUT)body=&s->body;I32 code=-1;Bool ok=FALSE;if(s->backend && (s->backend->execute!=NULL))ok=s->backend->execute(s->backend->ctx,s,&url,RestRequestJob_Method(s->requestType),&cookie,body,&code,&data);if(!ok)code=-1;CurlRestRequestJob_onRequestComplete(s,code,&data);MCString_Destroy(&url);MCString_Destroy(&cookie);MCString_Destroy(&data);MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));s->started=FALSE;Job_trySetStatus(s,JS_FINISHED);MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));}
U0 CurlRestRequestJob_finish(RestRequestJob *s) {Bool stopped=Job_getStatus(s)==JS_STOPPED;if(stopped){MCString empty;MCString_Init(&empty);if(s->error!=NULL)s->error(s->callbackContext,TRUE,FALSE,0,&empty,&s->tag);return;}Bool network=s->httpCode<=0;if(stopped || network || s->httpCode>=300){if((s->error!=NULL))s->error(s->callbackContext,stopped,network,s->httpCode,&s->response,&s->tag);}else if((s->success!=NULL))s->success(s->callbackContext,s->httpCode,&s->response,&s->tag);}
