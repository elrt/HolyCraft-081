Bool MojangConnector_isMCOCreateServersEnabled(MojangConnector *s) {return s->status==STATUS_CONNECTED && s->serverCreationEnabled;}
Bool MojangConnector_isServiceEnabled(MojangConnector *s) {return s->serviceEnabled;}
U0 MojangConnector_setMCOCreateServersEnabled(MojangConnector *s,Bool v) {s->serverCreationEnabled=v;}
