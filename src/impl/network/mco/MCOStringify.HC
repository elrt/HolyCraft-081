// Batch 018. Match the pinned JsonCpp FastWriter for these fixed string objects.
// Its asCString() writer truncates string data at the first embedded NUL.
U0 MCO_AppendLiteral018(MCString *out,U8 *s){MCString_AppendBytes017(out,s,MC_StrLen(s));}
U0 MCO_AppendQuoted018(MCString *out,MCString *s){I64 i;U8 c;U8 *hex="0123456789ABCDEF";MCString_AppendChar017(out,'"');for(i=0;i<s->size;i++){c=s->data[i];if(!c)break;if(c=='"')MCO_AppendLiteral018(out,"\\\"");else if(c=='\\')MCO_AppendLiteral018(out,"\\\\");else if(c==8)MCO_AppendLiteral018(out,"\\b");else if(c==12)MCO_AppendLiteral018(out,"\\f");else if(c==10)MCO_AppendLiteral018(out,"\\n");else if(c==13)MCO_AppendLiteral018(out,"\\r");else if(c==9)MCO_AppendLiteral018(out,"\\t");else if(c<32){MCO_AppendLiteral018(out,"\\u00");MCString_AppendChar017(out,hex[c>>4]);MCString_AppendChar017(out,hex[c&15]);}else MCString_AppendChar017(out,c);}MCString_AppendChar017(out,'"');}
U0 MCOStringify_authenticate(MCString *out,MCString *username,MCString *password,MCString *version){MCString_FromC(out,"{\"agent\":{\"name\":\"mcpe\",\"version\":");MCO_AppendQuoted018(out,version);MCO_AppendLiteral018(out,"},\"password\":");MCO_AppendQuoted018(out,password);MCO_AppendLiteral018(out,",\"username\":");MCO_AppendQuoted018(out,username);MCO_AppendLiteral018(out,"}\n");}
U0 MCOStringify_refresh(MCString *out,MCString *accessToken,MCString *clientToken,MCString *ignored,MCString *version){MCString_FromC(out,"{\"accessToken\":");MCO_AppendQuoted018(out,accessToken);MCO_AppendLiteral018(out,",\"agent\":{\"name\":\"mcpe\",\"version\":");MCO_AppendQuoted018(out,version);MCO_AppendLiteral018(out,"},\"clientToken\":");MCO_AppendQuoted018(out,clientToken);MCO_AppendLiteral018(out,"}\n");}
U0 MCOStringify_signOut(MCString *out,MCString *accessToken,MCString *clientToken){MCString_FromC(out,"{\"accessToken\":");MCO_AppendQuoted018(out,accessToken);MCO_AppendLiteral018(out,",\"clientToken\":");MCO_AppendQuoted018(out,clientToken);MCO_AppendLiteral018(out,"}\n");}
