// Batch022: network/mco/MCOParser; explicit host ABI, see docs/BATCH022.md.
U0 MC022_JsonAssign(MCString *out,MC022Json *v,U8 *def) {MCString tmp;MC022_JsonText(&tmp,v,def);MCString_Assign(out,&tmp);MCString_Destroy(&tmp);}
U0 MCOParser_parseErrorMessage(MCString *src,MCString *reason,I32 *error) {MC022Json *v=MC022_JsonParse(src);*error=MC022_JsonInt(MC022_Get(v,"error"),0);MC022_JsonAssign(reason,MC022_Get(v,"reason"),"");MC022_JsonFree(v);}
Bool MCOParser_parseJoinWorld(MCString *src,MCString *ip,U16 *port,MCString *key) {MC022Json *v=MC022_JsonParse(src);if(!v)return FALSE;MC022_JsonAssign(ip,MC022_Get(v,"ip"),"127.0.0.1");*port=MC022_JsonInt(MC022_Get(v,"port"),25675);MC022_JsonAssign(key,MC022_Get(v,"key"),"");MC022_JsonFree(v);return TRUE;}
U0 MCOParser_parseMCOAccountValidSessionReturnValue(MCString *src,LoginInformation *out) {LoginInformation_Init(out);MC022Json *v=MC022_JsonParse(src);MC022_JsonAssign(&out->accessToken,MC022_Get(v,"accessToken"),"");MC022_JsonAssign(&out->clientId,MC022_Get(v,"clientToken"),"");MC022_JsonAssign(&out->profileId,MC022_Get(v,"selectedProfile"),"7");MC022_JsonAssign(&out->profileName,MC022_Get(v,"name"),"");MC022_JsonFree(v);}
U0 MCOParser_parseStatus(MCString *src,Bool *buy,Bool *create,Bool *service) {MC022Json *v=MC022_JsonParse(src);*buy=MC022_JsonBool(MC022_Get(v,"buyServerEnabled"));*create=MC022_JsonBool(MC022_Get(v,"createServerEnabled"));*service=MC022_JsonBool(MC022_Get(v,"serviceEnabled"));MC022_JsonFree(v);}
U0 MCOParser_freeServerList(MCVector *out) {I64 i;MCOServerListItem *items=out->data(MCOServerListItem*);for(i=0;i<out->size;i++)MCOServerListItem_Destroy(&items[i]);MCVector_Destroy(out);}
U0 MCOParser_parseServerList(MCString *src,MCVector *out) {MCVector_Init(out,sizeof(MCOServerListItem));MC022Json *v=MC022_JsonParse(src),*row,*arr,*value;I64 i,j,k;Bool dup;if(v && v->type==2)for(i=0;i<v->children.size;i++){row=v->children.data[i];if(row->type!=1)continue;I64 id=MC022_JsonInt(MC022_Get(row,"serverId"),-1);MCOServerListItem *items=out->data(MCOServerListItem*);dup=FALSE;for(j=0;j<out->size;j++)if(items[j].serverId==id)dup=TRUE;if(dup)continue;MCOServerListItem item;MCOServerListItem_Init(&item);item.serverId=id;MC022_JsonAssign(&item.worldName,MC022_Get(row,"name"),"wrong_name");MC022_JsonAssign(&item.ownerName,MC022_Get(row,"ownerName"),"wrong_owner_name");MC022_JsonAssign(&item.gamemodeName,MC022_Get(row,"type"),"wrong_game_type");item.open=MC022_JsonBool(MC022_Get(row,"open"));item.myWorld=MC022_JsonBool(MC022_Get(row,"myWorld"));item.maxNrPlayers=MC022_JsonInt(MC022_Get(row,"maxNrPlayers"),0);for(k=0;k<2;k++){arr=MC022_Get(row,"playerNames");if(k)arr=MC022_Get(row,"invited");if(arr && arr->type==2)for(j=0;j<arr->children.size;j++){value=arr->children.data[j];MCString text;MC022_JsonText(&text,value,"");if(k){MCOServerListItem_Invite(&item,&text);MCString_Destroy(&text);}else MCVector_Push(&item.playerNames,&text);}}MCVector_Push(out,&item);}MC022_JsonFree(v);}
