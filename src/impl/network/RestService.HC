I32 MC012_stringCompare(MCString *a,MCString *b){I64 n=a->size;I32 v;if(b->size<n)n=b->size;v=memcmp(a->data,b->data,n);if(v)return v;if(a->size<b->size)return -1;if(a->size>b->size)return 1;return 0;}
U0 RestService_Init(RestService *s,MCString *url){MCString_CopyInit(&s->serviceURL,url);MCVector_Init(&s->cookieData,sizeof(MCRestCookie012));}U0 RestService_freeCookieData(MCVector *v){I64 i;MCRestCookie012 *e;for(i=0;i<v->size;i++){e=MCVector_At(v,i);MCString_Destroy(&e->key);MCString_Destroy(&e->value);}MCVector_Destroy(v);}U0 RestService_Destroy(RestService *s){MCString_Destroy(&s->serviceURL);RestService_freeCookieData(&s->cookieData);}U0 RestService_getCookieData(RestService *s,MCVector *out){I64 i;MCRestCookie012 copy,*e;MCVector_Init(out,sizeof(MCRestCookie012));for(i=0;i<s->cookieData.size;i++){e=MCVector_At(&s->cookieData,i);MCString_CopyInit(&copy.key,&e->key);MCString_CopyInit(&copy.value,&e->value);MCVector_Push(out,&copy);}}
U0 RestService_getCookieDataAsString(RestService *s,MCString *out){I64 i,n=0,pos=0;MCRestCookie012 *e;U8 *buf;for(i=0;i<s->cookieData.size;i++){e=MCVector_At(&s->cookieData,i);n+=e->key.size+e->value.size+2;}buf=MC_Alloc(n+1);for(i=0;i<s->cookieData.size;i++){e=MCVector_At(&s->cookieData,i);memcpy(buf+pos,e->key.data,e->key.size);pos+=e->key.size;buf[pos++]='=';memcpy(buf+pos,e->value.data,e->value.size);pos+=e->value.size;buf[pos++]=';';}buf[n]=0;out->data=buf;out->size=n;}MCString *RestService_getServiceURL(RestService *s){return &s->serviceURL;}
U0 RestService_setCookieData(RestService *s,MCString *key,MCString *value){I64 i,j;MCRestCookie012 pair,*e,*dst,*prev;for(i=0;i<s->cookieData.size;i++){e=MCVector_At(&s->cookieData,i);if(!MC012_stringCompare(&e->key,key)){if(!value->size)MCString_Assign(&e->value,value);return;}if(MC012_stringCompare(&e->key,key)>0)break;}MCString_CopyInit(&pair.key,key);MCString_CopyInit(&pair.value,value);MCVector_Push(&s->cookieData,&pair);for(j=s->cookieData.size-1;j>i;j--){dst=MCVector_At(&s->cookieData,j);prev=MCVector_At(&s->cookieData,j-1);*dst=*prev;}dst=MCVector_At(&s->cookieData,i);*dst=pair;}
