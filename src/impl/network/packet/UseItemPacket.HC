// Batch 009: minecraftpe/impl/network/packet/UseItemPacket.cpp includes the header only.
U0 UseItemPacket_Init(UseItemPacket *s) { memset(s,0,sizeof(UseItemPacket));s->item.valid=TRUE;Packet_Init(s);s->packetId=PID_USE_ITEM_PACKET;s->writeFn=&UseItemPacket_write;s->readFn=&UseItemPacket_read; }
U0 UseItemPacket_InitValues(UseItemPacket *s,I32 eid,I32 x,I32 y,I32 z,I32 face,I32 id,I32 meta) { UseItemPacket_Init(s);s->entityID=eid;s->x=x;s->y=y;s->z=z;s->face=face;s->itemId=id;s->blockMeta=meta; }
U0 UseItemPacket_InitEntity(UseItemPacket *s,MCPacketEntity009 *e,I32 x,I32 y,I32 z,I32 face,F32 fx,F32 fy,F32 fz,MCPacketItem009 *it) { UseItemPacket_Init(s);s->faceX=fx;s->faceY=fy;s->faceZ=fz;s->x=x;s->y=y;s->z=z;s->face=face;if(it) { s->itemId=it->id;s->blockMeta=it->aux; }s->entityID=e->eid;s->posX=e->x;s->posY=e->y;s->posZ=e->z; }
U0 UseItemPacket_write(Packet *p,MCBitStream *stream) { UseItemPacket *s=p;MCBitStream_WriteU8(stream,PID_USE_ITEM_PACKET);MCBitStream_WriteI32(stream,s->x);MCBitStream_WriteI32(stream,s->y);MCBitStream_WriteI32(stream,s->z);MCBitStream_WriteI32(stream,s->face);MCBitStream_WriteU16(stream,s->itemId);MCBitStream_WriteU8(stream,s->blockMeta);MCBitStream_WriteI32(stream,s->entityID);MCBitStream_WriteF32(stream,s->faceX);MCBitStream_WriteF32(stream,s->faceY);MCBitStream_WriteF32(stream,s->faceZ);MCBitStream_WriteF32(stream,s->posX);MCBitStream_WriteF32(stream,s->posY);MCBitStream_WriteF32(stream,s->posZ); }
U0 UseItemPacket_read(Packet *p,MCBitStream *stream) { UseItemPacket *s=p;MCBitStream_ReadI32(stream,&s->x);MCBitStream_ReadI32(stream,&s->y);MCBitStream_ReadI32(stream,&s->z);MCBitStream_ReadI32(stream,&s->face);MCBitStream_ReadU16(stream,&s->itemId);MCBitStream_ReadU8(stream,&s->blockMeta);MCBitStream_ReadI32(stream,&s->entityID);MCBitStream_ReadF32(stream,&s->faceX);MCBitStream_ReadF32(stream,&s->faceY);MCBitStream_ReadF32(stream,&s->faceZ);MCBitStream_ReadF32(stream,&s->posX);MCBitStream_ReadF32(stream,&s->posY);MCBitStream_ReadF32(stream,&s->posZ);s->item.id=s->itemId;s->item.count=s->blockMeta;s->item.aux=s->itemId!=0 && s->blockMeta!=0;if(!MC009_packetRegistry.itemIsValid) { printf("UseItemPacket: missing item validity callback\n");exit(95); }s->item.valid=MC009_packetRegistry.itemIsValid(s->item.id,s->item.count,s->item.aux);if(!s->item.valid) { s->item.id=-1;s->item.count=-1;s->item.aux=-1; } }
