// Batch 009: minecraftpe/impl/network/packet/AddEntityPacket.cpp includes the header only.
U0 AddEntityPacket_Init(AddEntityPacket *s) { memset(s,0,sizeof(AddEntityPacket));Packet_Init(s);s->packetId=PID_ADD_ENTITY_PACKET;s->writeFn=&AddEntityPacket_write;s->readFn=&AddEntityPacket_read; }
U0 AddEntityPacket_InitEntity(AddEntityPacket *s,MCPacketEntity009 *e,I32 did) { AddEntityPacket_Init(s);s->eid=e->eid;s->x=e->x;s->y=e->y;s->z=e->z;s->did=did;s->type=e->type;if(did>0) { s->motionX=e->motionX;s->motionY=e->motionY;s->motionZ=e->motionZ; } }
I16 MC009_motion(F32 v) { if(v>3.9)v=3.9;else if(v<=-3.9)v=-3.9;return (v*8000)(I16); }
U0 AddEntityPacket_write(Packet *p,MCBitStream *stream) { AddEntityPacket *s=p;MCBitStream_WriteU8(stream,PID_ADD_ENTITY_PACKET);MCBitStream_WriteI32(stream,s->eid);MCBitStream_WriteU8(stream,s->type);MCBitStream_WriteF32(stream,s->x);MCBitStream_WriteF32(stream,s->y);MCBitStream_WriteF32(stream,s->z);MCBitStream_WriteI32(stream,s->did);if(s->did>0) { MCBitStream_WriteI16(stream,MC009_motion(s->motionX));MCBitStream_WriteI16(stream,MC009_motion(s->motionY));MCBitStream_WriteI16(stream,MC009_motion(s->motionZ)); } }
U0 AddEntityPacket_read(Packet *p,MCBitStream *stream) { AddEntityPacket *s=p;U8 type=0;I16 x=0,y=0,z=0;MCBitStream_ReadI32(stream,&s->eid);MCBitStream_ReadU8(stream,&type);s->type=type;MCBitStream_ReadF32(stream,&s->x);MCBitStream_ReadF32(stream,&s->y);MCBitStream_ReadF32(stream,&s->z);MCBitStream_ReadI32(stream,&s->did);if(s->did>0) { MCBitStream_ReadI16(stream,&x);MCBitStream_ReadI16(stream,&y);MCBitStream_ReadI16(stream,&z);s->motionX=x(F32)/8000.0;s->motionY=y(F32)/8000.0;s->motionZ=z(F32)/8000.0; } }
