// Batch 009: minecraftpe/impl/network/packet/SendInventoryPacket.cpp includes the header only.
U0 SendInventoryPacket_Init(SendInventoryPacket *s) { memset(s,0,sizeof(SendInventoryPacket));Packet_Init(s);s->packetId=PID_SEND_INVENTORY_PACKET;s->writeFn=&SendInventoryPacket_write;s->readFn=&SendInventoryPacket_read;s->destroyFn=&SendInventoryPacket_Destroy;MCVector_Init(&s->items,sizeof(MCPacketItem009)); }
