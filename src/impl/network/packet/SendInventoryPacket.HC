U0 SendInventoryPacket_write(Packet *p,MCBitStream *s) { SendInventoryPacket *t=p;I32 i;if(t->field_1C<0 || t->items.size<t->field_1C+4) { printf("SendInventory: invalid item count\n");exit(96); }MCBitStream_WriteU8(s,PID_SEND_INVENTORY_PACKET);MCBitStream_WriteI32(s,t->field_C);MCBitStream_WriteU8(s,t->field_1E);MCBitStream_WriteI16(s,t->field_1C);for(i=0;i<t->field_1C+4;i++)PacketUtil_writeItemInstance(MCVector_At(&t->items,i),s); }
U0 SendInventoryPacket_read(Packet *p,MCBitStream *s) { SendInventoryPacket *t=p;I32 i;MCPacketItem009 item;MCBitStream_ReadI32(s,&t->field_C);MCBitStream_ReadU8(s,&t->field_1E);MCBitStream_ReadI16(s,&t->field_1C);for(i=0;i<t->field_1C+4 && !s->failed;i++) { PacketUtil_readItemInstance(&item,s);if(!s->failed)MCVector_Push(&t->items,&item); } }
