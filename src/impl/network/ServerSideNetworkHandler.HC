
U0 ServerSideNetworkHandler_Init(ServerSideNetworkHandler *s,Minecraft *m,Level *l,RakNetInstance *net){memset(s,0,sizeof(ServerSideNetworkHandler));s->minecraft=m;s->level=l;s->network=net;MCVector_Init(&s->players,sizeof(MCNetPlayer027));}
U0 ServerSideNetworkHandler_Destroy(ServerSideNetworkHandler *s){MCVector_Destroy(&s->players);}
Player *ServerSideNetworkHandler_getPlayer(ServerSideNetworkHandler *s,U64 guid){I32 i;for(i=0;i<s->players.size;i++){MCNetPlayer027 *p=MCVector_At(&s->players,i);if(p->guid==guid)return p->player;}return NULL;}
Bool ServerSideNetworkHandler_admitVerifiedPlayer(ServerSideNetworkHandler *s,U64 guid,Player *p,Bool approved){if(!approved || !s->allowConnections || !p || ServerSideNetworkHandler_getPlayer(s,guid))return FALSE;MCNetPlayer027 row;row.guid=guid;row.player=p;MCVector_Push(&s->players,&row);return TRUE;}
Bool ServerSideNetworkHandler_allowIncomingPacketId(ServerSideNetworkHandler *s,U64 guid,I32 id){if(!s->level)return FALSE;Bool ok=id>=0 && id<=56 && (id<=3 || ServerSideNetworkHandler_getPlayer(s,guid)!=NULL);if(!ok && s->network!=NULL && s->network->host!=NULL && s->network->host->close!=NULL)s->network->host->close(s->network->host->context,guid);return ok;}
U0 ServerSideNetworkHandler_onDisconnect(ServerSideNetworkHandler *s,U64 guid){I32 i;for(i=0;i<s->players.size;i++){MCNetPlayer027 *p=MCVector_At(&s->players,i);if(p->guid==guid){Level_removeEntity(s->level,&p->player->mob.entity.body);MCVector_Erase(&s->players,i);return;}}}
Bool ServerSideNetworkHandler_tileChanged(ServerSideNetworkHandler *s,I32 x,I32 y,I32 z){if(!s->level || !Level_InBounds(x,y,z))return FALSE;UpdateBlockPacket p;UpdateBlockPacket_InitValues(&p,x,y,z,Level_getTile(s->level,x,y,z),Level_getData(s->level,x,y,z));return RakNetInstance_send(s->network,0,&p);}
