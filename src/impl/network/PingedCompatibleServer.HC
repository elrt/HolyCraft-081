// RakNet address handled by explicit value-copy callbacks, not a binary SystemAddress layout.
U0 PingedCompatibleServer_Init(PingedCompatibleServer *s,MCRakAddressHost012 *h){s->host=h;MCString_FromC(&s->name,"");s->address=h->createDefault(h->host);s->field_18=0;s->field_1C=0;}U0 PingedCompatibleServer_CopyInit(PingedCompatibleServer *s,PingedCompatibleServer *other){s->host=other->host;MCString_CopyInit(&s->name,&other->name);s->address=s->host->copyAddress(s->host->host,other->address);s->field_18=other->field_18;s->field_1C=other->field_1C;}U0 PingedCompatibleServer_Assign(PingedCompatibleServer *s,PingedCompatibleServer *other){U0 *address;if(s==other)return;address=other->host->copyAddress(other->host->host,other->address);s->host->destroyAddress(s->host->host,s->address);MCString_Assign(&s->name,&other->name);s->host=other->host;s->address=address;s->field_18=other->field_18;s->field_1C=other->field_1C;}U0 PingedCompatibleServer_Destroy(PingedCompatibleServer *s){MCString_Destroy(&s->name);s->host->destroyAddress(s->host->host,s->address);}
