
U0 MC027_ClientHandle(U0 *ctx,U64 guid,I32 id,Packet *p){ClientSideNetworkHandler *s=ctx;if(guid!=s->serverGuid)return;if(id==PID_SET_TIME_PACKET){SetTimePacket *a=p;s->timeToSet=a->timeValue;if(s->level){s->level->level->data.time=a->timeValue;s->level->daylightCycle=!a->stopTime;}}else if(id==PID_UPDATE_BLOCK_PACKET && s->level){UpdateBlockPacket *a=p;Level_setTileAndData(s->level->level,a->x,a->y,a->z,a->id,a->meta,2);}else if(id==PID_SET_HEALTH_PACKET && s->minecraft!=NULL && s->minecraft->player!=NULL){SetHealthPacket *a=p;s->minecraft->player->player.mob.entity.body.health=a->health;}}
U0 ClientSideNetworkHandler_Init(ClientSideNetworkHandler *s,Minecraft *mc,MultiPlayerLevel *level,RakNetInstance *net){memset(s,0,sizeof(ClientSideNetworkHandler));s->minecraft=mc;s->level=level;s->network=net;s->receiver.context=s;s->receiver.handle=&MC027_ClientHandle;ClientSideNetworkHandler_clearChunksLoaded(s);}
U0 ClientSideNetworkHandler_clearChunksLoaded(ClientSideNetworkHandler *s){I32 i;for(i=0;i<256;i++){s->chunksToSend[i].x=i>>4;s->chunksToSend[i].y=i&15;s->chunksLoaded[i]=FALSE;}/* Original method does not reset the counters. */}
U0 ClientSideNetworkHandler_arrangeRequestChunkOrder(ClientSideNetworkHandler *s,I32 cx,I32 cz){ClientSideNetworkHandler_clearChunksLoaded(s);I32 i,j;for(i=1;i<256;i++){j=i;while(j>0){IntPair *a=&s->chunksToSend[j-1],*b=&s->chunksToSend[j];I32 da=(a->x-cx)*(a->x-cx)+(a->y-cz)*(a->y-cz),db=(b->x-cx)*(b->x-cx)+(b->y-cz)*(b->y-cz);if(da<=db)break;IntPair t=*a;*a=*b;*b=t;j--;}}/* Equal-distance ties use stable order rather than unspecified std::sort ties. */}
Bool ClientSideNetworkHandler_isChunkLoaded(ClientSideNetworkHandler *s,I32 x,I32 z){return x<0 || x>15 || z<0 || z>15 || s->chunksLoaded[16*x+z];}
Bool ClientSideNetworkHandler_requestNextChunk(ClientSideNetworkHandler *s){if(s->requestedChunks>255)return FALSE;IntPair *a=&s->chunksToSend[s->requestedChunks];RequestChunkPacket p;RequestChunkPacket_InitValues(&p,a->x,a->y);if(!RakNetInstance_send(s->network,s->serverGuid,&p))return FALSE;s->requestedChunks++;s->loadedChunks++;return TRUE;}
