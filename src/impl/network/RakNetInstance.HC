
U0 RakNetInstance_Init(RakNetInstance *s,MCRakHost027 *h,MCPacketFactoryHost019 *f){memset(s,0,sizeof(RakNetInstance));s->host=h;s->factory=f;MCVector_Init(&s->serverList,sizeof(MCPong027));}
U0 RakNetInstance_disconnect(RakNetInstance *s){if(s->active && s->host && s->host->disconnect!=NULL)s->host->disconnect(s->host->context);s->active=FALSE;s->loggedIn=FALSE;}
U0 RakNetInstance_Destroy(RakNetInstance *s){RakNetInstance_disconnect(s);I32 i;for(i=0;i<s->serverList.size;i++){MCPong027 *p=MCVector_At(&s->serverList,i);MCString_Destroy(&p->address);MCString_Destroy(&p->name);}MCVector_Destroy(&s->serverList);}
Bool RakNetInstance_host(RakNetInstance *s,I32 port,I32 limit){RakNetInstance_disconnect(s);s->_isServer=TRUE;s->isPingingHostsMaybe=FALSE;if(!s->host || !s->host->start || port<0 || port>65535 || limit<1)return FALSE;s->active=s->host->start(s->host->context,TRUE,port,limit);return s->active;}
Bool RakNetInstance_connect(RakNetInstance *s,U8 *address,I32 port){RakNetInstance_disconnect(s);s->_isServer=FALSE;s->isPingingHostsMaybe=FALSE;if(!s->host || !s->host->start || !s->host->connect || port<1 || port>65535)return FALSE;if(!s->host->start(s->host->context,FALSE,0,4))return FALSE;s->active=TRUE;Bool ok=s->host->connect(s->host->context,address,port);if(!ok)RakNetInstance_disconnect(s);return ok;}
Bool RakNetInstance_send(RakNetInstance *s,U64 guid,Packet *p){if(!p || !p->writeFn || !s->active || !s->host || !s->host->send)return FALSE;MCBitStream bits;MCBitStream_Init(&bits);Packet_write(p,&bits);Bool ok=s->host->send(s->host->context,guid,bits.data,(bits.bits+7)/8,p->packetPriorityMaybe,p->packetReliabilityMaybe);MCBitStream_Destroy(&bits);return ok;}
Bool RakNetInstance_receive(RakNetInstance *s,U64 guid,U8 *bytes,I32 count,MCPacketReceiver *receiver){if(!bytes || count<1 || count>16777216 || !receiver || !receiver->handle)return FALSE;Packet *p=MinecraftPackets_createPacket(bytes[0],s->factory);if(!p)return FALSE;MCBitStream bits;MCBitStream_FromBytes(&bits,bytes,count);bits.readBit=8;Packet_read(p,&bits);Bool ok=!bits.failed;if(ok)Packet_handle(p,guid,receiver);Packet_Destroy(p);free(p);MCBitStream_Destroy(&bits);return ok;}
I32 RakNetInstance_handleUnconnectedPong(RakNetInstance *s,MCString *payload,MCString *address,U8 *prefix,I32 now,Bool first){I32 len=strlen(prefix);if(payload->size<len || memcmp(payload->data,prefix,len))return -1;I32 i;for(i=0;i<s->serverList.size;i++){MCPong027 *p=MCVector_At(&s->serverList,i);if(MC026_Same(&p->address,address)){p->time=now;MCString t;MCString_FromBytes(&t,payload->data+len,payload->size-len);MCString_Assign(&p->name,&t);MCString_Destroy(&t);return i;}}MCPong027 p;MCString_CopyInit(&p.address,address);MCString_FromBytes(&p.name,payload->data+len,payload->size-len);p.time=now;p.stale=FALSE;if(first)MCVector_Insert(&s->serverList,0,&p);else MCVector_Push(&s->serverList,&p);return s->serverList.size-1;}
