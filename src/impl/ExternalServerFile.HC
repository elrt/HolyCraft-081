// Batch 004. Source: minecraftpe/impl/ExternalServerFile.cpp
U0 ExternalServerFile_Init(ExternalServerFile *self,MCString *directory) { MCVector_Init(&self->servers,sizeof(ExternalServer));U8 *path=MC_Alloc(directory->size+22);snprintf(path,directory->size+22,"%s/external_servers.txt",MCString_CStr(directory));MCString_FromC(&self->fileName,path);free(path); }
ExternalServer *ExternalServerFile_Find(ExternalServerFile *self,I32 id) { I64 i;ExternalServer *s;for(i=0;i<self->servers.size;i++) { s=MCVector_At(&self->servers,i);if(s->id==id)return s; }return NULL; }
MCVector *ExternalServerFile_getExternalServers(ExternalServerFile *self) { return &self->servers; }
U0 ExternalServerFile_save(ExternalServerFile *self) { U0 *f=fopen(MCString_CStr(&self->fileName),"w");I64 i;ExternalServer *s;U8 *line;I64 cap;if(!f)return;for(i=0;i<self->servers.size;i++) { s=MCVector_At(&self->servers,i);cap=s->name.size+s->ip.size+50;line=MC_Alloc(cap);snprintf(line,cap,"%d:%s:%s:%d\n",s->id,MCString_CStr(&s->name),MCString_CStr(&s->ip),s->port);fputs(line,f);free(line); }fclose(f); }
U0 ExternalServerFile_addServer(ExternalServerFile *self,MCString *name,MCString *ip,I32 port) { I32 i;ExternalServer s;for(i=1;i<=59999 && ExternalServerFile_Find(self,i);i++) {}if(!ExternalServerFile_Find(self,i)) { ExternalServer_InitValues(&s,i,name,ip,port);MCVector_Push(&self->servers,&s); }ExternalServerFile_save(self); }
U0 ExternalServerFile_editServer(ExternalServerFile *self,I32 id,MCString *name,MCString *ip,I32 port) { ExternalServer *s=ExternalServerFile_Find(self,id);if(s) { MCString_Assign(&s->name,name);MCString_Assign(&s->ip,ip);s->port=port; }ExternalServerFile_save(self); }
U0 ExternalServerFile_removeSevrer(ExternalServerFile *self,I32 id) { I64 i;ExternalServer *s;for(i=0;i<self->servers.size;i++) { s=MCVector_At(&self->servers,i);if(s->id==id) { ExternalServer_Destroy(s);MCVector_Erase(&self->servers,i);break; } }ExternalServerFile_save(self); }
U0 ExternalServerFile_load(ExternalServerFile *self) { U0 *f=fopen(MCString_CStr(&self->fileName),"r");U8 line[128];MCString text,*part;MCVector pieces;ExternalServer s;I32 id,port;I64 i,end;if(!f)return;while(fgets(line,128,f)) { if(MC_StrLen(line)<=2)continue;MCString_FromC(&text,line);MCStringVector_Init(&pieces);splitString(&text,':',&pieces);MCString_Destroy(&text);for(i=0;i<pieces.size;i++) { part=MCVector_At(&pieces,i);end=part->size;while(end>0 && (part->data[end-1]==' ' || part->data[end-1]=='\n' || part->data[end-1]=='\r' || part->data[end-1]=='\t'))end--;part->size=end;part->data[end]=0;if(end==0)break; }if(i==4) { part=MCVector_At(&pieces,0);id=strtol(MCString_CStr(part),NULL,0);part=MCVector_At(&pieces,3);port=strtol(MCString_CStr(part),NULL,0);if(id && port && !ExternalServerFile_Find(self,id)) { ExternalServer_InitValues(&s,id,MCVector_At(&pieces,1),MCVector_At(&pieces,2),port);MCVector_Push(&self->servers,&s); } }MCStringVector_Destroy(&pieces); }fclose(f); }
U0 ExternalServerFile_Destroy(ExternalServerFile *self) { I64 i;for(i=0;i<self->servers.size;i++)ExternalServer_Destroy(MCVector_At(&self->servers,i));MCVector_Destroy(&self->servers);MCString_Destroy(&self->fileName); }

