U0 PerfTimer_Init() { MCStringVector_Init(&PerfTimer_paths);MCVector_Init(&PerfTimer_startTimes,sizeof(F64));MCVector_Init(&PerfTimer_times,sizeof(PerfTimerEntry));MCString_Init(&PerfTimer_path); }
PerfTimerEntry *PerfTimer_Find(MCString *key) { I64 i;PerfTimerEntry *e;for(i=0;i<PerfTimer_times.size;i++) { e=MCVector_At(&PerfTimer_times,i);if(MCString_Equal(&e->key,key))return e; }return NULL; }
