U0 PerfTimer_Destroy() { PerfTimer_reset();MCVector_Destroy(&PerfTimer_times);MCStringVector_Destroy(&PerfTimer_paths);MCVector_Destroy(&PerfTimer_startTimes);MCString_Destroy(&PerfTimer_path); }
U0 PerfTimer_push(MCString *name) { if(!PerfTimer_enabled)return;I64 n=PerfTimer_path.size+name->size;U8 *s=MC_Alloc(n+2);I64 pos=PerfTimer_path.size;if(pos)memcpy(s,PerfTimer_path.data,pos);if(pos)s[pos++]='.';if(name->size)memcpy(s+pos,name->data,name->size);s[pos+name->size]=0;MCString_Destroy(&PerfTimer_path);MCString_FromC(&PerfTimer_path,s);free(s);MCStringVector_Push(&PerfTimer_paths,&PerfTimer_path);F64 now=getTimeS();MCVector_Push(&PerfTimer_startTimes,&now); }
U0 PerfTimer_pop() { if(!PerfTimer_enabled)return;if(PerfTimer_startTimes.size==0)exit(85);F64 *start=MCVector_At(&PerfTimer_startTimes,PerfTimer_startTimes.size-1);F32 elapsed=getTimeS()-*start;MCString *last=MCVector_At(&PerfTimer_paths,PerfTimer_paths.size-1);MCString_Destroy(last);PerfTimer_paths.size--;PerfTimer_startTimes.size--;PerfTimerEntry *e=PerfTimer_Find(&PerfTimer_path),entry;if(e)e->value+=elapsed;else { MCString_CopyInit(&entry.key,&PerfTimer_path);entry.value=elapsed;I64 position=0;PerfTimerEntry *next;while(position<PerfTimer_times.size) { next=MCVector_At(&PerfTimer_times,position);if(MCString_Compare(&next->key,&entry.key)>0)break;position++; }MCVector_Insert(&PerfTimer_times,position,&entry); }if(PerfTimer_paths.size)MCString_Assign(&PerfTimer_path,MCVector_At(&PerfTimer_paths,PerfTimer_paths.size-1));else MCString_Destroy(&PerfTimer_path); }
U0 PerfTimer_popPush(MCString *name) { PerfTimer_pop();PerfTimer_push(name); }
I32 PerfTimerResult_getColor(PerfTimerResult *self) { I32 hash=0;I64 i;I8 c;for(i=0;i<self->sectionName.size;i++) { c=self->sectionName.data[i];hash=31*hash+c; }return (hash&0xAAAAAA)+4473924; }
Bool PerfTimerResult_less(PerfTimerResult *self,PerfTimerResult *other) { if(self->field_0==other->field_0)return MCString_Compare(&self->sectionName,&other->sectionName)!=0;return self->field_0>other->field_0; }
U0 PerfTimerResultVector_Destroy(MCVector *v) { I64 i;PerfTimerResult *r;for(i=0;i<v->size;i++) { r=MCVector_At(v,i);MCString_Destroy(&r->sectionName); }MCVector_Destroy(v); }
Bool PerfTimer_IsChild(MCString *key,MCString *prefix) { I64 i;if(key->size<=prefix->size || (prefix->size && memcmp(key->data,prefix->data,prefix->size)!=0))return FALSE;for(i=prefix->size+1;i<key->size;i++)if(key->data[i]=='.')return FALSE;return TRUE; }
U0 PerfTimer_getLog(MCString *name,MCVector *out) { MCVector_Init(out,sizeof(PerfTimerResult));if(!PerfTimer_enabled)return;MCString root,prefix;MCString_FromC(&root,"root");PerfTimerEntry *e=PerfTimer_Find(&root);F32 rootTime=0,section=-1,sum=0,total,percent;I64 i,j;PerfTimerResult r,*a,*b,temp;if(e)rootTime=e->value;e=PerfTimer_Find(name);if(e)section=e->value;MCString_CopyInit(&prefix,name);if(prefix.size) { U8 *s=MC_Alloc(prefix.size+2);memcpy(s,prefix.data,prefix.size);s[prefix.size]='.';s[prefix.size+1]=0;MCString_Destroy(&prefix);MCString_FromC(&prefix,s);free(s); }for(i=0;i<PerfTimer_times.size;i++) { e=MCVector_At(&PerfTimer_times,i);if(PerfTimer_IsChild(&e->key,&prefix))sum+=e->value; }total=sum;if(total<section)total=section;if(rootTime<total)rootTime=total;for(i=0;i<PerfTimer_times.size;i++) { e=MCVector_At(&PerfTimer_times,i);if(PerfTimer_IsChild(&e->key,&prefix)) { percent=e->value*100.0;r.field_0=percent/total;r.field_4=percent/rootTime;MCString_FromBytes(&r.sectionName,e->key.data+prefix.size,e->key.size-prefix.size);MCVector_Push(out,&r); }e->value*=0.999; }if(total>sum) { r.field_0=(total-sum)*100/total;r.field_4=(total-sum)*100/rootTime;MCString_FromC(&r.sectionName,"unspecified");MCVector_Push(out,&r); }for(i=1;i<out->size;i++) { j=i;while(j>0) { a=MCVector_At(out,j);b=MCVector_At(out,j-1);if(!PerfTimerResult_less(a,b))break;temp=*a;*a=*b;*b=temp;j--; } }r.field_0=100;r.field_4=total*100/rootTime;MCString_CopyInit(&r.sectionName,name);MCVector_Insert(out,0,&r);MCString_Destroy(&root);MCString_Destroy(&prefix); }

