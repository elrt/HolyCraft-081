// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 RenderChunk_setPos(RenderChunk *s,I32 x,I32 y,I32 z){if(s->x==x && s->y==y && s->z==z)return;s->x=x;s->y=y;s->z=z;s->blockX=x+s->size/2;s->blockY=y+s->size/2;s->blockZ=z+s->size/2;MC023_Shape(&s->bounds,x-1,y,z-1,x+s->size+1,y+s->size+2,z+s->size+1);s->dirty=TRUE;s->built=s->frustum=FALSE;I32 i;for(i=0;i<4;i++)s->skip[i]=TRUE;}
U0 RenderChunk_Init(RenderChunk *s,MCWorld024 *w,MCGeometry024 *host,I32 x,I32 y,I32 z,I32 size,I32 lists){memset(s,0,sizeof(RenderChunk));s->world=w;s->host=host;s->size=size;s->renderLists=lists;s->x=-999;I32 i;for(i=0;i<4;i++)Tesselator_Init(&s->layers[i],host);RenderChunk_setPos(s,x,y,z);}
U0 RenderChunk_Destroy(RenderChunk *s){I32 i;for(i=0;i<4;i++)Tesselator_Destroy(&s->layers[i]);}
F32 RenderChunk_distanceToSqr(RenderChunk *s,F32 x,F32 y,F32 z){x-=s->blockX;y-=s->blockY;z-=s->blockZ;return x*x+y*y+z*z;}
F32 RenderChunk_squishedDistanceToSqr(RenderChunk *s,F32 x,F32 y,F32 z){x-=s->blockX;y=(y-s->blockY)*2;z-=s->blockZ;return x*x+(y+y)+z*z;}
I32 RenderChunk_getList(RenderChunk *s,I32 layer){if(layer<0 || layer>3 || !s->frustum || s->skip[layer])return -1;return s->renderLists+layer;}
Bool RenderChunk_rebuild(RenderChunk *s){if(!s->dirty)return TRUE;if(!s->host || s->host->tile==NULL || s->host->layer==NULL)return FALSE;I32 l,x,y,z,id,layer;Bool later;for(l=0;l<4;l++){s->skip[l]=TRUE;Tesselator *t=&s->layers[l];Tesselator_begin(t,7);Tesselator_offset(t,-s->x,-s->y,-s->z);later=FALSE;for(y=s->y;y<s->y+s->size;y++)for(z=s->z;z<s->z+s->size;z++)for(x=s->x;x<s->x+s->size;x++){id=MC023_Tile(s->world->w,x,y,z);if(!id)continue;layer=s->host->layer(s->host->ctx,id);if(layer!=l){later=TRUE;continue;}if(s->host->tile(s->host->ctx,id,x,y,z,t))s->skip[l]=FALSE;}Tesselator_end(t);if(!later){for(l++;l<4;l++)s->skip[l]=TRUE;break;}}s->built=TRUE;s->updates++;return TRUE;}
