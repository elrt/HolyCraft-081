// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 Textures_Init(Textures *s,MCTextureBackend024 *host){memset(s,0,sizeof(Textures));s->host=host;MCVector_Init(&s->entries,sizeof(MCTexture024));}
U0 Textures_bind(Textures *s,U32 id){if(s->current==id)return;s->current=id;if(id)s->changes++;if(s->host && s->host->bind!=NULL)s->host->bind(s->host->ctx,id);}
U32 Textures_loadTexture(Textures *s,U8 *name,Bool clamp){MCString n;MCString_FromC(&n,name);I32 i;for(i=0;i<s->entries.size;i++){MCTexture024 *e=MCVector_At(&s->entries,i);if(MCString_Equal(&e->name,&n)){MCString_Destroy(&n);if(!e->id && s->host && s->host->create!=NULL && s->host->upload!=NULL && e->image.format>=0 && e->image.format<=4){e->id=s->host->create(s->host->ctx);Textures_bind(s,e->id);if(!s->host->upload(s->host->ctx,e->id,&e->image,e->clamp)){if(s->host->remove!=NULL)s->host->remove(s->host->ctx,e->id);e->id=0;}}return e->id;}}if(!s->host || s->host->load==NULL || s->host->create==NULL || s->host->upload==NULL){MCString_Destroy(&n);return 0;}MCTexture024 v;memset(&v,0,sizeof(v));if(!s->host->load(s->host->ctx,&n,&v.image)){MCString_Destroy(&n);return 0;}v.name=n;v.clamp=clamp;if(v.image.format>=0 && v.image.format<=4){v.id=s->host->create(s->host->ctx);Textures_bind(s,v.id);if(!s->host->upload(s->host->ctx,v.id,&v.image,clamp)){if(s->host->remove!=NULL)s->host->remove(s->host->ctx,v.id);v.id=0;}}MCVector_Push(&s->entries,&v);return v.id;}
U0 Textures_clear(Textures *s,Bool all){I32 i;for(i=0;i<s->entries.size;i++){MCTexture024 *e=MCVector_At(&s->entries,i);if(e->id && s->host && s->host->remove!=NULL)s->host->remove(s->host->ctx,e->id);e->id=0;if(all){if(!e->image.borrowed)free(e->image.pixels);MCString_Destroy(&e->name);}}s->current=0;if(all)s->entries.size=0;}
U0 Textures_Destroy(Textures *s){Textures_clear(s,TRUE);MCVector_Destroy(&s->entries);}
I32 Textures_smoothBlend(I32 a,I32 b){I32 rgb=((a&0xFEFEFE)+(b&0xFEFEFE))(I32)>>1,alpha=((b>>24)+(a>>24))(I32)>>1;return rgb+(alpha<<24);}
I32 Textures_crispBlend(I32 a,I32 b){I32 v3=b>>24,v4=a>>24,v5=(a>>24)+(b>>24);if(v5)v5=255;else v3=1;if(!((a>>24)+(b>>24)))v4=v3;return (((b&255)*v3+v4*(a&255))(I32)/(v4+v3))|(v5<<24)|(((((b&0xff0000)>>16)*v3+v4*((a&0xff0000)>>16))(I32)/(v4+v3))<<16)|(((v3*((b&0xff00)>>8)+v4*((a&0xff00)>>8))(I32)/(v4+v3))<<8);}
