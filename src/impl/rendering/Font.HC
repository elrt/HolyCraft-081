// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 Font_Init(Font *s,U8 *atlas,I32 width,I32 height,U8 *glyphs){memset(s,0,sizeof(Font));s->lineHeight=10;s->glyphSizes=glyphs;I32 cp,col,row,c;if(!atlas || width!=128 || height!=128)return;for(cp=0;cp<256;cp++){col=7;for(;col>=0;col--){Bool found=FALSE;for(row=0;row<8;row++)if(atlas[4*((cp/16*8+row)*128+(cp%16*8+col))]){found=TRUE;break;}if(found)break;}if(cp==32)col=2;s->charWidths[cp]=col+2;s->charLength[cp]=col+2;}}
I32 Font_charWidth(Font *s,I32 cp,Bool unicode){if(cp==32)return 4;if(cp<0 || cp>65535)return 0;if(cp<=255 && !unicode)return s->charWidths[cp];if(s->glyphSizes && s->glyphSizes[cp])return ((s->glyphSizes[cp]&15)+1-(s->glyphSizes[cp]>>4))/2+1;return 0;}
I32 MC024_UTF8(U8 **p){U8 *s=*p;I32 c=*s++,n,min;if(c<128){*p=s;return c;}if(c>=194 && c<224){c&=31;n=1;min=128;}else if(c<240 && c>=224){c&=15;n=2;min=2048;}else if(c>=240 && c<=244){c&=7;n=3;min=65536;}else return -1;I32 i;for(i=0;i<n;i++){if((*s&192)!=128)return -1;c=(c<<6)|(*s++&63);}if(c<min || c>1114111 || (c>=55296 && c<=57343))return -1;*p=s;return c;}
Bool Font_containsUnicodeChar(U8 *text){U8 *p=text;I32 cp;while(*p){cp=MC024_UTF8(&p);if(cp<0)return FALSE;if(cp>255)return TRUE;}return FALSE;}
I32 Font_width(Font *s,U8 *text){Bool uni=Font_containsUnicodeChar(text);I32 cp,line=0,max=0;U8 *p=text;while(*p){cp=MC024_UTF8(&p);if(cp<0)break;if(cp==10){if(line>max)max=line;line=0;}else line+=Font_charWidth(s,cp,uni);}if(line>max)max=line;return max;}
F32 Font_getPixelLength(Font *s,U8 *text){F32 n=0;while(*text)n+=s->charLength[*text++];return n;}
F32 Font_buildChar(Font *s,Tesselator *t,I32 cp,F32 x,F32 y,Bool unicode){if(cp==32)return 4;if(cp<0 || cp>65535)return 0;F32 start=0,advance;if(unicode || cp>255){if(!s->glyphSizes)return 0;I32 g=s->glyphSizes[cp];start=g>>4;advance=((g&15)+1-start)*0.5+1;}else advance=s->charLength[cp];F32 u=(16*(cp&15))*0.0039062,v=(cp&240)*0.0039062,uu=(16*(cp&15)+15.99)*0.0039062,vv=((cp&240)+15.99)*0.0039062,xx=floor(x-start),xxx=floor(x-start+8);Tesselator_vertexUV(t,xx,y+8,0,u,vv);Tesselator_vertexUV(t,xxx,y+8,0,uu,vv);Tesselator_vertexUV(t,xxx,y,0,uu,v);Tesselator_vertexUV(t,xx,y,0,u,v);return advance;}
