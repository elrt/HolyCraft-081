
U0 LevelRenderer_Init(LevelRenderer *s,Level *l){memset(s,0,sizeof(LevelRenderer));s->level=l;MCVector_Init(&s->sections,sizeof(MCSection027));TileRenderer_Init(&s->tiles,l,NULL);}
U0 LevelRenderer_Destroy(LevelRenderer *s){I32 i;for(i=0;i<s->sections.size;i++){MCSection027 *p=MCVector_At(&s->sections,i);Tesselator_Destroy(&p->mesh);}MCVector_Destroy(&s->sections);}
Bool LevelRenderer_addSection(LevelRenderer *s,I32 x,I32 y,I32 z){if(x<0 || x>15 || y<0 || y>7 || z<0 || z>15)return FALSE;I32 i;for(i=0;i<s->sections.size;i++){MCSection027 *p=MCVector_At(&s->sections,i);if(p->x==x && p->y==y && p->z==z)return FALSE;}MCSection027 p;memset(&p,0,sizeof(p));p.x=x;p.y=y;p.z=z;p.dirty=TRUE;p.visible=TRUE;Tesselator_Init(&p.mesh,NULL);MCVector_Push(&s->sections,&p);s->totalLoaded=s->sections.size;return TRUE;}
U0 LevelRenderer_setDirty(LevelRenderer *s,I32 x,I32 y,I32 z,I32 xx,I32 yy,I32 zz){I32 i;for(i=0;i<s->sections.size;i++){MCSection027 *p=MCVector_At(&s->sections,i);if(p->x*16<=xx && p->x*16+15>=x && p->y*16<=yy && p->y*16+15>=y && p->z*16<=zz && p->z*16+15>=z)p->dirty=TRUE;}}
U0 LevelRenderer_setTilesDirty(LevelRenderer *s,I32 x,I32 y,I32 z,I32 xx,I32 yy,I32 zz){LevelRenderer_setDirty(s,x-1,y-1,z-1,xx+1,yy+1,zz+1);}
U0 LevelRenderer_tileChanged(LevelRenderer *s,I32 x,I32 y,I32 z){LevelRenderer_setDirty(s,x-1,y-1,z-1,x+1,y+1,z+1);}
I32 LevelRenderer_getLayerFeature(I32 layer,Bool fancy){if(layer==2)return 0xBE2;if(layer==1)return 0xBC0;if(layer==3 && fancy)return 0xBC0;return 0;}
I32 LevelRenderer_updateDirtyChunks(LevelRenderer *s,I32 budget){I32 i,done=0;for(i=0;i<s->sections.size && done<budget;i++){MCSection027 *p=MCVector_At(&s->sections,i);if(!p->dirty)continue;s->tiles.tess=&p->mesh;s->tiles.overflow=FALSE;p->unknown=0;Tesselator_begin(&p->mesh,7);I32 x,y,z;for(x=p->x*16;x<p->x*16+16;x++)for(z=p->z*16;z<p->z*16+16;z++)for(y=p->y*16;y<p->y*16+16;y++){I32 id=Level_getTile(s->level,x,y,z);if(!id)continue;if(!s->tiles.views[id] || (!TileRenderer_canRender(s->tiles.views[id]->kind) && s->tiles.views[id]->kind!=1 && s->tiles.views[id]->kind!=2 && s->tiles.views[id]->kind!=8)){p->unknown++;continue;}TileRenderer_tesselateInWorld(&s->tiles,x,y,z);}Tesselator_end(&p->mesh);p->overflow=s->tiles.overflow;p->dirty=FALSE;done++;}return done;}
Bool MC027_SectionVisible(MCSection027 *p,F32 *m){I32 side,corner;for(side=0;side<6;side++){Bool any=FALSE;for(corner=0;corner<8;corner++){F32 v[4],out[4];v[0]=p->x*16;v[1]=p->y*16;v[2]=p->z*16;v[3]=1;if(corner&1)v[0]+=16;if(corner&2)v[1]+=16;if(corner&4)v[2]+=16;MultiplyMatrixByVector4by4OpenGL_FLOAT(out,m,v);I32 axis=side/2;F32 dist=out[axis];if(side&1)dist=-dist;if(dist>=-out[3])any=TRUE;}if(!any)return FALSE;}return TRUE;}
U0 LevelRenderer_cullAndSort(LevelRenderer *s,F32 *matrix,Vec3 *camera){I32 i,j;s->frustrumClippedCnt=0;for(i=0;i<s->sections.size;i++){MCSection027 *p=MCVector_At(&s->sections,i);p->visible=MC027_SectionVisible(p,matrix);if(!p->visible)s->frustrumClippedCnt++;F32 dx=p->x*16+8-camera->x,dy=p->y*16+8-camera->y,dz=p->z*16+8-camera->z;p->distance=dx*dx+dy*dy+dz*dz;}for(i=1;i<s->sections.size;i++){j=i;while(j>0){MCSection027 *a=MCVector_At(&s->sections,j-1),*b=MCVector_At(&s->sections,j);if(a->distance<=b->distance)break;MCSection027 tmp=*a;*a=*b;*b=tmp;j--;}}}
I32 LevelRenderer_renderChunks(LevelRenderer *s,MCGeometry024 *h){s->totalRendered=0;s->unsupportedBlocks=0;I32 i;for(i=0;i<s->sections.size;i++){MCSection027 *p=MCVector_At(&s->sections,i);s->unsupportedBlocks+=p->unknown;if(!p->visible || !p->mesh.indices.size || p->overflow)continue;if(h && h->draw!=NULL){h->draw(h->ctx,p->mesh.vertices.data(MCVertex024*),p->mesh.vertices.size,p->mesh.indices.data(U16*),p->mesh.indices.size,p->mesh.mode);s->totalRendered++;}}return s->totalRendered;}
U0 LevelRenderer_tick(LevelRenderer *s){s->ticksElapsed++;}
