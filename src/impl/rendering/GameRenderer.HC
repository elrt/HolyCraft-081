
U0 GameRenderer_Init(GameRenderer *s,Minecraft *mc,LevelRenderer *r){memset(s,0,sizeof(GameRenderer));s->minecraft=mc;s->levelRenderer=r;s->field_4C=1;s->field_58=1;s->field_5C=1;s->health=20;HitResult_Init(&s->hit);}
F32 GameRenderer_getFov(GameRenderer *s,F32 part,Bool dynamic){F32 v=70;if(dynamic)v=(s->field_5C+(s->field_58-s->field_5C)*part)*70.0;if(s->underwater)v=60;if(s->health<=0){F32 a=1.0-(500.0/((s->deathTime+part)(F32)+500.0))(F32);v=v/((a+a)+1.0);}return (v+s->field_64)+(s->field_60-s->field_64)*part;}
U0 GameRenderer_tickFov(GameRenderer *s,F32 modifier){s->field_5C=s->field_58;s->field_58=s->field_58+(modifier-s->field_58)*0.5;}
U0 GameRenderer_zoomRegion(GameRenderer *s,F32 zoom,F32 x,F32 y){s->field_4C=zoom;s->field_50=x;s->field_54=y;}
U0 GameRenderer_unZoomRegion(GameRenderer *s){s->field_4C=1;}
Bool GameRenderer_setupCamera(GameRenderer *s,Vec3 *eye,Vec3 *target,I32 width,I32 height,F32 part){if(width<=0 || height<=0 || s->field_4C<=0)return FALSE;s->width=width;s->height=height;s->eye=*eye;s->target=*target;F32 fx=target->x-eye->x,fy=target->y-eye->y,fz=target->z-eye->z,len=sqrtf(fx*fx+fy*fy+fz*fz);if(len==0)return FALSE;fx/=len;fy/=len;fz/=len;F32 sx=-fz,sy=0,sz=fx;len=sqrtf(sx*sx+sz*sz);if(len==0)return FALSE;sx/=len;sz/=len;F32 ux=sz*fy,uy=sx*fz-sz*fx,uz=-sx*fy;/* f cross side yields source-style right-handed up. */ux=-ux;uy=-uy;uz=-uz;F32 *m=s->modelViewMat;memset(m,0,16*sizeof(F32));m[0]=sx;m[4]=sy;m[8]=sz;m[1]=ux;m[5]=uy;m[9]=uz;m[2]=-fx;m[6]=-fy;m[10]=-fz;m[12]=-(sx*eye->x+sy*eye->y+sz*eye->z);m[13]=-(ux*eye->x+uy*eye->y+uz*eye->z);m[14]=fx*eye->x+fy*eye->y+fz*eye->z;m[15]=1;F32 nearZ=0.05,farZ=512,aspect=width/(height(F32)),radians=GameRenderer_getFov(s,part,TRUE)*0.5*3.1416/180,cot=cos(radians)/sin(radians);F32 *p=s->projectionMat;memset(p,0,16*sizeof(F32));p[0]=cot/aspect*s->field_4C;p[5]=cot*s->field_4C;p[8]=s->field_50;p[9]=s->field_54;p[10]=-(farZ+nearZ)/(farZ-nearZ);p[11]=-1;p[14]=-2.0*nearZ*farZ/(farZ-nearZ);MultiplyMatrices4by4OpenGL_FLOAT(s->combined,p,m);return TRUE;}
Bool GameRenderer_pick(GameRenderer *s,Vec3 *end){if(!s->levelRenderer || !s->levelRenderer->level)return FALSE;Level *l=s->levelRenderer->level;HitResult_Init(&s->hit);F32 best=1.0e30;I32 minX=floorf(s->eye.x),maxX=floorf(end->x),minY=floorf(s->eye.y),maxY=floorf(end->y),minZ=floorf(s->eye.z),maxZ=floorf(end->z),q;if(minX>maxX){q=minX;minX=maxX;maxX=q;}if(minY>maxY){q=minY;minY=maxY;maxY=q;}if(minZ>maxZ){q=minZ;minZ=maxZ;maxZ=q;}if(maxX-minX>64 || maxY-minY>64 || maxZ-minZ>64)return FALSE;I32 x,y,z;for(x=minX;x<=maxX;x++)for(y=minY;y<=maxY;y++)for(z=minZ;z<=maxZ;z++){I32 id=Level_getTile(l,x,y,z);if(!id)continue;MCRenderTile027 *v=s->levelRenderer->tiles.views[id];if(!v)continue;AABB box;AABB_Init(&box,x+v->minX,y+v->minY,z+v->minZ,x+v->maxX,y+v->maxY,z+v->maxZ);HitResult hit;AABB_clip(&box,&s->eye,end,&hit);if(hit.hitType!=0)continue;F32 dx=hit.hitVec.x-s->eye.x,dy=hit.hitVec.y-s->eye.y,dz=hit.hitVec.z-s->eye.z,d=dx*dx+dy*dy+dz*dz;if(d<best){best=d;s->hit=hit;s->hit.x=x;s->hit.y=y;s->hit.z=z;}}return s->hit.hitType==0;}
I32 GameRenderer_renderLevel(GameRenderer *s,MCGeometry024 *backend){if(!s->levelRenderer)return 0;LevelRenderer_cullAndSort(s->levelRenderer,s->combined,&s->eye);return LevelRenderer_renderChunks(s->levelRenderer,backend);}
