U0 ChickenRenderer_Init(ChickenRenderer *s,MCMobRenderHost012 *h,U0 *model,F32 shadow){s->host=h;s->base=h->createBase(h->host,model,shadow);}U0 ChickenRenderer_Destroy(ChickenRenderer *s){s->host->destroyBase(s->host->host,s->base);}F32 ChickenRenderer_getBob(ChickenRenderer *s,F32 c8c,F32 c90,F32 c94,F32 c98,F32 pt){F32 a=c98+(c8c-c98)*pt,b=c94+(c90-c94)*pt;return (Mth_sin(a)+1.0)*b;}
