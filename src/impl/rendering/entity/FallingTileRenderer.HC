U0 FallingTileRenderer_Init(FallingTileRenderer *s,MCFallingRenderHost012 *h){s->host=h;s->tileRenderer=h->createTileRenderer(h->host);}U0 FallingTileRenderer_Destroy(FallingTileRenderer *s){s->host->destroyTileRenderer(s->host->host,s->tileRenderer);}U0 FallingTileRenderer_render(FallingTileRenderer *s,I32 id,F32 x,F32 y,F32 z){MCFallingRenderHost012 *h=s->host;U0 *tile;h->pushMatrix(h->host);h->translate(h->host,x,y,z);h->bindTexture(h->host,"terrain-atlas.tga");tile=h->tileByID(h->host,id);if(tile)h->renderTile(h->host,s->tileRenderer,tile,0,1);h->popMatrix(h->host);}
