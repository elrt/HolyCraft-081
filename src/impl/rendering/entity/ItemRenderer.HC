// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 ItemRenderer_Init(ItemRenderer *s,Tesselator *t,MCUI025 *ui,I32 seed){memset(s,0,sizeof(ItemRenderer));s->tesselator=t;s->ui=ui;Random random;Random_setSeed(&random,seed);I32 i;for(i=0;i<16;i++){F32 f=Random_nextFloat(&random);s->randomFloats[i]=(f+f)-1;}}
I32 ItemRenderer_getAtlasPos(ItemInstance *item){if(!item)return -1;I32 id=ItemInstance_getId(item);if(id<0 || id>406)return -1;I32 result=ItemRenderer_atlas025[id];if(result!=-2)return result;I32 base=-1;if(id==6)base=407;else if(id==17)base=423;else if(id==18)base=439;else if(id==24)base=455;else if(id==35)base=471;else if(id==44)base=487;else if(id==98)base=503;else if(id==155)base=519;else if(id==263)base=535;else if(id==325)base=551;else if(id==351)base=567;else if(id==383)base=583;if(base<0)return -1;return ItemRenderer_atlas025[base+(item->metadata&15)];}
U0 ItemRenderer_blit(Tesselator *t,F32 x,F32 y,F32 u,F32 v,F32 width,F32 height){Tesselator_begin(t,7);F32 vv=(v+height)*0.0039062,uu=(u+width)*0.0039062;Tesselator_vertexUV(t,x,y+height,0,u*0.0039062,vv);Tesselator_vertexUV(t,x+width,y+height,0,uu,vv);Tesselator_vertexUV(t,x+width,y,0,uu,v*0.0039062);Tesselator_vertexUV(t,x,y,0,u*0.0039062,v*0.0039062);Tesselator_end(t);}
U0 ItemRenderer_fillRect(Tesselator *t,F32 x,F32 y,F32 width,F32 height,I32 color){Tesselator_begin(t,7);Tesselator_color(t,(color>>16)&255,(color>>8)&255,color&255,255);Tesselator_vertex(t,x,y,0);Tesselator_vertex(t,x,y+height,0);Tesselator_vertex(t,x+width,y+height,0);Tesselator_vertex(t,x+width,y,0);Tesselator_end(t);}
F32 MC025_Color(F32 v){if(v<0)return 0;if(v>1)return 1;return v;}
U0 ItemRenderer_iconBlit(Tesselator *t,F32 x,F32 y,TextureUVCoordinateSet *uv,F32 width,F32 height,F32 brightness,F32 alpha,I32 tint,F32 scale){F32 r=brightness,g=brightness,b=brightness;if(tint!=-1){r=MC025_Color(((tint>>16)&255)/255.0*brightness);g=MC025_Color(((tint>>8)&255)/255.0*brightness);b=MC025_Color((tint&255)/255.0*brightness);}Tesselator_begin(t,7);Tesselator_color(t,r*255,g*255,b*255,alpha*255);F32 xx=(width*0.5)*(scale-1),yy=(height*0.5)*(scale-1);Tesselator_vertexUV(t,x-xx,y+height+yy,0,uv->minX,uv->maxY);Tesselator_vertexUV(t,x+width+xx,y+height+yy,0,uv->maxX,uv->maxY);Tesselator_vertexUV(t,x+width+xx,y-yy,0,uv->maxX,uv->minY);Tesselator_vertexUV(t,x-xx,y-yy,0,uv->minX,uv->minY);Tesselator_end(t);}
Bool ItemRenderer_guiAtlasUV(ItemInstance *item,TextureUVCoordinateSet *out){I32 atlas=ItemRenderer_getAtlasPos(item);if(atlas<0)return FALSE;F32 u,v,size;if(atlas>127){I32 n=atlas-128;size=0.03125;u=(n&31)*size;v=(n>>5)*size+0.84375;}else{size=0.09375;u=(atlas%10)*size;v=(atlas/10)*size;}out->minX=u;out->minY=v;out->maxX=u+size;out->maxY=v+size;return TRUE;}
U0 ItemRenderer_renderGuiItemDecorations(ItemRenderer *s,ItemInstance *item,F32 x,F32 y){if(!item || item->count<=0 || !ItemInstance_isDamaged(item) || !item->itemClass || item->itemClass->maxDamage<=0)return;I32 damage=item->metadata,max=item->itemClass->maxDamage;F32 width=floorf(13.5-(damage*13.0)/max);I32 green=floorf(255.5-(damage*255.0)/max),red=255-green;MC025_Rect(s->ui,x+2,y+13,x+15,y+14,0xff000000);MC025_Rect(s->ui,x+2,y+13,x+14,y+14,0xff000000|((red/4)<<16)|0x3f00);MC025_Rect(s->ui,x+2,y+13,x+2+width,y+14,0xff000000|(green<<8)|(red<<16));}
I32 ItemRenderer_stackCopies(I32 count){if(count>20)return 4;if(count>5)return 3;if(count>1)return 2;return 1;}
U0 ItemRenderer_billboard(ItemRenderer *s,TextureUVCoordinateSet *uv,I32 count){Tesselator *t=s->tesselator;Tesselator_begin(t,7);Tesselator_normal(t,0,0,1);I32 i,n=ItemRenderer_stackCopies(count);for(i=0;i<n;i++){Tesselator_vertexUV(t,-0.5,-0.25,0,uv->minX,uv->maxY);Tesselator_vertexUV(t,0.5,-0.25,0,uv->maxX,uv->maxY);Tesselator_vertexUV(t,0.5,0.75,0,uv->maxX,uv->minY);Tesselator_vertexUV(t,-0.5,0.75,0,uv->minX,uv->minY);if(i+1<n)Tesselator_offset(t,s->randomFloats[(i+1)*3]*0.3,s->randomFloats[(i+1)*3+1]*0.3,s->randomFloats[(i+1)*3+2]*0.3);}Tesselator_end(t);Tesselator_offset(t,0,0,0);}
