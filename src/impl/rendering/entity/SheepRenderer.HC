U0 SheepRenderer_Init(SheepRenderer *s,MCMobRenderHost012 *h,U0 *furred,U0 *sheared,F32 shadow){s->host=h;s->base=h->createBase(h->host,furred,shadow);s->sheared=sheared;s->furred=furred;}U0 SheepRenderer_Destroy(SheepRenderer *s){MCMobRenderHost012 *h=s->host;h->setModel(h->host,s->base,NULL);if(s->furred)h->destroyModel(h->host,s->furred);s->furred=NULL;if(s->sheared)h->destroyModel(h->host,s->sheared);s->sheared=NULL;h->destroyBase(h->host,s->base);}U0 SheepRenderer_render(SheepRenderer *s,U0 *entity,Bool sheared,F32 x,F32 y,F32 z,F32 yaw,F32 pt){MCMobRenderHost012 *h=s->host;if(sheared)h->setModel(h->host,s->base,s->sheared);else h->setModel(h->host,s->base,s->furred);h->renderBase(h->host,s->base,entity,x,y,z,yaw,pt);}I32 SheepRenderer_prepareArmor(SheepRenderer *s,I32 slot,F32 pt){return -1;}
