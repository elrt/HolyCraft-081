// Inline implementation in PigRenderer.hpp.
U0 PigRenderer_Init(PigRenderer *s,MCMobRenderHost012 *h,U0 *model,F32 shadow){U0 *armor;s->host=h;s->base=h->createBase(h->host,model,shadow);armor=h->createPigArmor(h->host,0.5);h->setArmor(h->host,s->base,armor);}U0 PigRenderer_Destroy(PigRenderer *s){MCMobRenderHost012 *h=s->host;U0 *armor=h->getArmor(h->host,s->base);if(armor)h->destroyModel(h->host,armor);h->destroyBase(h->host,s->base);}I32 PigRenderer_prepareArmor(PigRenderer *s,Bool saddle,I32 slot,F32 pt){if(!saddle || slot>0)return -1;s->host->bindTexture(s->host->host,s->base,"mob/saddle.png");return 1;}
