// Inline implementation in SpiderRenderer.hpp.
U0 SpiderRenderer_Init(SpiderRenderer *s,MCMobRenderHost012 *h,U0 *model,F32 shadow){s->host=h;s->base=h->createBase(h->host,model,shadow);s->eyes=h->createSpiderEyes(h->host);h->setArmor(h->host,s->base,s->eyes);}U0 SpiderRenderer_Destroy(SpiderRenderer *s){MCMobRenderHost012 *h=s->host;h->destroyModel(h->host,s->eyes);h->destroyBase(h->host,s->base);}I32 SpiderRenderer_prepareArmor(SpiderRenderer *s,I32 slot){MCMobRenderHost012 *h=s->host;if(slot)return -1;h->bindTexture(h->host,s->base,"mob/spider_eyes.png");h->rgba(h->host,1,1,1,1);return 1;}F32 SpiderRenderer_getFlipDegrees(SpiderRenderer *s){return 180;}U0 SpiderRenderer_scale(SpiderRenderer *s,F32 value){s->host->scale(s->host->host,value,value,value);}
