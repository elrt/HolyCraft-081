U0 TntRenderer_Init(TntRenderer *s,MCTntRenderHost012 *h){s->host=h;s->tileRenderer=h->createTileRenderer(h->host);}U0 TntRenderer_Destroy(TntRenderer *s){s->host->destroyTileRenderer(s->host->host,s->tileRenderer);}U0 TntRenderer_render(TntRenderer *s,I32 ticks,F32 x,F32 y,F32 z,F32 pt){MCTntRenderHost012 *h=s->host;F32 time=ticks-pt+1.0,v,sc,alpha;Bool fancy;h->pushMatrix(h->host);h->translate(h->host,x,y,z);if(time<10){v=1.0-time/10.0;if(v<0)v=0;else if(v>1)v=1;sc=(v*v)(F32)*(v*v)(F32)*0.3+1;h->scale(h->host,sc,sc,sc);}alpha=(1.0-((ticks-pt+1.0)(F32)/100.0)(F32))*0.8;h->rgba(h->host,1,1,1,alpha);if((ticks/5)&1){h->bindTexture(h->host,"terrain-atlas.tga");h->renderTnt(h->host,s->tileRenderer,0,1);}else{h->disable(h->host,0xde1);h->blendFunc(h->host,0x302,0x304);fancy=h->isFancy(h->host);if(fancy)h->disable(h->host,0xb50);h->renderTnt(h->host,s->tileRenderer,0,1);if(fancy)h->enable(h->host,0xb50);h->blendFunc(h->host,0x302,0x303);h->enable(h->host,0xde1);}h->rgba(h->host,1,1,1,1);h->popMatrix(h->host);}
