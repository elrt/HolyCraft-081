// Inline implementation in CreeperRenderer.hpp.
U0 CreeperRenderer_Init(CreeperRenderer *s,MCMobRenderHost012 *h,U0 *model,F32 shadow){s->host=h;s->base=h->createBase(h->host,model,shadow);}U0 CreeperRenderer_Destroy(CreeperRenderer *s){s->host->destroyBase(s->host->host,s->base);}I32 CreeperRenderer_getOverlayColor(CreeperRenderer *s,F32 swelling){I32 bit=(swelling*10.0)(I32)&1,v;if(!bit)return 0;v=((swelling*0.2)(F32)*255.0)(I32);if(v<0)v=0;else if(v>=255)v=255;return (v<<24)|0xffffff;}U0 CreeperRenderer_scale(CreeperRenderer *s,F32 swelling){F32 v=(Mth_sin(swelling*100.0)*swelling)(F32)*0.01+1.0,q,x,y;if(swelling<0)swelling=0;else if(swelling>1)swelling=1;q=(swelling*swelling)(F32)*(swelling*swelling)(F32);x=(q*0.4+1.0)*v;y=(q*0.1+1.0)/v;s->host->scale(s->host->host,x,y,x);}
