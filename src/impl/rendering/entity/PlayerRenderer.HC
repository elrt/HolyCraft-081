// Batch023: rendering/entity/PlayerRenderer; explicit simulation ABI, see docs/BATCH023.md.
U0 PlayerRenderer_Init(PlayerRenderer *s,MCG020 *g,U0 *model,U0 *inner,U0 *outer) {memset(s,0,sizeof(PlayerRenderer));s->g=g;s->model=model;s->armorInner=inner;s->armorOuter=outer;}
Bool PlayerRenderer_prepareArmor(PlayerRenderer *s,MCItemDef023 *item,I32 slot,Bool riding) {if(!item || !item->armor || item->armorMaterial<0 || item->armorMaterial>4 || slot<0 || slot>3)return FALSE;U8 *names[5]={"cloth","chain","iron","diamond","gold"};U8 path[80];I32 layer=1;if(slot==2)layer=2;snprintf(path,80,"armor/%s_%d.png",names[item->armorMaterial],layer);MCG020_Bind(s->g,path);U0 *model=s->armorOuter;if(slot==2)model=s->armorInner;if(s->g->modelOp!=NULL){s->g->modelOp(s->g->ctx,model,23,(slot==0)(F32),(slot==1 || slot==2)(F32),(slot==1)(F32),(slot==2 || slot==3)(F32),riding(F32),0.0(F32));}return TRUE;/* Model-op 23 is the explicit armor visibility/riding bridge. */}
U0 PlayerRenderer_renderName(PlayerRenderer *s,MCString *name,F32 x,F32 y,F32 z,F32 distanceSquared,Bool isCamera) {MCG020 *g=s->g;if(isCamera || distanceSquared>1024 || g->fontWidth==NULL || g->fontDraw==NULL)return;I32 width=g->fontWidth(g->ctx,name);MCG020_C(g,1);MCG020_C(g,3,x,y+1,z);MCG020_C(g,5,-s->cameraYaw,0,1,0);MCG020_C(g,5,s->cameraPitch,1,0,0);MCG020_C(g,4,-0.02666667,-0.02666667,0.02666667);MCG020_C(g,8,2896);MCG020_C(g,11,0);MCG020_C(g,8,2929);MCG020_C(g,7,3042);MCG020_C(g,12,770,771);MCG020_C(g,8,3553);MCG020_C(g,14,7);MCG020_C(g,6,0,0,0,0.25);MCG020_C(g,19,-width/2-1,-1,0);MCG020_C(g,19,-width/2-1,8,0);MCG020_C(g,19,width/2+1,8,0);MCG020_C(g,19,width/2+1,-1,0);MCG020_C(g,18);MCG020_C(g,7,3553);g->fontDraw(g->ctx,name,(-width/2)(F32),0.0(F32),553648127);MCG020_C(g,7,2929);MCG020_C(g,11,1);g->fontDraw(g->ctx,name,(-width/2)(F32),0.0(F32),-1);MCG020_C(g,7,2896);MCG020_C(g,8,3042);MCG020_C(g,6,1,1,1,1);MCG020_C(g,2);}
U0 PlayerRenderer_render(PlayerRenderer *s,MCRenderEntity020 *e,F32 x,F32 y,F32 z,F32 yaw,F32 partial) {if(s->g->mobRender!=NULL)s->g->mobRender(s->g->ctx,e,x(F32),y(F32),z(F32),yaw(F32),partial(F32));/* Skin/held items/sleep transforms require the full MobRenderer backend. */}
