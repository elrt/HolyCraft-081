// Batch023: rendering/entity/MinecartRenderer; explicit simulation ABI, see docs/BATCH023.md.
U0 MinecartRenderer_Init(MinecartRenderer *s,MCG020 *g,U0 *model) {s->g=g;s->model=model;}
U0 MinecartRenderer_jitter(I32 id,Vec3 *out) {I32 a=(493286711*id)(I32);U64 b=(a*a)(I32)(I64)*4392167121+a(I64)*98761;out->x=(((b>>16)&7)+0.5)*0.125*0.004-0.002;out->y=(((b>>20)&7)+0.5)*0.125*0.004-0.002;out->z=(((b>>24)&7)+0.5)*0.125*0.004-0.002;}
U0 MinecartRenderer_render(MinecartRenderer *s,I32 id,F32 x,F32 y,F32 z,F32 angle,F32 pitch,F32 hurt,F32 damage,I32 direction) {MCG020 *g=s->g;Vec3 d;MinecartRenderer_jitter(id,&d);MCG020_C(g,1);MCG020_C(g,3,d.x,d.y,d.z);MCG020_C(g,3,x,y,z);MCG020_C(g,5,180-angle,0,1,0);MCG020_C(g,5,-pitch,0,0,1);if(damage<0)damage=0;if(hurt>0)MCG020_C(g,5,hurt*Mth_sin(hurt)*damage*0.1*direction,1,0,0);MCG020_Bind(g,"entity/minecart.png");MCG020_C(g,4,-1,-1,1);if(g->modelDraw!=NULL)g->modelDraw(g->ctx,s->model,0.0625(F32),FALSE);MCG020_C(g,2);/* Rail interpolation/display-block rendering remain backend integration work. */}
