// Ported from minecraftpe/impl/rendering/entity/TripodCameraRenderer.cpp; host-facing representation, not C++ ABI.

U0 TripodCameraRenderer_Init(TripodCameraRenderer *s,MCG020 *g) {s->g=g;s->model=g->modelNew(g->ctx,3);g->modelOp(g->ctx,s->model,0,(-4)(F32),(-4)(F32),(-6)(F32),(8)(F32),(8)(F32),(10)(F32));g->modelOp(g->ctx,s->model,1,(0)(F32),(11)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));}
F32 TripodCameraRenderer_getFlashTime(MCRenderEntity020 *e,F32 t) {if(e->flash>7 || e->flash<0)return -1;return (e->flash-t)*0.125;}
U0 TripodCameraRenderer_render(TripodCameraRenderer *s,MCRenderEntity020 *e,F32 x,F32 y,F32 z,F32 angle,F32 t) {MCG020 *g=s->g;MCG020_C(g,1);MCG020_C(g,3,x,y,z);g->modelOp(g->ctx,s->model,2,(0.017453*(e->a.pitch*0.5+180))(F32),(-(0.017453*e->a.yaw))(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));MCG020_C(g,20,1,1,1);MCG020_Bind(g,"items-opaque.png");MCG020_C(g,14,0);g->crossTexture(g->ctx,(-0.5)(F32),(-0.5)(F32),(-0.5)(F32));MCG020_C(g,18,1);MCG020_Bind(g,"item/camera.png");g->modelDraw(g->ctx,s->model,(0.0625)(F32),FALSE);F32 flash=TripodCameraRenderer_getFlashTime(e,t);if(flash>=0){MCG020_C(g,6,1,1,1,sin(flash*6.283));MCG020_C(g,6,1,1,1,1);}if(e->selected){MCG020_C(g,8,0xDE1);MCG020_C(g,12,0x302,0x304);MCG020_C(g,6,0.5,0.5,0.5,0.5);g->modelDraw(g->ctx,s->model,(0.0625)(F32),TRUE);MCG020_C(g,6,1,1,1,1);MCG020_C(g,12,0x302,0x303);MCG020_C(g,7,0xDE1);}MCG020_C(g,2);}
U0 TripodCameraRenderer_Destroy(TripodCameraRenderer *s) {s->g->modelDelete(s->g->ctx,s->model);}
