U0 HumanoidMobRenderer_Init(HumanoidMobRenderer *s,MCG020 *g,U0 *model,F32 shadow) {s->g=g;s->hmodel=model;s->shadow=shadow;}
U0 HumanoidMobRenderer_renderHand(HumanoidMobRenderer *s) {MCG020 *g=s->g;g->modelOp(g->ctx,s->hmodel,5,(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0.0625)(F32));MCG020_C(g,9,0x8078);g->modelOp(g->ctx,s->hmodel,6,(0.0625)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));MCG020_C(g,10,0x8078);}
U0 HumanoidMobRenderer_render(HumanoidMobRenderer *s,MCRenderEntity020 *e,F32 x,F32 y,F32 z,F32 angle,F32 t) {MCG020 *g=s->g;if(e->carried)g->modelOp(g->ctx,s->hmodel,7,(1)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));g->modelOp(g->ctx,s->hmodel,8,(e->sneaking)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));g->mobRender(g->ctx,e->identity,(x)(F32),(y)(F32),(z)(F32),(angle)(F32),(t)(F32));g->modelOp(g->ctx,s->hmodel,7,(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));}
U0 HumanoidMobRenderer_additionalRendering(HumanoidMobRenderer *s,MCRenderEntity020 *e,F32 t) {MCG020 *g=s->g;MCItem020 *i=e->carried;if(!i || i->count<=0)return;MCG020_C(g,1);g->modelOp(g->ctx,s->hmodel,9,(0.0625)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));MCG020_C(g,3,-0.0625,0.4375,0.0625);if(i->hasTile && i->tileCanRender){MCG020_C(g,3,0,0.1875,-0.3125);MCG020_C(g,5,200,1,0,0);MCG020_C(g,5,45,0,1,0);MCG020_C(g,4,0.375,0.375,0.375);}else if(i->isBow){MCG020_C(g,3,0.2,0.125,-0.3875);MCG020_C(g,5,-180,1,0,0);MCG020_C(g,5,10,0,1,0);MCG020_C(g,4,0.625,0.625,0.625);MCG020_C(g,5,-100,1,0,0);MCG020_C(g,5,45,0,1,0);}else if(!i->handEquipped){MCG020_C(g,3,0.25,0.1875,-0.1875);MCG020_C(g,4,0.375,0.375,0.375);MCG020_C(g,5,60,0,0,1);MCG020_C(g,5,-90,1,0,0);MCG020_C(g,5,20,0,0,1);}else{MCG020_C(g,5,180,0,1,0);MCG020_C(g,3,0.1,0.265,0);MCG020_C(g,4,0.625,0.625,0.625);MCG020_C(g,5,80,1,0,0);MCG020_C(g,5,45,0,1,0);}g->heldRender(g->ctx,e->identity,i);MCG020_C(g,2);}
U0 HumanoidMobRenderer_Destroy(HumanoidMobRenderer *s) {}
