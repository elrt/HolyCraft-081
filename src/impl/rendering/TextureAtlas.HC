U0 TextureAtlas_Init(TextureAtlas *s,MCString *path){MCString_CopyInit(&s->path,path);MCVector_Init(&s->entries,sizeof(U0 *));}
U0 TextureAtlas_Destroy(TextureAtlas *s){I64 i;MCAtlasEntry015 *e;for(i=0;i<s->entries.size;i++){e=*(MCVector_At(&s->entries,i)(MCAtlasEntry015 **));MCString_Destroy(&e->key);TextureAtlasTextureItem_Destroy(&e->item);free(e);}MCVector_Destroy(&s->entries);MCString_Destroy(&s->path);}
U0 TextureAtlas_parseJSON(TextureAtlas *s,MCAtlasHost015 *h,U0 *json,TextureUVCoordinateSet *out){F32 a[6],dx,dy;I32 i;for(i=0;i<6;i++)a[i]=h->asFloat(h->host,h->at(h->host,json,i));dx=(a[2]-a[0])*0.002;dy=(a[3]-a[1])*0.002;out->width=a[4];out->height=a[5];out->minX=a[0]+dx;out->maxX=a[2]-dx;out->minY=a[1]+dy;out->maxY=a[3]-dy;}
TextureAtlasTextureItem *TextureAtlas_getTextureItem(TextureAtlas *s,MCString *name){I64 i;MCAtlasEntry015 *e;for(i=0;i<s->entries.size;i++){e=*(MCVector_At(&s->entries,i)(MCAtlasEntry015 **));if(MCString_Equal(&e->key,name))return &e->item;}e=MC_Alloc(sizeof(MCAtlasEntry015));MCString_CopyInit(&e->key,name);TextureAtlasTextureItem_Init(&e->item);MCVector_Push(&s->entries,&e);return &e->item;}
U0 TextureAtlas_load(TextureAtlas *s,MCAtlasHost015 *h){U0 *asset,*root,*node,*extras;I32 i,j;MCString name;MCVector uv;TextureUVCoordinateSet one,base;TextureAtlasTextureItem tmp,*slot;asset=h->readAsset(h->host,&s->path);root=h->parse(h->host,asset);if(root){for(i=0;i<h->size(h->host,root);i++){node=h->at(h->host,root,i);extras=h->field(h->host,node,"additonal_textures");MCVector_Init(&uv,sizeof(TextureUVCoordinateSet));for(j=0;j<h->size(h->host,extras);j++){TextureAtlas_parseJSON(s,h,h->at(h->host,extras,j),&one);MCVector_Push(&uv,&one);}h->asString(h->host,h->field(h->host,node,"name"),&name);TextureAtlas_parseJSON(s,h,h->field(h->host,node,"uv"),&base);TextureAtlasTextureItem_InitValues(&tmp,&name,&base,&uv);slot=TextureAtlas_getTextureItem(s,&name);TextureAtlasTextureItem_Assign(slot,&tmp);TextureAtlasTextureItem_Destroy(&tmp);MCString_Destroy(&name);MCVector_Destroy(&uv);}h->freeRoot(h->host,root);}h->freeAsset(h->host,asset);}
