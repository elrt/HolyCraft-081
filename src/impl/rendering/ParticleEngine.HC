// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 ParticleEngine_Init(ParticleEngine *s,MCParticleBackend024 *host){memset(s,0,sizeof(ParticleEngine));s->host=host;MCPtrVector_Init(&s->active);I32 i;for(i=0;i<16;i++)MCPtrVector_Init(&s->pool[i]);}
Particle *ParticleEngine_get(ParticleEngine *s,I32 type){if(type<0 || type>=16)return NULL;MCPtrVector *pool=&s->pool[type];if(!pool->size)return NULL;return pool->data[--pool->size];}
Bool ParticleEngine_add(ParticleEngine *s,Particle *p){if(!p || p->type<0 || p->type>=16)return FALSE;I32 i;for(i=0;i<s->active.size;i++)if(s->active.data[i]==p)return FALSE;MCPtrVector_Push(&s->active,p);return TRUE;}
Particle *ParticleEngine_instance(ParticleEngine *s,I32 type,F32 x,F32 y,F32 z,F32 mx,F32 my,F32 mz,I32 data){Particle *p=ParticleEngine_get(s,type);if(!p && type>=0 && type<16 && s->host!=NULL && s->host->create!=NULL)p=s->host->create(s->host->ctx,type);if(!p)return NULL;Particle_start(p,x,y,z,mx,my,mz,data);if(!ParticleEngine_add(s,p))return NULL;return p;}
U0 ParticleEngine_tick(ParticleEngine *s){I32 i,j;for(i=0;i<s->active.size;i++){Particle *p=s->active.data[i];if(p->tickFn!=NULL)p->tickFn(p);else Particle_tick(p);if(p->dead){MCPtrVector_Push(&s->pool[p->type],p);for(j=i+1;j<s->active.size;j++)s->active.data[j-1]=s->active.data[j];s->active.size--;i--;}}}
U0 ParticleEngine_clear(ParticleEngine *s){I32 i,j;for(i=0;i<s->active.size;i++)if(s->host && s->host->destroy!=NULL)s->host->destroy(s->host->ctx,s->active.data[i]);s->active.size=0;for(i=0;i<16;i++){for(j=0;j<s->pool[i].size;j++)if(s->host && s->host->destroy!=NULL)s->host->destroy(s->host->ctx,s->pool[i].data[j]);s->pool[i].size=0;}}
U0 ParticleEngine_Destroy(ParticleEngine *s){ParticleEngine_clear(s);MCPtrVector_Destroy(&s->active);I32 i;for(i=0;i<16;i++)MCPtrVector_Destroy(&s->pool[i]);}
