// Ported from minecraftpe/impl/rendering/TileEntityRenderDispatcher.cpp; host-facing representation, not C++ ABI.

TileEntityRenderDispatcher *TileEntityRenderDispatcher_instance020=NULL;
U0 TileEntityRenderDispatcher_Init(TileEntityRenderDispatcher *s,MCDispatchHost020 *h) {memset(s,0,sizeof(TileEntityRenderDispatcher));s->h=h;s->renderers[1]=h->newRenderer(h->ctx,1,TRUE);s->renderers[2]=h->newRenderer(h->ctx,2,TRUE);I32 i;for(i=1;i<3;i++){MCRenderer020 *r=s->renderers[i];if(r)r->initFn(r->object,s);}}
U0 TileEntityRenderDispatcher_Destroy(TileEntityRenderDispatcher *s) {I32 i,j;for(i=0;i<3;i++){MCRenderer020 *r=s->renderers[i];if(r){for(j=i+1;j<3;j++)if(s->renderers[j]==r)s->renderers[j]=NULL;r->destroy(r->object);s->renderers[i]=NULL;}}}
U0 TileEntityRenderDispatcher_destroy() {if(TileEntityRenderDispatcher_instance020){TileEntityRenderDispatcher_Destroy(TileEntityRenderDispatcher_instance020);free(TileEntityRenderDispatcher_instance020);TileEntityRenderDispatcher_instance020=NULL;}}
U0 * TileEntityRenderDispatcher_getInstance(MCDispatchHost020 *h) {if(!TileEntityRenderDispatcher_instance020){TileEntityRenderDispatcher_instance020=MC_Alloc(sizeof(TileEntityRenderDispatcher));TileEntityRenderDispatcher_Init(TileEntityRenderDispatcher_instance020,h);}return TileEntityRenderDispatcher_instance020;}
F32 TileEntityRenderDispatcher_distanceToSqr(TileEntityRenderDispatcher *s,F32 x,F32 y,F32 z) {return ((y-s->camY)*(y-s->camY)+(x-s->camX)*(x-s->camX))+(z-s->camZ)*(z-s->camZ);}
U0 * TileEntityRenderDispatcher_getFont(TileEntityRenderDispatcher *s) {return s->font;}
MCRenderer020 * TileEntityRenderDispatcher_getRendererId(TileEntityRenderDispatcher *s,I32 id) {if(id<0 || id>=3)return NULL;return s->renderers[id];}
MCRenderer020 * TileEntityRenderDispatcher_getRenderer(TileEntityRenderDispatcher *s,MCRenderTile020 *e) {return TileEntityRenderDispatcher_getRendererId(s,e->renderId);}
U0 TileEntityRenderDispatcher_setLevel(TileEntityRenderDispatcher *s,U0 *level) {s->level=level;I32 i;for(i=0;i<3;i++){MCRenderer020 *r=s->renderers[i];if(r)r->newLevel(r->object,level);}}
U0 TileEntityRenderDispatcher_prepare(TileEntityRenderDispatcher *s,U0 *level,U0 *textures,U0 *font,MCRenderEntity020 *camera,F32 t) {if(s->level!=level)TileEntityRenderDispatcher_setLevel(s,level);s->textures=textures;s->camera=camera;s->font=font;MCActor020 *a=&camera->a;s->camYaw=a->prevYaw+(a->yaw-a->prevYaw)*t;s->camPitch=a->prevPitch+(a->pitch-a->prevPitch)*t;s->camX=a->prevX+(a->x-a->prevX)*t;s->camY=a->prevY+(a->y-a->prevY)*t;s->camZ=a->prevZ+(a->z-a->prevZ)*t;}
U0 TileEntityRenderDispatcher_renderAt(TileEntityRenderDispatcher *s,MCRenderTile020 *e,F32 x,F32 y,F32 z,F32 t) {MCRenderer020 *r=TileEntityRenderDispatcher_getRenderer(s,e);if(r)r->render(r->object,e,(x)(F32),(y)(F32),(z)(F32),(t)(F32),(s->fancy)(F32));}
U0 TileEntityRenderDispatcher_render(TileEntityRenderDispatcher *s,MCRenderTile020 *e,F32 t) {MCDispatchHost020 *h=s->h;if(h->tileDistance(h->ctx,e,(s->camX)(F32),(s->camY)(F32),(s->camZ)(F32))<4096){F32 b=h->light(h->ctx,s->level,e->x,e->y,e->z);MCG020_C(h->graphics,6,b,b,b,1);TileEntityRenderDispatcher_renderAt(s,e,e->x-s->xOff,e->y-s->yOff,e->z-s->zOff,t);}}
