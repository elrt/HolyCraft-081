// Ported from minecraftpe/impl/rendering/tileentity/ChestRenderer.cpp; host-facing representation, not C++ ABI.

U0 ChestRenderer_Init(ChestRenderer *s,MCG020 *g) {s->g=g;s->single=g->modelNew(g->ctx,0);s->paired=g->modelNew(g->ctx,1);}
U0 ChestRenderer_render(ChestRenderer *s,MCRenderTile020 *e,F32 x,F32 y,F32 z,F32 t,Bool fancy) {if(!e->isUnpaired)return;MCG020 *g=s->g;I32 data=0;Bool inventory=!e->hasLevel;if(!inventory){data=e->data;g->lighting(g->ctx,e->identity,fancy,(t)(F32));}MCG020_C(g,1);MCG020_C(g,3,x,y+1,z+1);MCG020_C(g,4,1,-1,-1);MCG020_C(g,3,0.5,0.5,0.5);if(inventory)MCG020_C(g,3,-1,0,0);else{F32 angle=0;if(data==2)angle=180;else if(data==4)angle=90;else if(data==5)angle=-90;MCG020_C(g,5,angle,0,1,0);MCG020_C(g,3,-0.5,-0.5,-0.5);}U0 *model;if(e->paired){model=s->paired;MCG020_Bind(g,"item/chest/double_normal.png");F32 sign=1;if(data==2 || data==5)sign=-1;MCG020_C(g,3,e->modelOffsetX*sign,0,0);}else{model=s->single;MCG020_Bind(g,"item/chest/normal.png");}F32 v=1-(e->prevLid+(e->lid-e->prevLid)*t);F32 rotation=-(0.5*((1-(v*v)*v)*3.1416));g->modelOp(g->ctx,model,3,(rotation)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));g->modelDraw(g->ctx,model,(1)(F32),FALSE);MCG020_C(g,2);}
U0 ChestRenderer_Destroy(ChestRenderer *s) {s->g->modelDelete(s->g->ctx,s->single);s->g->modelDelete(s->g->ctx,s->paired);}
