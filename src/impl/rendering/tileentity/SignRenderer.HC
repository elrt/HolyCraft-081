// Ported from minecraftpe/impl/rendering/tileentity/SignRenderer.cpp; host-facing representation, not C++ ABI.

U0 SignRenderer_Init(SignRenderer *s,MCG020 *g) {s->g=g;s->model=g->modelNew(g->ctx,2);}
U0 SignRenderer_render(SignRenderer *s,MCRenderTile020 *e,F32 x,F32 y,F32 z,F32 t,Bool fancy) {MCG020 *g=s->g;g->lighting(g->ctx,e->identity,fancy,(t)(F32));MCG020_C(g,1);MCG020_C(g,3,x+0.5,y+0.5,z+0.5);if(e->isSign)MCG020_C(g,5,-(360*e->data)/16.0,0,1,0);else{F32 angle=0;if(e->data==2)angle=180;else if(e->data==4)angle=90;else if(e->data==5)angle=-90;MCG020_C(g,5,-angle,0,1,0);MCG020_C(g,3,0,-0.3125,-0.4375);}g->modelOp(g->ctx,s->model,4,(e->isSign)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32),(0)(F32));MCG020_Bind(g,"item/sign.png");MCG020_C(g,1);MCG020_C(g,4,0.66667,-0.66667,-0.66667);g->modelDraw(g->ctx,s->model,(1)(F32),FALSE);MCG020_C(g,2);MCG020_C(g,3,0,0.33333,0.046667);MCG020_C(g,4,0.011111,-0.011111,0.011111);MCG020_C(g,7,0xBE2);MCG020_C(g,9,0x8076);MCG020_C(g,11,0);if(fancy){MCG020_C(g,8,0xB50);MCG020_C(g,10,0x8075);}I32 i;F32 lineY=-20;for(i=0;i<4;i++){g->fontReset(g->ctx);MCString text;MCString_Init(&text);if(i==e->selectedLine){MCString_FromC(&text,"> ");MCString_AppendBytes(&text,e->lines[i].data,e->lines[i].size);MCString_AppendBytes(&text," <",2);}else MCString_FromBytes(&text,e->lines[i].data,e->lines[i].size);I32 width=g->fontWidth(g->ctx,&text);g->fontDraw(g->ctx,&text,(-width*0.5)(F32),(lineY)(F32),0xff000000);MCString_Destroy(&text);lineY+=10;}if(fancy){MCG020_C(g,9,0x8075);MCG020_C(g,7,0xB50);}MCG020_C(g,11,1);MCG020_C(g,10,0x8076);MCG020_C(g,8,0xBE2);MCG020_C(g,2);}
U0 SignRenderer_Destroy(SignRenderer *s) {s->g->modelDelete(s->g->ctx,s->model);}
