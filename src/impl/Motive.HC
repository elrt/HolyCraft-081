U0 Motive_Init(Motive *self,MCString *name,I32 w,I32 h,I32 uo,I32 vo,Bool used) { MCString_CopyInit(&self->name,name);self->w=w;self->h=h;self->uo=uo;self->vo=vo;self->isUsed=used; }
U0 Motive_InitRegistry() {
MCString_FromC(&Motive_Kebab.name,"Kebab"); Motive_Kebab.w=16;Motive_Kebab.h=16;Motive_Kebab.uo=0;Motive_Kebab.vo=0;Motive_Kebab.isUsed=1;
MCString_FromC(&Motive_Aztec.name,"Aztec"); Motive_Aztec.w=16;Motive_Aztec.h=16;Motive_Aztec.uo=16;Motive_Aztec.vo=0;Motive_Aztec.isUsed=1;
