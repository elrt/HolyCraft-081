}
U0 Motive_getAllMotivesAsList(MCPtrVector *out) { MCPtrVector_Init(out);
MCPtrVector_Push(out,&Motive_Kebab);
MCPtrVector_Push(out,&Motive_Aztec2);
MCPtrVector_Push(out,&Motive_Alban);
MCPtrVector_Push(out,&Motive_Bomb);
MCPtrVector_Push(out,&Motive_Plant);
MCPtrVector_Push(out,&Motive_Wasteland);
MCPtrVector_Push(out,&Motive_Pool);
MCPtrVector_Push(out,&Motive_Courbet);
MCPtrVector_Push(out,&Motive_Sea);
MCPtrVector_Push(out,&Motive_Sunset);
MCPtrVector_Push(out,&Motive_Creebet);
MCPtrVector_Push(out,&Motive_Wanderer);
MCPtrVector_Push(out,&Motive_Graham);
MCPtrVector_Push(out,&Motive_Match);
MCPtrVector_Push(out,&Motive_Bust);
MCPtrVector_Push(out,&Motive_Stage);
MCPtrVector_Push(out,&Motive_Void);
MCPtrVector_Push(out,&Motive_SkullAndRoses);
MCPtrVector_Push(out,&Motive_Fighters);
MCPtrVector_Push(out,&Motive_Pointer);
MCPtrVector_Push(out,&Motive_Pigscene);
MCPtrVector_Push(out,&Motive_BurningSkull);
MCPtrVector_Push(out,&Motive_Skeleton);
MCPtrVector_Push(out,&Motive_DonkeyKong);
MCPtrVector_Push(out,&Motive_Earth);
MCPtrVector_Push(out,&Motive_Wind);
MCPtrVector_Push(out,&Motive_Fire);
MCPtrVector_Push(out,&Motive_Water);
}
Motive *Motive_getMotiveByName(MCString *name) { MCPtrVector all; Motive_getAllMotivesAsList(&all); I64 i;Motive *out=Motive_DefaultImage; for(i=0;i<all.size;i++) { Motive *m=all.data[i]; if(MCString_Equal(name,&m->name)) {out=m;break;} } MCPtrVector_Destroy(&all); return out; }
