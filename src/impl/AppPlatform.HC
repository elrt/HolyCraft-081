// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 AppPlatform_Init(AppPlatform *s,MCUI025 *ui,U8 *extensions,F32 maxAnisotropy){memset(s,0,sizeof(AppPlatform));s->width=854;s->height=480;s->pixelsPerMillimeter=10;s->ui=ui;MCVector_Init(&s->listeners,sizeof(MCAppListener025));if(extensions && strstr(extensions,"GL_APPLE_texture_max_level"))s->textureMaxLevel=0x813d;if(extensions && strstr(extensions,"GL_EXT_texture_filter_anisotropic")){s->anisotropicFilter=0x84fe;s->anisotropicMaxLevel=maxAnisotropy;}}
U0 AppPlatform_Destroy(AppPlatform *s){MCVector_Destroy(&s->listeners);}
U0 AppPlatform_showKeyboard(AppPlatform *s,MCString *text,I32 limit,Bool restricted){s->keyboardShown=TRUE;if(s->ui && s->ui->keyboard!=NULL)s->ui->keyboard(s->ui->ctx,TRUE,text,limit,restricted);}
U0 AppPlatform_hideKeyboard(AppPlatform *s){s->keyboardShown=FALSE;if(s->ui && s->ui->keyboard!=NULL)s->ui->keyboard(s->ui->ctx,FALSE,NULL,0,FALSE);}
U0 AppPlatform_updateTextBoxText(AppPlatform *s,MCString *text){if(s->ui && s->ui->updateText!=NULL)s->ui->updateText(s->ui->ctx,text);}
Bool AppPlatform_readAssetFile(AppPlatform *s,MCString *path,MCVector *out){return MC024_ReadFile(path->data,out);}
U0 AppPlatform_addListener(AppPlatform *s,MCAppListener025 *listener){MCVector_Push(&s->listeners,listener);I32 i=s->listeners.size-1;while(i>0){MCAppListener025 *a=MCVector_At(&s->listeners,i-1),*b=MCVector_At(&s->listeners,i);if(a->priority<=b->priority)break;MCAppListener025 tmp=*a;*a=*b;*b=tmp;i--;}}
U0 AppPlatform_removeListener(AppPlatform *s,U0 *object){I32 i;for(i=0;i<s->listeners.size;i++){MCAppListener025 *l=MCVector_At(&s->listeners,i);if(l->object==object){MCVector_Erase(&s->listeners,i);return;}}}
U0 AppPlatform_fireAppSuspended(AppPlatform *s){I32 i;for(i=s->listeners.size-1;i>=0;i--){MCAppListener025 l=*(MCVector_At(&s->listeners,i)(MCAppListener025*));if(l.suspend!=NULL)l.suspend(l.object);}}
U0 AppPlatform_fireAppResumed(AppPlatform *s){I32 i;for(i=0;i<s->listeners.size;i++){MCAppListener025 l=*(MCVector_At(&s->listeners,i)(MCAppListener025*));if(l.resume!=NULL)l.resume(l.object);}}
Bool AppPlatform_loadImage(AppPlatform *s,ImageData *out,MCString *name,Bool external){ImageData_Init(out);I32 n=name->size,kind=0;if(n>=4 && !strcmp(name->data+n-4,".png"))kind=1;if(n>=4 && !strcmp(name->data+n-4,".tga"))kind=2;if(!kind || s->loadImage==NULL)return FALSE;return s->loadImage(s->context,name,kind,external,out);}
Bool AppPlatform_loadTexture(AppPlatform *s,TextureData *out,MCString *name,Bool external){TextureData_Init(out);if(!AppPlatform_loadImage(s,&out->image,name,external) || !out->image.pixels)return FALSE;if(!s->textureMaxLevel)return TRUE;I32 dot=0;while(dot<name->size && name->data[dot]!='.')dot++;if(dot==name->size)return TRUE;I32 lod;for(lod=1;lod<=16;lod++){MCString path;MCString_FromBytes(&path,name->data,dot);MC025_Append(&path,"_mip");U8 suffix[2];suffix[0]=lod+'/';suffix[1]=0;MC025_Append(&path,suffix);MC025_Append(&path,name->data+dot);ImageData image;Bool ok=AppPlatform_loadImage(s,&image,&path,external);MCString_Destroy(&path);if(!ok || !image.pixels)break;image.lod=lod;MCImageVector_Push(&out->images,&image);}return TRUE;}
