// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 NinecraftApp_initSinTable(){I32 i;for(i=0;i<65536;i++)Mth__sin[i]=sin(i/10430.0);}
U0 NinecraftApp_Init(NinecraftApp *s,AppPlatform *platform,MCG020 *graphics){memset(s,0,sizeof(NinecraftApp));Minecraft_Init(&s->minecraft,platform,FALSE);s->graphics=graphics;MCVector_Init(&s->backEvents,sizeof(I32));s->timer.ticksPerSecond=20;s->timer.timeScale=1;s->timer.adjustTime=1;s->timer.lastMs=MC_TimerTimeMs();s->timer.lastMsSysTime=s->timer.lastMs;s->timer.lastTime=s->timer.lastMs/1000.0;NinecraftApp_initSinTable();s->initialized=TRUE;}
U0 NinecraftApp_initGLStates(NinecraftApp *s){MCG020 *g=s->graphics;if(!g || g->command==NULL)return;I32 enabled[4]={0xbe2,0xb71,0xb44,0xde1},disabled[6]={0xb60,0xb50,0xbc0,0xb90,0x8037,0xb50},i;for(i=0;i<4;i++)MCG020_C(g,7,enabled[i]);for(i=0;i<6;i++)MCG020_C(g,8,disabled[i]);MCG020_C(g,21,0x203);MCG020_C(g,22,0,1);MCG020_C(g,23,0x204,0.5);MCG020_C(g,24,0x405);MCG020_C(g,25,0x1d00);MCG020_C(g,9,0x8074);MCG020_C(g,26,0xc50,0x1101);MCG020_C(g,26,0xc54,0x1101);MCG020_C(g,12,0x302,0x303);MCG020_C(g,11,1);MCG020_C(g,27,0x202,0,255);MCG020_C(g,28,255);MCG020_C(g,13,0xb52,0);MCG020_C(g,29,-1,-1);}
Bool NinecraftApp_handleBack(NinecraftApp *s,Bool held){Minecraft *mc=&s->minecraft;if(mc->level){if(!held){if(!mc->currentScreen){mc->paused=TRUE;return FALSE;}if(!Screen_handleBackEvent(mc->currentScreen,FALSE))Minecraft_setScreen(mc,NULL);}}else if(mc->currentScreen)Screen_handleBackEvent(mc->currentScreen,held);return TRUE;}
U0 NinecraftApp_queueBack(NinecraftApp *s,Bool held){I32 event=held;MCVector_Push(&s->backEvents,&event);}
U0 NinecraftApp_updateTicks(NinecraftApp *s,I32 ticks,F32 partial){I32 i;for(i=0;i<s->backEvents.size;i++){I32 held=*(MCVector_At(&s->backEvents,i)(I32*));NinecraftApp_handleBack(s,held);}s->backEvents.size=0;s->frames++;if(!s->suspended)Minecraft_updateTicks(&s->minecraft,ticks,partial);}
U0 NinecraftApp_update(NinecraftApp *s){F32 old=s->timer.field_8;Timer_advanceTime(&s->timer);if(s->minecraft.paused && s->minecraft.level)s->timer.field_8=old;NinecraftApp_updateTicks(s,s->timer.ticks,s->timer.field_8);}
U0 NinecraftApp_onAppSuspended(NinecraftApp *s){s->suspended=TRUE;if(s->minecraft.platform)AppPlatform_fireAppSuspended(s->minecraft.platform);if(s->minecraft.player)LocalPlayer_releaseAllKeys(s->minecraft.player);}
U0 NinecraftApp_onAppResumed(NinecraftApp *s){NinecraftApp_initGLStates(s);s->suspended=FALSE;if(s->minecraft.platform)AppPlatform_fireAppResumed(s->minecraft.platform);}
U0 NinecraftApp_Destroy(NinecraftApp *s){Minecraft_Destroy(&s->minecraft);MCVector_Destroy(&s->backEvents);}
