U0 ItemDiffer_Init(ItemDiffer *s,MCItemDiffHost014 *h,MCVector *items){I32 i;U0 *p,*q;s->host=h;s->len=items->size;MCVector_Init(&s->items,sizeof(U0 *));for(i=0;i<s->len;i++){p=*(MCVector_At(items,i)(U0 **));if(p)q=h->copy(h->host,p);else q=h->nullItem(h->host);MCVector_Push(&s->items,&q);}}U0 ItemDiffer_getDiff(ItemDiffer *s,MCVector *items,MCVector *out){I32 i;U0 *a,*b;if(items->size!=s->len){printf("ItemDiffer: unequal lengths trigger out-of-bounds in original\n");exit(98);}for(i=0;i<s->len;i++){a=*(MCVector_At(&s->items,i)(U0 **));b=*(MCVector_At(items,i)(U0 **));if(!s->host->matchesNulls(s->host->host,a,b))MCVector_Push(out,&i);}}U0 ItemDiffer_Destroy(ItemDiffer *s){I32 i;U0 *a;for(i=0;i<s->len;i++){a=*(MCVector_At(&s->items,i)(U0 **));s->host->destroy(s->host->host,a);}MCVector_Destroy(&s->items);}
