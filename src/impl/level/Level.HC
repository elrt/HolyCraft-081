// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
Bool Level_InBounds(I32 x,I32 y,I32 z){return x>=0 && x<256 && z>=0 && z<256 && y>=0 && y<128;}
LevelChunk *Level_getChunk(Level *s,I32 x,I32 z,Bool create){if(x<0 || z<0 || x>15 || z>15)return NULL;I32 i=x+16*z;if(!s->chunks[i] && create){s->chunks[i]=MC_Alloc(sizeof(LevelChunk));LevelChunk_Init(s->chunks[i],s->registry,x,z);s->chunks[i]->level=s;s->chunks[i]->hasNoSky=s->noSky;}return s->chunks[i];}
I32 Level_getTile(Level *s,I32 x,I32 y,I32 z){if(!Level_InBounds(x,y,z))return 0;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);if(!c)return 0;return LevelChunk_getTile(c,x&15,y,z&15);}
I32 Level_getData(Level *s,I32 x,I32 y,I32 z){if(!Level_InBounds(x,y,z))return 0;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);if(!c)return 0;return LevelChunk_getData(c,x&15,y,z&15);}
Bool Level_setTileAndData(Level *s,I32 x,I32 y,I32 z,I32 id,I32 meta,I32 flags){if(!Level_InBounds(x,y,z) || id<0 || id>255)return FALSE;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,TRUE);Bool ok=LevelChunk_setTileAndData(c,x&15,y,z&15,id,meta);if(ok && (flags&2))MC023_Event(&s->world,MC023_DIRTY,x,y,z,id,meta,1);if(ok && (flags&1))MC023_Event(&s->world,MC023_NEIGHBOR,x,y,z,id,meta,1);return ok;}
I32 MC025_LevelGet(U0 *ctx,I32 op,I32 x,I32 y,I32 z){Level *s=ctx;if(op==MC023_TILE)return Level_getTile(s,x,y,z);if(op==MC023_DATA)return Level_getData(s,x,y,z);if(op==MC023_READY)return Level_InBounds(x,y,z) && Level_getChunk(s,x>>4,z>>4,FALSE)!=NULL;if(op==MC023_MAYPLACE)return Level_InBounds(x,y,z) && !Level_getTile(s,x,y,z);if(op==MC023_SKY){if(s->noSky || !Level_InBounds(x,y,z))return FALSE;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);return c && y>=LevelChunk_getHeightmap(c,x&15,z&15);}if(op==MC023_LIGHT || op==7){LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);I32 layer=1;if(op==7)layer=0;if(c)return LevelChunk_getBrightness(c,layer,x&15,y,z&15);}return 0;}
Bool MC025_LevelSet(U0 *ctx,I32 op,I32 x,I32 y,I32 z,I32 id,I32 meta,I32 flags){Level *s=ctx;if(op==MC023_SET_TILE)return Level_setTileAndData(s,x,y,z,id,meta,flags);if(!Level_InBounds(x,y,z))return FALSE;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,TRUE);if(op==MC023_SET_DATA)return LevelChunk_setData(c,x&15,y,z&15,meta);if(op==MC023_SET_LIGHT){if(id<0 || id>1)return FALSE;LevelChunk_setBrightness(c,id,x&15,y,z&15,meta);c->unsaved=TRUE;return TRUE;}return FALSE;}
class MC32BoxHook {I32 (*f)(U0*,I32,I32,I32,I32,Bool,AABB*);};
MC32BoxHook g032_box;
class MC35MultiHook {Bool (*f)(U0*,I32,I32,I32,I32,AABB*,MCVector*);};
MC35MultiHook g035_multi;
U0 Level_getCubes(Level *s,AABB *box,MCVector *out){MCVector_Init(out,sizeof(AABB));I32 x0=floorf(box->minX),x1=floorf(box->maxX+1),y0=floorf(box->minY)-1,y1=floorf(box->maxY+1),z0=floorf(box->minZ),z1=floorf(box->maxZ+1),x,y,z,id;if(x0<0)x0=0;if(y0<0)y0=0;if(z0<0)z0=0;if(x1>256)x1=256;if(y1>128)y1=128;if(z1>256)z1=256;for(x=x0;x<x1;x++)for(z=z0;z<z1;z++)for(y=y0;y<y1;y++){id=Level_getTile(s,x,y,z);if(!id)continue;AABB a;if(g035_multi.f!=NULL && g035_multi.f(s,id,x,y,z,box,out))continue;if(g032_box.f!=NULL){I32 hr=g032_box.f(s,id,x,y,z,TRUE,&a);if(hr==2)continue;if(hr==1){if(MC025_Intersects(&a,box))MCVector_Push(out,&a);continue;}}if(!s->registry->tiles[id].solid)continue;if(s->tileObjects[id])Tile_getAABB(s->tileObjects[id],x,y,z,&a);else AABB_Init(&a,x,y,z,x+1,y+1,z+1);if(MC025_Intersects(&a,box))MCVector_Push(out,&a);}}
U0 Level_clipMove(Level *s,AABB *box,F32 *dx,F32 *dy,F32 *dz){AABB expanded;AABB_expand(box,*dx,*dy,*dz,&expanded);MCVector cubes;Level_getCubes(s,&expanded,&cubes);I32 i;for(i=0;i<cubes.size;i++)*dy=AABB_clipYCollide(MCVector_At(&cubes,i),box,*dy);AABB_move(box,0,*dy,0);for(i=0;i<cubes.size;i++)*dx=AABB_clipXCollide(MCVector_At(&cubes,i),box,*dx);AABB_move(box,*dx,0,0);for(i=0;i<cubes.size;i++)*dz=AABB_clipZCollide(MCVector_At(&cubes,i),box,*dz);AABB_move(box,0,0,*dz);MCVector_Destroy(&cubes);}
U0 MC025_MoveBody(U0 *ctx,MCBody023 *body,F32 dx,F32 dy,F32 dz){Level *s=ctx;AABB box;F32 oldX=dx,oldY=dy,oldZ=dz;AABB_Init(&box,body->x-body->width/2,body->minYBound,body->z-body->width/2,body->x+body->width/2,body->minYBound+body->height,body->z+body->width/2);Level_clipMove(s,&box,&dx,&dy,&dz);F32 off=body->y-body->minYBound;body->x=(box.minX+box.maxX)*0.5;body->z=(box.minZ+box.maxZ)*0.5;body->minYBound=box.minY;body->y=box.minY+off;body->onGround=oldY!=dy && oldY<0;if(oldX!=dx)body->motionX=0;if(oldY!=dy)body->motionY=0;if(oldZ!=dz)body->motionZ=0;}
U0 MC025_Entities(U0 *ctx,MCBody023 *except,F32 x,F32 y,F32 z,F32 xx,F32 yy,F32 zz,MCPtrVector *out){Level *s=ctx;AABB query;AABB_Init(&query,x,y,z,xx,yy,zz);I32 i;for(i=0;i<s->bodies.size;i++){MCBody023 *b=s->bodies.data[i];if(b==except || b->dead)continue;AABB a;AABB_Init(&a,b->x-b->width/2,b->minYBound,b->z-b->width/2,b->x+b->width/2,b->minYBound+b->height,b->z+b->width/2);if(MC025_Intersects(&query,&a))MCPtrVector_Push(out,b);}}
U0 MC025_LevelEvent(U0 *ctx,MCWorldEvent023 *e){Level *s=ctx;if(e->op>=0 && e->op<64)s->eventCount[e->op]++;if(e->op==MC023_DROP && e->count>0 && e->id>0 && e->id<512 && s->registry->items[e->id]!=NULL){ItemInstance item;ItemInstance_Init(&item,s->registry,e->id,e->count,e->meta);ItemEntity *drop=MC_Alloc(sizeof(ItemEntity));F32 x=e->x+0.5,y=e->y+0.5,z=e->z+0.5;if(e->a!=0 || e->b!=0 || e->c!=0){x=e->a;y=e->b;z=e->c;}ItemEntity_Init(drop,&s->world,x,y,z,&item,Random_genrand_int32(&s->world.random));drop->minYBound=y;MCPtrVector_Push(&s->drops,drop);MCPtrVector_Push(&s->bodies,drop);}if(e->op==MC023_PLAYER_DESTROY && e->id>0 && e->id<256 && s->tileObjects[e->id]!=NULL)Tile_spawnResources(s->tileObjects[e->id],s,e->x,e->y,e->z,e->meta,1);if(s->event!=NULL)s->event(s->ctx,e);}
F32 MC025_LevelValue(U0 *ctx,I32 op,I32 x,I32 y,I32 z){Level *s=ctx;if(op!=MC023_LIGHT || !Level_InBounds(x,y,z))return 0;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);if(!c)return 0;return LevelChunk_getRawBrightness(c,x&15,y,z&15,s->skyDarken)/15.0;}
U0 Level_Init(Level *s,MCRegistry023 *r,I32 seed){memset(s,0,sizeof(Level));s->registry=r;s->chunkLimit=256;s->world.ctx=s;s->world.registry=r;s->world.get=&MC025_LevelGet;s->world.set=&MC025_LevelSet;s->world.event=&MC025_LevelEvent;s->world.move=&MC025_MoveBody;s->world.entities=&MC025_Entities;s->world.value=&MC025_LevelValue;s->world.difficulty=2;s->actions.ctx=s;s->actions.canDestroy=&MC025_CanDestroy;s->actions.mine=&MC025_MineItem;s->world.actions=&s->actions;s->world.blockEntity=&MC025_BlockEntity;Random_setSeed(&s->world.random,seed);MC024_Init(&s->adapter,&s->world);LevelData_InitSettings(&s->data,seed,0,0,"HolyC025");s->data.storageVersion=3;MCPtrVector_Init(&s->bodies);MCPtrVector_Init(&s->drops);MCVector_Init(&s->pendingTicks,sizeof(MCTick025));}
U0 Level_Destroy(Level *s){I32 i;for(i=0;i<256;i++)if(s->chunks[i]){LevelChunk_Destroy(s->chunks[i]);free(s->chunks[i]);s->chunks[i]=NULL;}for(i=0;i<s->drops.size;i++)free(s->drops.data[i]);MCPtrVector_Destroy(&s->drops);MCPtrVector_Destroy(&s->bodies);MCVector_Destroy(&s->pendingTicks);LevelData_Destroy(&s->data);}
U0 Level_addEntity(Level *s,MCBody023 *body){I32 i;for(i=0;i<s->bodies.size;i++)if(s->bodies.data[i]==body)return;MCPtrVector_Push(&s->bodies,body);}
U0 Level_removeEntity(Level *s,MCBody023 *body){I32 i,j;for(i=0;i<s->bodies.size;i++)if(s->bodies.data[i]==body){for(j=i+1;j<s->bodies.size;j++)s->bodies.data[j-1]=s->bodies.data[j];s->bodies.size--;break;}}
U0 Level_addToTickNextTick(Level *s,I32 x,I32 y,I32 z,I32 id,I32 delay){if(!Level_hasChunksAt(s,x-8,y-8,z-8,x+8,y+8,z+8))return;I32 i;for(i=0;i<s->pendingTicks.size;i++){MCTick025 *old=MCVector_At(&s->pendingTicks,i);if(old->x==x && old->y==y && old->z==z && old->id==id)return;}MCTick025 t;t.x=x;t.y=y;t.z=z;t.id=id;t.time=s->data.time+delay;MCVector_Push(&s->pendingTicks,&t);}
U0 Level_tick(Level *s){s->ticks++;s->data.time++;I32 i,limit=s->pendingTicks.size;for(i=0;i<limit;i++){MCTick025 t=*(MCVector_At(&s->pendingTicks,i)(MCTick025*));if(t.time>s->data.time)continue;MCVector_Erase(&s->pendingTicks,i);i--;limit--;if(s->tileTick!=NULL && Level_getTile(s,t.x,t.y,t.z)==t.id)s->tileTick(s->ctx,t.id,t.x,t.y,t.z);}for(i=0;i<s->drops.size;i++){ItemEntity *drop=s->drops.data[i];if(!drop->dead)ItemEntity_tick(drop);}}
Bool Level_saveChunks(Level *s,RegionFile *file){I32 i;MCVector bytes;MC024_BytesInit(&bytes);for(i=0;i<256;i++)if(s->chunks[i] && s->chunks[i]->unsaved){LevelChunk_pack(s->chunks[i],&bytes);if(!RegionFile_writeChunk(file,i&15,i>>4,&bytes)){MCVector_Destroy(&bytes);return FALSE;}s->chunks[i]->unsaved=FALSE;}MCVector_Destroy(&bytes);return TRUE;}
Bool Level_loadChunk(Level *s,RegionFile *file,I32 x,I32 z){if(x<0 || z<0 || x>15 || z>15)return FALSE;MCVector bytes;MC024_BytesInit(&bytes);if(!RegionFile_readChunk(file,x,z,&bytes)){MCVector_Destroy(&bytes);return FALSE;}LevelChunk *c=Level_getChunk(s,x,z,TRUE);Bool ok=LevelChunk_unpack(c,&bytes,3);MCVector_Destroy(&bytes);return ok;}

Bool MC025_CanDestroy(U0 *ctx,MCPlayer023 *player,I32 id){Level *s=ctx;if(id<1 || id>255)return FALSE;Tile *tile=s->tileObjects[id];if(!tile || !tile->material)return FALSE;return Material_isAlwaysDestroyable(tile->material);}
U0 MC025_MineItem(U0 *ctx,ItemInstance *item,I32 id,I32 x,I32 y,I32 z,MCPlayer023 *player){if(item && ItemInstance_isDamageableItem(item))ItemInstance_hurtAndBreak(item,1,player);}
U0 *MC025_BlockEntity(U0 *ctx,I32 x,I32 y,I32 z){Level *s=ctx;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,FALSE);if(!c)return NULL;I32 i;for(i=0;i<c->blockEntities.size;i++){MCTileEntity025 *t=MCVector_At(&c->blockEntities,i);if(t->x==x && t->y==y && t->z==z)return t->object;}return NULL;}
Bool Level_setBlockEntity(Level *s,I32 x,I32 y,I32 z,I32 kind,U0 *object){if(!Level_InBounds(x,y,z))return FALSE;LevelChunk *c=Level_getChunk(s,x>>4,z>>4,TRUE);I32 i;for(i=0;i<c->blockEntities.size;i++){MCTileEntity025 *t=MCVector_At(&c->blockEntities,i);if(t->x==x && t->y==y && t->z==z){if(!object)MCVector_Erase(&c->blockEntities,i);else{t->object=object;t->kind=kind;}return TRUE;}}if(!object)return FALSE;MCTileEntity025 t;t.x=x;t.y=y;t.z=z;t.kind=kind;t.object=object;MCVector_Push(&c->blockEntities,&t);return TRUE;}

Bool Level_hasChunksAt(Level *s,I32 x,I32 y,I32 z,I32 xx,I32 yy,I32 zz){if(yy<0 || y>=128)return FALSE;I32 a,b;for(a=x>>4;a<=(xx>>4);a++)for(b=z>>4;b<=(zz>>4);b++)if(!Level_getChunk(s,a,b,FALSE))return FALSE;return TRUE;}
