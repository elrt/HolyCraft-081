Bool PerformanceTestChunkSource_hasChunk(PerformanceTestChunkSource *s,I32 x,I32 z){return TRUE;}U0 *PerformanceTestChunkSource_getChunk(PerformanceTestChunkSource *s,I32 x,I32 z){return PerformanceTestChunkSource_create(s,x,z);}
U0 *PerformanceTestChunkSource_create(PerformanceTestChunkSource *s,I32 x,I32 z){I32 y,i,j;U8 *tiles=MC_Alloc(0x8000);U0 *chunk;memset(tiles,0,0x8000);for(y=0;y<65;y++){if(y>59){for(i=0;i<16;i+=2)for(j=0;j<16;j+=2)tiles[y|(i<<11)|(j<<7)]=3;}else{for(i=(y+1)&1;i<=15;i+=2)for(j=y&1;j<=15;j+=2)tiles[y|(i<<11)|(j<<7)]=3;}}chunk=s->host->createChunk(s->host->host,tiles,x,z);s->host->recalcHeightmap(s->host->host,chunk);return chunk;}
U0 PerformanceTestChunkSource_postProcess(PerformanceTestChunkSource *s,U0 *source,I32 x,I32 z){}Bool PerformanceTestChunkSource_tick(PerformanceTestChunkSource *s){return FALSE;}Bool PerformanceTestChunkSource_shouldSave(PerformanceTestChunkSource *s){return FALSE;}U8 *PerformanceTestChunkSource_gatherStats(PerformanceTestChunkSource *s){return "PerformanceTestChunkSource";}
