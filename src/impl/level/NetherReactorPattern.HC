U0 NetherReactorPattern_Init(NetherReactorPattern *s,I32 gold,I32 stone,I32 reactor){I32 i;memset(s->pattern,0,sizeof(s->pattern));for(i=0;i<27;i++){if(i==1||i==3||i==4||i==5||i==7||i==9||i==11||i==15||i==17||i==19||i==21||i==22||i==23||i==25)s->pattern[i]=stone;}s->pattern[0]=gold;s->pattern[2]=gold;s->pattern[6]=gold;s->pattern[8]=gold;s->pattern[13]=reactor;}
I32 NetherReactorPattern_getTileAt(NetherReactorPattern *s,I32 x,I32 y,I32 z){return s->pattern[9*x+3*y+z];}U0 NetherReactorPattern_setTileAt(NetherReactorPattern *s,I32 x,I32 y,I32 z,I32 id){s->pattern[9*x+3*y+z]=id;}
