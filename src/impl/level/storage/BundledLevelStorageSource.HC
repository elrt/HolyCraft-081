U0 BundledLevelStorageSource_Init(BundledLevelStorageSource *s,MCBundledStorageHost012 *h,U0 *mc){MemoryLevelStorageSource_Init(&s->base);s->host=h;s->minecraft=mc;s->base.nameFn=&BundledLevelStorageSource_Name;s->base.selectFn=&BundledLevelStorageSource_Select;}U0 BundledLevelStorageSource_Name(LevelStorageSource *b,MCString *out){MCString_FromC(out,"Bundled Level Storage");}LevelStorage *BundledLevelStorageSource_Select(LevelStorageSource *b,MCString *name,Bool create){BundledLevelStorageSource *s=b;return s->host->createBundled(s->host->host,s->minecraft,name);}
