// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 RegionFile_Init(RegionFile *s,U8 *folder){memset(s,0,sizeof(RegionFile));MCString_FromC(&s->path,folder);MCString_AppendBytes017(&s->path,"/chunks.dat",11);MCVector_Init(&s->sectors,1);}
U0 RegionFile_close(RegionFile *s){if(s->file)fclose(s->file);s->file=NULL;}
U0 RegionFile_Destroy(RegionFile *s){RegionFile_close(s);MCString_Destroy(&s->path);MCVector_Destroy(&s->sectors);}
U0 RegionFile_mark(RegionFile *s,I32 index,U8 state){if(index<0 || index>1048576)return;if(index>=s->sectors.size){I64 old=s->sectors.size;MCVector_Reserve(&s->sectors,index+1);memset(s->sectors.data+old,0,index+1-old);s->sectors.size=index+1;}s->sectors.data[index]=state;}
Bool RegionFile_open(RegionFile *s){RegionFile_close(s);memset(s->locations,0,4096);s->file=fopen(s->path.data,"r+b");Bool fresh=FALSE;if(!s->file){s->file=fopen(s->path.data,"w+b");fresh=TRUE;}if(!s->file)return FALSE;RegionFile_mark(s,0,1);if(fresh){if(fwrite(s->locations,4,1024,s->file)!=1024){RegionFile_close(s);return FALSE;}}else{if(fread(s->locations,4,1024,s->file)!=1024){RegionFile_close(s);return FALSE;}fseek(s->file,0,2);I64 length=ftell(s->file);I32 i,j;for(i=0;i<1024;i++){I32 loc=s->locations[i],first=loc(U32)>>8,count=loc&255;if(loc && (first<1 || !count || first>1048576 || (first(I64)+count)*4096>length)){RegionFile_close(s);return FALSE;}for(j=0;j<count;j++)RegionFile_mark(s,first+j,1);}}return TRUE;}
Bool RegionFile_readChunk(RegionFile *s,I32 x,I32 z,MCVector *out){out->size=0;if(!s->file || x<0 || x>31 || z<0 || z>31)return FALSE;U32 loc=s->locations[x+32*z];if(!loc)return FALSE;I32 first=loc>>8,count=loc&255;I32 total=0;if(fseek(s->file,first(I64)*4096,0) || fread(&total,4,1,s->file)!=1 || total<4 || total>count*4096)return FALSE;I32 bytes=total-4;MCVector_Reserve(out,bytes);if(fread(out->data,1,bytes,s->file)!=bytes)return FALSE;out->size=bytes;return TRUE;}
Bool RegionFile_write(RegionFile *s,I32 sector,MCVector *data){if(!s->file || sector<1 || data->size<0 || data->size>1044476)return FALSE;I32 size=data->size+4;if(fseek(s->file,sector(I64)*4096,0))return FALSE;return fwrite(&size,4,1,s->file)==1 && fwrite(data->data,1,data->size,s->file)==data->size;}
Bool RegionFile_writeChunk(RegionFile *s,I32 x,I32 z,MCVector *data){if(!s->file || x<0 || x>31 || z<0 || z>31 || data->size<0)return FALSE;I32 needed=((data->size+4)>>12)+1;if(needed>255)return FALSE;/* Source accepts256, whose low-byte sector count overflows: rejected explicitly. */I32 index=x+32*z;U32 old=s->locations[index];I32 first=old>>8,count=old&255,i;if(first && count==needed)return RegionFile_write(s,first,data);for(i=0;i<count;i++)RegionFile_mark(s,first+i,2);I32 start=0,run=0;while(start+run<s->sectors.size && s->sectors.data[start+run]){if(s->sectors.data[start+run]==2){run++;if(run>=needed)break;}else{start+=run+1;run=0;}}if(run<needed){fseek(s->file,0,2);U8 zeros[4096];memset(zeros,0,4096);for(i=run;i<needed;i++){if(fwrite(zeros,1,4096,s->file)!=4096)return FALSE;RegionFile_mark(s,start+i,2);}}for(i=0;i<needed;i++)RegionFile_mark(s,start+i,1);if(!RegionFile_write(s,start,data))return FALSE;s->locations[index]=(start<<8)|needed;if(fseek(s->file,index*4,0) || fwrite(&s->locations[index],4,1,s->file)!=1)return FALSE;return TRUE;}
