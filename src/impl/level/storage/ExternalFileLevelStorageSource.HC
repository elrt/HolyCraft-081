Bool MC022_CacheTransfer(ExternalFileLevelStorageSource *s,MCString *id,Bool temporary,I32 seed,I32 version,Bool load) {MCString cache,base,chunks;MC022_CacheName(s,seed,version,&cache);ExternalFileLevelStorageSource_getFullPath(s,id,temporary,&base);MC022_PathAppend(&chunks,&base,"/chunks.dat");Bool exists=FALSE,ok=FALSE;if((s->host->exists!=NULL))exists=s->host->exists(s->host->ctx,&cache);if(load && exists && (s->host->gzip!=NULL)){ok=s->host->gzip(s->host->ctx,&cache,&chunks,FALSE);if(!ok && (s->host->removeFile!=NULL)){s->host->removeFile(s->host->ctx,&cache);s->host->removeFile(s->host->ctx,&chunks);}}else if(!load){ok=exists;if(!exists && (s->host->gzip!=NULL))ok=s->host->gzip(s->host->ctx,&chunks,&cache,TRUE);}MCString_Destroy(&cache);MCString_Destroy(&base);MCString_Destroy(&chunks);return ok;}
Bool ExternalFileLevelStorageSource_storeToCache(ExternalFileLevelStorageSource *s,MCString *id,Bool temp,I32 seed,I32 version) {return MC022_CacheTransfer(s,id,temp,seed,version,FALSE);}Bool ExternalFileLevelStorageSource_loadFromCache(ExternalFileLevelStorageSource *s,MCString *id,Bool temp,I32 seed,I32 version) {return MC022_CacheTransfer(s,id,temp,seed,version,TRUE);}
