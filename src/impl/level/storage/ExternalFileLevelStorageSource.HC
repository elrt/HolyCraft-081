U0 MC022_PathAppend(MCString *out,MCString *base,U8 *suffix) {MCString_CopyInit(out,base);MCString_AppendBytes017(out,suffix,MC_StrLen(suffix));}
U0 MC022_CreateTree(MCStorageHost022 *h,MCString *root) {MCString p;MC022_PathAppend(&p,root,"/games");if((h->mkdir!=NULL))h->mkdir(h->ctx,&p);MCString_AppendBytes017(&p,"/com.mojang",11);if((h->mkdir!=NULL))h->mkdir(h->ctx,&p);MCString_AppendBytes017(&p,"/minecraftWorlds",16);if((h->mkdir!=NULL))h->mkdir(h->ctx,&p);MCString_Destroy(&p);}
U0 ExternalFileLevelStorageSource_Init(ExternalFileLevelStorageSource *s,MCString *a,MCString *b,MCStorageHost022 *h) {s->host=h;s->separate=!MCString_Equal(a,b);MC022_CreateTree(h,a);if(s->separate)MC022_CreateTree(h,b);MC022_PathAppend(&s->primary,a,"/games/com.mojang/minecraftWorlds");MC022_PathAppend(&s->secondary,b,"/games/com.mojang/minecraftWorlds");MC022_PathAppend(&s->cache,&s->secondary,"/_LevelCache");if((h->mkdir!=NULL))h->mkdir(h->ctx,&s->cache);}
U0 ExternalFileLevelStorageSource_Destroy(ExternalFileLevelStorageSource *s) {MCString_Destroy(&s->primary);MCString_Destroy(&s->secondary);MCString_Destroy(&s->cache);}
U0 ExternalFileLevelStorageSource_getFullPath(ExternalFileLevelStorageSource *s,MCString *id,Bool temporary,MCString *out) {MCString *root=&s->primary;if(temporary)root=&s->secondary;MC022_PathAppend(out,root,"/");MCString_AppendStr017(out,id);}
Bool ExternalFileLevelStorageSource_getLevelSummaryIfExists(ExternalFileLevelStorageSource *s,MCString *id,U0 *summary) {MCString path;ExternalFileLevelStorageSource_getFullPath(s,id,FALSE,&path);Bool ok=FALSE;if((s->host->summary!=NULL))ok=s->host->summary(s->host->ctx,&path,summary);MCString_Destroy(&path);return ok;}
U0 ExternalFileLevelStorageSource_getLevelList(ExternalFileLevelStorageSource *s,MCVector *out) {MCStringVector_Init(out);if(!(s->host->listDirs!=NULL))return;MCVector dirs;MCStringVector_Init(&dirs);s->host->listDirs(s->host->ctx,&s->primary,&dirs);I64 i;MCString *names=dirs.data(MCString*);for(i=0;i<dirs.size;i++)if(ExternalFileLevelStorageSource_getLevelSummaryIfExists(s,&names[i],NULL)){MCString copy;MCString_CopyInit(&copy,&names[i]);MCVector_Push(out,&copy);}MCStringVector_Destroy(&dirs);}
Bool ExternalFileLevelStorageSource_deleteLevel(ExternalFileLevelStorageSource *s,MCString *id,Bool temporary) {MCString path;ExternalFileLevelStorageSource_getFullPath(s,id,temporary,&path);Bool ok=FALSE;if((s->host->removeTree!=NULL))ok=s->host->removeTree(s->host->ctx,&path);MCString_Destroy(&path);return ok;}
Bool ExternalFileLevelStorageSource_clearCache(ExternalFileLevelStorageSource *s) {U8 *tail="_LevelCache";I64 n=MC_StrLen(tail);if(s->cache.size<n || memcmp(s->cache.data+s->cache.size-n,tail,n))return FALSE;Bool ok=FALSE;if((s->host->removeTree!=NULL))ok=s->host->removeTree(s->host->ctx,&s->cache);if((s->host->mkdir!=NULL))s->host->mkdir(s->host->ctx,&s->cache);return ok;}
