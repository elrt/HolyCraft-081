// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 LevelData_Init(LevelData *s){memset(s,0,sizeof(LevelData));MCString_Init(&s->levelName);s->xSpawn=s->zSpawn=128;s->ySpawn=64;s->gameType=1;s->stopTime=5000;}
U0 LevelData_Destroy(LevelData *s){Tag_DeleteDeep(s->playerTag);s->playerTag=NULL;MCString_Destroy(&s->levelName);}
U0 LevelData_setPlayerTag(LevelData *s,CompoundTag *tag){CompoundTag *copy=NULL;if(tag)copy=Tag_copy(tag)(CompoundTag*);Tag_DeleteDeep(s->playerTag);s->playerTag=copy;}
U0 LevelData_Copy(LevelData *s,LevelData *other){if(s==other)return;MCString name;MCString_CopyInit(&name,&other->levelName);CompoundTag *copy=NULL;if(other->playerTag)copy=Tag_copy(other->playerTag)(CompoundTag*);LevelData_Destroy(s);*s=*other;s->levelName=name;s->playerTag=copy;}
U0 LevelData_InitSettings(LevelData *s,I32 seed,I32 game,I32 generator,U8 *name){LevelData_Init(s);s->seed=seed;s->gameType=game;s->generatorVersion=generator;if(generator<0)s->generatorVersion=0;s->spawnMobs=game==0;s->stopTime=5000;if(s->spawnMobs)s->stopTime=-1;MC024_SetString(&s->levelName,name);}
U0 LevelData_getTagData(LevelData *s,CompoundTag *tag){if(!tag)return;s->seed=MC024_Long(tag,"RandomSeed");s->gameType=MC024_Int(tag,"GameType");s->xSpawn=MC024_Int(tag,"SpawnX");s->ySpawn=MC024_Int(tag,"SpawnY");s->zSpawn=MC024_Int(tag,"SpawnZ");s->time=MC024_Long(tag,"Time");s->lastPlayed=MC024_Long(tag,"LastPlayed");s->sizeOnDisk=MC024_Long(tag,"SizeOnDisk");MCString name;MC024_GetString(tag,"LevelName",&name);MCString_Assign(&s->levelName,&name);MCString_Destroy(&name);s->storageVersion=MC024_Int(tag,"StorageVersion");s->stopTime=-1;if(s->gameType==1)s->stopTime=5000;/* Source overrides stored stop time unconditionally. */s->spawnMobs=s->gameType!=1;if(s->gameType==1 && MC024_Contains(tag,"spawnMobs",1))s->spawnMobs=MC023_NBTGet(tag,"spawnMobs",TRUE)!=0;if(MC024_Contains(tag,"Player",10))LevelData_setPlayerTag(s,MC023_TagGet(tag,"Player")(CompoundTag*));}
U0 LevelData_setTagData(LevelData *s,CompoundTag *tag,CompoundTag *ownedPlayer,I32 epoch){MC024_PutLong(tag,"RandomSeed",s->seed);MC024_PutInt(tag,"GameType",s->gameType);MC024_PutInt(tag,"SpawnX",s->xSpawn);MC024_PutInt(tag,"SpawnY",s->ySpawn);MC024_PutInt(tag,"SpawnZ",s->zSpawn);MC024_PutLong(tag,"Time",s->time);MC024_PutLong(tag,"SizeOnDisk",s->sizeOnDisk);MC024_PutLong(tag,"LastPlayed",epoch);MC024_PutString(tag,"LevelName",&s->levelName);MC024_PutInt(tag,"StorageVersion",s->storageVersion);MC024_PutInt(tag,"Platform",2);MC024_PutInt(tag,"dayCycleStopTime",s->stopTime);MC023_NBTPut(tag,"spawnMobs",s->spawnMobs,TRUE);if(ownedPlayer)MC023_TagPut(tag,"Player",ownedPlayer);}
CompoundTag *LevelData_createTag(LevelData *s,I32 epoch){CompoundTag *out=MC_Alloc(sizeof(CompoundTag));CompoundTag_InitEmpty(out);CompoundTag *player=NULL;if(s->playerTag)player=Tag_copy(s->playerTag)(CompoundTag*);LevelData_setTagData(s,out,player,epoch);return out;}
