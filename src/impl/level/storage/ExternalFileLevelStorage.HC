// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 ExternalFileLevelStorage_Init(ExternalFileLevelStorage *s,U8 *folder){memset(s,0,sizeof(ExternalFileLevelStorage));MCString_FromC(&s->folder,folder);RegionFile_Init(&s->region,folder);MCVector_Init(&s->pending,sizeof(MCUnsaved024));}
Bool ExternalFileLevelStorage_readLevelData(U8 *folder,LevelData *out){MCString path;MCString_FromC(&path,folder);MCString_AppendBytes017(&path,"/level.dat",10);MCVector bytes;MC024_BytesInit(&bytes);Bool ok=MC024_ReadFile(path.data,&bytes);if(!ok){MCString_AppendBytes017(&path,"_old",4);ok=MC024_ReadFile(path.data,&bytes);}MCString_Destroy(&path);if(!ok || bytes.size<8){MCVector_Destroy(&bytes);return FALSE;}I32 version,length;memcpy(&version,bytes.data,4);memcpy(&length,bytes.data+4,4);ok=FALSE;if(version>1 && length>0 && length<=bytes.size-8){MCMemoryInput in;MCMemoryInput_Init(&in,bytes.data+8,length);Tag *tag=NbtIo_read(&in);if(tag && !in.failed){LevelData_getTagData(out,tag(CompoundTag*));ok=TRUE;}Tag_DeleteDeep(tag);}MCVector_Destroy(&bytes);return ok;/* Invalid contents return FALSE, unlike source's success-on-open. v1/RakString is not implemented here. */}
Bool ExternalFileLevelStorage_writeLevelData(U8 *folder,LevelData *data,I32 epoch){if(data->storageVersion<2)return FALSE;MCString path;MCString_FromC(&path,folder);MCString_AppendBytes017(&path,"/level.dat",10);CompoundTag *tag=LevelData_createTag(data,epoch);MCMemoryOutput bytes;MCMemoryOutput_Init(&bytes);Tag_writeNamedTag(tag,&bytes);I32 version=data->storageVersion;I32 length=bytes.bytes.size;U0 *file=fopen(path.data,"wb");Bool ok=FALSE;if(file){ok=fwrite(&version,4,1,file)==1 && fwrite(&length,4,1,file)==1 && fwrite(bytes.bytes.data,1,length,file)==length;fclose(file);}MCString_Destroy(&path);Tag_DeleteDeep(tag);MCMemoryOutput_Destroy(&bytes);return ok;/* Atomic backup/rename lifecycle remains unimplemented, not silently simulated. */}
U0 ExternalFileLevelStorage_queue(ExternalFileLevelStorage *s,I32 x,I32 z,MCVector *data){I32 i;MCUnsaved024 *a=s->pending.data(MCUnsaved024*);for(i=0;i<s->pending.size;i++)if(a[i].x==x && a[i].z==z){MCVector_Reserve(&a[i].bytes,data->size);memcpy(a[i].bytes.data,data->data,data->size);a[i].bytes.size=data->size;return;}MCUnsaved024 e;e.x=x;e.z=z;MC024_BytesInit(&e.bytes);MCVector_Reserve(&e.bytes,data->size);memcpy(e.bytes.data,data->data,data->size);e.bytes.size=data->size;MCVector_Push(&s->pending,&e);}
I32 ExternalFileLevelStorage_savePendingUnsavedChunks(ExternalFileLevelStorage *s,I32 count){if(!s->region.file && !RegionFile_open(&s->region))return 0;I32 done=0;while(s->pending.size>0 && done<count){MCUnsaved024 *a=s->pending.data(MCUnsaved024*);if(!RegionFile_writeChunk(&s->region,a[0].x,a[0].z,&a[0].bytes))break;MCVector_Destroy(&a[0].bytes);MCVector_Erase(&s->pending,0);done++;}return done;}
U0 ExternalFileLevelStorage_Destroy(ExternalFileLevelStorage *s){I32 i;MCUnsaved024 *a=s->pending.data(MCUnsaved024*);for(i=0;i<s->pending.size;i++)MCVector_Destroy(&a[i].bytes);MCVector_Destroy(&s->pending);RegionFile_Destroy(&s->region);MCString_Destroy(&s->folder);}
