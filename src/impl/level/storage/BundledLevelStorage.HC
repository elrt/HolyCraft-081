Bool BundledLevelStorage_getChunkData(BundledLevelStorage *s,I32 x,I32 z,MCString *out) {MCString_Init(out);if(!(s->host->readAsset!=NULL))return FALSE;MCString path,file;MC022_ChunkPath(&path,x,z);MCString_Init(&file);Bool ok=s->host->readAsset(s->host->ctx,&path,&file);MCString_Destroy(&path);if(!ok || file.size<4){MCString_Destroy(&file);return FALSE;}U64 size=file.data[0]|(file.data[1]<<8)|(file.data[2]<<16)|(file.data[3]<<24);if(size==0 || size>16777216){MCString_Destroy(&file);return FALSE;}U8 *data=MC_Alloc(size+1);I32 rc=uncompress(data,&size,file.data+4,file.size-4);MCString_Destroy(&file);if(rc!=0){free(data);return FALSE;}data[size]=0;out->data=data;out->size=size;return TRUE;}
MCBundledChunk022 *BundledLevelStorage_load(BundledLevelStorage *s,I32 x,I32 z) {MCString raw;if(!BundledLevelStorage_getChunkData(s,x,z,&raw))return NULL;if(raw.size<MC022_CHUNK_BYTES){MCString_Destroy(&raw);return NULL;}MCBundledChunk022 *c=MC_Alloc(sizeof(MCBundledChunk022));memset(c,0,sizeof(MCBundledChunk022));c->x=x;c->z=z;memcpy(c->tiles,raw.data,32768);memcpy(c->meta,raw.data+32768,16384);memcpy(c->sky,raw.data+49152,16384);memcpy(c->block,raw.data+65536,16384);memcpy(c->update,raw.data+81920,256);MCString_Destroy(&raw);if((s->host->heightmap!=NULL))s->host->heightmap(s->host->ctx,c);c->unsaved=TRUE;c->decorated=TRUE;c->loaded=TRUE;return c;}
Bool BundledLevelStorage_saveAsset022(BundledLevelStorage *s,MCBundledChunk022 *c) {if(!(s->host->writeAsset!=NULL))return FALSE;U8 *raw=MC_Alloc(MC022_CHUNK_BYTES);memcpy(raw,c->tiles,32768);memcpy(raw+32768,c->meta,16384);memcpy(raw+49152,c->sky,16384);memcpy(raw+65536,c->block,16384);memcpy(raw+81920,c->update,256);U64 size=compressBound(MC022_CHUNK_BYTES);U8 *data=MC_Alloc(size+5);I32 rc=compress2(data+4,&size,raw,MC022_CHUNK_BYTES,-1);free(raw);if(rc!=0){free(data);return FALSE;}U32 bytes=MC022_CHUNK_BYTES;I32 i;for(i=0;i<4;i++)data[i]=bytes>>(8*i);MCString file,path;file.data=data;file.size=size+4;data[file.size]=0;MC022_ChunkPath(&path,c->x,c->z);Bool ok=s->host->writeAsset(s->host->ctx,&path,&file);MCString_Destroy(&path);MCString_Destroy(&file);return ok;}
