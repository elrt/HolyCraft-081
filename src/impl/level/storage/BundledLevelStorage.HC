U0 BundledLevelStorage_prepareLevel(BundledLevelStorage *s) {s->gameType=1;s->spawnMobs=FALSE;I64 i;for(i=0;i+8<=s->name.size;i++)if(!memcmp(s->name.data+i,"survival",8)){s->gameType=0;s->spawnMobs=TRUE;break;}MCString seed;MCString_FromC(&seed,"Nya1n");s->generatorSeed=Util_hashCode(&seed);MCString_Destroy(&seed);}
