// Batch023: level/BiomeSource; explicit simulation ABI, see docs/BATCH023.md.
U0 BiomeSource_Init(BiomeSource *s,I32 seed) {memset(s,0,sizeof(BiomeSource));Random_setSeed(&s->seeds[0],(seed*9871)(I32));PerlinNoise_InitRandom(&s->temperatureNoise,&s->seeds[0],4);Random_setSeed(&s->seeds[1],(seed*39811)(I32));PerlinNoise_InitRandom(&s->rainNoise,&s->seeds[1],4);Random_setSeed(&s->seeds[2],(seed*543321)(I32));PerlinNoise_InitRandom(&s->detailNoise,&s->seeds[2],2);}
U0 BiomeSource_Destroy(BiomeSource *s) {PerlinNoise_Destroy(&s->temperatureNoise);PerlinNoise_Destroy(&s->rainNoise);PerlinNoise_Destroy(&s->detailNoise);free(s->temperatures);free(s->rainfall);free(s->details);free(s->biomes);memset(s,0,sizeof(BiomeSource));}
Bool BiomeSource_capacity(BiomeSource *s,I32 w,I32 h) {if(w<=0 || h<=0 || w>4096 || h>4096 || w*h>1048576)return FALSE;I32 n=w*h;if(n<=s->capacity)return TRUE;free(s->temperatures);free(s->rainfall);free(s->details);free(s->biomes);s->temperatures=MC_Alloc(n*sizeof(F32));s->rainfall=MC_Alloc(n*sizeof(F32));s->details=MC_Alloc(n*sizeof(F32));s->biomes=MC_Alloc(n*sizeof(Biome*));s->capacity=n;return TRUE;}
F32 BiomeSource_clamp(F32 t) {if(t<0)return 0;if(t>1)return 1;return t;}
F32 *BiomeSource_getTemperatureBlock(BiomeSource *s,I32 x,I32 z,I32 w,I32 h) {if(!BiomeSource_capacity(s,w,h))return NULL;PerlinNoise_getRegion2(&s->temperatureNoise,s->temperatures,x,z,w,h,0.025,0.025,0.25);PerlinNoise_getRegion2(&s->detailNoise,s->details,x,z,w,h,0.25,0.25,0.588);I32 i;for(i=0;i<w*h;i++){F32 d=s->details[i]*1.1;d+=0.5;d*=0.01;F32 t=s->temperatures[i]*0.15;t+=0.7;t*=0.99;F32 v=1.0-(d+t);F32 vv=v*v;s->temperatures[i]=BiomeSource_clamp(1.0-vv);}return s->temperatures;}
Biome **BiomeSource_getBiomeBlock(BiomeSource *s,I32 x,I32 z,I32 w,I32 h) {if(!BiomeSource_capacity(s,w,h))return NULL;/* Deliberate memory-safety fix: original passes w,w even for rectangular requests. */PerlinNoise_getRegion2(&s->temperatureNoise,s->temperatures,x,z,w,h,0.025,0.025,0.25);PerlinNoise_getRegion2(&s->rainNoise,s->rainfall,x,z,w,h,0.05,0.05,0.3333);PerlinNoise_getRegion2(&s->detailNoise,s->details,x,z,w,h,0.25,0.25,0.588);I32 i;for(i=0;i<w*h;i++){F32 d=s->details[i]*1.1;d+=0.5;F32 t=s->temperatures[i]*0.15;t+=0.7;t*=0.99;t+=d*0.01;F32 a=BiomeSource_clamp(1.0-(1.0-t)*(1.0-t)),b=BiomeSource_clamp(d*0.002+(s->rainfall[i]*0.15+0.5)*0.998);s->temperatures[i]=a;s->rainfall[i]=b;s->biomes[i]=Biome_getBiome(a,b);}return s->biomes;}
Biome *BiomeSource_getBiome(BiomeSource *s,I32 x,I32 z) {Biome **v=BiomeSource_getBiomeBlock(s,x,z,1,1);if(v)return v[0];return NULL;}
