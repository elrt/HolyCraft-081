// Batch022: level/Region; explicit host ABI, see docs/BATCH022.md.
Bool Region_Init(Region *s,MCRegionHost022 *host,I32 minX,I32 minZ,I32 maxX,I32 maxZ) {memset(s,0,sizeof(Region));s->host=host;s->minCX=minX>>4;s->minCZ=minZ>>4;s->sizeX=(maxX>>4)-s->minCX+1;s->sizeZ=(maxZ>>4)-s->minCZ+1;if(s->sizeX<=0 || s->sizeZ<=0 || s->sizeX>4096 || s->sizeZ>4096 || s->sizeX(I64)*s->sizeZ>1048576)return FALSE;s->chunks=MC_Alloc(s->sizeX(I64)*s->sizeZ*sizeof(U0*));I32 x,z;for(x=0;x<s->sizeX;x++)for(z=0;z<s->sizeZ;z++){U0 *c=NULL;if((host->getChunk!=NULL))c=host->getChunk(host->ctx,s->minCX+x,s->minCZ+z);s->chunks[x*s->sizeZ+z]=c;}return TRUE;}
U0 Region_Destroy(Region *s) {free(s->chunks);s->chunks=NULL;}
U0 *MC022_RegionChunk(Region *s,I32 x,I32 z) {I32 cx=(x>>4)-s->minCX,cz=(z>>4)-s->minCZ;if(!s->chunks || cx<0 || cz<0 || cx>=s->sizeX || cz>=s->sizeZ)return NULL;return s->chunks[cx*s->sizeZ+cz];}
I32 Region_getTile(Region *s,I32 x,I32 y,I32 z) {if(y<0 || y>127)return 0;U0 *c=MC022_RegionChunk(s,x,z);if(!c || !(s->host->tile!=NULL))return 0;return s->host->tile(s->host->ctx,c,x&15,y,z&15);}
I32 Region_getData(Region *s,I32 x,I32 y,I32 z) {if(y<0 || y>127)return 0;U0 *c=MC022_RegionChunk(s,x,z);if(!c || !(s->host->data!=NULL))return 0;return s->host->data(s->host->ctx,c,x&15,y,z&15);}
I32 Region_getRawBrightness(Region *s,I32 x,I32 y,I32 z,Bool complex) {if(x< -32000000 || z< -32000000 || x>31999999 || z>32000000)return 15;I32 tile=Region_getTile(s,x,y,z);if(complex && (tile==s->host->stoneSlab || tile==s->host->farmland || tile==s->host->woodSlab)){I32 a=Region_getRawBrightness(s,x,y+1,z,FALSE),v;v=Region_getRawBrightness(s,x+1,y,z,FALSE);if(v>a)a=v;v=Region_getRawBrightness(s,x-1,y,z,FALSE);if(v>a)a=v;v=Region_getRawBrightness(s,x,y,z+1,FALSE);if(v>a)a=v;v=Region_getRawBrightness(s,x,y,z-1,FALSE);if(v>a)a=v;return a;}if(y<0)return 0;if(y>127){I32 sky=15-s->host->skyDarken;if(sky<0)sky=0;return sky;}U0 *c=MC022_RegionChunk(s,x,z);if(!c || !(s->host->rawLight!=NULL))return 0;return s->host->rawLight(s->host->ctx,c,x&15,y,z&15,s->host->skyDarken);}
F32 Region_getBrightness(Region *s,I32 x,I32 y,I32 z) {I32 raw=Region_getRawBrightness(s,x,y,z,TRUE);if(raw<0)raw=0;if(raw>15)raw=15;return s->host->lightRamp[raw];}
Bool Region_isEmptyTile(Region *s,I32 x,I32 y,I32 z) {I32 id=Region_getTile(s,x,y,z);if(!(s->host->registered!=NULL))return TRUE;return !s->host->registered(s->host->ctx,id);}
U0 *Region_getMaterial(Region *s,I32 x,I32 y,I32 z) {if(!(s->host->material!=NULL))return NULL;return s->host->material(s->host->ctx,Region_getTile(s,x,y,z));}
Bool Region_isSolidRenderTile(Region *s,I32 x,I32 y,I32 z) {I32 id=Region_getTile(s,x,y,z);return (s->host->registered!=NULL) && s->host->registered(s->host->ctx,id) && (s->host->solidRender!=NULL) && s->host->solidRender(s->host->ctx,id);}
Bool Region_isSolidBlockingTile(Region *s,I32 x,I32 y,I32 z) {I32 id=Region_getTile(s,x,y,z);return (s->host->registered!=NULL) && s->host->registered(s->host->ctx,id) && (s->host->solidBlocking!=NULL) && s->host->solidBlocking(s->host->ctx,id) && (s->host->cube!=NULL) && s->host->cube(s->host->ctx,id);}
U0 *Region_getBiome(Region *s,I32 x,I32 z) {if(!(s->host->biome!=NULL))return NULL;return s->host->biome(s->host->ctx,x,z);}
