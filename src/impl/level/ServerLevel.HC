U0 ServerLevel_Init(ServerLevel *s,MCServerHost014 *h){s->host=h;s->allSleeping=FALSE;}Bool ServerLevel_allPlayersSleeping(ServerLevel *s){MCServerHost014 *h=s->host;I32 i;if(!s->allSleeping||h->isClient)return FALSE;for(i=0;i<h->playerCount(h->host);i++)if(!h->playerAt(h->host,i)->longEnough)return FALSE;return TRUE;}U0 ServerLevel_awakenAllPlayers(ServerLevel *s){MCServerHost014 *h=s->host;MCSummaryPlayer014 *p;I32 i;s->allSleeping=FALSE;for(i=0;i<h->playerCount(h->host);i++){p=h->playerAt(h->host,i);if(p->sleeping){h->stopSleep(h->host,p,FALSE,FALSE,TRUE);p->health=20;p->prevHealth=20;}}h->sendHealth(h->host,20);}U0 ServerLevel_tick(ServerLevel *s){MCServerHost014 *h=s->host;I32 t;h->baseTick(h->host);if(ServerLevel_allPlayersSleeping(s)){t=h->getTime(h->host)+19200;h->setTime(h->host,t-t%19200);t=h->getTime(h->host);h->sendTime(h->host,t,(h->stopTime(U32)>>31)!=0);ServerLevel_awakenAllPlayers(s);}}U0 ServerLevel_updateSleepingPlayerList(ServerLevel *s){MCServerHost014 *h=s->host;Bool old=s->allSleeping;I32 i,n=h->playerCount(h->host);s->allSleeping=n!=0;for(i=0;i<n;i++)if(!h->playerAt(h->host,i)->sleeping){s->allSleeping=FALSE;break;}if(!old && s->allSleeping){h->event(h->host,9800,0,0,0,0);for(i=0;i<n;i++)h->setAllSleeping(h->host,h->playerAt(h->host,i));}}
