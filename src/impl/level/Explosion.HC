// Batch023: level/Explosion; explicit simulation ABI, see docs/BATCH023.md.
U0 Explosion_Init(Explosion *s,MCWorld023 *w,MCBody023 *source,F32 x,F32 y,F32 z,F32 radius,Bool fire) {memset(s,0,sizeof(Explosion));s->w=w;s->source=source;s->x=x;s->y=y;s->z=z;s->radius=radius;s->fire=fire;Random_setSeed(&s->rng,1);MCVector_Init(&s->affected,sizeof(TilePos));}
U0 Explosion_Destroy(Explosion *s) {MCVector_Destroy(&s->affected);}
U0 Explosion_add(Explosion *s,I32 x,I32 y,I32 z) {TilePos *a=s->affected.data(TilePos*);I32 i;for(i=0;i<s->affected.size;i++)if(a[i].x==x && a[i].y==y && a[i].z==z)return;TilePos p;p.x=x;p.y=y;p.z=z;MCVector_Push(&s->affected,&p);}
U0 Explosion_explode(Explosion *s) {I32 a,b,c;if(s->radius<=0)return;for(a=0;a<16;a++)for(b=0;b<16;b++)for(c=0;c<16;c++)if(a==0 || a==15 || b==0 || b==15 || c==0 || c==15){F32 dx=a/15.0*2-1,dy=b/15.0*2-1,dz=c/15.0*2-1,len=sqrtf(dx*dx+dy*dy+dz*dz);dx/=len;dy/=len;dz/=len;F32 energy=s->radius*(Random_nextFloat(&s->w->random)*0.6+0.7),x=s->x,y=s->y,z=s->z;while(energy>0){I32 ix=floorf(x),iy=floorf(y),iz=floorf(z),id=MC023_Tile(s->w,ix,iy,iz);MCTileDef023 *t=MC023_Def(s->w,id);if(id>0 && t)energy-=(t->resistance+0.3)*0.3;if(energy>0)Explosion_add(s,ix,iy,iz);x+=dx*0.3;y+=dy*0.3;z+=dz*0.3;energy-=0.225;}}
F32 rr=s->radius*2;I32 old=s->radius;MCPtrVector v;MC023_Entities(s->w,s->source,floorf(s->x-rr-1),floorf(s->y-rr-1),floorf(s->z-rr-1),floorf(s->x+rr+1),floorf(s->y+rr+1),floorf(s->z+rr+1),&v);I32 i;for(i=0;i<v.size;i++){MCBody023 *e=v.data[i];if(!e)continue;F32 dx=e->x-s->x,dy=e->y-s->y,dz=e->z-s->z,len=sqrtf(dx*dx+dy*dy+dz*dz),distance=len/rr;if(distance>1 || len==0)continue;/* Occlusion fraction supplied by world value op 100; without it damage is NOT assumed visible. */F32 seen=0;if(s->w->value!=NULL)seen=s->w->value(s->w->ctx,100,e->id,0,0);F32 impact=(1-distance)*seen;MC023_Hurt(e,s->source,((impact+impact*impact)*0.5*8*rr+1)(I32));e->motionX+=dx/len*impact;e->motionY+=dy/len*impact;e->motionZ+=dz/len*impact;}MCPtrVector_Destroy(&v);s->radius=old;/* Original truncates fractional radius when restoring. */if(s->fire){TilePos *p=s->affected.data(TilePos*);for(i=0;i<s->affected.size;i++)if(!MC023_Tile(s->w,p[i].x,p[i].y,p[i].z) && MC023_Solid(s->w,p[i].x,p[i].y-1,p[i].z) && Random_genrand_int32(&s->rng)%3==0)MC023_Set(s->w,MC023_SET_TILE,p[i].x,p[i].y,p[i].z,s->w->registry->fire,0,0);}}
U0 Explosion_finalizeExplosion(Explosion *s) {MC023_Sound(s->w,"random.explode",s->x,s->y,s->z,4.0,((Random_nextFloat(&s->w->random)-Random_nextFloat(&s->w->random))*0.2+1)*0.7);TilePos *p=s->affected.data(TilePos*);I32 i;for(i=0;i<s->affected.size;i++){I32 x=p[i].x,y=p[i].y,z=p[i].z,id=MC023_Tile(s->w,x,y,z),meta=MC023_Data(s->w,x,y,z);if((i&7)==0){F32 px=x+Random_nextFloat(&s->w->random),py=y+Random_nextFloat(&s->w->random),pz=z+Random_nextFloat(&s->w->random),dx=px-s->x,dy=py-s->y,dz=pz-s->z,d=sqrtf(dx*dx+dy*dy+dz*dz);if(d>0){F32 speed=0.5/(s->radius*d+0.1)*(Random_nextFloat(&s->w->random)*Random_nextFloat(&s->w->random)+0.3);dx=dx/d*speed;dy=dy/d*speed;dz=dz/d*speed;MC023_Particle(s->w,3,(px+s->x)*0.5,(py+s->y)*0.5,(pz+s->z)*0.5,dx,dy,dz);MC023_Particle(s->w,1,px,py,pz,dx,dy,dz);}}if(id>0){if(!s->w->isClient && !s->w->creative)MC023_Event(s->w,MC023_DROP,x,y,z,id,meta,30);if(MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,0))MC023_Event(s->w,MC023_NEIGHBOR,x,y,z,id,0,0);MC023_Event(s->w,MC023_DIRTY,x,y,z,id,0,0);if(!s->w->isClient)MC023_Event(s->w,MC023_EXPLODE,x,y,z,id,meta,0,s);}}/* Unique vector order differs from unordered_set iteration; final particle RNG order is not bit-identical. */}
