// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 LevelChunk_Init(LevelChunk *s,MCRegistry023 *r,I32 x,I32 z){memset(s,0,sizeof(LevelChunk));s->registry=r;s->chunkX=x;s->chunkZ=z;s->tiles=MC_Alloc(32768);memset(s->tiles,0,32768);DataLayer_Init(&s->tileMeta,32768);DataLayer_Init(&s->skyLight,32768);DataLayer_Init(&s->blockLight,32768);MCVector_Init(&s->blockEntities,sizeof(MCTileEntity025));}
U0 LevelChunk_Destroy(LevelChunk *s){free(s->tiles);s->tiles=NULL;DataLayer_Destroy(&s->tileMeta);DataLayer_Destroy(&s->skyLight);DataLayer_Destroy(&s->blockLight);MCVector_Destroy(&s->blockEntities);}
Bool MC025_Local(I32 x,I32 y,I32 z){return x>=0 && x<16 && z>=0 && z<16 && y>=0 && y<128;}
I32 LevelChunk_getTile(LevelChunk *s,I32 x,I32 y,I32 z){if(!MC025_Local(x,y,z))return 0;return s->tiles[y|(x<<11)|(z<<7)];}
I32 LevelChunk_getData(LevelChunk *s,I32 x,I32 y,I32 z){if(!MC025_Local(x,y,z))return 0;return DataLayer_get(&s->tileMeta,x,y,z);}
U0 LevelChunk_setTileRaw(LevelChunk *s,I32 x,I32 y,I32 z,I32 id){if(MC025_Local(x,y,z))s->tiles[y|(x<<11)|(z<<7)]=id;}
U0 LevelChunk_recalcColumn(LevelChunk *s,I32 x,I32 z,I32 start){I32 y=start;if(y>128)y=128;while(y>0 && !s->registry->tiles[LevelChunk_getTile(s,x,y-1,z)].opacity)y--;s->heightMap[x+16*z]=y;s->topBlockY=127;I32 i;for(i=0;i<256;i++)if(s->heightMap[i]<s->topBlockY)s->topBlockY=s->heightMap[i];}
U0 LevelChunk_recalcHeightmap(LevelChunk *s){I32 x,z,y,h,light;I32 min=127;for(x=0;x<16;x++)for(z=0;z<16;z++){h=127;while(h>0 && !s->registry->tiles[LevelChunk_getTile(s,x,h-1,z)].opacity)h--;s->heightMap[x+16*z]=h;if(h<min)min=h;if(!s->hasNoSky){light=15;for(y=127;y>0 && light>0;y--){light-=s->registry->tiles[LevelChunk_getTile(s,x,y,z)].opacity;if(light>0)DataLayer_set(&s->skyLight,x,y,z,light);}}}s->topBlockY=min;}
Bool LevelChunk_setData(LevelChunk *s,I32 x,I32 y,I32 z,I32 n){if(!MC025_Local(x,y,z))return FALSE;s->unsaved=TRUE;if(DataLayer_get(&s->tileMeta,x,y,z)==n)return FALSE;DataLayer_set(&s->tileMeta,x,y,z,n);return TRUE;}
Bool LevelChunk_setTileAndData(LevelChunk *s,I32 x,I32 y,I32 z,I32 id,I32 meta){if(!MC025_Local(x,y,z) || id<0 || id>255)return FALSE;I32 idx=y|(x<<11)|(z<<7),old=s->tiles[idx];if(old==id && LevelChunk_getData(s,x,y,z)==meta)return FALSE;s->tiles[idx]=id;DataLayer_set(&s->tileMeta,x,y,z,meta);LevelChunk_recalcColumn(s,x,z,128);s->unsaved=TRUE;s->updateMap[x+16*z]|=1<<(y>>4);return TRUE;}
Bool LevelChunk_setTile(LevelChunk *s,I32 x,I32 y,I32 z,I32 id){if(LevelChunk_getTile(s,x,y,z)==id)return FALSE;return LevelChunk_setTileAndData(s,x,y,z,id,0);}
I32 LevelChunk_getHeightmap(LevelChunk *s,I32 x,I32 z){if(x<0 || z<0 || x>15 || z>15)return 0;return s->heightMap[x+16*z];}
I32 LevelChunk_getBrightness(LevelChunk *s,I32 layer,I32 x,I32 y,I32 z){if(!MC025_Local(x,y,z))return 0;if(layer==0)return DataLayer_get(&s->skyLight,x,y,z);if(layer==1)return DataLayer_get(&s->blockLight,x,y,z);return 0;}
U0 LevelChunk_setBrightness(LevelChunk *s,I32 layer,I32 x,I32 y,I32 z,I32 n){if(!MC025_Local(x,y,z))return;if(layer==0)DataLayer_set(&s->skyLight,x,y,z,n);if(layer==1)DataLayer_set(&s->blockLight,x,y,z,n);}
I32 LevelChunk_getRawBrightness(LevelChunk *s,I32 x,I32 y,I32 z,I32 dark){I32 sky=LevelChunk_getBrightness(s,0,x,y,z),block=LevelChunk_getBrightness(s,1,x,y,z);if(sky>0)LevelChunk_touchedSky025=TRUE;sky-=dark;if(block<sky)return sky;return block;}
U0 LevelChunk_clearUpdateMap(LevelChunk *s){memset(s->updateMap,0,256);s->unsaved=FALSE;}
U0 LevelChunk_pack(LevelChunk *s,MCVector *out){MCVector_Reserve(out,82176);out->size=82176;memcpy(out->data,s->tiles,32768);memcpy(out->data+32768,s->tileMeta.data,16384);memcpy(out->data+49152,s->skyLight.data,16384);memcpy(out->data+65536,s->blockLight.data,16384);memcpy(out->data+81920,s->updateMap,256);}
Bool LevelChunk_unpack(LevelChunk *s,MCVector *in,I32 version){I32 need=82176;if(version==0)need=49408;if(in->size<need || version<0 || version==1)return FALSE;memcpy(s->tiles,in->data,32768);memcpy(s->tileMeta.data,in->data+32768,16384);I32 offset=49152;if(version>0){memcpy(s->skyLight.data,in->data+offset,16384);memcpy(s->blockLight.data,in->data+offset+16384,16384);offset+=32768;}memcpy(s->updateMap,in->data+offset,256);LevelChunk_recalcHeightmap(s);s->decorated=TRUE;s->unsaved=FALSE;return TRUE;}
U0 LevelChunk_getRandom(LevelChunk *s,I32 seed,I32 extra,Random *out){I32 x=s->chunkX,z=s->chunkZ;I32 a=(4987142*x*x)(I32),b=(5947611*x)(I32),c=(4392871*z*z)(I32),d=(389711*z)(I32);Random_setSeed(out,((seed+a+b+c+d)(I32))^extra);}
