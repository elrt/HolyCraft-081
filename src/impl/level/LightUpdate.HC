// Batch023: level/LightUpdate; explicit simulation ABI, see docs/BATCH023.md.
U0 LightUpdate_Init(LightUpdate *s,I32 layer,I32 x1,I32 y1,I32 z1,I32 x2,I32 y2,I32 z2) {s->layer=layer;s->x1=x1;s->y1=y1;s->z1=z1;s->x2=x2;s->y2=y2;s->z2=z2;}
Bool LightUpdate_expandToContain(LightUpdate *s,I32 a,I32 b,I32 c,I32 d,I32 e,I32 f) {if(a>=s->x1 && b>=s->y1 && c>=s->z1 && d<=s->x2 && e<=s->y2 && f<=s->z2)return TRUE;if(a<s->x1-1 || b<s->y1-1 || c<s->z1-1 || d>s->x2+1 || e>s->y2+1 || f>s->z2+1)return FALSE;I32 aa=a,bb=b,cc=c,dd=d,ee=e,ff=f;if(aa>s->x1)aa=s->x1;if(bb>s->y1)bb=s->y1;if(cc>s->z1)cc=s->z1;if(dd<s->x2)dd=s->x2;if(ee<s->y2)ee=s->y2;if(ff<s->z2)ff=s->z2;I64 old=(s->x2-s->x1)*(s->y2-s->y1)*(s->z2-s->z1),n=(dd-aa)*(ee-bb)*(ff-cc);if(n-old>2)return FALSE;s->x1=aa;s->y1=bb;s->z1=cc;s->x2=dd;s->y2=ee;s->z2=ff;return TRUE;}
I32 LightUpdate_update(LightUpdate *s,MCWorld023 *w) {I64 volume=(s->x2-s->x1+1)(I64)*(s->y2-s->y1+1)*(s->z2-s->z1+1);if(volume>32768 || volume<0)return 0;if(s->y1<0)s->y1=0;if(s->y2>127)s->y2=127;I32 x,y,z,i,n,changed=0,op=MC023_LIGHT;if(!s->layer)op=7;I32 dx[6]={-1,1,0,0,0,0},dy[6]={0,0,-1,1,0,0},dz[6]={0,0,0,0,-1,1};for(x=s->x1;x<=s->x2;x++)for(z=s->z1;z<=s->z2;z++){if(!MC023_Get(w,MC023_READY,x,0,z))continue;for(y=s->y1;y<=s->y2;y++){I32 old=MC023_Get(w,op,x,y,z),opacity=1,emission=0;MCTileDef023 *t=MC023_Def(w,MC023_Tile(w,x,y,z));if(t){opacity=t->opacity;emission=t->emission;}if(opacity<1)opacity=1;if(!s->layer){emission=0;if(MC023_Get(w,MC023_SKY,x,y,z))emission=15;}n=0;if(opacity<=14 || emission){for(i=0;i<6;i++){I32 v=MC023_Get(w,op,x+dx[i],y+dy[i],z+dz[i]);if(v>n)n=v;}n-=opacity;if(n<0)n=0;if(n<emission)n=emission;}if(n==old)continue;MC023_Set(w,MC023_SET_LIGHT,x,y,z,s->layer,n,0);changed++;I32 p=n-1;if(p<0)p=0;for(i=0;i<6;i++)if(i==0 || i==2 || i==4 || i==1 && x+1>=s->x2 || i==3 && y+1>=s->y2 || i==5 && z+1>=s->z2)MC023_Event(w,MC023_NEIGHBOR,x+dx[i],y+dy[i],z+dz[i],s->layer,p,0);}}return changed;}
