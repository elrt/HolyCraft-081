// Batch022: android/AndroidRestRequestJob; explicit host ABI, see docs/BATCH022.md.
I32 MC022_RequestId=1;
MCNativeMutex MC022_IdLock;
Bool MC022_IdLockReady=FALSE;
// Initialization must precede launching worker threads (Init is UI-thread only).
I32 MC022_NextId() {if(!MC022_IdLockReady){MCThread_Check(pthread_mutex_init(MC_MutexAddress(&MC022_IdLock)));MC022_IdLockReady=TRUE;}MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&MC022_IdLock)));I32 id=++MC022_RequestId;MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&MC022_IdLock)));return id;}
U0 MC022_AndroidRunHook(Job *s) {AndroidRestRequestJob_run(s);}U0 MC022_AndroidStopHook(Job *s) {AndroidRestRequestJob_stop(s);}U0 MC022_AndroidFinishHook(Job *s) {AndroidRestRequestJob_finish(s);}
U0 AndroidRestRequestJob_Init(RestRequestJob *s,RestService *service,I32 type,MCRestBackend022 *backend) {RestRequestJob_Init(s,service,type);s->backend=backend;s->requestId=MC022_NextId();s->runFn=&MC022_AndroidRunHook;s->stopFn=&MC022_AndroidStopHook;s->finishFn=&MC022_AndroidFinishHook;}
Bool AndroidRestRequestJob_isRunning(RestRequestJob *s) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));Bool b=s->started;MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));return b;}
U0 AndroidRestRequestJob_onRequestComplete(RestRequestJob *s,I32 id,I32 code,MCString *data) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));if(id==s->requestId && !s->completed){s->httpCode=code;MCString_Assign(&s->response,data);s->completed=TRUE;MCThread_Check(pthread_cond_broadcast(MC_CondAddress(&s->ready)));}MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));}
U0 AndroidRestRequestJob_stop(RestRequestJob *s) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));Job_trySetStatus(s,JS_STOPPED);s->started=FALSE;s->completed=TRUE;MCThread_Check(pthread_cond_broadcast(MC_CondAddress(&s->ready)));MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));if(s->backend && (s->backend->abort!=NULL))s->backend->abort(s->backend->ctx,s->requestId);}
U0 AndroidRestRequestJob_run(RestRequestJob *s) {MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));if(Job_getStatus(s)==JS_STOPPED){MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));return;}s->started=TRUE;Job_trySetStatus(s,JS_STARTED);MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));MCString cookie;RestService_getCookieDataAsString(s->service,&cookie);if(s->backend && (s->backend->start!=NULL))s->backend->start(s->backend->ctx,s,s->requestId,&s->url,RestRequestJob_Method(s->requestType),&cookie,&s->body);else{MCString empty;MCString_Init(&empty);AndroidRestRequestJob_onRequestComplete(s,s->requestId,-1,&empty);}MCString_Destroy(&cookie);MCThread_Check(pthread_mutex_lock(MC_MutexAddress(&s->ioMutex)));while(!s->completed)MCThread_Check(pthread_cond_wait(MC_CondAddress(&s->ready),MC_MutexAddress(&s->ioMutex)));s->started=FALSE;Job_trySetStatus(s,JS_FINISHED);MCThread_Check(pthread_mutex_unlock(MC_MutexAddress(&s->ioMutex)));}
U0 AndroidRestRequestJob_finish(RestRequestJob *s) {Bool stopped=Job_getStatus(s)==JS_STOPPED;if(stopped){MCString empty;MCString_Init(&empty);if(s->error!=NULL)s->error(s->callbackContext,TRUE,FALSE,0,&empty,&s->tag);return;}Bool network=s->httpCode<0;if(stopped || network || s->httpCode>=300){if((s->error!=NULL))s->error(s->callbackContext,stopped,network,s->httpCode,&s->response,&s->tag);}else if((s->success!=NULL))s->success(s->callbackContext,s->httpCode,&s->response,&s->tag);}
