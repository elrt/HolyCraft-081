// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 Options_Init(Options *s,F32 pixelsPerMm,Bool supportNonTouch){memset(s,0,sizeof(Options));s->musicVolume=1;s->soundVolume=1;s->sensitivity=0.5;s->pixelDensity=pixelsPerMm;if(s->pixelDensity>12)s->pixelDensity=12;else if(s->pixelDensity<=3)s->pixelDensity=3;s->supportsNonTouch=supportNonTouch;s->flags[16]=supportNonTouch;s->canEditName=TRUE;s->difficulty=2;s->renderDistance=2;s->flags[5]=s->flags[9]=s->flags[14]=s->flags[18]=s->flags[19]=s->flags[20]=TRUE;I32 keys[16]={19,21,20,22,23,10,81,69,84,70,102,103,20,19,23,4};memcpy(s->keyCodes,keys,sizeof(keys));MCString_FromC(&s->username,"Steve");OptionsFile_Init(&s->file);}
U0 Options_Destroy(Options *s){MCString_Destroy(&s->username);OptionsFile_Destroy(&s->file);}
Bool Options_boolId(I32 id){return id==2 || id==5 || id==7 || id==9 || (id>=12 && id<=20);}
Bool Options_getBooleanValue(Options *s,I32 id){if(!Options_boolId(id))return FALSE;return s->flags[id];}
F32 Options_getProgressValue(Options *s,I32 id){if(id==0)return s->musicVolume;if(id==1)return s->soundVolume;if(id==3)return s->sensitivity;if(id==21)return s->pixelDensity;return 0;}
I32 Options_getIntValue(Options *s,I32 id){if(id==4)return s->renderDistance;if(id==8)return s->difficulty;return 0;}
U0 Options_notify(Options *s,I32 id,I32 kind,F32 value){if(s->changed!=NULL)s->changed(s->context,id,kind,value(F32));}
U0 Options_setFloat(Options *s,I32 id,F32 v){if(id==0)s->musicVolume=v;if(id==1)s->soundVolume=v;if(id==3)s->sensitivity=v;if(id==21)s->pixelDensity=v;Options_notify(s,id,1,v);}
U0 Options_setInt(Options *s,I32 id,I32 v){if(id==4)s->renderDistance=v;if(id==8)s->difficulty=v;Options_notify(s,id,3,v);}
U0 Options_setString(Options *s,I32 id,MCString *text){if(id!=22)return;if(text->size)MCString_Assign(&s->username,text);else MC024_SetString(&s->username,"Steve");}
Bool Options_canModify(Options *s,I32 id){return id!=22 || s->canEditName;}
Bool Options_hideOption(Options *s,I32 id){if(id<0 || id>=23)return FALSE;return s->hidden[id] || (id==16 && !s->supportsNonTouch);}
Bool Options_readFloat(MCString *text,F32 *out){if(MC025_Str(text,"true") || MC025_Str(text,"YES")){*out=1;return TRUE;}if(MC025_Str(text,"false") || MC025_Str(text,"NO")){*out=0;return TRUE;}return sscanf(text->data,"%f",out)!=0;}
Bool Options_readInt(MCString *text,I32 *out){if(MC025_Str(text,"true") || MC025_Str(text,"YES")){*out=1;return TRUE;}if(MC025_Str(text,"false") || MC025_Str(text,"NO")){*out=0;return TRUE;}return sscanf(text->data,"%d",out)!=0;}
Bool Options_readBool(MCString *text,Bool *out){I32 a=0,n=text->size;while(a<n && (text->data[a]==' ' || text->data[a]=='\t' || text->data[a]=='\r' || text->data[a]=='\n'))a++;while(n>a && (text->data[n-1]==' ' || text->data[n-1]=='\t' || text->data[n-1]=='\r' || text->data[n-1]=='\n'))n--;MCString t;MCString_FromBytes(&t,text->data+a,n-a);Bool ok=TRUE;if(MC025_Str(&t,"true") || MC025_Str(&t,"1") || MC025_Str(&t,"YES"))*out=TRUE;else if(MC025_Str(&t,"false") || MC025_Str(&t,"0") || MC025_Str(&t,"NO"))*out=FALSE;else ok=FALSE;MCString_Destroy(&t);return ok;}
U0 MC025_OptionLine(MCVector *out,U8 *key,U8 *value){MCString t;MCString_FromC(&t,key);MC025_Append(&t,":");MC025_Append(&t,value);MCVector_Push(out,&t);}
U0 MC025_OptionNum(MCVector *out,U8 *key,F32 value,Bool integer){U8 buf[96];if(integer)snprintf(buf,96,"%d",value(I32));else snprintf(buf,96,"%.6g",value(F64));MC025_OptionLine(out,key,buf);}
U0 Options_getSaveOutput(Options *s,MCVector *out){MCStringVector_Init(out);MC025_OptionLine(out,"mp_username",s->username.data);MC025_OptionNum(out,"game_difficulty",s->difficulty,TRUE);MC025_OptionNum(out,"game_thirdperson",s->flags[12],TRUE);MC025_OptionNum(out,"gfx_pixeldensity",s->pixelDensity,FALSE);MC025_OptionNum(out,"mp_server_visible",s->flags[14],TRUE);MC025_OptionNum(out,"ctrl_sensitivity",s->sensitivity,FALSE);MC025_OptionNum(out,"ctrl_invertmouse",s->flags[2],TRUE);MC025_OptionNum(out,"ctrl_islefthanded",s->flags[15],TRUE);MC025_OptionNum(out,"ctrl_usetouchscreen",s->flags[16],TRUE);MC025_OptionNum(out,"ctrl_usetouchjoypad",s->flags[17],TRUE);MC025_OptionNum(out,"feedback_vibration",s->flags[18],TRUE);MC025_OptionNum(out,"gfx_renderdistance",s->renderDistance,TRUE);MC025_OptionNum(out,"gfx_fancygraphics",s->flags[9],TRUE);MC025_OptionNum(out,"gfx_fancyskies",s->flags[19],TRUE);MC025_OptionNum(out,"gfx_animatetextures",s->flags[20],TRUE);MC025_OptionNum(out,"gfx_hidegui",s->flags[13],TRUE);MC025_OptionNum(out,"audio_sound",s->soundVolume,FALSE);MC025_OptionNum(out,"old_game_version_major",s->major,TRUE);MC025_OptionNum(out,"old_game_version_minor",s->minor,TRUE);MC025_OptionNum(out,"old_game_version_patch",s->patch,TRUE);MC025_OptionNum(out,"old_game_version_beta",s->beta,TRUE);}
U0 Options_save(Options *s){s->saveCount++;if(!s->file.filename.size)return;MCVector out;Options_getSaveOutput(s,&out);OptionsFile_save(&s->file,&out);MCStringVector_Destroy(&out);}
U0 Options_toggle(Options *s,I32 id,I32 delta){if(id==4)s->renderDistance=(delta+s->renderDistance(U8))&3;else if(id==8)s->difficulty=(delta+s->difficulty(U8))&3;else if(id==11)s->guiScale=(delta+s->guiScale(U8))&3;else if(Options_boolId(id))s->flags[id]^=1;Options_notify(s,id,0,Options_getBooleanValue(s,id));Options_save(s);}
U0 Options_setKey(Options *s,I32 slot,I32 code){if(slot<0 || slot>=16)return;s->keyCodes[slot]=code;Options_save(s);}
Bool Options_validateVersion(Options *s){if(s->major || s->minor!=8 || s->patch!=1 || s->beta){s->major=0;s->minor=8;s->patch=1;s->beta=0;Options_save(s);return TRUE;}return FALSE;}
U0 Options_updatePair(Options *s,MCString *key,MCString *v){if(MC025_Str(key,"mp_username")){Options_setString(s,22,v);return;}I32 ids[12]={2,15,17,18,9,19,20,12,16,13,14,5};U8 *names[12]={"ctrl_invertmouse","ctrl_islefthanded","ctrl_usetouchjoypad","feedback_vibration","gfx_fancygraphics","gfx_fancyskies","gfx_animatetextures","game_thirdperson","ctrl_usetouchscreen","gfx_hidegui","mp_server_visible","view_bobbing"};I32 i;for(i=0;i<12;i++)if(MC025_Str(key,names[i])){Options_readBool(v,&s->flags[ids[i]]);if(ids[i]==16)s->flags[16]=FALSE;if(ids[i]==17 && !s->flags[16] && s->supportsNonTouch)s->flags[17]=FALSE;return;}if(MC025_Str(key,"ctrl_sensitivity")){F32 f=0;if(Options_readFloat(v,&f))s->sensitivity=pow(f*1.1,1.3)*0.42+0.3;}else if(MC025_Str(key,"gfx_pixeldensity")){Options_readFloat(v,&s->pixelDensity);if(s->pixelDensity>12)s->pixelDensity=12;else if(s->pixelDensity<=3)s->pixelDensity=3;}else if(MC025_Str(key,"gfx_renderdistance"))Options_readInt(v,&s->renderDistance);else if(MC025_Str(key,"audio_sound"))Options_readFloat(v,&s->soundVolume);else if(MC025_Str(key,"game_difficulty")){Options_readInt(v,&s->difficulty);if(s->difficulty!=0 && s->difficulty!=2)s->difficulty=2;}else if(MC025_Str(key,"old_game_version_major"))Options_readInt(v,&s->major);else if(MC025_Str(key,"old_game_version_minor"))Options_readInt(v,&s->minor);else if(MC025_Str(key,"old_game_version_patch"))Options_readInt(v,&s->patch);else if(MC025_Str(key,"old_game_version_beta"))Options_readInt(v,&s->beta);}
U0 Options_update(Options *s){MCVector strings;OptionsFile_getOptionStrings(&s->file,&strings);I32 i;for(i=0;i+1<strings.size;i+=2)Options_updatePair(s,MCVector_At(&strings,i),MCVector_At(&strings,i+1));MCStringVector_Destroy(&strings);}
