// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 SoundEngine_Init(SoundEngine *s,SoundSystemAL *system,F32 distance){memset(s,0,sizeof(SoundEngine));s->system=system;s->invDistance=1/distance;s->volume=1;SoundRepository_Init(&s->sounds);}
U0 SoundEngine_Destroy(SoundEngine *s){SoundRepository_Destroy(&s->sounds);}
F32 SoundEngine_getVolumeMult(SoundEngine *s,F32 x,F32 y,F32 z){F32 dx=x-s->x,dy=y-s->y,dz=z-s->z,v=1.1-sqrtf(dx*dx+dy*dy+dz*dz)*s->invDistance;if(v>1)return 1;if(v<=-1)return -1;return v;}
U0 SoundEngine_addPCM(SoundEngine *s,U8 *name,U8 *pcm){MCString n;MCString_FromC(&n,name);SoundDesc d;SoundDesc_InitPCM(&d,pcm);SoundRepository_add(&s->sounds,&n,&d);SoundDesc_Destroy(&d);MCString_Destroy(&n);}
Bool SoundEngine_play(SoundEngine *s,U8 *name,F32 x,F32 y,F32 z,F32 gain,F32 pitch,Bool ui){gain*=s->volume;if(gain<=0)return FALSE;if(!ui)gain*=SoundEngine_getVolumeMult(s,x,y,z);if(gain<0)gain=0;if(gain>1)gain=1;if(gain<=0 || !s->system)return FALSE;MCString n;MCString_FromC(&n,name);SoundDesc d;SoundDesc_Init(&d);Bool found=SoundRepository_get(&s->sounds,&n,&d),ok=FALSE;if(found)ok=SoundSystemAL_playAt(s->system,&d,x,y,z,gain,pitch);SoundDesc_Destroy(&d);MCString_Destroy(&n);return ok;}
U0 SoundEngine_update(SoundEngine *s,F32 oldX,F32 oldY,F32 oldZ,F32 x,F32 y,F32 z,F32 oldYaw,F32 yaw,F32 partial){if(s->volume==0)return;s->x=oldX+(x-oldX)*partial;s->y=oldY+(y-oldY)*partial;s->z=oldZ+(z-oldZ)*partial;s->angle=oldYaw+(yaw-oldYaw)*partial;if(s->system)SoundSystemAL_setListenerAngle(s->system,s->angle);}
