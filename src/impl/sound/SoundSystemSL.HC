// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 SoundSystemSL_Init(SoundSystemSL *s,MCAudio024 *host){memset(s,0,sizeof(SoundSystemSL));s->host=host;if(host && host->init!=NULL)s->ready=host->init(host->ctx,2);}
U0 SoundSystemSL_removeStoppedSounds(SoundSystemSL *s){I32 i;s->playing=0;for(i=0;i<4;i++)if(s->active[i]){Bool stop=s->queued[i];if(2!=2 && s->host->playing!=NULL)stop=!s->host->playing(s->host->ctx,2,i);if(stop){if(s->host->release!=NULL)s->host->release(s->host->ctx,2,i);s->active[i]=FALSE;s->queued[i]=FALSE;}else s->playing++;}}
Bool SoundSystemSL_playAt(SoundSystemSL *s,SoundDesc *sound,F32 x,F32 y,F32 z,F32 gain,F32 pitch){if(!s->ready || !sound || !sound->field_0 || sound->field_4<=0)return FALSE;SoundSystemSL_removeStoppedSounds(s);if(s->playing>=4 || s->host->play==NULL)return FALSE;I32 i,mb=0;for(i=0;i<4 && s->active[i];i++){}if(i>=4)return FALSE;if(2==1){if(gain<=0)mb=-10000;else{if(gain>1)gain=1;mb=floor(2000*log(gain)/log(10.0)+0.5);}}if(2==2)mb=s->currentVolume-(1-gain)*2000;if(s->host->play(s->host->ctx,2,i,sound,0.0(F32),0.0(F32),0.0(F32),gain(F32),1.0(F32),mb)){s->active[i]=TRUE;s->playing++;return TRUE;}return FALSE;}
U0 SoundSystemSL_queueFinished(SoundSystemSL *s,I32 slot){if(slot>=0 && slot<4 && s->active[slot])s->queued[slot]=TRUE;}
U0 SoundSystemSL_setListenerAngle(SoundSystemSL *s,F32 angle){if(2==0 && s->ready && s->host->angle!=NULL)s->host->angle(s->host->ctx,2,(-sin(angle*0.0174532925))(F32),0.0(F32),cos(angle*0.0174532925)(F32));}
U0 SoundSystemSL_Destroy(SoundSystemSL *s){I32 i;if(s->host)for(i=0;i<4;i++)if(s->active[i] && s->host->release!=NULL)s->host->release(s->host->ctx,2,i);memset(s,0,sizeof(SoundSystemSL));}
