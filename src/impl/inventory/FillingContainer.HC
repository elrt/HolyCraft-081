// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 FillingContainer_Init(FillingContainer *s,MCRegistry023 *r,I32 size,I32 links,I32 maxStack,Bool creative){memset(s,0,sizeof(FillingContainer));s->registry=r;s->size=size;s->linkedCount=links;s->maxStack=maxStack;s->creative=creative;s->items=MC_Alloc(size*sizeof(ItemInstance*));memset(s->items,0,size*sizeof(ItemInstance*));s->links=MC_Alloc(links*sizeof(I32));I32 i;for(i=0;i<links;i++)s->links[i]=i;}
U0 FillingContainer_Destroy(FillingContainer *s){I32 i;for(i=s->linkedCount;i<s->size;i++)free(s->items[i]);free(s->items);free(s->links);s->items=NULL;s->links=NULL;s->size=0;}
I32 FillingContainer_physical(FillingContainer *s,I32 index){if(index<0 || index>=s->size)return -1;if(index<s->linkedCount)index=s->links[index];if(index<s->linkedCount || index>=s->size)return -1;return index;}
ItemInstance *FillingContainer_getItem(FillingContainer *s,I32 index){index=FillingContainer_physical(s,index);if(index<0)return NULL;ItemInstance *v=s->items[index];if(!v || !v->itemClass)return NULL;return v;}
U0 FillingContainer_setItem(FillingContainer *s,I32 slot,ItemInstance *item){slot=FillingContainer_physical(s,slot);if(slot<0)return;ItemInstance *copy=ItemInstance_clone(item);free(s->items[slot]);s->items[slot]=copy;}
Bool FillingContainer_linkSlot(FillingContainer *s,I32 slot,I32 index){if(slot<0 || slot>=s->linkedCount || index<s->linkedCount || index>=s->size || s->links[slot]==index)return FALSE;s->links[slot]=index;return TRUE;}
Bool FillingContainer_linkEmptySlot(FillingContainer *s,I32 index){if(s->creative)return FALSE;I32 i;for(i=0;i<s->linkedCount;i++)if(s->links[i]==index)return TRUE;for(i=0;i<s->linkedCount;i++)if(!FillingContainer_getItem(s,i)){s->links[i]=index;return TRUE;}return FALSE;}
U0 FillingContainer_compressLinkedSlotList(FillingContainer *s,I32 start){if(s->creative || start<0 || start>=s->linkedCount)return;I32 removed=0,i;for(i=start;i<s->linkedCount;i++){s->links[i-removed]=s->links[i];if(!FillingContainer_getItem(s,i))removed++;}for(i=s->linkedCount-removed;i<s->linkedCount;i++)s->links[i]=-1;}
U0 FillingContainer_clearSlot(FillingContainer *s,I32 index){if(index<0 || index>=s->size)return;I32 actual=FillingContainer_physical(s,index);if(actual>=0){free(s->items[actual]);s->items[actual]=NULL;}if(index<s->linkedCount)s->links[index]=-1;FillingContainer_compressLinkedSlotList(s,index);}
U0 FillingContainer_clearInventory(FillingContainer *s){I32 i;for(i=0;i<s->linkedCount;i++)s->links[i]=i;for(i=s->linkedCount;i<s->size;i++){free(s->items[i]);s->items[i]=NULL;}}
I32 FillingContainer_getFreeSlot(FillingContainer *s){I32 i;for(i=s->linkedCount;i<s->size;i++)if(ItemInstance_isNull(FillingContainer_getItem(s,i)))return i;return -1;}
I32 FillingContainer_getEmptySlotsCount(FillingContainer *s){I32 n=0,i;for(i=s->linkedCount;i<s->size;i++)if(ItemInstance_isNull(FillingContainer_getItem(s,i)))n++;return n;}
I32 FillingContainer_getSlot(FillingContainer *s,I32 id,I32 aux,Bool requireCount,Bool exactAux){I32 i;for(i=s->linkedCount;i<s->size;i++){ItemInstance *v=FillingContainer_getItem(s,i);if(v && ItemInstance_getId(v)==id && (!exactAux || v->metadata==aux) && (!requireCount || v->count>0))return i;}return -1;}
I32 FillingContainer_getSlotWithRemainingSpace(FillingContainer *s,ItemInstance *item){I32 i;for(i=0;i<s->size;i++){ItemInstance *v=FillingContainer_getItem(s,i);if(v && v->itemClass==item->itemClass && ItemInstance_isStackable(v) && v->count<v->itemClass->maxStack && v->count<s->maxStack && (!v->itemClass->stackedByData || v->metadata==item->metadata))return i;}return -1;}
I32 FillingContainer_addResource(FillingContainer *s,ItemInstance *item){if(!item || !item->itemClass)return 0;I32 remaining=item->count,slot;if(item->itemClass->maxStack==1){slot=FillingContainer_getFreeSlot(s);if(slot>=0){FillingContainer_setItem(s,slot,item);return 0;}return remaining;}slot=FillingContainer_getSlotWithRemainingSpace(s,item);if(slot<0)slot=FillingContainer_getFreeSlot(s);if(slot<0)return remaining;ItemInstance *old=FillingContainer_getItem(s,slot);I32 count=0;if(old)count=old->count;ItemInstance tmp;ItemInstance_Init(&tmp,s->registry,ItemInstance_getId(item),count,item->metadata);FillingContainer_setItem(s,slot,&tmp);ItemInstance *v=FillingContainer_getItem(s,slot);FillingContainer_linkEmptySlot(s,slot);I32 n=item->itemClass->maxStack-v->count;if(n>remaining)n=remaining;if(n>s->maxStack-v->count)n=s->maxStack-v->count;if(n){remaining-=n;v->count+=n;}return remaining;}
Bool FillingContainer_add(FillingContainer *s,ItemInstance *item){if(s->creative || ItemInstance_isNull(item))return TRUE;if(ItemInstance_isDamaged(item)){I32 freeSlot=FillingContainer_getFreeSlot(s);if(freeSlot<0)return FALSE;FillingContainer_setItem(s,freeSlot,item);FillingContainer_linkEmptySlot(s,freeSlot);item->count=0;return TRUE;}I32 count,left;do{count=item->count;left=FillingContainer_addResource(s,item);item->count=left;}while(left>0 && left<count);return left<count;}
I32 FillingContainer_removeResource(FillingContainer *s,ItemInstance *item,Bool exactAux){if(s->creative)return 0;I32 count=item->count;while(count>0){Bool aux=exactAux || (!Recipe_isAnyAuxValue(ItemInstance_getId(item)) && item->metadata!= -1);I32 slot=FillingContainer_getSlot(s,ItemInstance_getId(item),item->metadata,TRUE,aux);if(slot<0)return count;ItemInstance *v=s->items[slot];I32 n=count;if(n>v->count)n=v->count;count-=n;v->count-=n;if(v->count<=0)FillingContainer_clearSlot(s,slot);}return 0;}
U0 FillingContainer_removeItem(FillingContainer *s,I32 slot,I32 amount,ItemInstance *out){ItemInstance *v=FillingContainer_getItem(s,slot);if(v && amount>=0){if(amount>v->count)amount=v->count;v->count-=amount;if(v->count<=0)FillingContainer_clearSlot(s,slot);}ItemInstance_Init(out,s->registry,0,0,0);/* Original returns empty after removal. */}
Bool FillingContainer_contains(FillingContainer *s,ItemInstance *item){I32 i;for(i=0;i<s->size;i++)if(s->items[i] && ItemInstance_matches(s->items[i],item))return TRUE;return FALSE;}
U0 FillingContainer_dropSlot(FillingContainer *s,I32 slot,Bool discard,Bool random){I32 actual=FillingContainer_physical(s,slot);if(actual<0)return;ItemInstance *v=s->items[actual];if(v && v->count){if(!discard && s->drop!=NULL)s->drop(s->dropContext,v,random);v->count=0;FillingContainer_clearSlot(s,actual);}}
ListTag *FillingContainer_save(FillingContainer *s){ListTag *list=MC_Alloc(sizeof(ListTag));ListTag_InitEmpty(list);I32 i;for(i=0;i<s->size;i++){ItemInstance temp,*v=s->items[i];if(i<s->linkedCount){ItemInstance_Init(&temp,s->registry,255,255,s->links[i]);v=&temp;}if(!v)continue;if(v->count<0)v->count=0;if(v->count>255)v->count=255;CompoundTag *t=MC_Alloc(sizeof(CompoundTag));CompoundTag_InitEmpty(t);MC023_NBTPut(t,"Slot",i,TRUE);ItemInstance_save(v,t);ListTag_add(list,t);}return list;}
U0 FillingContainer_load(FillingContainer *s,ListTag *list){if(s->creative && !list->value.size)return;if(!s->creative)FillingContainer_clearInventory(s);I32 i;for(i=list->value.size-1;i>=0;i--){Tag *tag=list->value.data[i];if(!tag || Tag_getId(tag)!=10)continue;CompoundTag *t=tag(CompoundTag*);I32 slot=MC023_NBTGet(t,"Slot",TRUE);ItemInstance v;ItemInstance_Init(&v,s->registry,0,0,0);ItemInstance_load(&v,t);if(!v.isValid)continue;if(!s->creative && slot<s->linkedCount){if(ItemInstance_getId(&v)==255 && v.count==255)FillingContainer_linkSlot(s,slot,v.metadata);continue;}if(slot>95 || slot<s->linkedCount || !v.count)continue;if(slot>=s->size){if(!s->creative && s->drop!=NULL)s->drop(s->dropContext,&v,TRUE);continue;}if(ItemInstance_getId(&v)==s->registry->stoneSlab)v.metadata&=7;FillingContainer_setItem(s,slot,&v);}FillingContainer_compressLinkedSlotList(s,0);}
