// Batch023: inventory/Inventory; explicit simulation ABI, see docs/BATCH023.md.
U0 Inventory_Init(Inventory *s,MCRegistry023 *registry,MCBody023 *player,Bool creative) {memset(s,0,sizeof(Inventory));s->registry=registry;s->player=player;s->creative=creative;Inventory_setupDefault(s);}
U0 Inventory_Destroy(Inventory *s) {I32 i;for(i=9;i<s->size;i++){free(s->items[i]);s->items[i]=NULL;}}
U0 Inventory_setupDefault(Inventory *s) {Inventory_Destroy(s);I32 i;s->size=45;if(s->creative)s->size=18;for(i=0;i<9;i++)s->links[i]=i;if(s->creative){I32 ids[9]={s->registry->rock,s->registry->stoneBrick,s->registry->dirt,s->registry->wood,s->registry->wood,s->registry->torch,s->registry->brickStairs,s->registry->cobbleWall,s->registry->sapling};for(i=0;i<9;i++){s->items[i+9]=MC_Alloc(sizeof(ItemInstance));I32 meta=0;if(i==4)meta=1;ItemInstance_Init(s->items[i+9],s->registry,ids[i],5,meta);s->links[i]=i+9;}}}
ItemInstance *Inventory_getLinked(Inventory *s,I32 slot) {if(slot<0 || slot>8)return NULL;I32 index=s->links[slot];if(index<9 || index>=s->size)return NULL;return s->items[index];}
ItemInstance *Inventory_getSelected(Inventory *s) {return Inventory_getLinked(s,s->selectedSlot);}
U0 Inventory_selectSlot(Inventory *s,I32 slot) {if(slot>=0 && slot<=8)s->selectedSlot=slot;}
Bool Inventory_moveToSelectionSlot(Inventory *s,I32 slot,I32 item) {if(slot<0 || slot>8 || item<9 || item>=s->size || s->links[slot]==item)return FALSE;s->links[slot]=item;return TRUE;}
Bool Inventory_moveToSelectedSlot(Inventory *s,I32 item) {return Inventory_moveToSelectionSlot(s,s->selectedSlot,item);}
Bool Inventory_moveToEmptySelectionSlot(Inventory *s,I32 item) {if(s->creative)return FALSE;I32 i;for(i=0;i<9;i++)if(s->links[i]==item)return TRUE;for(i=0;i<9;i++)if(!Inventory_getLinked(s,i)){s->links[i]=item;return TRUE;}return FALSE;}
U0 Inventory_clearSlot(Inventory *s,I32 slot) {if(slot<0 || slot>=s->size)return;I32 actual=slot;if(slot<9){actual=s->links[slot];s->links[slot]=-1;}if(actual>=9 && actual<s->size){free(s->items[actual]);s->items[actual]=NULL;}/* Full FillingContainer compress/reordering remains separate. */}
I32 Inventory_getLinkedSlotForItem(Inventory *s,I32 index) {if(index<0 || index>=s->size)return -1;I32 i;for(i=0;i<9;i++)if(s->items[index]==Inventory_getLinked(s,i))return i;return -1;}
I32 Inventory_getLinkedSlotForItemIdAndAux(Inventory *s,I32 id,I32 aux) {I32 i;for(i=0;i<9;i++){ItemInstance *v=Inventory_getLinked(s,i);if(v && ItemInstance_getId(v)==id && v->metadata==aux)return i;}return -1;}
Bool Inventory_removeItemInstance(Inventory *s,ItemInstance *item) {I32 i;for(i=9;i<s->size;i++)if(s->items[i]==item){Inventory_clearSlot(s,i);return TRUE;}return FALSE;}
I32 Inventory_getEmptySlotsCount(Inventory *s) {I32 i,count=0;for(i=9;i<s->size;i++)if(!s->items[i])count++;return count;}
Bool Inventory_add(Inventory *s,ItemInstance *item) {if(s->creative || s->unlimited || !item || ItemInstance_isNull(item))return TRUE;I32 before=item->count,i;/* Safe concrete subset of FillingContainer add; full linked-list compression not included. */for(i=9;i<s->size && item->count>0;i++){ItemInstance *v=s->items[i];if(v && ItemInstance_canStack(v,item)){I32 max=v->itemClass->maxStack;if(max>64)max=64;I32 n=max-v->count;if(n>item->count)n=item->count;if(n>0){v->count+=n;item->count-=n;}}}for(i=9;i<s->size && item->count>0;i++)if(!s->items[i]){ItemInstance *copy=ItemInstance_clone(item);I32 max=copy->itemClass->maxStack;if(max>64)max=64;if(max<1)max=1;if(copy->count>max)copy->count=max;s->items[i]=copy;item->count-=copy->count;Inventory_moveToEmptySelectionSlot(s,i);}return item->count<before;}
Bool Inventory_stillValid(Inventory *s,MCBody023 *player) {if(!s->player || s->player->dead)return FALSE;F32 d=MC023_Distance(s->player,player);return d*d<=64.0;}
