U0 BaseContainerMenu_Init(BaseContainerMenu *s,I32 id){memset(s,0,sizeof(BaseContainerMenu));s->containerID=id;s->field_0=-1;MCVector_Init(&s->cached,sizeof(MCInventoryItem011));s->resultSlot=&BaseContainerMenu_isResultSlot;}U0 BaseContainerMenu_Destroy(BaseContainerMenu *s){MCVector_Destroy(&s->cached);}Bool BaseContainerMenu_isResultSlot(BaseContainerMenu *s,I32 i){return FALSE;}
