U0 MC011_inventoryCopy(MCInventoryHost011 *c,I32 start,MCVector *out){I32 i,n=c->size(c->host);MCInventoryItem011 empty,*it;memset(&empty,0,sizeof(empty));empty.valid=TRUE;MCVector_Init(out,sizeof(MCInventoryItem011));for(i=start;i<n;i++){it=c->get(c->host,i);if(it)MCVector_Push(out,it);else MCVector_Push(out,&empty);}}
U0 ContainerMenu_Init(ContainerMenu *s,MCInventoryHost011 *c,I32 id){BaseContainerMenu_Init(&s->base,0);s->container=c;s->entityID=id;s->base.derived=s;s->base.getItems=&ContainerMenu_getItems;s->base.setSlot=&ContainerMenu_setSlot;s->base.destroyed=&ContainerMenu_tileEntityDestroyedIsInvalid;c->open(c->host);}U0 ContainerMenu_Destroy(ContainerMenu *s){s->container->close(s->container->host);BaseContainerMenu_Destroy(&s->base);}U0 ContainerMenu_getItems(BaseContainerMenu *b,MCVector *out){ContainerMenu *s=b->derived;MC011_inventoryCopy(s->container,0,out);}U0 ContainerMenu_setSlot(BaseContainerMenu *b,I32 i,MCInventoryItem011 *it){ContainerMenu *s=b->derived;s->container->set(s->container->host,i,it);}Bool ContainerMenu_tileEntityDestroyedIsInvalid(BaseContainerMenu *b,I32 id){ContainerMenu *s=b->derived;return s->entityID==id;}
