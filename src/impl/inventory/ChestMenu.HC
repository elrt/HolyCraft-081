U0 ChestMenu_Init(ChestMenu *s,MCInventoryHost011 *c,U0 *chest,I32 id,I32 pairedID){ContainerMenu_Init(&s->base,c,id);s->chest=chest;s->pairedID=pairedID;s->base.base.destroyed=&ChestMenu_tileEntityDestroyedIsInvalid;}U0 ChestMenu_Destroy(ChestMenu *s){ContainerMenu_Destroy(&s->base);}Bool ChestMenu_tileEntityDestroyedIsInvalid(BaseContainerMenu *b,I32 id){ChestMenu *s=b->derived;return s->base.entityID==id || s->pairedID==id;}
