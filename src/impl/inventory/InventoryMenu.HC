U0 InventoryMenu_Init(InventoryMenu *s,MCInventoryHost011 *c){BaseContainerMenu_Init(&s->base,0);s->container=c;s->base.derived=s;s->base.getItems=&InventoryMenu_getItems;s->base.setSlot=&InventoryMenu_setSlot;s->base.destroyed=&InventoryMenu_tileEntityDestroyedIsInvalid;}U0 InventoryMenu_Destroy(InventoryMenu *s){BaseContainerMenu_Destroy(&s->base);}U0 InventoryMenu_getItems(BaseContainerMenu *b,MCVector *out){InventoryMenu *s=b->derived;MC011_inventoryCopy(s->container,9,out);}U0 InventoryMenu_setSlot(BaseContainerMenu *b,I32 i,MCInventoryItem011 *it){InventoryMenu *s=b->derived;s->container->set(s->container->host,i+9,it);}Bool InventoryMenu_tileEntityDestroyedIsInvalid(BaseContainerMenu *b,I32 id){return FALSE;}
