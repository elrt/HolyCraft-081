U0 FurnaceMenu_Init(FurnaceMenu *s,MCFurnace012 *f){BaseContainerMenu_Init(&s->base,2);s->base.derived=s;s->base.getItems=&FurnaceMenu_getItems;s->base.setSlot=&FurnaceMenu_setSlot;s->base.destroyed=&FurnaceMenu_tileEntityDestroyedIsInvalid;s->furnace=f;s->entityID=f->id;s->lastCook=0;s->lastBurn=0;s->lastTotal=0;}U0 FurnaceMenu_Destroy(FurnaceMenu *s){BaseContainerMenu_Destroy(&s->base);}U0 FurnaceMenu_getItems(BaseContainerMenu *b,MCVector *v){FurnaceMenu *s=b->derived;I32 i,n=s->furnace->container->size(s->furnace->container->host);MCInventoryItem011 *item;MCVector_Init(v,sizeof(MCInventoryItem011));for(i=0;i<n;i++){item=s->furnace->container->get(s->furnace->container->host,i);if(!item){printf("FurnaceMenu requires non-null slot\n");exit(99);}MCVector_Push(v,item);}}U0 FurnaceMenu_setSlot(BaseContainerMenu *b,I32 i,MCInventoryItem011 *item){FurnaceMenu *s=b->derived;s->furnace->container->set(s->furnace->container->host,i,item);}U0 FurnaceMenu_setData(FurnaceMenu *s,I32 i,I32 value){if(i==0)s->furnace->cookTime=value;else if(i==1)s->furnace->burnTime=value;else if(i==2)s->furnace->totalBurnTime=value;}
U0 FurnaceMenu_setListener(FurnaceMenu *s,MCMenuListener011 *l){BaseContainerMenu_setListener(&s->base,l);if(l){l->setData(l->host,&s->base,0,s->furnace->cookTime);l->setData(l->host,&s->base,1,s->furnace->burnTime);l->setData(l->host,&s->base,2,s->furnace->totalBurnTime);}}
U0 FurnaceMenu_broadcastChanges(FurnaceMenu *s){MCMenuListener011 *l;BaseContainerMenu_broadcastChanges(&s->base);l=s->base.listener;if(l){if(s->furnace->cookTime!=s->lastCook){l->setData(l->host,&s->base,0,s->furnace->cookTime);s->lastCook=s->furnace->cookTime;}if(s->furnace->burnTime!=s->lastBurn){l->setData(l->host,&s->base,1,s->furnace->burnTime);s->lastBurn=s->furnace->burnTime;}if(s->furnace->totalBurnTime!=s->lastTotal){l->setData(l->host,&s->base,2,s->furnace->totalBurnTime);s->lastTotal=s->furnace->totalBurnTime;}}}Bool FurnaceMenu_tileEntityDestroyedIsInvalid(BaseContainerMenu *b,I32 id){FurnaceMenu *s=b->derived;return id==s->entityID;}
