// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 Recipes_Init(Recipes *s,MCRecipeIDs009 *ids,Bool families){MCRecipeBook009_Init(&s->book,ids);if(families){ToolRecipes_addRecipes(&s->book);WeaponRecipes_addRecipes(&s->book);OreRecipes_addRecipes(&s->book);FoodRecipes_addRecipes(&s->book);StructureRecipes_addRecipes(&s->book);ArmorRecipes_addRecipes(&s->book);ClothDyeRecipes_addRecipes(&s->book);}/* Recipes.cpp constructor's extra defaults require a separate supplied registry; not silently fabricated. */}
U0 Recipes_Destroy(Recipes *s){MCRecipeBook009_Destroy(&s->book);}
Bool Recipes_addShapedRecipe(Recipes *s,MCRecipeItem *results,I32 resultCount,U8 **rows,I32 height,MCRecipesType024 *defs,I32 count){if(height<1 || height>3 || resultCount<1 || count<0)return FALSE;I32 width=strlen(rows[0]),x,y,j,k;if(width<1 || width>3)return FALSE;for(y=0;y<height;y++)if(strlen(rows[y])!=width)return FALSE;MCRecipeItem pattern[9];memset(pattern,0,sizeof(pattern));for(y=0;y<height;y++)for(x=0;x<width;x++)for(j=0;j<count;j++)if(rows[y][x]==defs[j].key){pattern[y*width+x]=defs[j].item;if(defs[j].tile)pattern[y*width+x].aux=-1;break;}ShapedRecipe *r=MC_Alloc(sizeof(ShapedRecipe));ShapedRecipe_Init(r,width,height,pattern,results,resultCount);MCRecipeEntry009 e;e.shaped=TRUE;e.recipe=r;MCVector_Push(&s->book.entries,&e);return TRUE;}
Bool Recipes_addShapelessRecipe(Recipes *s,MCRecipeItem *result,MCRecipesType024 *defs,I32 count){if(count<1 || count>9)return FALSE;MCRecipeItem ingredients[9];I32 i,n=0;for(i=0;i<count;i++)if(!MCRecipeItem_isNull(&defs[i].item)){ingredients[n]=defs[i].item;if(defs[i].tile)ingredients[n].aux=0;n++;}MC009_shapeless(&s->book,result,ingredients,n);return TRUE;}
MCRecipeEntry009 *Recipes_getRecipeFor(Recipes *s,MCRecipeItem *item){I32 i;for(i=0;i<s->book.entries.size;i++){MCRecipeEntry009 *e=MCVector_At(&s->book.entries,i);MCVector *results;if(e->shaped)results=ShapedRecipe_getResultItem(e->recipe);else results=ShapelessRecipe_getResultItem(e->recipe);if(results->size){MCRecipeItem *r=MCVector_At(results,0);/* Source has an inverted sameItem condition. */if(!MCRecipeItem_sameItem(item,r) && (item->count==0 || item->count==r->count) && item->aux==r->aux)return e;}}return NULL;}
