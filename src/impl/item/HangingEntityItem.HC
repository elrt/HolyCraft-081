U0 HangingEntityItem_Init(HangingEntityItem *s,MCHangingHost012 *h,I32 id,I32 entityId){s->host=h;MCItem009_Init(&s->base,h->itemContext,id);s->entityId=entityId;}U0 *HangingEntityItem_createEntity(HangingEntityItem *s,I32 x,I32 y,I32 z,I32 facing){if(s->entityId!=83)return NULL;return s->host->createPainting(s->host->host,x,y,z,facing);}Bool HangingEntityItem_useOn(HangingEntityItem *s,MCPacketItem009 *item,I32 x,I32 y,I32 z,I32 face){MCHangingHost012 *h=s->host;U0 *e;if(face==0 || face==1)return FALSE;if(face<0 || face>5){printf("HangingEntityItem invalid face\n");exit(99);}e=HangingEntityItem_createEntity(s,x,y,z,Direction_FACING_DIRECTION[face]);if(e){if(h->survives(h->host,e)){if(h->isClient)h->destroyEntity(h->host,e);else h->addEntity(h->host,e);item->count--;}else h->destroyEntity(h->host,e);}return TRUE;}
