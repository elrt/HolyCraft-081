// Batch 009: minecraftpe/impl/item/TilePlanterItem.cpp includes the header only.
U0 TilePlanterItem_Init(TilePlanterItem *s,MCItemContext009 *c,MCPlaceContext009 *p,I32 id,I32 tile) { MCItem009_Init(&s->base,c,id);s->blockID=tile;s->place=p; }
Bool TilePlanterItem_useOn(TilePlanterItem *s,MCItemContext009 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 face,F32 fx,F32 fy,F32 fz) { MCPlaceContext009 *p=s->place;MCPlaceTile009 *target,*tile;I32 data;target=p->tileInfo(p->host,c->getTile(c->host,x,y,z));if(target && target->replaceable)face=1;else { if(face==0)y--;else if(face==1)y++;else if(face==2)z--;else if(face==3)z++;else if(face==4)x--;else if(face==5)x++; }if(!it->count)return FALSE;if(p->mayPlace(p->host,s->blockID,x,y,z,FALSE,face)) { tile=p->tileInfo(p->host,s->blockID);if(tile) { data=p->placementData(p->host,s->blockID,x,y,z,face,fx,fy,fz,it->aux);if(p->setTileAndData(p->host,x,y,z,s->blockID,data,3)) { MC009_placementSound(c,tile,x,y,z);it->count--; } } }return TRUE; }
Bool TilePlanterItem_isEmissive(TilePlanterItem *s,I32 unused) { return MC009_isEmissive(s->place,s->blockID); }
