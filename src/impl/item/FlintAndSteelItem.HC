// Batch 009: minecraftpe/impl/item/FlintAndSteelItem.cpp includes the header only.
U0 FlintAndSteelItem_Init(FlintAndSteelItem *s,MCItemContext009 *c,I32 id) { MCItem009_Init(&s->base,c,id);s->base.maxStackSize=1;s->base.maxDamage=64; }
Bool FlintAndSteelItem_useOn(FlintAndSteelItem *s,MCItemContext009 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 face,F32 fx,F32 fy,F32 fz) { F32 pitch,ax,ay,az,volume=1;if(face==0)y--;else if(face==1)y++;else if(face==2)z--;else if(face==3)z++;else if(face==4)x--;else if(face==5)x++;if(!c->getTile(c->host,x,y,z)) { pitch=Random_nextFloat(c->worldRandom)*0.4+0.8;ax=x+0.5;ay=y+0.5;az=z+0.5;c->soundAt(c->host,ax,ay,az,"fire.ignite",volume,pitch);c->setTile(c->host,x,y,z,c->fireID,3); }if(!c->instabuild)c->hurtAndBreak(c->host,it,1);return TRUE; }
