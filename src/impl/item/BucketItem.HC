// Batch023: item/BucketItem; explicit simulation ABI, see docs/BATCH023.md.
U0 BucketItem_Init(BucketItem *s,MCWorld023 *w) {s->w=w;}
Bool BucketItem_emptyBucket(BucketItem *s,I32 type,I32 x,I32 y,I32 z) {if(type<=0)return FALSE;I32 old=MC023_Tile(s->w,x,y,z);MCTileDef023 *t=MC023_Def(s->w,old);if(old && t && t->solid)return FALSE;MC023_Set(s->w,MC023_SET_TILE,x,y,z,type,0,3);if(type==s->w->registry->water && (old==s->w->registry->fire || old==s->w->registry->lava || old==s->w->registry->calmLava))MC023_Sound(s->w,"random.fizz",x+0.5,y+0.5,z+0.5,0.5,(Random_nextFloat(&s->w->random)-Random_nextFloat(&s->w->random))*0.8+2.6);return TRUE;}
I32 BucketItem_getMaxStackSize(ItemInstance *item) {if(item->metadata)return 1;return 16;}
I32 BucketItem_getIcon(BucketItem *s,I32 meta) {if(meta==s->w->registry->water)return 2;if(meta==s->w->registry->lava)return 3;if(meta==1)return 1;return 0;}
U8 *BucketItem_getDescriptionId(BucketItem *s,ItemInstance *item) {if(item->metadata==s->w->registry->water)return "item.bucketWater";if(item->metadata==s->w->registry->lava)return "item.bucketLava";return "item.bucket";}
Bool BucketItem_isLiquidClipItem(I32 meta) {return meta==0;}Bool BucketItem_isEmissive(BucketItem *s,I32 meta) {return meta==s->w->registry->lava;}
Bool BucketItem_useOn(BucketItem *s,ItemInstance *item,MCPlayer023 *player,I32 x,I32 y,I32 z,I32 face) {I32 meta=item->metadata;Bool space=Inventory_getEmptySlotsCount(player->inventory)>0 || item->count==1;if(!meta){if(!space && !player->instabuildMode)return FALSE;I32 material=MC023_Material(s->w,x,y,z);if((material!=3 && material!=4) || MC023_Data(s->w,x,y,z)!=0)return FALSE;MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);if(player->instabuildMode)return TRUE;I32 liquid=s->w->registry->water;if(material==4)liquid=s->w->registry->lava;ItemInstance filled;ItemInstance_Init(&filled,item->registry,s->w->registry->bucket,1,liquid);item->count--;if(!item->count)*item=filled;else Inventory_add(player->inventory,&filled);return TRUE;}if(meta<=1)return FALSE;if(face==0)y--;else if(face==1)y++;else if(face==2)z--;else if(face==3)z++;else if(face==4)x--;else if(face==5)x++;if(!BucketItem_emptyBucket(s,meta,x,y,z))return FALSE;ItemInstance empty;ItemInstance_Init(&empty,item->registry,s->w->registry->bucket,1,0);item->count--;if(!item->count)*item=empty;else Inventory_add(player->inventory,&empty);return TRUE;}
