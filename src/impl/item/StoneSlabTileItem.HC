U0 StoneSlabTileItem_Init(StoneSlabTileItem *s,MCSlabHost013 *h,MCString *desc){s->host=h;MCString_CopyInit(&s->descriptionId,desc);}U0 StoneSlabTileItem_Destroy(StoneSlabTileItem *s){MCString_Destroy(&s->descriptionId);}TextureUVCoordinateSet *StoneSlabTileItem_getIcon(StoneSlabTileItem *s,I32 d){return s->host->stoneIcon(s->host->host,2,d);}
Bool StoneSlabTileItem_useOn(StoneSlabTileItem *s,MCSlabStack013 *item,U0 *player,I32 x,I32 y,I32 z,I32 face,F32 fx,F32 fy,F32 fz){MCSlabHost013 *h=s->host;I32 id,meta,top;if(!item->count)return FALSE;id=h->getTile(h->host,x,y,z);meta=h->getData(h->host,x,y,z);top=(meta>>3)&1;if((face==1 && top)||(face!=1 && (face!=0 || !top)))return h->baseUseOn(h->host,item,player,x,y,z,face,fx,fy,fz);if(id==h->halfID && (meta&7)==item->aux){if(h->unobstructed(h->host,x,y,z) && h->setTileData(h->host,x,y,z,h->fullID,meta&7,3)){h->playSound(h->host,x,y,z);item->count--;}return TRUE;}return h->baseUseOn(h->host,item,player,x,y,z,face,fx,fy,fz);}
I32 StoneSlabTileItem_getLevelDataForAuxValue(StoneSlabTileItem *s,I32 d){return d;}U0 StoneSlabTileItem_getDescriptionId(StoneSlabTileItem *s,I32 d,MCString *out){U8 *name;if(d<0||d>=7)d=0;name=StoneSlabTile_name(d);MCString_CopyInit(out,&s->descriptionId);MC013_appendC(out,".");MC013_appendC(out,name);}U0 StoneSlabTileItem_getName(StoneSlabTileItem *s,I32 d,MCString *out){MCString key;StoneSlabTileItem_getDescriptionId(s,d,&key);MC013_appendC(&key,".name");s->host->localize(s->host->host,&key,out);MCString_Destroy(&key);}
