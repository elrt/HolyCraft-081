// Port of minecraftpe/impl/item/DyePowderItem.cpp
U8 *MC010_dyeColor(I32 index) { switch(index) { case 0:return "black";case 1:return "red";case 2:return "green";case 3:return "brown";case 4:return "blue";case 5:return "purple";case 6:return "cyan";case 7:return "silver";case 8:return "gray";case 9:return "pink";case 10:return "lime";case 11:return "yellow";case 12:return "lightBlue";case 13:return "magenta";case 14:return "orange";default:return "white"; } }
I32 MC010_dyeRGB(I32 i) { switch(i) { case 0:return 0x1E1B1B;case 1:return 0xB3312C;case 2:return 0x3B511A;case 3:return 0x51301A;case 4:return 0x253192;case 5:return 0x7B2FBE;case 6:case 7:return 0x287697;case 8:return 0x434343;case 9:return 0xD88198;case 10:return 0x41CD34;case 11:return 0xDECF2A;case 12:return 0x6689D3;case 13:return 0xC354CD;case 14:return 0xEB8844;default:return 0xF0F0F0; } }
U0 DyePowderItem_Init(DyePowderItem *s,MCItemContext010 *c,I32 id) { I32 i;MCItem009_Init(&s->base,c->items,id);s->base.stackedByData=TRUE;s->base.maxDamage=0;for(i=0;i<16;i++)s->textures[i]=*c->place->itemTexture(c->place->host,"dye_powder",i); }
TextureUVCoordinateSet *DyePowderItem_getIcon(DyePowderItem *s,I32 aux) { if(aux>15)aux=15;if(aux<0) { printf("DyePowderItem invalid negative texture index\n");exit(98); }return &s->textures[aux]; }
Bool DyePowderItem_useOn(DyePowderItem *s,MCItemContext010 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z) { I32 id;if(it->aux!=15 || c->items->isClient)return FALSE;if(!c->items->instabuild)it->count--;id=c->items->getTile(c->items->host,x,y,z);return c->fertilize(c->host,id,x,y,z); }
U0 DyePowderItem_interactEnemy(DyePowderItem *s,MCItemContext010 *c,MCPacketItem009 *it,Bool hasPlayer) { I32 color;if(c->sheepType==13 && !c->sheepSheared) { color=(~it->aux)&15;if(c->sheepColor!=color) { c->setSheepColor(c->host,color);if(hasPlayer && !c->items->instabuild)it->count--; } } }
U0 DyePowderItem_getDescriptionId(DyePowderItem *s,MCItemContext010 *c,MCPacketItem009 *it,MCString *out) { I32 i=it->aux;if(i<0)i=0;if(i>15)i=15;MC009_joinStrings(out,c->dyeDescription,".",MC010_dyeColor(i),""); }
U0 DyePowderItem_getName(DyePowderItem *s,MCItemContext010 *c,MCPacketItem009 *it,MCString *out) { MCString desc,key;DyePowderItem_getDescriptionId(s,c,it,&desc);MC009_joinStrings(&key,MCString_CStr(&desc),".name","","");MCString_FromC(out,c->place->translate(c->place->host,MCString_CStr(&key)));MCString_Destroy(&desc);MCString_Destroy(&key); }
