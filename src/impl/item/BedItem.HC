// Port of minecraftpe/impl/item/BedItem.cpp
U0 BedItem_Init(BedItem *s,MCItemContext010 *c,I32 id) { MCItem009_Init(&s->base,c->items,id); }
Bool BedItem_useOn(BedItem *s,MCItemContext010 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 face) { I32 d,dx=0,dz=0,id;if(face!=1)return FALSE;d=MC010_floor(c->yaw*4.0/360.0+0.5)&3;if(d==0)dz=1;else if(d==1)dx=-1;else if(d==2)dz=-1;else dx=1;if(!c->items->isEmptyTile(c->items->host,x,y+1,z) || !c->items->isEmptyTile(c->items->host,x+dx,y+1,z+dz) || !c->isSolid(c->host,x,y,z) || !c->isSolid(c->host,x+dx,y,z+dz))return FALSE;c->place->setTileAndData(c->place->host,x,y+1,z,c->bedID,d,3);id=c->items->getTile(c->items->host,x,y+1,z);if(id==c->bedID)c->place->setTileAndData(c->place->host,x+dx,y+1,z+dz,id,d+8,3);it->count--;return TRUE; }
