// Batch 009: minecraftpe/impl/item/PickaxeItem.cpp
U0 PickaxeItem_Init(PickaxeItem *s,MCItemContext009 *c,I32 id,MCToolTier009 *tier,MCToolTiles009 *t) { MCToolTile009 *a[18];DiggerItem_Init(&s->base,c,id,2,tier,NULL,0);s->tiles=t;a[0]=t->stoneBrick;a[1]=t->stoneSlab;a[2]=t->stoneSlabHalf;a[3]=t->rock;a[4]=t->sandStone;a[5]=t->mossStone;a[6]=t->ironOre;a[7]=t->ironBlock;a[8]=t->coalOre;a[9]=t->goldBlock;a[10]=t->goldOre;a[11]=t->emeraldOre;a[12]=t->emeraldBlock;a[13]=t->ice;a[14]=t->lapisOre;a[15]=t->lapisBlock;a[16]=t->redStoneOre;a[17]=t->redStoneOre_lit;DiggerItem_setTiles(&s->base,a,18); }
F32 PickaxeItem_getDestroySpeed(PickaxeItem *s,MCToolTile009 *tile) { if(tile && (tile->material==s->tiles->metalMaterial || tile->material==s->tiles->stoneMaterial))return s->base.efficiencyMultiplier;return DiggerItem_getDestroySpeed(&s->base,tile); }
Bool PickaxeItem_canDestroySpecial(PickaxeItem *s,MCToolTile009 *a) { MCToolTiles009 *t=s->tiles;I32 level=s->base.tier->level;if(a==t->obsidian || a==t->glowingObsidian)return level==3;if(a==t->emeraldBlock || a==t->emeraldOre || a==t->goldBlock || a==t->goldOre || a==t->redStoneOre || a==t->redStoneOre_lit)return level>1;if(a==t->ironBlock || a==t->ironOre || a==t->lapisBlock || a==t->lapisOre)return level>0;return a->material==t->stoneMaterial || a->material==t->metalMaterial; }
