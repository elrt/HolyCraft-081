// Port of minecraftpe/impl/item/HoeItem.cpp
U0 HoeItem_Init(HoeItem *s,MCItemContext010 *c,I32 id,MCToolTier009 *tier) { MCItem009_Init(&s->base,c->items,id);s->tier=*tier;s->base.maxStackSize=1;s->base.maxDamage=tier->durability; }
Bool HoeItem_useOn(HoeItem *s,MCItemContext010 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 face) { I32 id,seed;F32 xx,yy,zz;MCPlaceTile009 *tile;Random *rng=c->items->worldRandom;id=c->items->getTile(c->items->host,x,y,z);if(!face || c->items->getTile(c->items->host,x,y+1,z))return FALSE;if(id!=c->grassID && id!=c->dirtID)return FALSE;tile=c->place->tileInfo(c->place->host,c->farmlandID);MC009_placementSound(c->items,tile,x,y,z);c->items->hurtAndBreak(c->items->host,it,1);if(!c->items->isClient) { c->items->setTile(c->items->host,x,y,z,c->farmlandID,3);if(id==c->grassID && !(Random_genrand_int32(rng)&7)) { xx=Random_nextFloat(rng)*0.7+0.15;yy=Random_nextFloat(rng)*0.7+0.75;zz=Random_nextFloat(rng)*0.7+0.15;seed=c->wheatSeedID;if(!(Random_genrand_int32(rng)%15))seed=c->beetSeedID;c->spawnSeed(c->host,seed,x+xx,y+yy,z+zz,10); } }return TRUE; }
Bool HoeItem_isHandEquipped(HoeItem *s) { return TRUE; }
