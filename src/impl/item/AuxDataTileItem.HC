// Batch 009: minecraftpe/impl/item/AuxDataTileItem.cpp includes the header only.
U0 AuxDataTileItem_Init(AuxDataTileItem *s,MCItemContext009 *c,MCPlaceContext009 *p,I32 id,I32 tile) { TileItem_Init(&s->base,c,p,id);s->tileID=tile;s->base.base.maxDamage=0;s->base.base.stackedByData=TRUE;s->base.levelData=&AuxDataTileItem_getLevelDataForAuxValue;s->base.levelDataSelf=s; }
TextureUVCoordinateSet *AuxDataTileItem_getIcon(AuxDataTileItem *s,I32 aux,I32 unused,Bool use) { MCPlaceContext009 *p=s->base.place;return p->texture(p->host,s->tileID,2,aux,TRUE); }
I32 AuxDataTileItem_getLevelDataForAuxValue(U0 *s,I32 aux) { return aux; }
U0 AuxDataTileItem_getName(AuxDataTileItem *s,MCPacketItem009 *it,MCString *out) { MCPlaceContext009 *p=s->base.place;U8 *type=p->typeDescription(p->host,s->tileID,it->aux),*base;MCString key;if(type && *type) { base=TileItem_getDescriptionId(&s->base,NULL);MC009_joinStrings(&key,base,".",type,".name"); }else { base=TileItem_getDescriptionId(&s->base,it);MC009_joinStrings(&key,base,".name","",""); }MCString_FromC(out,p->translate(p->host,MCString_CStr(&key)));MCString_Destroy(&key); }
U0 AuxDataTileItem_getDescription(AuxDataTileItem *s,MCPacketItem009 *it,MCString *out) { MCPlaceContext009 *p=s->base.place;U8 *type=p->typeDescription(p->host,s->tileID,it->aux),*base;if(type && *type) { base=TileItem_getDescriptionId(&s->base,NULL);MC009_joinStrings(out,base,".",type,""); }else { base=TileItem_getDescriptionId(&s->base,it);MCString_FromC(out,p->translate(p->host,base)); } }
