// Batch 009: minecraftpe/impl/item/TileItem.cpp includes the header only.
I32 MC009_defaultLevelData(U0 *self,I32 aux) { return 0; }
U0 TileItem_Init(TileItem *s,MCItemContext009 *c,MCPlaceContext009 *p,I32 id) { TextureUVCoordinateSet *texture;MCItem009_Init(&s->base,c,id);s->blockID=id+256;s->place=p;s->levelData=&MC009_defaultLevelData;s->levelDataSelf=s;texture=p->texture(p->host,s->blockID,2,0,FALSE);if(!texture) { printf("TileItem: missing tile texture\n");exit(97); }s->icon=*texture; }
Bool TileItem_useOn(TileItem *s,MCItemContext009 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 side,F32 fx,F32 fy,F32 fz) { MCPlaceContext009 *p=s->place;MCPlaceTile009 *target,*tile;I32 data,meta;tile=p->tileInfo(p->host,s->blockID);if(!tile) { printf("TileItem: missing tile\n");exit(97); }if(p->allowInteract && s->blockID!=p->leaves && !tile->isPlant)return FALSE;target=p->tileInfo(p->host,c->getTile(c->host,x,y,z));if(target && target->replaceable)side=1;else { if(side==0)y--;else if(side==1)y++;else if(side==2)z--;else if(side==3)z++;else if(side==4)x--;else if(side==5)x++; }if(!it->count || !p->mayPlace(p->host,s->blockID,x,y,z,FALSE,side))return FALSE;meta=s->levelData(s->levelDataSelf,it->aux);data=p->placementData(p->host,s->blockID,x,y,z,side,fx,fy,fz,meta);if(p->setTileAndData(p->host,x,y,z,s->blockID,data,3)) { MC009_placementSound(c,tile,x,y,z);it->count--; }return TRUE; }
U8 *TileItem_getDescriptionId(TileItem *s,MCPacketItem009 *item) { return s->place->description(s->place->host,s->blockID,item); }
Bool TileItem_isEmissive(TileItem *s,I32 unused) { return MC009_isEmissive(s->place,s->blockID); }
