// Inline implementation from DoorItem.hpp; DoorItem.cpp is include-only.
U0 DoorItem_Init(DoorItem *s,MCItemContext010 *c,I32 id,Bool wood) { MCItem009_Init(&s->base,c->items,id);s->base.maxDamage=64;s->base.maxStackSize=1;s->wood=wood; }
U0 DoorItem_place(MCItemContext010 *c,I32 x,I32 y,I32 z,I32 dir,I32 id) { I32 dx=0,dz=0,left,right;Bool hasLeft,flip;if(dir==0)dz=1;else if(dir==1)dx=-1;else if(dir==2)dz=-1;else if(dir==3)dx=1;left=c->isSolid(c->host,x-dx,y,z-dz)+c->isSolid(c->host,x-dx,y+1,z-dz);right=c->isSolid(c->host,x+dx,y,z+dz)+c->isSolid(c->host,x+dx,y+1,z+dz);hasLeft=c->items->getTile(c->items->host,x-dx,y,z-dz)==id || c->items->getTile(c->items->host,x-dx,y+1,z-dz)==id;flip=(c->items->getTile(c->items->host,x+dx,y,z+dz)!=id && c->items->getTile(c->items->host,x+dx,y+1,z+dz)!=id && hasLeft) || right>left;c->place->setTileAndData(c->place->host,x,y,z,id,dir,2);c->place->setTileAndData(c->place->host,x,y+1,z,id,8+flip,2);c->neighbors(c->host,x,y,z,id);c->neighbors(c->host,x,y+1,z,id); }
Bool DoorItem_useOn(DoorItem *s,MCItemContext010 *c,MCPacketItem009 *it,I32 x,I32 y,I32 z,I32 face) { I32 id,dir;if(face!=1)return FALSE;if(s->wood)id=c->woodDoorID;else id=c->ironDoorID;if(!c->tileMayPlace(c->host,id,x,y+1,z))return FALSE;dir=MC010_floor((c->yaw+180.0)*4.0/360.0-0.5)&3;DoorItem_place(c,x,y+1,z,dir,id);it->count--;return TRUE; }
