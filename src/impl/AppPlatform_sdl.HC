// Batch026; algorithms and omissions documented in docs/BATCH026.md.
U0 AppPlatform_sdl_Init(AppPlatform_sdl *s,MCUI025 *ui){memset(s,0,sizeof(AppPlatform_sdl));AppPlatform_Init(&s->base,ui,"",1);s->screenWidth=854;s->screenHeight=480;}
U0 AppPlatform_sdl_getImagePath(AppPlatform_sdl *s,MCString *name,Bool external,MCString *out){MCString_FromC(out,"assets/images/");MC025_Append(out,name->data);}
Bool AppPlatform_sdl_readAssetFile(AppPlatform_sdl *s,MCString *name,MCVector *out){MCString path;MCString_FromC(&path,"assets/");MC025_Append(&path,name->data);Bool ok=AppPlatform_readAssetFile(&s->base,&path,out);MCString_Destroy(&path);return ok;}
Bool AppPlatform_sdl_sdlCtxInit(AppPlatform_sdl *s){if(s->hasContext)return TRUE;if(s->videoMode==NULL)return FALSE;s->surface=s->videoMode(s->backend,s->screenWidth,s->screenHeight,FALSE);s->hasContext=s->surface!=NULL;return s->hasContext;}
U0 AppPlatform_sdl_sdlCtxDestroy(AppPlatform_sdl *s){if(!s->hasContext)return;if(s->destroyContext!=NULL)s->destroyContext(s->backend);s->hasContext=FALSE;s->surface=NULL;}
Bool AppPlatform_sdl_setFullscreen(AppPlatform_sdl *s,Bool full){if(!s->hasContext || s->videoMode==NULL)return FALSE;I32 w=s->screenWidth,h=s->screenHeight;if(full){w=0;h=0;}else if(s->fullscreen){w=s->lastWidth;h=s->lastHeight;}U0 *surface=s->videoMode(s->backend,w,h,full);if(!surface)return FALSE;if(full && !s->fullscreen){s->lastWidth=s->screenWidth;s->lastHeight=s->screenHeight;}if(!full){s->screenWidth=w;s->screenHeight=h;}s->surface=surface;s->fullscreen=full;return TRUE;}
Bool AppPlatform_sdl_loadPNG(AppPlatform_sdl *s,ImageData *out,MCString *path){if(s->base.loadImage==NULL)return FALSE;ImageData temp;ImageData_Init(&temp);if(!s->base.loadImage(s->base.context,path,1,FALSE,&temp))return FALSE;if(!temp.pixels || temp.width<=0 || temp.height<=0)return FALSE;temp.field_C=0;*out=temp;return TRUE;}
U0 AppPlatform_sdl_onKeyPressed(AppPlatform_sdl *s,Minecraft *mc,I32 key,Bool pressed,Bool mouseGrabbed){I32 code=0;if(key==119)code=mc->options.keyCodes[0];if(key==115)code=mc->options.keyCodes[1];if(key==97)code=mc->options.keyCodes[2];if(key==100)code=mc->options.keyCodes[3];if(key==32)code=mc->options.keyCodes[4];if(key==101)code=100;if(key==8)code=8;if(key==13)code=13;if(key==27){if(pressed && mc->currentScreen)Screen_handleBackEvent(mc->currentScreen,FALSE);return;}if(key==304 && mc->player!=NULL && mc->currentScreen==NULL && mc->input!=NULL)mc->input->sneaking=pressed;if(key>=49 && key<=56 && mc->player!=NULL && mc->currentScreen==NULL)Inventory_selectSlot(&mc->player->player.inventory,key-49);if(code){Keyboard_feed(code,pressed);if(s->key!=NULL)s->key(s->backend,code,pressed);}}
U0 AppPlatform_sdl_getLoginInformation(AppPlatform_sdl *s,LoginInformation *out){LoginInformation_Init(out);}
U0 AppPlatform_sdl_Destroy(AppPlatform_sdl *s){AppPlatform_sdl_sdlCtxDestroy(s);AppPlatform_Destroy(&s->base);}
