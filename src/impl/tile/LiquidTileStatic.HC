U0 LiquidTileStatic_Init(LiquidTileStatic *s,MCTileHost013 *h,I32 id,Bool lava){s->host=h;s->id=id;s->isLava=lava;s->ticking=lava;}U0 LiquidTileStatic_setDynamic(LiquidTileStatic *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;I32 d=h->getData(h->host,x,y,z),id=s->id-1,delay;h->setTileDataNoUpdate(h->host,x,y,z,id,d);h->setDirty(h->host,x,y,z,x,y,z);delay=h->liquidTickDelay(h->host);h->scheduleTick(h->host,x,y,z,id,delay);}U0 LiquidTileStatic_tick(LiquidTileStatic *s,I32 x,I32 y,I32 z,Random *r){if(s->isLava)s->host->spreadFire(s->host->host,x,y,z,r);}U0 LiquidTileStatic_neighborChanged(LiquidTileStatic *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;h->updateLiquid(h->host,x,y,z);if(h->getTile(h->host,x,y,z)==s->id)LiquidTileStatic_setDynamic(s,x,y,z);}
