U0 ObsidianTile_Init(ObsidianTile *s,MCTileHost013 *h,I32 id,Bool glow){s->host=h;s->id=id;s->glowing=glow;}U0 ObsidianTile_poofParticles(ObsidianTile *s,I32 x,I32 y,I32 z){MC013_poofParticles(s->host,x,y,z);}U0 ObsidianTile_animateTick(ObsidianTile *s,I32 x,I32 y,I32 z,Random *r){if(s->glowing)ObsidianTile_poofParticles(s,x,y,z);}I32 ObsidianTile_getResource(ObsidianTile *s){return s->host->obsidianID;}I32 ObsidianTile_getResourceCount(ObsidianTile *s){return 1;}
