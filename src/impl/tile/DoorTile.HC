// Batch023: tile/DoorTile; explicit simulation ABI, see docs/BATCH023.md.
U0 DoorTile_Init(DoorTile *s,MCWorld023 *w,I32 id,Bool metal) {s->w=w;s->id=id;s->metal=metal;}
I32 DoorTile_getCompositeData(DoorTile *s,I32 x,I32 y,I32 z) {I32 m=MC023_Data(s->w,x,y,z),lo=m,hi=MC023_Data(s->w,x,y+1,z);if(m&8){lo=MC023_Data(s->w,x,y-1,z);hi=m;}return (lo&7)|(m&8)|((hi&1)<<4);}
U0 DoorTile_shape(I32 m,MC023Shape *out) {I32 dir=m&3;Bool open=(m&4)!=0,hinge=(m&16)!=0;I32 plane=dir;if(open){if(!hinge)plane=(dir+1)&3;else plane=(dir+3)&3;}if(plane==0)MC023_Shape(out,0,0,0,0.1875,1,1);if(plane==1)MC023_Shape(out,0,0,0,1,1,0.1875);if(plane==2)MC023_Shape(out,0.8125,0,0,1,1,1);if(plane==3)MC023_Shape(out,0,0,0.8125,1,1,1);}
Bool DoorTile_setOpen(DoorTile *s,I32 x,I32 y,I32 z,Bool open) {I32 m=DoorTile_getCompositeData(s,x,y,z);if(((m&4)!=0)==open)return FALSE;I32 by=y;if(m&8)by--;MC023_Set(s->w,MC023_SET_DATA,x,by,z,0,(m&7)^4,2);MC023_Event(s->w,MC023_DIRTY,x,by,z,s->id,0,0);MC023_Event(s->w,MC023_LEVEL_EVENT,x,y,z,1003,0,0);return TRUE;}
Bool DoorTile_use(DoorTile *s,I32 x,I32 y,I32 z) {if(!s->metal){I32 m=DoorTile_getCompositeData(s,x,y,z);DoorTile_setOpen(s,x,y,z,(m&4)==0);}return TRUE;}
Bool DoorTile_mayPlace(DoorTile *s,I32 x,I32 y,I32 z) {return y<=126 && MC023_Solid(s->w,x,y-1,z) && MC023_Get(s->w,MC023_MAYPLACE,x,y,z) && MC023_Get(s->w,MC023_MAYPLACE,x,y+1,z);}
U0 DoorTile_neighborChanged(DoorTile *s,I32 x,I32 y,I32 z,I32 changed) {I32 m=MC023_Data(s->w,x,y,z);if(m&8){if(MC023_Tile(s->w,x,y-1,z)!=s->id)MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);if(changed>0 && changed!=s->id)DoorTile_neighborChanged(s,x,y-1,z,changed);return;}Bool removed=FALSE;if(MC023_Tile(s->w,x,y+1,z)!=s->id){MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);removed=TRUE;}if(!MC023_Solid(s->w,x,y-1,z)){MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);removed=TRUE;if(MC023_Tile(s->w,x,y+1,z)==s->id)MC023_Set(s->w,MC023_SET_TILE,x,y+1,z,0,0,3);}if(removed){if(!s->w->isClient)MC023_Event(s->w,MC023_DROP,x,y,z,s->id,m,1);return;}Bool power=MC023_Get(s->w,MC023_SIGNAL,x,y,z)||MC023_Get(s->w,MC023_SIGNAL,x,y+1,z);MCTileDef023 *t=MC023_Def(s->w,changed);if(changed!=s->id && (power || !changed || (t && t->signal)))DoorTile_setOpen(s,x,y,z,power);}
