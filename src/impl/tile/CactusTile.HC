// Inline original implementation from CactusTile.hpp.
U0 CactusTile_Init(CactusTile *s,MCTileHost012 *h,I32 id){s->host=h;s->id=id;s->top=*h->texture(h->host,"cactus",0);s->side=*h->texture(h->host,"cactus",1);s->bottom=*h->texture(h->host,"cactus",2);}Bool CactusTile_isCubeShaped(CactusTile *s){return FALSE;}I32 CactusTile_getRenderShape(CactusTile *s){return 13;}TextureUVCoordinateSet *CactusTile_getTexture(CactusTile *s,I32 side){if(side==1)return &s->top;if(side)return &s->side;return &s->bottom;}AABB *CactusTile_getAABB(CactusTile *s,I32 x,I32 y,I32 z){AABB_Init(&s->aabb,x+0.0625,y,z+0.0625,x+1-0.0625,y+1-0.0625,z+1-0.0625);return &s->aabb;}U0 CactusTile_getTileAABB(CactusTile *s,I32 x,I32 y,I32 z,AABB *out){AABB_Init(out,x+0.0625,y,z+0.0625,x+1-0.0625,y+1.0,z+1-0.0625);}Bool CactusTile_isSolidRender(CactusTile *s){return FALSE;}
Bool CactusTile_canSurvive(CactusTile *s,I32 x,I32 y,I32 z){I32 bid;MCTileHost012 *h=s->host;if(h->solid(h->host,x-1,y,z)||h->solid(h->host,x+1,y,z)||h->solid(h->host,x,y,z-1)||h->solid(h->host,x,y,z+1))return FALSE;bid=h->getTile(h->host,x,y-1,z);return bid==h->cactusID || bid==h->sandID;}Bool CactusTile_mayPlace(CactusTile *s,I32 x,I32 y,I32 z){return s->host->baseMayPlace(s->host->host,x,y,z) && CactusTile_canSurvive(s,x,y,z);}
U0 CactusTile_tick(CactusTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;I32 i,meta,za;if(h->empty(h->host,x,y+1,z)){for(i=1;h->getTile(h->host,x,y-i,z)==s->id;i++){}if(i<=2){meta=h->getData(h->host,x,y,z);if(meta<=9)za=meta+1;else{h->setTile(h->host,x,y+1,z,s->id,3);za=0;}h->setData(h->host,x,y,z,za,4);}}}U0 CactusTile_neighborChanged(CactusTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;if(!CactusTile_canSurvive(s,x,y,z)){h->spawnResources(h->host,x,y,z,h->getData(h->host,x,y,z),1.0);h->setTile(h->host,x,y,z,0,3);}}I32 CactusTile_getRenderLayer(CactusTile *s){if(s->host->goodGraphics)return 3;return 1;}U0 CactusTile_entityInside(CactusTile *s,U0 *entity){s->host->hurtEntity(s->host->host,entity,1);}
