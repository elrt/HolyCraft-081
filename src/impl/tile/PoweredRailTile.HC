U0 PoweredRailTile_updateState(PoweredRailTile *s,MCWorld014 *w,I32 x,I32 y,I32 z,I32 a6,I32 a7,I32 a8){if(w->neighborSignal(w->host,x,y,z)||PoweredRailTile_findPoweredRailSignal(s,w,x,y,z,a6,TRUE,0)||PoweredRailTile_findPoweredRailSignal(s,w,x,y,z,a6,FALSE,0)){w->setData(w->host,x,y,z,a7,3);w->neighbors(w->host,x,y-1,z,s->blockID);if((a7-2)(U32)<=3)w->neighbors(w->host,x,y+1,z,s->blockID);}}
