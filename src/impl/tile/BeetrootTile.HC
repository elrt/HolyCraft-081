U0 BeetrootTile_Init(BeetrootTile *s,MCTileHost012 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<4;i++)s->textures[i]=*h->texture(h->host,"beetroot_stage_x",i);}U0 BeetrootTile_spawnItem(BeetrootTile *s,I32 x,I32 y,I32 z,I32 id){MCTileHost012 *h=s->host;F32 a=Random_nextFloat(h->random),b=Random_nextFloat(h->random),c=Random_nextFloat(h->random);h->spawnItem(h->host,id,x+(a*0.7+0.15)(F32),y+(b*0.7+0.15)(F32),z+(c*0.7+0.15)(F32),10);}TextureUVCoordinateSet *BeetrootTile_getTexture(BeetrootTile *s,I32 meta){I32 i;if(meta>6)i=3;else{if(meta==6)meta=5;i=meta>>1;}if(i<0 || i>3){printf("BeetrootTile invalid stage\n");exit(99);}return &s->textures[i];}U0 BeetrootTile_spawnResources(BeetrootTile *s,I32 x,I32 y,I32 z,I32 data,F32 chance){MCTileHost012 *h=s->host;I32 n,m,i;if(h->isClient || data<=1)return;if(data>6){n=Random_genrand_int32(h->random)%3;m=Random_genrand_int32(h->random)&1;for(i=0;i<n;i++)BeetrootTile_spawnItem(s,x,y,z,h->beetSeedID);for(i=0;i<=m;i++)BeetrootTile_spawnItem(s,x,y,z,h->beetID);}else BeetrootTile_spawnItem(s,x,y,z,h->beetSeedID);}I32 BeetrootTile_getBaseSeed(BeetrootTile *s){return s->host->beetSeedID;}I32 BeetrootTile_getBasePlantId(BeetrootTile *s){return s->host->beetID;}
