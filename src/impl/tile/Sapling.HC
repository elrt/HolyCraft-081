U0 Sapling_Init(Sapling *s,MCTileHost013 *h,I32 id){I32 i;s->host=h;s->id=id;AABB_Init(&s->shape,0.1,0,0.1,0.9,0.8,0.9);for(i=0;i<4;i++)s->tex[i]=*h->texture(h->host,"sapling",i);}
U0 Sapling_growTree(Sapling *s,I32 x,I32 y,I32 z,Random *r){MCTileHost013 *h=s->host;I32 d=h->getData(h->host,x,y,z)&3,kind=0;if(d==1)kind=1;else if(d==2)kind=2;h->setTileNoUpdate(h->host,x,y,z,0);if(!h->placeFeature(h->host,kind,r,x,y,z))h->setTileDataNoUpdate(h->host,x,y,z,s->id,d);}
Bool Sapling_onFertilized(Sapling *s,I32 x,I32 y,I32 z){Sapling_growTree(s,x,y,z,s->host->random);return TRUE;}TextureUVCoordinateSet *Sapling_getTexture(Sapling *s,I32 side,I32 d){d&=3;if(d==1)return &s->tex[2];if(d==2)return &s->tex[1];return &s->tex[d];}
U0 Sapling_tick(Sapling *s,I32 x,I32 y,I32 z,Random *r){MCTileHost013 *h=s->host;I32 d;if(!h->isClient){h->checkAlive(h->host,x,y,z);if(h->brightness(h->host,x,y+1,z)>8 && !(Random_genrand_int32(r)%7)){d=h->getData(h->host,x,y,z);if(d&8)Sapling_growTree(s,x,y,z,r);else h->setDataNoUpdate(h->host,x,y,z,d|8);}}}I32 Sapling_getSpawnResourcesAuxValue(Sapling *s,I32 d){return d&3;}
