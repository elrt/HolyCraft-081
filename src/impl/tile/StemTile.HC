// Batch023: tile/StemTile; explicit simulation ABI, see docs/BATCH023.md.
U0 StemTile_Init(StemTile *s,MCWorld023 *w,I32 id,I32 fruit,I32 seed) {s->w=w;s->id=id;s->fruit=fruit;s->seed=seed;}
I32 StemTile_getConnectDir(StemTile *s,I32 x,I32 y,I32 z) {if(MC023_Data(s->w,x,y,z)<=6)return -1;if(MC023_Data(s->w,x-1,y,z)==s->fruit)return 0;if(MC023_Data(s->w,x+1,y,z)==s->fruit)return 1;if(MC023_Data(s->w,x,y,z-1)==s->fruit)return 2;if(MC023_Data(s->w,x,y,z+1)==s->fruit)return 3;return -1;/* Source uses getData, not getTile. */}
F32 StemTile_getGrowthSpeed(StemTile *s,I32 x,I32 y,I32 z) {Bool xx=MC023_Tile(s->w,x-1,y,z)==s->id || MC023_Tile(s->w,x+1,y,z)==s->id,zz=MC023_Tile(s->w,x,y,z-1)==s->id || MC023_Tile(s->w,x,y,z+1)==s->id;Bool diag=FALSE;F32 speed=1.0;I32 a,b;for(a=-1;a<=1;a++)for(b=-1;b<=1;b++){if(a && b && MC023_Tile(s->w,x+a,y,z+b)==s->id)diag=TRUE;F32 v=0.0;if(MC023_Tile(s->w,x+a,y-1,z+b)==s->w->registry->farmland){v=1.0;if(MC023_Data(s->w,x+a,y-1,z+b)>0)v=3.0;}if(a || b)v*=0.25;speed+=v;}if(diag || xx && zz)speed*=0.5;return speed;}
F32 StemTile_height(I32 meta) {return (meta+1)*0.125;}
Bool StemTile_onFertilized(StemTile *s,I32 x,I32 y,I32 z) {I32 value=MC023_Data(s->w,x,y,z)+Random_genrand_int32(&s->w->random)%3+2;if(value>=7)value=7;MC023_Set(s->w,MC023_SET_DATA,x,y,z,0,value,2);return TRUE;}
U0 StemTile_tick(StemTile *s,I32 x,I32 y,I32 z) {MC023_Event(s->w,MC023_CHECK_ALIVE,x,y,z,s->id,0,0);if(MC023_Get(s->w,MC023_LIGHT,x,y+1,z)<=8)return;F32 speed=StemTile_getGrowthSpeed(s,x,y,z);I32 chance=(25.0/speed)(I32)+1;if(chance<=0 || Random_genrand_int32(&s->w->random)%chance(U32))return;I32 meta=MC023_Data(s->w,x,y,z);if(meta<=6){MC023_Set(s->w,MC023_SET_DATA,x,y,z,0,meta+1,2);return;}if(MC023_Tile(s->w,x-1,y,z)==s->fruit || MC023_Tile(s->w,x+1,y,z)==s->fruit || MC023_Tile(s->w,x,y,z-1)==s->fruit || MC023_Tile(s->w,x,y,z+1)==s->fruit)return;I32 dx[4]={-1,1,0,0},dz[4]={0,0,-1,1},i;for(i=0;i<4;i++){I32 nx=x+dx[i],nz=z+dz[i],ground=MC023_Tile(s->w,nx,y-1,nz);if(!MC023_Tile(s->w,nx,y,nz) && (ground==s->w->registry->farmland || ground==s->w->registry->dirt || ground==s->w->registry->grass)){MC023_Set(s->w,MC023_SET_TILE,nx,y,nz,s->fruit,0,3);return;}}}
I32 StemTile_getColor(I32 meta) {return (4*meta)|(meta<<21)|((255-8*meta)<<8);}
U0 StemTile_spawnResources(StemTile *s,I32 x,I32 y,I32 z,I32 meta) {if(s->w->isClient)return;I32 i;for(i=0;i<3;i++)if((Random_genrand_int32(&s->w->random)%15)(I32)<=meta)MC023_Event(s->w,MC023_DROP,x,y,z,s->seed,0,1);}
