U0 WoodSlabTile_Init(WoodSlabTile *s,MCTileHost012 *h,MCSlabHost013 *sh,I32 id,Bool full){SlabTile_Init(&s->base,h,id,full);s->slabHost=sh;}TextureUVCoordinateSet *WoodSlabTile_getTexture(WoodSlabTile *s,I32 side,I32 data){return s->slabHost->texture(s->slabHost->host,"planks",data&7);}I32 WoodSlabTile_getResource(WoodSlabTile *s){return s->slabHost->halfID;}U8 *WoodSlabTile_getTypeDescriptionId(WoodSlabTile *s,I32 data){I32 v=data&7;if(v==0)return "oak";if(v==1)return "spruce";if(v==2)return "birch";if(v==3)return "jungle";printf("WoodSlabTile wood name index unavailable\n");exit(99);return NULL;}I32 WoodSlabTile_getSpawnResourcesAuxValue(WoodSlabTile *s,I32 data){return data&7;}
U0 WoodSlabTileItem_Init(WoodSlabTileItem *s,MCSlabHost013 *h){s->host=h;}Bool WoodSlabTileItem_useOn(WoodSlabTileItem *s,MCSlabStack013 *item,U0 *player,I32 x,I32 y,I32 z,I32 face,F32 fx,F32 fy,F32 fz){MCSlabHost013 *h=s->host;I32 id,meta,top;if(!item->count)return FALSE;id=h->getTile(h->host,x,y,z);meta=h->getData(h->host,x,y,z);top=(meta>>3)&1;if((face==1 && top)||(face!=1 && (face!=0 || !top)))return h->baseUseOn(h->host,item,player,x,y,z,face,fx,fy,fz);if(id!=h->halfID)return h->baseUseOn(h->host,item,player,x,y,z,face,fx,fy,fz);if((meta^item->aux)&7)return FALSE;if(h->unobstructed(h->host,x,y,z) && h->setTileData(h->host,x,y,z,h->fullID,meta|item->aux,3)){h->playSound(h->host,x,y,z);item->count--;}return TRUE;}
