// Batch023: tile/BedTile; explicit simulation ABI, see docs/BATCH023.md.
U0 BedTile_Init(BedTile *s,MCWorld023 *w,I32 id) {s->w=w;s->id=id;}
U0 BedTile_shape(MC023Shape *out) {MC023_Shape(out,0,0,0,1,0.5625,1);}
U0 BedTile_setOccupied(BedTile *s,I32 x,I32 y,I32 z,Bool occupied) {I32 m=MC023_Data(s->w,x,y,z);if(occupied)m|=4;else m&=~4;MC023_Set(s->w,MC023_SET_DATA,x,y,z,0,m,2);}
Bool BedTile_findStandUpPosition(BedTile *s,I32 x,I32 y,I32 z,I32 skip,TilePos *out) {I32 dx[4]={0,-1,0,1},dz[4]={1,0,-1,0},dir=MC023_Data(s->w,x,y,z)&3,k,a,b;for(k=0;k<=1;k++)for(a=x-dx[dir]*k-1;a<=x-dx[dir]*k+1;a++)for(b=z-dz[dir]*k-1;b<=z-dz[dir]*k+1;b++)if(MC023_Solid(s->w,a,y-1,b) && !MC023_Solid(s->w,a,y,b) && !MC023_Solid(s->w,a,y+1,b)){if(skip<=0){out->x=a;out->y=y;out->z=b;return TRUE;}skip--;}return FALSE;}
U0 BedTile_neighborChanged(BedTile *s,I32 x,I32 y,I32 z) {I32 m=MC023_Data(s->w,x,y,z),dx[4]={0,-1,0,1},dz[4]={1,0,-1,0},d=m&3,a=dx[d],b=dz[d];if(m&8){a=-a;b=-b;}if(MC023_Tile(s->w,x+a,y,z+b)!=s->id){MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);if(!(m&8) && !s->w->isClient)MC023_Event(s->w,MC023_DROP,x,y,z,s->w->registry->bedItem,0,1);}}
Bool BedTile_use(BedTile *s,I32 x,I32 y,I32 z,MCPlayer023 *p) {I32 m=MC023_Data(s->w,x,y,z),dx[4]={0,-1,0,1},dz[4]={1,0,-1,0},d=m&3;if(p->sleeping){I32 same=(p->bedX==x)+(p->bedY==y)+(p->bedZ==z);if(same>=2 && MC023_Abs(p->bedX-x)<=2 && MC023_Abs(p->bedY-y)<=2 && MC023_Abs(p->bedZ-z)<=2){p->sleeping=FALSE;return TRUE;}}if(s->w->isClient)return TRUE;if(!(m&8)){x+=dx[d];z+=dz[d];if(MC023_Tile(s->w,x,y,z)!=s->id)return TRUE;m=MC023_Data(s->w,x,y,z);}if(!s->w->mayRespawn){MC023_Set(s->w,MC023_SET_TILE,x,y,z,0,0,3);I32 xx=x+dx[d],yy=y+dz[d];/* Preserve original wrong Y offset, not silently corrected. */if(MC023_Tile(s->w,xx,yy,z)==s->id)MC023_Set(s->w,MC023_SET_TILE,xx,yy,z,0,0,3);MC023_Event(s->w,MC023_EXPLODE,xx,yy,z,5,1,0,p);return TRUE;}MCInteraction023 *a=s->w->actions;if(!a || a->sleep==NULL){MC023_Event(s->w,MC023_SLEEP,x,y,z,0,m,0,p);return TRUE;}I32 result=a->sleep(a->ctx,p,x,y,z);if(!result)BedTile_setOccupied(s,x,y,z,TRUE);else if(result==2 || result==5)MC023_Event(s->w,MC023_MESSAGE,x,y,z,result,0,0,p);return TRUE;/* Host sleep service must enforce occupancy/player-list policy. */}
