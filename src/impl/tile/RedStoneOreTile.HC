U0 RedStoneOreTile_Init(RedStoneOreTile *s,MCTileHost013 *h,I32 id,Bool glow){s->host=h;s->id=id;s->emitLight=glow;s->ticking=glow;}U0 RedStoneOreTile_poofParticles(RedStoneOreTile *s,I32 x,I32 y,I32 z){MC013_poofParticles(s->host,x,y,z);}U0 RedStoneOreTile_interact(RedStoneOreTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;RedStoneOreTile_poofParticles(s,x,y,z);if(s->id==h->redstoneOreID)h->setTile(h->host,x,y,z,h->redstoneOreLitID,2);}I32 RedStoneOreTile_getTickDelay(RedStoneOreTile *s){return 30;}U0 RedStoneOreTile_tick(RedStoneOreTile *s,I32 x,I32 y,I32 z,Random *r){MCTileHost013 *h=s->host;if(s->id==h->redstoneOreLitID)h->setTile(h->host,x,y,z,h->redstoneOreID,2);}U0 RedStoneOreTile_animateTick(RedStoneOreTile *s,I32 x,I32 y,I32 z,Random *r){if(s->emitLight)RedStoneOreTile_poofParticles(s,x,y,z);}I32 RedStoneOreTile_getResource(RedStoneOreTile *s){return s->host->redstoneID;}I32 RedStoneOreTile_getResourceCount(RedStoneOreTile *s,Random *r){return (Random_genrand_int32(r)&1)+4;}Bool RedStoneOreTile_use(RedStoneOreTile *s,I32 x,I32 y,I32 z,U0 *p){RedStoneOreTile_interact(s,x,y,z);return s->host->baseUse(s->host->host,x,y,z,p);}U0 RedStoneOreTile_stepOn(RedStoneOreTile *s,I32 x,I32 y,I32 z,U0 *e){RedStoneOreTile_interact(s,x,y,z);}U0 RedStoneOreTile_attack(RedStoneOreTile *s,I32 x,I32 y,I32 z,U0 *p){RedStoneOreTile_interact(s,x,y,z);}
