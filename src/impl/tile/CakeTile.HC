// Inline original implementation from CakeTile.hpp.
U0 CakeTile_Init(CakeTile *s,MCTileHost012 *h,I32 id){s->host=h;s->id=id;s->top=*h->texture(h->host,"cake_top",0);s->bottom=*h->texture(h->host,"cake_bottom",0);s->inner=*h->texture(h->host,"cake_inner",0);s->side=*h->texture(h->host,"cake_side",0);}
Bool CakeTile_isCubeShaped(CakeTile *s){return FALSE;}Bool CakeTile_isSolidRender(CakeTile *s){return FALSE;}U0 CakeTile_updateShape(CakeTile *s,I32 d){AABB_Init(&s->shape,(2*d+1)*0.0625,0,0.0625,0.9375,0.5,0.9375);}U0 CakeTile_updateDefaultShape(CakeTile *s){AABB_Init(&s->shape,0.0625,0,0.0625,0.9375,0.5,0.9375);}TextureUVCoordinateSet *CakeTile_getTexture(CakeTile *s,I32 side,I32 d){if(side==1)return &s->top;if(!side)return &s->bottom;if(d>0 && side==4)return &s->inner;return &s->side;}Bool CakeTile_mayPlace(CakeTile *s,U8 side){return side==1;}Bool CakeTile_canSurvive(CakeTile *s,I32 x,I32 y,I32 z){return s->host->solid(s->host->host,x,y-1,z);}U0 CakeTile_neighborChanged(CakeTile *s,I32 x,I32 y,I32 z){if(!CakeTile_canSurvive(s,x,y,z))s->host->removeTile(s->host->host,x,y,z);}I32 CakeTile_getResourceCount(CakeTile *s){return 0;}Bool CakeTile_use(CakeTile *s,I32 x,I32 y,I32 z){I32 d;MCTileHost012 *h=s->host;if(h->playerInvulnerable && h->playerHurt){h->foodEat(h->host,2);d=h->getData(h->host,x,y,z)+1;if(d<=5)h->setData(h->host,x,y,z,d,2);else h->removeTile(h->host,x,y,z);}return TRUE;}
