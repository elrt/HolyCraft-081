// Inline original implementation from QuartzBlockTile.hpp.
U0 QuartzBlockTile_Init(QuartzBlockTile *s,MCTileHost012 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<7;i++)s->textures[i]=*h->texture(h->host,"quartz_block",i);}TextureUVCoordinateSet *QuartzBlockTile_getTexture(QuartzBlockTile *s,I32 side,I32 data){I32 i;if(side(U32)>1){if(data==1)i=5;else if(data==2)i=3;else i=2;}else if(data==1)i=6;else if(data==2)i=4;else if(side)i=1;else i=0;return &s->textures[i];}U8 *QuartzBlockTile_getDescriptionId(QuartzBlockTile *s,I32 aux){aux&=15;if(aux==1)return "tile.quartzBlockChiseled";if(aux==2)return "tile.quartzBlockPillar";return "tile.quartzBlock";}I32 QuartzBlockTile_getSpawnResourcesAuxValue(QuartzBlockTile *s,I32 n){return n;}
