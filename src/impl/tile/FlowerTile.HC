U0 FlowerTile_Init(FlowerTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;}
Bool FlowerTile_randomWalk(FlowerTile *s,I32 *x,I32 *y,I32 *z,I32 a){I32 i;U32 v;MCTileHost013 *h=s->host;for(i=0;;i++){if(i>=a/16)return a>15;*x+=Random_genrand_int32(h->random)%3-1;v=Random_genrand_int32(h->random)%3-1;*y+=(Random_genrand_int32(h->random)%3*v)(I32)/2;*z+=Random_genrand_int32(h->random)%3-1;if(h->getTile(h->host,*x,*y-1,*z)!=h->grassID || h->solid(h->host,*x,*y,*z))return FALSE;}}
Bool FlowerTile_onFertilized(FlowerTile *s,I32 x,I32 y,I32 z){I32 i,rx,ry,rz,id;U8 v;MCTileHost013 *h=s->host;for(i=16;i!=64;i++){rx=x;ry=y+1;rz=z;if(FlowerTile_randomWalk(s,&rx,&ry,&rz,i) && !h->getTile(h->host,rx,ry,rz)){v=Random_genrand_int32(h->random);id=h->flowerID;if((v&7)!=0){if(s->id==h->roseID)id=h->roseID;}else if(s->id!=h->roseID)id=h->roseID;if(h->survive(h->host,id,rx,ry,rz))h->setTileData(h->host,rx,ry,rz,id,0,3);}}return TRUE;}
