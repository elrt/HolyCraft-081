U0 NetherReactor_Init(NetherReactor *s,MCTileHost013 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<3;i++)s->tex[i]=*h->texture(h->host,"reactor_core_stage_x",i);}
Bool NetherReactor_allPlayersCloseToReactor(NetherReactor *s,I32 x,I32 y,I32 z){I32 i;F32 py;MCPlayer013 *p;MCTileHost013 *h=s->host;for(i=0;i<h->playerCount(h->host);i++){p=h->playerAt(h->host,i);if(p->x<x-5||p->x>x+5)return FALSE;py=p->y-p->ridingHeight;if(py<y-1||py>y+1||p->z<z-5||p->z>z+5)return FALSE;}return TRUE;}
Bool NetherReactor_canSpawnStartNetherReactor(NetherReactor *s,I32 x,I32 y,I32 z,U0 *player){MCTileHost013 *h=s->host;if(!NetherReactor_allPlayersCloseToReactor(s,x,y,z)){h->message(h->host,player,"All players need to be close to the reactor.");return FALSE;}if(y>100){h->message(h->host,player,"The nether reactor needs to be built lower down.");return FALSE;}if(y<=1){h->message(h->host,player,"The nether reactor needs to be built higher up.");return FALSE;}return TRUE;}
U0 NetherReactor_setPhase(NetherReactor *s,I32 x,I32 y,I32 z,I32 phase){MCTileHost013 *h=s->host;if(h->getData(h->host,x,y,z)!=phase)h->setData(h->host,x,y,z,phase,2);}
TextureUVCoordinateSet *NetherReactor_getTexture(NetherReactor *s,I32 data){if(data==1)return &s->tex[1];if(data==2)return &s->tex[2];return &s->tex[0];}I32 NetherReactor_getTileEntityType(NetherReactor *s){return 3;}
Bool NetherReactor_use(NetherReactor *s,I32 x,I32 y,I32 z,U0 *player){MCTileHost013 *h=s->host;NetherReactorPattern pat;I32 yy,xx,zz;if(h->gameType(h->host))return FALSE;NetherReactorPattern_Init(&pat,h->goldID,h->stoneID,h->reactorID);for(yy=0;yy<3;yy++)for(xx=0;xx<3;xx++)for(zz=0;zz<3;zz++)if(h->getTile(h->host,x-1+xx,y-1+yy,z-1+zz)!=NetherReactorPattern_getTileAt(&pat,yy,xx,zz)){h->message(h->host,player,"Not the correct pattern!");return FALSE;}if(!NetherReactor_canSpawnStartNetherReactor(s,x,y,z,player))return FALSE;h->message(h->host,player,"Active!");h->activateReactor(h->host,x,y,z);return TRUE;}
