U0 TallGrass_Init(TallGrass *s,MCTileHost013 *h,I32 id,TextureUVCoordinateSet *base){s->host=h;s->id=id;s->base=*base;AABB_Init(&s->shape,0.1,0,0.1,0.9,0.8,0.9);s->tex0=*h->texture(h->host,"tallgrass",0);s->tex2=*h->texture(h->host,"tallgrass",2);s->tex3=*h->texture(h->host,"tallgrass",3);s->tex4=*h->texture(h->host,"tallgrass",4);s->replaceable=TRUE;}TextureUVCoordinateSet *TallGrass_getTexture(TallGrass *s,I32 d){if(d==1)return &s->tex0;if(d==2)return &s->tex2;return &s->base;}TextureUVCoordinateSet *TallGrass_getCarriedTexture(TallGrass *s,I32 d){if(d==1)return &s->tex3;if(d==2)return &s->tex4;return &s->base;}I32 TallGrass_getResource(TallGrass *s,Random *r){if(Random_genrand_int32(r)&7)return -1;return s->host->seedsID;}I32 TallGrass_getColor(TallGrass *s,I32 d){return s->host->grassColorData(s->host->host,d);}I32 TallGrass_getColorAt(TallGrass *s,I32 x,I32 y,I32 z){return s->host->grassColorAt(s->host->host,x,y,z);}U0 TallGrass_playerDestroy(TallGrass *s,I32 x,I32 y,I32 z,I32 d,Bool selected,Bool shears){MCTileHost013 *h=s->host;if(!h->isClient && selected && shears)h->popItem(h->host,x,y,z,h->tallgrassID,d);else h->basePlayerDestroy(h->host,x,y,z,d);}U8 *TallGrass_getDescriptionId(TallGrass *s,I32 d){if(d==1)return "tile.tallgrass.grass";return "tile.tallgrass.fern";}
