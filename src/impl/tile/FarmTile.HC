// Inline original implementation from FarmTile.hpp.
U0 FarmTile_Init(FarmTile *s,MCTileHost012 *h,I32 id){s->host=h;s->id=id;s->dirt=*h->texture(h->host,"dirt",0);s->wet=*h->texture(h->host,"farmland",0);s->dry=*h->texture(h->host,"farmland",1);AABB_Init(&s->shape,0,0,0,1,0.9375,1);}Bool FarmTile_isCubeShaped(FarmTile *s){return FALSE;}Bool FarmTile_isSolidRender(FarmTile *s){return FALSE;}TextureUVCoordinateSet *FarmTile_getTexture(FarmTile *s,I32 side,I32 data){if(side!=1)return &s->dirt;if(data<=0)return &s->dry;return &s->wet;}AABB *FarmTile_getAABB(FarmTile *s,I32 x,I32 y,I32 z){AABB_Init(&s->aabb,x,y,z,x+1,y+1,z+1);return &s->aabb;}
U0 FarmTile_tick(FarmTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;I32 xx,yy,zz,d;for(xx=x-4;xx<=x+4;xx++)for(yy=y;yy<=y+1;yy++)for(zz=z-4;zz<=z+4;zz++)if(h->water(h->host,xx,yy,zz)){h->setData(h->host,x,y,z,7,2);return;}d=h->getData(h->host,x,y,z);if(d>0)h->setData(h->host,x,y,z,d-1,2);else if(h->getTile(h->host,x,y+1,z)!=h->cropsID)h->setTile(h->host,x,y,z,h->dirtID,3);}
U0 FarmTile_neighborChanged(FarmTile *s,I32 x,I32 y,I32 z,I32 a,I32 b,I32 c,I32 d){MCTileHost012 *h=s->host;h->baseNeighbor(h->host,x,y,z,a,b,c,d);if(h->solid(h->host,x,y+1,z))h->setTile(h->host,x,y,z,h->dirtID,3);}I32 FarmTile_getResource(FarmTile *s,Random *r){return s->host->dirtResource(s->host->host,r);}U0 FarmTile_fallOn(FarmTile *s,I32 x,I32 y,I32 z,F32 distance){MCTileHost012 *h=s->host;if(!h->isClient && Random_nextFloat(h->random)<distance-0.5)h->setTile(h->host,x,y,z,h->dirtID,3);}
