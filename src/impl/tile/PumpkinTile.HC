U0 PumpkinTile_Init(PumpkinTile *s,MCTileHost012 *h,I32 id,Bool lit){s->host=h;s->id=id;s->lit=lit;s->top=*h->texture(h->host,"pumpkin",0);s->side=*h->texture(h->host,"pumpkin",1);if(lit)s->face=*h->texture(h->host,"pumpkin",3);else s->face=*h->texture(h->host,"pumpkin",2);}
TextureUVCoordinateSet *PumpkinTile_getTexture(PumpkinTile *s,I32 side,I32 data){Bool front=FALSE;if(side==1 || side==0)return &s->top;if(data==2)front=side==2;else if(data==3)front=side==5;else if(data==1)front=side==4;else if(data==0)front=side==3;if(front)return &s->face;return &s->side;}
Bool PumpkinTile_mayPlace(PumpkinTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;I32 id=h->getTile(h->host,x,y,z);if(id && !h->replaceable(h->host,id))return FALSE;return h->topSolid(h->host,x,y-1,z);}U0 PumpkinTile_onPlace(PumpkinTile *s,I32 x,I32 y,I32 z){}I32 PumpkinTile_getPlacementDataValue(PumpkinTile *s,F32 yaw){F32 v=(yaw*4.0)(F32)/360.0+2.5;I32 i=v;if(v<i)i--;return i&3;}
