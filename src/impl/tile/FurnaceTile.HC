// Batch023: tile/FurnaceTile; explicit simulation ABI, see docs/BATCH023.md.
Bool FurnaceTile_noDrop023=FALSE;
U0 FurnaceTile_Init(FurnaceTile *s,MCWorld023 *w,Bool lit) {s->w=w;s->lit=lit;Random_setSeed(&s->random,1);}
U0 FurnaceTile_setLit(MCWorld023 *w,I32 x,I32 y,I32 z,Bool lit) {if(w->blockEntity==NULL)return;FurnaceTileEntity *te=w->blockEntity(w->ctx,x,y,z);if(!te || te->type!=1)return;I32 meta=MC023_Data(w,x,y,z),id=w->registry->furnace;if(lit)id=w->registry->litFurnace;te->preserve=TRUE;FurnaceTile_noDrop023=TRUE;MC023_Set(w,MC023_SET_TILE,x,y,z,id,0,2);FurnaceTile_noDrop023=FALSE;te->preserve=FALSE;MC023_Set(w,MC023_SET_DATA,x,y,z,0,meta,2);}
I32 FurnaceTile_getTexture(FurnaceTile *s,I32 face,I32 orientation,Bool inWorld) {if(face==0 || face==1)return 3;if(!inWorld){if(face==3)return 0;return 2;}if(face!=orientation)return 2;if(s->lit)return 1;return 0;}
I32 FurnaceTile_getPlacementDataValue(F32 yaw,I32 initial) {I32 dir=floorf(yaw*4.0/360.0+0.5)(I32)&3;if(dir==0)return initial|2;if(dir==1)return initial|5;if(dir==2)return initial|3;return initial|4;}
U0 FurnaceTile_animateTick(FurnaceTile *s,I32 x,I32 y,I32 z) {if(!s->lit)return;I32 dir=MC023_Data(s->w,x,y,z);F32 xx=x+0.5,yy=y+Random_nextFloat(&s->random)*6.0*0.0625,zz=z+0.5,offset=Random_nextFloat(&s->random)*0.6-0.3;if(dir==4){xx-=0.52;zz+=offset;}else if(dir==5){xx+=0.52;zz+=offset;}else if(dir==2){xx+=offset;zz-=0.52;}else if(dir==3){xx+=offset;zz+=0.52;}else return;MC023_Particle(s->w,1,xx,yy,zz,0.0,0.0,0.0);MC023_Particle(s->w,2,xx,yy,zz,0.0,0.0,0.0);}
Bool FurnaceTile_use(FurnaceTile *s,I32 x,I32 y,I32 z,MCPlayer023 *p) {if(!s->w->isClient && s->w->blockEntity!=NULL){U0 *te=s->w->blockEntity(s->w->ctx,x,y,z);if(te)MC023_Event(s->w,MC023_OPEN_FURNACE,x,y,z,0,0,0,p,te);}return TRUE;}
U0 FurnaceTile_onRemove(FurnaceTile *s,I32 x,I32 y,I32 z) {if(FurnaceTile_noDrop023 || s->w->isClient || s->w->blockEntity==NULL)return;FurnaceTileEntity *te=s->w->blockEntity(s->w->ctx,x,y,z);if(!te || te->type!=1)return;I32 slot;for(slot=0;slot<3;slot++){ItemInstance *v=&te->inventory[slot];F32 dx=Random_nextFloat(&s->random)*0.8+0.1,dy=Random_nextFloat(&s->random)*0.8+0.1,dz=Random_nextFloat(&s->random)*0.8+0.1;while(v->count>0){I32 count=Random_genrand_int32(&s->random)%21+10;if(count>v->count)count=v->count;v->count-=count;MCWorldEvent023 e;memset(&e,0,sizeof(e));e.op=MC023_DROP;e.id=ItemInstance_getId(v);e.meta=v->metadata;e.count=count;e.a=x+dx;e.b=y+dy;e.c=z+dz;e.d=Random_nextGaussian(&s->random)*0.05;e.e=Random_nextGaussian(&s->random)*0.05+0.2;e.f=Random_nextGaussian(&s->random)*0.05;if(s->w->event!=NULL)s->w->event(s->w->ctx,&e);}}}
