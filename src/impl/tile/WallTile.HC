U0 WallTile_Init(WallTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;AABB_Init(&s->shape,0,0,0,1,1,1);}Bool WallTile_connectsTo(WallTile *s,I32 x,I32 y,I32 z){return MC013_connects(s->host,s->id,x,y,z);}Bool WallTile_isCubeShaped(WallTile *s){return FALSE;}I32 WallTile_getRenderShape(WallTile *s){return 32;}
U0 WallTile_updateShape(WallTile *s,I32 x,I32 y,I32 z){Bool zn=WallTile_connectsTo(s,x,y,z-1),zp=WallTile_connectsTo(s,x,y,z+1),xn=WallTile_connectsTo(s,x-1,y,z),xp=WallTile_connectsTo(s,x+1,y,z);F32 minX=0.25,maxX=0.75,minZ=0.25,maxZ=0.75,maxY=1;if(xn)minX=0;if(xp)maxX=1;if(zn)minZ=0;if(zp)maxZ=1;if(zn && zp && !xn && !xp){maxY=0.8125;maxX=0.6875;minX=0.3125;}else if(!zn && !zp && xn && xp){maxY=0.8125;maxZ=0.6875;minZ=0.3125;}AABB_Init(&s->shape,minX,0,minZ,maxX,maxY,maxZ);}
Bool WallTile_shouldRenderFace(WallTile *s,I32 x,I32 y,I32 z,I32 side){return side || s->host->baseRenderFace(s->host->host,x,y,z,0);}TextureUVCoordinateSet *WallTile_getTexture(WallTile *s,I32 side,I32 data){return s->host->wallTexture(s->host->host,data==1,side);}
AABB *WallTile_getAABB(WallTile *s,I32 x,I32 y,I32 z){WallTile_updateShape(s,x,y,z);s->shape.maxY=1.5;AABB_Init(&s->aabb,x+s->shape.minX,y+s->shape.minY,z+s->shape.minZ,x+s->shape.maxX,y+s->shape.maxY,z+s->shape.maxZ);return &s->aabb;}Bool WallTile_isSolidRender(WallTile *s){return FALSE;}I32 WallTile_getSpawnResourcesAuxValue(WallTile *s,I32 data){return data;}
