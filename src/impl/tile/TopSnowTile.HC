U0 TopSnowTile_Init(TopSnowTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;AABB_Init(&s->shape,0,0,0,1,0.125,1);}Bool TopSnowTile_checkCanSurvive(TopSnowTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;if(TopSnowTile_mayPlace(s,x,y,z))return TRUE;h->spawnResources(h->host,x,y,z,h->getData(h->host,x,y,z),1.0);h->setTile(h->host,x,y,z,0,3);return FALSE;}I32 TopSnowTile_getTileType(TopSnowTile *s){return 4;}Bool TopSnowTile_isCubeShaped(TopSnowTile *s){return FALSE;}Bool TopSnowTile_shouldRenderFace(TopSnowTile *s,I32 x,I32 y,I32 z,I32 face,Bool sameMaterial){if(face==1)return TRUE;if(sameMaterial)return FALSE;return s->host->baseRenderFace(s->host->host,x,y,z,face);}AABB *TopSnowTile_getAABB(TopSnowTile *s,I32 x,I32 y,I32 z){return NULL;}Bool TopSnowTile_isSolidRender(TopSnowTile *s){return FALSE;}Bool TopSnowTile_mayPlace(TopSnowTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;I32 id=h->getTile(h->host,x,y-1,z);if(!id || !h->solidRenderID(h->host,id))return FALSE;return h->blocksMotion(h->host,x,y-1,z);}
U0 TopSnowTile_tick(TopSnowTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;if(h->blockBrightness(h->host,x,y,z)>11){h->spawnResources(h->host,x,y,z,h->getData(h->host,x,y,z),1.0);h->setTile(h->host,x,y,z,0,3);}}U0 TopSnowTile_neighborChanged(TopSnowTile *s,I32 x,I32 y,I32 z){TopSnowTile_checkCanSurvive(s,x,y,z);}I32 TopSnowTile_getResource(TopSnowTile *s){return s->host->snowballID;}I32 TopSnowTile_getResourceCount(TopSnowTile *s){return 0;}F32 TopSnowTile_getThickness(TopSnowTile *s){return 0.13;}U0 TopSnowTile_playerDestroy(TopSnowTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;F32 a,b,c;if(!h->isClient){a=Random_nextFloat(h->random);b=Random_nextFloat(h->random);c=Random_nextFloat(h->random);h->spawnSnowball(h->host,x+(a*0.7+0.15),y+(b*0.7+0.15),z+(c*0.7+0.15),h->snowballID,10);h->setTile(h->host,x,y,z,0,3);}}
