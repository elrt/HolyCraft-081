U0 PotatoTile_Init(PotatoTile *s,MCTileHost011 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<4;i++)s->textures[i]=*h->atlasTexture(h->host,"potatoes_stage_x",i);}TextureUVCoordinateSet *PotatoTile_getTexture(PotatoTile *s,I32 meta){I32 frame;if(meta>6)frame=3;else{if(meta==6)meta=5;frame=meta>>1;}if(frame<0 || frame>3){printf("PotatoTile invalid frame\n");exit(99);}return &s->textures[frame];}U0 PotatoTile_spawnResources(PotatoTile *s,I32 x,I32 y,I32 z,I32 data,F32 chance){s->host->cropSpawn(s->host->host,s->id,x,y,z,data,chance);}I32 PotatoTile_getBasePlantId(PotatoTile *s){return s->host->potatoID;}I32 PotatoTile_getBaseSeed(PotatoTile *s){return s->host->potatoID;}
