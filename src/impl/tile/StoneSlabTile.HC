U8 *StoneSlabTile_name(I32 i){switch(i){case 0:return "stone";case 1:return "sand";case 2:return "wood";case 3:return "cobble";case 4:return "brick";case 5:return "smoothStoneBrick";case 6:return "quartz";default:return NULL;}}
U0 StoneSlabTile_Init(StoneSlabTile *s,MCTileHost012 *h,I32 id,Bool full){SlabTile_Init(&s->base,h,id,full);s->tex[0]=*h->texture(h->host,"stone_slab",0);s->tex[1]=*h->texture(h->host,"stone_slab",1);s->tex[2]=*h->texture(h->host,"sandstone",3);s->tex[3]=*h->texture(h->host,"sandstone",3);s->tex[4]=*h->texture(h->host,"sandstone",0);s->tex[5]=*h->texture(h->host,"planks",0);s->tex[6]=*h->texture(h->host,"cobblestone",0);s->tex[7]=*h->texture(h->host,"brick",0);s->tex[8]=*h->texture(h->host,"stonebrick",0);s->tex[9]=*h->texture(h->host,"quartz_block",0);}
TextureUVCoordinateSet *StoneSlabTile_getTexture(StoneSlabTile *s,I32 side,I32 data){I32 v=data&7,i=0;if(v==0){if(side>1)i=1;}else if(v==1){if(side==0)i=3;else if(side==1)i=2;else i=4;}else if(v>=2 && v<=6)i=v+3;return &s->tex[i];}I32 StoneSlabTile_getResource(StoneSlabTile *s,I32 data){if((data&7)==2)return s->base.host->woodSlabHalfID;return s->base.host->stoneSlabHalfID;}I32 StoneSlabTile_getSpawnResourcesAuxValue(StoneSlabTile *s,I32 data){I32 n=data&7;if(n==2)return 0;return n;}
