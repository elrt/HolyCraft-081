U0 SlabTile_Init(SlabTile *s,MCTileHost012 *h,I32 id,Bool full){s->host=h;s->id=id;s->isFull=full;SlabTile_updateDefaultShape(s);}Bool SlabTile_isBottomSlab(SlabTile *s,I32 x,I32 y,I32 z){return ((s->host->getData(s->host->host,x,y,z)^8)(U32)>>3)&1;}I32 SlabTile_getTileType(SlabTile *s){return 2;}Bool SlabTile_isCubeShaped(SlabTile *s){return s->isFull;}U0 SlabTile_updateShape(SlabTile *s,I32 x,I32 y,I32 z){if(s->isFull)AABB_Init(&s->shape,0,0,0,1,1,1);else if(SlabTile_isBottomSlab(s,x,y,z))AABB_Init(&s->shape,0,0,0,1,0.5,1);else AABB_Init(&s->shape,0,0.5,0,1,1,1);}U0 SlabTile_updateDefaultShape(SlabTile *s){if(s->isFull)AABB_Init(&s->shape,0,0,0,1,1,1);else AABB_Init(&s->shape,0,0,0,1,0.5,1);}
Bool SlabTile_shouldRenderFace(SlabTile *s,I32 x,I32 y,I32 z,I32 side){MCTileHost012 *h=s->host;I32 opp,id,d;if(s->isFull)return h->baseRenderFace(h->host,x,y,z,side);if(side<0 || side>5){printf("SlabTile invalid face\n");exit(99);}if(side>1 && !h->baseRenderFace(h->host,x,y,z,side))return FALSE;opp=Facing_OPPOSITE_FACING[side];if(SlabTile_isBottomSlab(s,x+Facing_STEP_X[opp],y+Facing_STEP_Y[opp],z+Facing_STEP_Z[opp])){if(side!=1 && (side || !h->baseRenderFace(h->host,x,y,z,0))){id=h->getTile(h->host,x,y,z);if(id==h->woodSlabHalfID || id==h->stoneSlabHalfID){d=h->getData(h->host,x,y,z);return (d(U32)>>3)&1;}}}else if(side){if(side!=1 || !h->baseRenderFace(h->host,x,y,z,1)){id=h->getTile(h->host,x,y,z);if(id==h->woodSlabHalfID || id==h->stoneSlabHalfID){d=h->getData(h->host,x,y,z)^8;return (d(U32)>>3)&1;}}}return TRUE;}
U0 SlabTile_addAABBs(SlabTile *s,I32 x,I32 y,I32 z,AABB *clip,MCVector *out){SlabTile_updateShape(s,x,y,z);s->host->baseAddAABBs(s->host->host,x,y,z,&s->shape,clip,out);}Bool SlabTile_isSolidRender(SlabTile *s){return s->isFull;}I32 SlabTile_getResourceCount(SlabTile *s){if(s->isFull)return 2;return 1;}I32 SlabTile_getPlacementDataValue(SlabTile *s,I32 side,F32 hitY,I32 meta){if(!s->isFull && (!side || (side!=1 && hitY>0.5)))return meta|8;return meta;}
