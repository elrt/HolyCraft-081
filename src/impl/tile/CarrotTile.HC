U0 CarrotTile_Init(CarrotTile *s,MCTileHost011 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<4;i++)s->textures[i]=*h->atlasTexture(h->host,"carrots_stage_x",i);}TextureUVCoordinateSet *CarrotTile_getTexture(CarrotTile *s,I32 meta){I32 frame;if(meta>6)frame=3;else{if(meta==6)meta=5;frame=meta>>1;}if(frame<0 || frame>3){printf("CarrotTile invalid frame\n");exit(99);}return &s->textures[frame];}U0 CarrotTile_spawnResources(CarrotTile *s,I32 x,I32 y,I32 z,I32 data,F32 chance){s->host->cropSpawn(s->host->host,s->id,x,y,z,data,chance);}I32 CarrotTile_getBasePlantId(CarrotTile *s){return s->host->carrotID;}I32 CarrotTile_getBaseSeed(CarrotTile *s){return s->host->carrotID;}
