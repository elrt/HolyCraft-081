U0 SignTile_Init(SignTile *s,MCTileHost013 *h,I32 id,Bool standing){s->host=h;s->id=id;s->standing=standing;s->textureUV=*h->texture(h->host,"planks",0);AABB_Init(&s->shape,0.25,0,0.25,0.75,1,0.75);}Bool SignTile_isCubeShaped(SignTile *s){return FALSE;}I32 SignTile_getRenderShape(SignTile *s){return -1;}U0 SignTile_updateShape(SignTile *s,I32 x,I32 y,I32 z){I32 d;if(s->standing)return;d=s->host->getData(s->host->host,x,y,z);AABB_Init(&s->shape,0,0,0,1,1,1);if(d==2)AABB_Init(&s->shape,0,0.28125,0.875,1,0.78125,1);else if(d==3)AABB_Init(&s->shape,0,0.28125,0,1,0.78125,0.125);else if(d==4)AABB_Init(&s->shape,0.875,0.28125,0,1,0.78125,1);else if(d==5)AABB_Init(&s->shape,0,0.28125,0,0.125,0.78125,1);}AABB *SignTile_getAABB(SignTile *s,I32 x,I32 y,I32 z){return NULL;}AABB *SignTile_getTileAABB(SignTile *s,I32 x,I32 y,I32 z){SignTile_updateShape(s,x,y,z);AABB_Init(&s->aabb,x+s->shape.minX,y+s->shape.minY,z+s->shape.minZ,x+s->shape.maxX,y+s->shape.maxY,z+s->shape.maxZ);return &s->aabb;}Bool SignTile_isSolidRender(SignTile *s){return FALSE;}Bool SignTile_isPathfindable(SignTile *s){return TRUE;}I32 SignTile_getTileEntityType(SignTile *s){return 4;}
U0 SignTile_neighborChanged(SignTile *s,I32 x,I32 y,I32 z,I32 a,I32 b,I32 c,I32 e){MCTileHost013 *h=s->host;I32 d,sx=x,sy=y,sz=z;Bool check=TRUE;if(s->standing)sy--;else{d=h->getData(h->host,x,y,z);if(d==2)sz++;else if(d==3)sz--;else if(d==4)sx++;else if(d==5)sx--;else check=FALSE;}if(!check || !h->solid(h->host,sx,sy,sz)){d=h->getData(h->host,x,y,z);h->spawnResources(h->host,x,y,z,d,1.0);h->setTile(h->host,x,y,z,0,3);}h->baseNeighbor(h->host,x,y,z,a,b,c,e);}I32 SignTile_getResource(SignTile *s){return s->host->signItemID;}
