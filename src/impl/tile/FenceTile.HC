U0 FenceTile_Init(FenceTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;AABB_Init(&s->shape,0,0,0,1,1,1);}
Bool FenceTile_connectsTo(FenceTile *s,I32 x,I32 y,I32 z){return MC013_connects(s->host,s->id,x,y,z);}Bool FenceTile_isCubeShaped(FenceTile *s){return FALSE;}I32 FenceTile_getRenderShape(FenceTile *s){return 11;}
U0 FenceTile_updateShape(FenceTile *s,I32 x,I32 y,I32 z){Bool zn=FenceTile_connectsTo(s,x,y,z-1),zp=FenceTile_connectsTo(s,x,y,z+1),xn=FenceTile_connectsTo(s,x-1,y,z),xp=FenceTile_connectsTo(s,x+1,y,z);AABB_Init(&s->shape,0.375,0,0.375,0.625,1,0.625);if(xn)s->shape.minX=0;if(xp)s->shape.maxX=1;if(zn)s->shape.minZ=0;if(zp)s->shape.maxZ=1;}
AABB *FenceTile_getAABB(FenceTile *s,I32 x,I32 y,I32 z){Bool zn=FenceTile_connectsTo(s,x,y,z-1),zp=FenceTile_connectsTo(s,x,y,z+1),xn=FenceTile_connectsTo(s,x-1,y,z),xp=FenceTile_connectsTo(s,x+1,y,z);AABB_Init(&s->aabb,x+0.375,y,z+0.375,x+0.625,y+1.5,z+0.625);if(xn)s->aabb.minX=x;if(xp)s->aabb.maxX=x+1;if(zn)s->aabb.minZ=z;if(zp)s->aabb.maxZ=z+1;return &s->aabb;}
Bool FenceTile_isSolidRender(FenceTile *s){return FALSE;}Bool FenceTile_mayPlace(FenceTile *s,I32 x,I32 y,I32 z){return s->host->baseMayPlace(s->host->host,x,y,z);}
