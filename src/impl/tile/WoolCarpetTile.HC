U0 WoolCarpetTile_Init(WoolCarpetTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;WoolCarpetTile_updateShape(s,0);}I32 WoolCarpetTile_getItemAuxValueForTileData(I32 a){return ~a&15;}I32 WoolCarpetTile_getTileDataForItemAuxValue(I32 a){return ~a&15;}
U0 WoolCarpetTile_updateShape(WoolCarpetTile *s,I32 data){AABB_Init(&s->shape,0,0,0,1,0.0625,1);}U0 WoolCarpetTile_updateShapeAt(WoolCarpetTile *s,I32 x,I32 y,I32 z){WoolCarpetTile_updateShape(s,s->host->getData(s->host->host,x,y,z));}U0 WoolCarpetTile_updateDefaultShape(WoolCarpetTile *s){WoolCarpetTile_updateShape(s,0);}Bool WoolCarpetTile_isCubeShaped(WoolCarpetTile *s){return FALSE;}
Bool WoolCarpetTile_shouldRenderFace(WoolCarpetTile *s,I32 x,I32 y,I32 z,I32 side){return side==1 || s->host->baseRenderFace(s->host->host,x,y,z,side);}TextureUVCoordinateSet *WoolCarpetTile_getTexture(WoolCarpetTile *s,I32 side,I32 data){return s->host->clothTexture(s->host->host,side,data);}
AABB *WoolCarpetTile_getAABB(WoolCarpetTile *s,I32 x,I32 y,I32 z){AABB_Init(&s->aabb,x+s->shape.minX,y+s->shape.minY,z+s->shape.minZ,x+s->shape.maxX,y,z+s->shape.maxZ);return &s->aabb;}Bool WoolCarpetTile_isSolidRender(WoolCarpetTile *s){return FALSE;}Bool WoolCarpetTile_canSurvive(WoolCarpetTile *s,I32 x,I32 y,I32 z){return !s->host->empty(s->host->host,x,y-1,z);}Bool WoolCarpetTile_mayPlace(WoolCarpetTile *s,I32 x,I32 y,I32 z){return s->host->baseMayPlace(s->host->host,x,y,z)&&WoolCarpetTile_canSurvive(s,x,y,z);}Bool WoolCarpetTile_checkCanSurvive(WoolCarpetTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;if(WoolCarpetTile_canSurvive(s,x,y,z))return TRUE;h->spawnResources(h->host,x,y,z,h->getData(h->host,x,y,z),0);h->removeTile(h->host,x,y,z);return FALSE;}U0 WoolCarpetTile_neighborChanged(WoolCarpetTile *s,I32 x,I32 y,I32 z){WoolCarpetTile_checkCanSurvive(s,x,y,z);}F32 WoolCarpetTile_getThickness(WoolCarpetTile *s){return 0.07;}I32 WoolCarpetTile_getSpawnResourcesAuxValue(WoolCarpetTile *s,I32 d){return d;}
