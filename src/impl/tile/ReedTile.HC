U0 ReedTile_Init(ReedTile *s,MCTileHost013 *h,I32 id){s->host=h;s->id=id;AABB_Init(&s->shape,0.125,0,0.125,0.875,1,0.875);}Bool ReedTile_onFertilized(ReedTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;I32 below=y-1,above=y+1,n,end;while(below>0 && h->getTile(h->host,x,below,z)==s->id)below--;while(above<=127 && h->getTile(h->host,x,above,z)==s->id)above++;n=below-(above-1)+3;if(n<=0)return FALSE;end=above-1+n;while(above<=end){h->setTileData(h->host,x,above,z,s->id,0,3);above++;}return TRUE;}
Bool ReedTile_isCubeShaped(ReedTile *s){return FALSE;}I32 ReedTile_getRenderShape(ReedTile *s){return 1;}AABB *ReedTile_getAABB(ReedTile *s,I32 x,I32 y,I32 z){return NULL;}Bool ReedTile_isSolidRender(ReedTile *s){return FALSE;}
Bool ReedTile_mayPlace(ReedTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;I32 id=h->getTile(h->host,x,y-1,z);if(id==s->id)return TRUE;if(id!=h->grassID && id!=h->dirtID && id!=h->sandID)return FALSE;return h->water(h->host,x-1,y-1,z)||h->water(h->host,x+1,y-1,z)||h->water(h->host,x,y-1,z-1)||h->water(h->host,x,y-1,z+1);}
U0 ReedTile_tick(ReedTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;I32 i,d;if(h->empty(h->host,x,y+1,z)){for(i=1;h->getTile(h->host,x,y-i,z)==s->id;i++){}if(i<=2){d=h->getData(h->host,x,y,z);if(d==15){h->setTile(h->host,x,y+1,z,s->id,3);d=0;}else d++;h->setData(h->host,x,y,z,d,4);}}}U0 ReedTile_neighborChanged(ReedTile *s,I32 x,I32 y,I32 z){MCTileHost013 *h=s->host;if(!ReedTile_canSurvive(s,x,y,z)){h->popItem(h->host,x,y,z,h->reedsID,0);h->setTile(h->host,x,y,z,0,3);}}I32 ReedTile_getResource(ReedTile *s){return s->host->reedsID;}I32 ReedTile_getRenderLayer(ReedTile *s){if(s->host->goodGraphics)return 3;return 1;}Bool ReedTile_canSurvive(ReedTile *s,I32 x,I32 y,I32 z){return ReedTile_mayPlace(s,x,y,z);}
