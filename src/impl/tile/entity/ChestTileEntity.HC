// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 ChestTileEntity_Init(ChestTileEntity *s,MCRegistry023 *registry){memset(s,0,sizeof(ChestTileEntity));TileEntity_Init(&s->base,2);FillingContainer_Init(&s->container,registry,27,0,64,FALSE);s->primary=TRUE;}
U0 ChestTileEntity_unpair(ChestTileEntity *s){if(s->pair){s->pair->pair=NULL;s->pair->primary=TRUE;}s->pair=NULL;s->primary=TRUE;}
U0 ChestTileEntity_Destroy(ChestTileEntity *s){ChestTileEntity_unpair(s);FillingContainer_Destroy(&s->container);}
Bool ChestTileEntity_canPairWith(ChestTileEntity *s,ChestTileEntity *other){if(!other || other==s || other->base.type!=2 || other->base.y!=s->base.y || other->pair)return FALSE;I32 d=TileEntity_getData(&s->base);if(d!=TileEntity_getData(&other->base))return FALSE;I32 v=d-4;if(other->base.x==s->base.x)v=d-2;return v(U32)>1;}
U0 ChestTileEntity_pairWith(ChestTileEntity *s,ChestTileEntity *other,Bool primary){s->pair=other;s->primary=primary;s->sameX=FALSE;if(other)s->sameX=s->base.x==other->base.x;}
I32 ChestTileEntity_getContainerSize(ChestTileEntity *s){if(s->pair)return 54;return 27;}
ItemInstance *ChestTileEntity_getItem(ChestTileEntity *s,I32 slot){if(slot<0)return NULL;ChestTileEntity *master=s;if(!s->primary && s->pair)master=s->pair;if(slot<27)return FillingContainer_getItem(&master->container,slot);if(slot<54 && master->pair)return FillingContainer_getItem(&master->pair->container,slot-27);return NULL;}
Bool ChestTileEntity_canOpen(ChestTileEntity *s){if(!s->base.world)return FALSE;MCWorld023 *w=s->base.world->w;if(MC023_Solid(w,s->base.x,s->base.y+1,s->base.z))return FALSE;if(s->pair && MC023_Solid(w,s->pair->base.x,s->pair->base.y+1,s->pair->base.z))return FALSE;return TRUE;}
U0 ChestTileEntity_startOpen(ChestTileEntity *s){s->openCount++;if(s->base.world)MC023_Event(s->base.world->w,MC023_LEVEL_EVENT,s->base.x,s->base.y,s->base.z,1,s->openCount,0,s);}
U0 ChestTileEntity_stopOpen(ChestTileEntity *s){if(!s->primary && s->pair){ChestTileEntity_stopOpen(s->pair);return;}s->openCount--;if(s->base.world)MC023_Event(s->base.world->w,MC023_LEVEL_EVENT,s->base.x,s->base.y,s->base.z,1,s->openCount,0,s);}
U0 ChestTileEntity_tick(ChestTileEntity *s){s->ticks++;s->previousLid=s->lid;if(s->openCount>0)s->lid+=0.1;else s->lid-=0.1;if(s->lid<0)s->lid=0;if(s->lid>1)s->lid=1;if(s->base.world){if(s->previousLid==0 && s->openCount>0)MC023_Sound(s->base.world->w,"random.chestopen",s->base.x+0.5,s->base.y+0.5,s->base.z+0.5,0.5,0.9+Random_nextFloat(&s->base.world->w->random)*0.1);if(s->previousLid>=0.5 && s->lid<0.5)MC023_Sound(s->base.world->w,"random.chestclosed",s->base.x+0.5,s->base.y+0.5,s->base.z+0.5,0.5,0.9+Random_nextFloat(&s->base.world->w->random)*0.1);}}
Bool ChestTileEntity_save(ChestTileEntity *s,CompoundTag *tag){if(!TileEntity_save(&s->base,tag))return FALSE;if(s->pair && s->primary){MC024_PutInt(tag,"pairx",s->base.x);MC024_PutInt(tag,"pairz",s->base.z);}ListTag *items=FillingContainer_save(&s->container);MC023_TagPut(tag,"Items",items(Tag*));return TRUE;}
U0 ChestTileEntity_load(ChestTileEntity *s,CompoundTag *tag){TileEntity_load(&s->base,tag);Tag *items=MC023_TagGet(tag,"Items");if(items && Tag_getId(items)==9)FillingContainer_load(&s->container,items(ListTag*));}
