// Batch023: tile/entity/FurnaceTileEntity; explicit simulation ABI, see docs/BATCH023.md.
U0 FurnaceTileEntity_Init(FurnaceTileEntity *s,MCWorld023 *w,FurnaceRecipes *recipes,I32 x,I32 y,I32 z) {memset(s,0,sizeof(FurnaceTileEntity));s->type=1;s->w=w;s->recipes=recipes;s->x=x;s->y=y;s->z=z;I32 i;for(i=0;i<3;i++)ItemInstance_Init(&s->inventory[i],w->registry,0,0,0);}
U0 MC023_FurnaceResult(FurnaceTileEntity *s,ItemInstance *out) {MCRecipeItem r;memset(&r,0,sizeof(r));if(s->recipes)FurnaceRecipes_getResult(s->recipes,ItemInstance_getId(&s->inventory[0]),&r);ItemInstance_Init(out,s->w->registry,r.id,r.count,r.aux);}
Bool FurnaceTileEntity_canBurn(FurnaceTileEntity *s) {if(ItemInstance_isNull(&s->inventory[0]))return FALSE;ItemInstance result;MC023_FurnaceResult(s,&result);if(ItemInstance_isNull(&result))return FALSE;ItemInstance *out=&s->inventory[2];if(ItemInstance_isNull(out))return TRUE;if(!ItemInstance_sameItemAndAux(out,&result))return FALSE;I32 max=64;if(out->itemClass && out->itemClass->maxStack<max)max=out->itemClass->maxStack;if(out->count<max)return TRUE;return result.itemClass && out->count<result.itemClass->maxStack;}
U0 FurnaceTileEntity_burn(FurnaceTileEntity *s) {if(!FurnaceTileEntity_canBurn(s))return;ItemInstance result;MC023_FurnaceResult(s,&result);ItemInstance *out=&s->inventory[2];if(ItemInstance_isNull(out))*out=result;else if(out->itemClass==result.itemClass && out->itemClass)out->count++;s->inventory[0].count--;if(s->inventory[0].count<=0)ItemInstance_setNull(&s->inventory[0]);}
I32 FurnaceTileEntity_getBurnDuration(ItemInstance *item) {if(ItemInstance_isNull(item) || !item->itemClass)return 0;MCRegistry023 *r=item->registry;I32 id=ItemInstance_getId(item);if(id<=255 && item->tileClass && item->tileClass->material==2)return 300;if(id==r->stick)return 100;if(id==r->coal)return 1600;if(id==r->bucket && item->metadata==r->lava)return 20000;if(id==r->sapling)return 100;if(id==r->coalBlock)return 16000;if(id==r->bow || id==r->bowl || id==r->woodShovel || id==r->woodHoe || id==r->woodPick || id==r->woodSword)return 200;return 0;}
I32 FurnaceTileEntity_getBurnProgress(FurnaceTileEntity *s,I32 scale) {return (s->cookTime*scale)(I32)/200;}
I32 FurnaceTileEntity_getLitProgress(FurnaceTileEntity *s,I32 scale) {if(!s->totalBurnTime)s->totalBurnTime=200;I32 v=(s->burnTime*scale)(I32)/s->totalBurnTime;if(v>=scale)return scale;return v;}
U0 FurnaceTileEntity_tick(FurnaceTileEntity *s) {Bool was=s->burnTime>0,change=FALSE;if(was)s->burnTime--;if(!s->w->isClient){if(!s->burnTime && FurnaceTileEntity_canBurn(s)){s->burnTime=FurnaceTileEntity_getBurnDuration(&s->inventory[1]);s->totalBurnTime=s->burnTime;if(s->burnTime>0){if(!ItemInstance_isNull(&s->inventory[1]))ItemInstance_useAsFuel(&s->inventory[1]);change=TRUE;}}if(s->burnTime>0 && FurnaceTileEntity_canBurn(s)){s->cookTime++;if(s->cookTime==200){s->cookTime=0;FurnaceTileEntity_burn(s);change=TRUE;}}else s->cookTime=0;if(was!=(s->burnTime>0)){FurnaceTile_setLit(s->w,s->x,s->y,s->z,s->burnTime>0);change=TRUE;}if(change){s->changed++;MC023_Event(s->w,MC023_CHANGED,s->x,s->y,s->z,0,0,0,s);return;}}if(!was)s->finished=TRUE;}
U0 FurnaceTileEntity_setItem(FurnaceTileEntity *s,I32 slot,ItemInstance *item) {if(slot<0 || slot>2)return;s->inventory[slot]=*item;if(s->inventory[slot].count>64)s->inventory[slot].count=64;}
U0 FurnaceTileEntity_removeItem(FurnaceTileEntity *s,I32 slot,I32 amount,ItemInstance *out) {ItemInstance_Init(out,s->w->registry,0,0,0);if(slot<0 || slot>2 || ItemInstance_isNull(&s->inventory[slot]))return;ItemInstance *item=&s->inventory[slot];if(item->count>amount){ItemInstance_remove(item,amount,out);if(!item->count)ItemInstance_setNull(item);}else{ItemInstance_setNull(item);ItemInstance_cloneSafe(out,s->w->registry,item);/* Source's full-stack removal returns cleared item, intentionally preserved. */}}
Bool FurnaceTileEntity_shouldSave(FurnaceTileEntity *s) {return s->burnTime>0 || !ItemInstance_isNull(&s->inventory[2]);/* Source loop tests slot2 three times. */}
U0 FurnaceTileEntity_load(FurnaceTileEntity *s,CompoundTag *tag) {I32 i;for(i=0;i<3;i++)ItemInstance_setNull(&s->inventory[i]);Tag *raw=MC023_TagGet(tag,"Items");if(raw && raw->id==9){ListTag *list=raw;for(i=0;i<list->value.size;i++){Tag *v=list->value.data[i];if(v && v->id==10){CompoundTag *ct=v;I32 slot=MC023_NBTGet(ct,"Slot",TRUE);if(slot<=2){ItemInstance_load(&s->inventory[slot],ct);if(!s->inventory[slot].itemClass)ItemInstance_setNull(&s->inventory[slot]);}}}}s->burnTime=MC023_NBTGet(tag,"BurnTime",FALSE);s->cookTime=MC023_NBTGet(tag,"CookTime",FALSE);s->totalBurnTime=FurnaceTileEntity_getBurnDuration(&s->inventory[1]);}
Bool FurnaceTileEntity_save(FurnaceTileEntity *s,CompoundTag *tag) {MC023_NBTPut(tag,"BurnTime",s->burnTime,FALSE);MC023_NBTPut(tag,"CookTime",s->cookTime,FALSE);ListTag *list=MC_Alloc(sizeof(ListTag));ListTag_InitEmpty(list);I32 i;for(i=0;i<3;i++)if(!ItemInstance_isNull(&s->inventory[i])){CompoundTag *ct=MC_Alloc(sizeof(CompoundTag));CompoundTag_InitEmpty(ct);MC023_NBTPut(ct,"Slot",i,TRUE);ItemInstance_save(&s->inventory[i],ct);ListTag_add(list,ct);}MC023_TagPut(tag,"Items",list);return TRUE;}
