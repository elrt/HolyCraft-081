// Batch024 partial API; explicit backend contracts: docs/BATCH024.md
U0 NetherReactorTileEntity_Init(NetherReactorTileEntity *s){memset(s,0,sizeof(NetherReactorTileEntity));TileEntity_Init(&s->base,3);}
Bool NetherReactorTileEntity_checkLevelChange(I32 seconds){return seconds==10 || seconds==13 || seconds==20 || seconds==22 || seconds==25 || seconds==30 || seconds==34 || seconds==36 || seconds==38 || seconds==40;}
I32 NetherReactorTileEntity_getNumEnemiesToSpawn(NetherReactorTileEntity *s){if(s->phase==0)return 3;if(s->phase<=3)return 2;I32 v=Random_genrand_int32(&s->base.world->w->random)&1;if(s->phase<=5)return v;return 0;}
I32 NetherReactorTileEntity_getNumItemsToSpawn(NetherReactorTileEntity *s){if(s->phase==0)return 9;if(s->phase<=3)return 15;U32 r=Random_genrand_int32(&s->base.world->w->random);I32 n;if(s->phase<=7)n=(r%42-4)(I32);else n=(r%27-2)(I32);if(n<0)n=0;return n;}
Bool NetherReactorTileEntity_isEdge(I32 x,I32 radius,I32 z){return x==-radius || x==radius || z==-radius || z==radius;}
U0 NetherReactorTileEntity_buildFloorVolume(NetherReactorTileEntity *s,I32 x,I32 y,I32 z,I32 radius,I32 height,I32 id){I32 a,b,c;for(b=0;b<height;b++)for(a=-radius;a<=radius;a++)for(c=-radius;c<=radius;c++)MC023_Set(s->base.world->w,MC023_SET_TILE,x+a,y+b,z+c,id,0,3);}
U0 NetherReactorTileEntity_buildHollowedVolume(NetherReactorTileEntity *s,I32 x,I32 y,I32 z,I32 radius,I32 height,I32 wall,I32 inside){I32 a,b,c,id;for(b=0;b<height;b++)for(a=-radius;a<=radius;a++)for(c=-radius;c<=radius;c++){if(NetherReactorTileEntity_isEdge(a,radius,c))id=wall;else{if(b<=2 && a>=-1 && a<=1 && c>=-1 && c<=1)continue;id=inside;}MC023_Set(s->base.world->w,MC023_SET_TILE,x+a,y+b,z+c,id,0,3);}}
U0 NetherReactorTileEntity_buildCrockedRoofVolume(NetherReactorTileEntity *s,Bool reverse,I32 x,I32 y,I32 z,I32 radius,I32 height,I32 id){I32 a,b,c,h;for(a=-radius;a<=radius;a++)for(c=-radius;c<=radius;c++){h=a+c;if(reverse)h=-h;h=h/2+height+radius;for(b=0;b<height+2*radius;b++)if(h>=b && (NetherReactorTileEntity_isEdge(a,radius,c) || h==b))MC023_Set(s->base.world->w,MC023_SET_TILE,x+a,y+b,z+c,id,0,3);}}
Bool NetherReactorTileEntity_save(NetherReactorTileEntity *s,CompoundTag *tag){if(!TileEntity_save(&s->base,tag))return FALSE;MC023_NBTPut(tag,"IsInitialized",s->initialized,TRUE);MC023_NBTPut(tag,"Progress",s->progress,FALSE);MC023_NBTPut(tag,"HasFinished",s->finished,TRUE);return TRUE;}
U0 NetherReactorTileEntity_load(NetherReactorTileEntity *s,CompoundTag *tag){TileEntity_load(&s->base,tag);s->initialized=MC023_NBTGet(tag,"IsInitialized",TRUE);if(s->initialized){s->progress=MC023_NBTGet(tag,"Progress",FALSE);s->finished=MC023_NBTGet(tag,"HasFinished",TRUE)!=0;}}
