U0 Mushroom_Init(Mushroom *s,I32 id){s->blockID=id;}
Bool Mushroom_mayPlaceOn(Mushroom *s,MCWorld014 *w,I32 id){return w->solid(w->host,id);}
Bool Mushroom_canSurvive(Mushroom *s,MCWorld014 *w,I32 x,I32 y,I32 z){I32 tile;if(y(U32)>127)return FALSE;tile=w->getTile(w->host,x,y-1,z);return w->brightness(w->host,x,y,z)<=12 && Mushroom_mayPlaceOn(s,w,tile);}
Bool Mushroom_mayPlace(Mushroom *s,MCWorld014 *w,I32 x,I32 y,I32 z,U8 face){return w->baseMayPlace(w->host,x,y,z,face)&&Mushroom_canSurvive(s,w,x,y,z);}
U0 Mushroom_tick(Mushroom *s,MCWorld014 *w,I32 x,I32 y,I32 z){I32 i,j,k,n=5,v14,v15,v16,v22,v25=z,v26;U32 v12,v13,v17,v18,v19,v21;Bool v20;if(w->random(w->host)%25)return;for(i=x-4;i<=x+4;i++)for(j=z-4;j<=z+4;j++)for(k=y-1;k<=y+1;k++)if(w->getTile(w->host,i,k,j)==s->blockID && --n<=0)return;v12=x+w->random(w->host)%3-1;v13=y+(w->random(w->host)&1);v14=v13-(w->random(w->host)&1);v26=4;v15=z+w->random(w->host)%3-1;while(TRUE){if(!w->empty(w->host,v12,v14,v15)||!Mushroom_canSurvive(s,w,v12,v14,v15)){v12=x;v14=y;v15=v25;}v16=v12+w->random(w->host)%3-1;v17=v14+(w->random(w->host)&1);v18=v17-(w->random(w->host)&1);v19=w->random(w->host)%3;v20=v26--==1;v21=v19+v15;if(v20)break;v25=v15;v15=v21-1;y=v14;v14=v18;x=v12;v12=v16;}v22=v21-1;if(w->empty(w->host,v16,v18,v22)&&Mushroom_canSurvive(s,w,v16,v18,v22))w->setTile(w->host,v16,v18,v22,s->blockID,3);}
