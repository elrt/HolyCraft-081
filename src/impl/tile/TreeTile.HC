U0 TreeTile_Init(TreeTile *s,MCTileHost013 *h,I32 id){I32 i;s->host=h;s->id=id;for(i=0;i<8;i++)s->tex[i]=*h->texture(h->host,"log",i);}U0 TreeTile_onRemove(TreeTile *s,I32 x,I32 y,I32 z){I32 dx,dy,dz,d;MCTileHost013 *h=s->host;if(!h->isClient && h->hasChunks(h->host,x-5,y-5,z-5,x+5,y+5,z+5)){for(dx=-4;dx<=4;dx++)for(dy=-4;dy<=4;dy++)for(dz=-4;dz<=4;dz++)if(h->getTile(h->host,x+dx,y+dy,z+dz)==h->leavesID){d=h->getData(h->host,x+dx,y+dy,z+dz);if(!(d&4))h->setDataNoUpdate(h->host,x+dx,y+dy,z+dz,d|4);}}}I32 TreeTile_getResource(TreeTile *s){return s->host->trunkID;}I32 TreeTile_getResourceCount(TreeTile *s){return 1;}U8 *TreeTile_getTypeDescriptionId(TreeTile *s,I32 a){I32 i=a&7;if(i==0)return "oak";if(i==1)return "spruce";if(i==2)return "birch";if(i==3)return "jungle";printf("TreeTile wood name index unavailable\n");exit(99);return NULL;}I32 TreeTile_getSpawnResourcesAuxValue(TreeTile *s,I32 a){return a&3;}
TextureUVCoordinateSet *TreeTile_getDirTexture(TreeTile *s,I32 side,I32 data){I32 i,d=data&3;if(side(U32)>1){i=0;if(d==1)i=4;else if(d==2)i=2;else if(d==3)i=6;}else{i=1;if(d==1)i=5;else if(d==2)i=3;else if(d==3)i=7;}s->textureUV=s->tex[i];return &s->textureUV;}
