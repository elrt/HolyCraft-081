// Inline original implementation from FenceGateTile.hpp.
U0 FenceGateTile_Init(FenceGateTile *s,MCTileHost012 *h,I32 id){s->host=h;s->id=id;}Bool FenceGateTile_isCubeShaped(FenceGateTile *s){return FALSE;}I32 FenceGateTile_getRenderShape(FenceGateTile *s){return 21;}AABB *FenceGateTile_getAABB(FenceGateTile *s,I32 x,I32 y,I32 z){I32 data=s->host->getData(s->host->host,x,y,z);if(data&4)return NULL;if(data!=2 && data)AABB_Init(&s->aabb,x+0.375,y,z,x+0.625,y+1.5,z+1.0);else AABB_Init(&s->aabb,x,y,z+0.375,x+1.0,y+1.5,z+0.625);return &s->aabb;}Bool FenceGateTile_isSolidRender(FenceGateTile *s){return FALSE;}Bool FenceGateTile_mayPlace(FenceGateTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;return h->solid(h->host,x,y-1,z) && h->baseMayPlace(h->host,x,y,z);}I32 FenceGateTile_getPlacementDataValue(FenceGateTile *s,F32 yaw){F32 v=(yaw*4)(F32)/360.0+0.5;I32 n=v;if(v<n)n--;return n&3;}Bool FenceGateTile_use(FenceGateTile *s,I32 x,I32 y,I32 z){MCTileHost012 *h=s->host;I32 data=h->getData(h->host,x,y,z),next,dir;if(data&4)next=data&~4;else{dir=FenceGateTile_getPlacementDataValue(s,h->playerYaw);if((data&3)==((dir+2)&3))data=dir;next=data|4;}h->setData(h->host,x,y,z,next,2);h->levelEvent(h->host,1003,x,y,z,0);return TRUE;}
