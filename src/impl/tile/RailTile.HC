U0 RailTile_Init(RailTile *s,MCTileHost011 *h,I32 id,TextureUVCoordinateSet *normal){s->host=h;s->id=id;s->normal=*normal;s->turned=*h->atlasTexture(h->host,"rail_normal_turned",0);}TextureUVCoordinateSet *RailTile_getTexture(RailTile *s,I32 meta){if(meta<=5)return &s->normal;return &s->turned;}U0 RailTile_updateState(RailTile *s,I32 x,I32 y,I32 z,I32 neighbor){MCTileHost011 *h=s->host;if(neighbor>0 && h->signalSource(h->host,neighbor) && h->railConnections(h->host,x,y,z)==3)h->railUpdate(h->host,x,y,z,FALSE);}
