U0 EntityTile_Init(EntityTile *s,MCTileHost011 *h,I32 id){s->host=h;s->id=id;h->registerEntityTile(h->host,id);}U0 *EntityTile_newTileEntity(EntityTile *s){MCTileHost011 *h=s->host;return h->createTileEntity(h->host,h->tileEntityType(h->host,s->id));}U0 EntityTile_onPlace(EntityTile *s,I32 x,I32 y,I32 z){s->host->setTileEntity(s->host->host,x,y,z,EntityTile_newTileEntity(s));}U0 EntityTile_onRemove(EntityTile *s,I32 x,I32 y,I32 z){s->host->removeTileEntity(s->host->host,x,y,z);}U0 EntityTile_triggerEvent(EntityTile *s,I32 x,I32 y,I32 z,I32 a,I32 b){U0 *v=s->host->getTileEntity(s->host->host,x,y,z);if(v)s->host->triggerTileEntity(s->host->host,v,a,b);}
