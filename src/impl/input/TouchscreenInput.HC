// Batch025 partial source API; contracts/omissions in docs/BATCH025.md
U0 MC025_TouchRect(MCTouchRect025 *r,F32 x,F32 y,F32 xx,F32 yy){r->x=x;r->y=y;r->xx=xx;r->yy=yy;}
Bool MC025_Inside(MCTouchRect025 *r,F32 x,F32 y){return x>=r->x && y>=r->y && x<=r->xx && y<=r->yy;}
U0 TouchscreenInput_onConfigChanged(TouchscreenInput *s,I32 width,I32 height,F32 pixelsPerMm,F32 guiScale){F32 cell=pixelsPerMm*16,x=8,y=(height-8)-cell*3;if(s->options && s->options->flags[15])x=(width-8)-cell*3;memset(s->zones,0,sizeof(s->zones));MC025_TouchRect(&s->movement,x,y,x+cell*3,y+cell*3);MC025_TouchRect(&s->zones[0],x+cell,y,x+cell*2,y+cell);MC025_TouchRect(&s->zones[1],x+cell,y+cell*2,x+cell*2,y+cell*3);MC025_TouchRect(&s->zones[2],x,y+cell,x+cell,y+cell*2);MC025_TouchRect(&s->zones[3],x+cell*2,y+cell,x+cell*3,y+cell*2);MC025_TouchRect(&s->zones[4],x+cell,y+cell,x+cell*2,y+cell*2);F32 chat=guiScale*18;if(chat>pixelsPerMm*10)chat=pixelsPerMm*10;MC025_TouchRect(&s->zones[6],width-chat-4,4,width-4,chat+4);}
I32 TouchscreenInput_zone(TouchscreenInput *s,F32 x,F32 y){I32 i;for(i=0;i<8;i++){if(i==5 || i==7)continue;if(MC025_Inside(&s->zones[i],x,y))return i+100;}return -1;}
U0 TouchscreenInput_tickBase(IMoveInput *base,U0 *player){TouchscreenInput *s=base;Player *p=player;MCBody023 *body=&p->mob.entity.body;base->strafeInput=0;base->forwardInput=0;base->jumping=FALSE;I32 i;for(i=0;i<6;i++)s->buttons[i]=FALSE;Bool stick=FALSE,jumpHeld=FALSE,stickJump=FALSE;for(i=0;i<s->points.size;i++){MCTouchPoint025 *point=MCVector_At(&s->points,i);if(s->stick && !s->flightMode && MC025_Inside(&s->movement,point->x,point->y)){stick=TRUE;F32 angle=atan2(point->y-(s->movement.y+s->movement.yy)*0.5,point->x-(s->movement.x+s->movement.xx)*0.5)+3.1416;base->forwardInput=Mth_sin(angle);base->strafeInput=Mth_cos(angle);}I32 id=TouchscreenInput_zone(s,point->x,point->y);if(id<100)continue;I32 n=id-100;if(point->pressed)s->jumpOrigin=id==104;Bool down=FALSE;if(id==104){jumpHeld=TRUE;if(body->inWater || point->pressed){base->jumping=TRUE;down=TRUE;}else if(s->stick && !p->abilities.flying){stickJump=TRUE;base->forwardInput+=1;id=100;n=0;if(body->inWater)base->jumping=TRUE;else if(!s->flightMode)stick=TRUE;base->forwardInput+=1;down=TRUE;}else down=TRUE;}else if(id==100){if(body->inWater)base->jumping=TRUE;else if(!s->flightMode)stick=TRUE;base->forwardInput+=1;down=TRUE;}else if(id==101 && !s->stick){base->forwardInput-=1;down=TRUE;}else if(id==102 && !s->stick){base->strafeInput+=1;down=TRUE;}else if(id==103 && !s->stick){base->strafeInput-=1;down=TRUE;}else if(id==106 && point->released){if(s->ui && s->ui->action!=NULL)s->ui->action(s->ui->ctx,3,0);}s->buttons[n]=down;}s->stick=stick;if(stickJump && !s->previousStickJump)base->jumping=TRUE;s->previousStickJump=stickJump;s->flightMode=FALSE;if(s->buttons[0])base->flyUpPressed=(base->flyUpPressed || s->previousJump) && s->jumpOrigin;else base->flyUpPressed=FALSE;if(s->buttons[1])base->flyDownPressed=(base->flyDownPressed || s->previousJump) && s->jumpOrigin;else base->flyDownPressed=FALSE;if(p->abilities.flying && (base->flyUpPressed || base->flyDownPressed || (jumpHeld && !s->stick))){base->forwardInput=0;s->flightMode=TRUE;}if(base->sneaking){base->strafeInput*=0.3;base->forwardInput*=0.3;}s->previousJump=jumpHeld;}
U0 TouchscreenInput_releaseBase(IMoveInput *base){TouchscreenInput *s=base;base->strafeInput=0;base->forwardInput=0;memset(s->buttons,0,sizeof(s->buttons));s->previousJump=FALSE;s->jumpOrigin=FALSE;s->points.size=0;}
U0 TouchscreenInput_Init(TouchscreenInput *s,Options *options,MCUI025 *ui,I32 width,I32 height,F32 pixelsPerMm,F32 guiScale){memset(s,0,sizeof(TouchscreenInput));IMoveInput_Init(&s->base);s->base.strafeInput=0;s->base.forwardInput=0;s->base.jumping=FALSE;s->base.sneaking=FALSE;s->base.flyUpPressed=FALSE;s->base.flyDownPressed=FALSE;s->base.tickFn=&TouchscreenInput_tickBase;s->base.releaseFn=&TouchscreenInput_releaseBase;s->options=options;s->ui=ui;MCVector_Init(&s->points,sizeof(MCTouchPoint025));TouchscreenInput_onConfigChanged(s,width,height,pixelsPerMm,guiScale);}
U0 TouchscreenInput_feed(TouchscreenInput *s,MCTouchPoint025 *points,I32 n){s->points.size=0;I32 i;for(i=0;i<n;i++)if(points[i].id>=0 && points[i].id<12)MCVector_Push(&s->points,&points[i]);}
Bool TouchscreenInput_isButtonDown(TouchscreenInput *s,I32 id){if(id<100 || id>107)return FALSE;return s->buttons[id-100];}
U0 TouchscreenInput_Destroy(TouchscreenInput *s){MCVector_Destroy(&s->points);}
