U0 XperiaTickDispatch015(IMoveInput *base,U0 *player){XperiaPlayInput_tick(base(XperiaPlayInput *),player);}U0 XperiaRenderDispatch015(IMoveInput *base,F32 pt){XperiaPlayInput_render(base(XperiaPlayInput *),pt);}U0 XperiaConfigDispatch015(IConfigListener *base,U0 *cfg){Config *c=cfg;XperiaPlayInput_onConfigChanged(base(XperiaPlayInput *),c->width);}
U0 XperiaPlayInput_Init(XperiaPlayInput *s,MCXperiaHost015 *h,U0 *options,I32 (*key)(U0 *,I32),U0 (*craft)(U0 *)){KeyboardInput_Init(&s->base,options,key,craft);s->host=h;s->base.tickFn=&XperiaTickDispatch015;s->base.renderFn=&XperiaRenderDispatch015;s->base.configFn=&XperiaConfigDispatch015;s->wasTouched=FALSE;s->chatPressed=FALSE;RectangleArea_Init(&s->drawArea,TRUE,0,0,0,0);RectangleArea_Init(&s->touchArea,TRUE,0,0,0,0);s->pressedColor=h->makeColor(h->host,0xc0c0c0,128);s->normalColor=h->makeColor(h->host,0xffffff,128);XperiaPlayInput_onConfigChanged(s,h->configWidth);}
U0 XperiaPlayInput_tick(XperiaPlayInput *s,U0 *player){KeyboardInput *b=&s->base;MCXperiaHost015 *h=s->host;Bool sneak=b->sneaking,touch,wasChat=s->chatPressed;KeyboardInput_tick(b,player);b->sneaking=sneak;b->flyUpPressed=b->jumping&&b->inputs[0];b->flyDownPressed=b->jumping&&b->inputs[1];if((b->flyUpPressed||b->flyDownPressed)&&player&&h->flying(h->host,player))b->forwardInput=0;touch=h->touched(h->host,1);if(touch&&!s->wasTouched)b->sneaking^=1;s->wasTouched=touch;if(b->sneaking){b->strafeInput*=0.3;b->forwardInput*=0.3;}s->chatPressed=FALSE;if(h->mouseDown(h->host,1)){if(RectangleArea_isInside(&s->touchArea,h->mouseX(h->host),h->mouseY(h->host)))s->chatPressed=TRUE;}else if(wasChat){h->clickSound(h->host);h->chatScreen(h->host);}}
U0 XperiaPlayInput_render(XperiaPlayInput *s,F32 partial){MCXperiaHost015 *h=s->host;F32 x0,x1,y0,y1;if(!h->hideGUI&&!h->currentScreen){h->begin(h->host,0);if(s->chatPressed)h->color(h->host,s->pressedColor);else h->color(h->host,s->normalColor);x0=h->invGuiScale*s->drawArea.minX;x1=h->invGuiScale*s->drawArea.maxX;y0=h->invGuiScale*s->drawArea.minY;y1=h->invGuiScale*s->drawArea.maxY;h->vertex(h->host,x0,y1,(0)(F32),(0.78125)(F32),(0.39062)(F32));h->vertex(h->host,x1,y1,(0)(F32),(0.85156)(F32),(0.39062)(F32));h->vertex(h->host,x1,y0,(0)(F32),(0.85156)(F32),(0.32031)(F32));h->vertex(h->host,x0,y0,(0)(F32),(0.78125)(F32),(0.32031)(F32));h->bind(h->host,"gui/gui.png");h->draw(h->host,TRUE);}}
U0 XperiaPlayInput_onConfigChanged(XperiaPlayInput *s,I32 width){F32 n=s->host->guiScale*18,limit=s->host->deviceScale*10,margin,x;s->drawArea.field_4=TRUE;s->touchArea.field_4=TRUE;if(n>limit)n=limit;s->drawArea.minY=4;s->drawArea.maxY=n+4;x=width(F32)-(n+4);s->drawArea.minX=x;s->drawArea.maxX=x+n;margin=n*0.25;s->touchArea.minX=x-margin;s->touchArea.minY=4-margin;s->touchArea.maxX=x+n+margin;s->touchArea.maxY=n+4+margin;}
